write-kubeconfig-mode: "0600"
secrets-encryption: true
tls-san:
  - "{{ omnigent_hostname }}"
flannel-backend: vxlan
node-label:
  - "omnigent.dev/single-node=true"
kubelet-arg:
  - "eviction-hard=memory.available<500Mi,nodefs.available<10%,imagefs.available<10%"
  - "eviction-minimum-reclaim=memory.available=250Mi,nodefs.available=5%,imagefs.available=5%"

