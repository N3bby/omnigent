direction: right

title: "Omnigent — Deployment and Runtime Overview" {
  shape: text
  near: top-center
  style: {
    font-size: 32
    bold: true
    font-color: "#0F172A"
  }
}

classes: {
  group: {
    style: {
      fill: "#F8FAFC"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 16
      font-size: 24
    }
  }
  component: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      shadow: true
      font-size: 20
    }
  }
  primary: {
    style: {
      fill: "#DBEAFE"
      stroke: "#2563EB"
      stroke-width: 3
      border-radius: 12
      shadow: true
      font-size: 22
    }
  }
  data: {
    shape: cylinder
    style: {
      fill: "#FEF3C7"
      stroke: "#D97706"
      stroke-width: 2
      font-size: 20
    }
  }
  external: {
    style: {
      fill: "#FAF5FF"
      stroke: "#9333EA"
      stroke-width: 2
      border-radius: 12
      font-size: 20
    }
  }
  security: {
    style: {
      fill: "#DCFCE7"
      stroke: "#16A34A"
      stroke-width: 2
      border-radius: 12
      font-size: 20
    }
  }
}

deployment: {
  label: "Deployment"
  class: group
  direction: down

  owner: "Owner\nReviews and approves changes" {
    class: component
  }
  source: "Source control\nConfiguration and versions" {
    class: external
  }
  automation: "Automated delivery\nValidate, build, publish" {
    class: external
  }

  owner -> source: "change"
  source -> automation: "release"
}

visitor: "User\nWeb browser" {
  class: external
}

platform: {
  label: "Omnigent platform on an Ubuntu VM"
  class: group
  direction: down

  entry: "Secure web access" {
    class: security
  }
  omnigent: "Omnigent\nUser experience and orchestration" {
    class: primary
  }
  data: "Private application data\nAccounts, sessions, and history" {
    class: data
  }
  credentials: "Encrypted connections\nGitHub credentials protected at rest" {
    class: security
  }
  kubernetes: "Kubernetes (k3s)\nSchedules isolated workloads" {
    class: security
  }
  agents: "Ephemeral agent pods\nCodex and Claude\nOne workspace per session" {
    class: primary
  }

  entry -> omnigent: "access"
  omnigent -> data: "store"
  omnigent -> credentials: "protect connections"
  omnigent -> kubernetes: "request workspace"
  kubernetes -> agents: "spawn ephemeral pod"
}

connected: {
  label: "Connected services"
  class: group
  direction: down

  github: "GitHub\nRepositories and collaboration" {
    class: external
  }
  ai: "AI services\nOpenAI and Anthropic" {
    class: external
  }
}

deployment.automation -> platform: "deploy approved release" {
  style.stroke: "#0F766E"
  style.stroke-width: 3
}
visitor -> platform.entry: "HTTPS" {
  style.stroke: "#2563EB"
  style.stroke-width: 3
}
platform.omnigent -> connected.github: "connect account" {
  style.stroke: "#9333EA"
  style.stroke-width: 2
}
platform.agents -> connected.github: "work with code" {
  style.stroke: "#9333EA"
  style.stroke-width: 3
}
platform.agents -> connected.ai: "reason and generate" {
  style.stroke: "#DC2626"
  style.stroke-width: 3
}
