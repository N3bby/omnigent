direction: down

classes: {
  boundary: {
    style: {
      fill: "#F8FAFC"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 12
    }
  }
  namespace: {
    style: {
      fill: "#EFF6FF"
      stroke: "#2563EB"
      stroke-width: 2
      border-radius: 10
    }
  }
  workload: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      border-radius: 8
      shadow: true
    }
  }
  state: {
    shape: cylinder
    style: {
      fill: "#FEF3C7"
      stroke: "#D97706"
      stroke-width: 2
    }
  }
  security: {
    style: {
      fill: "#F0FDF4"
      stroke: "#16A34A"
      border-radius: 8
    }
  }
  external: {
    style: {
      fill: "#FAF5FF"
      stroke: "#9333EA"
      border-radius: 8
    }
  }
  note: {
    shape: text
    style: {
      font-color: "#475569"
      italic: true
    }
  }
}

operator: {
  label: "Operator workstation"
  class: boundary
  direction: down

  repo: "Git repository\nTracked desired state + versions" {
    class: workload
  }
  mise: "Mise tasks\ncheck / diff / deploy / status" {
    class: workload
  }
  ansible: "Ansible\nHost provisioning + reconciliation" {
    class: workload
  }

  repo -> mise: "render + validate"
  mise -> ansible: "manual deployment"
}

delivery: {
  label: "GitHub delivery"
  class: boundary
  direction: down

  actions: "GitHub Actions\nValidate + build linux/amd64" {
    class: external
  }
  ghcr: "Public GHCR\nomnigent-runner\nomnigent-server\nimmutable digests" {
    class: external
  }

  actions -> ghcr: "publish + attest"
}

clients: {
  label: "Users and external services"
  class: boundary
  direction: down

  browser: "Browser\nhttps://omni.n3b.by" {
    class: external
  }
  dns: "Public DNS\nomni.n3b.by -> netcup IP" {
    class: external
  }
  letsencrypt: "Let's Encrypt\nACME certificates" {
    class: external
  }
  github: "GitHub App + repositories\nPer-user OAuth; clone / push / PR" {
    class: external
  }
  ai: "AI provider endpoints\nOpenAI / Anthropic" {
    class: external
  }

  browser -> dns: "resolve + HTTPS"
}

vm: {
  label: "netcup Ubuntu VM | single x86_64 node"
  class: boundary
  direction: down

  host_security: {
    label: "Host boundary"
    class: security
    direction: right

    ssh: "SSH :22\noperator access" {
      class: workload
    }
    firewall: "nftables\nOnly public k3s API :6443 blocked\nOther ports and egress unchanged" {
      class: security
    }
    k3s: "Pinned k3s\ncontainerd + encrypted Kubernetes Secrets\nlocal-path storage" {
      class: workload
    }

    ssh -> k3s: "Ansible"
    firewall -> k3s: "protect API :6443"
  }

  cluster: {
    label: "Kubernetes cluster"
    class: boundary
    direction: right

    edge: {
      label: "Ingress and TLS"
      class: namespace
      direction: down

      traefik: "Traefik\nHTTP -> HTTPS redirect\nsecurity headers" {
        class: workload
      }
      certmanager: "cert-manager\ncontroller + webhook + cainjector" {
        class: workload
      }
      issuer: "ClusterIssuer\nletsencrypt-prod" {
        class: security
      }
      tls: "Secret: omnigent-tls" {
        class: security
      }

      certmanager -> issuer: "reconcile"
      issuer -> tls: "issue / renew"
      tls -> traefik: "serve certificate"
    }

    app: {
      label: "Namespace: omnigent | Pod Security baseline"
      class: namespace
      direction: down

      ingress: "Ingress + Middleware\nomnigent-public" {
        class: workload
      }
      service: "Service: omnigent\nClusterIP :80" {
        class: workload
      }
      server: "Deployment: omnigent\n1 replica | 500m/1Gi request | 2CPU/2Gi limit\nVault-enabled image pinned by digest" {
        class: workload
      }
      config: "Generated ConfigMaps\nserver + sandbox configuration" {
        class: workload
      }
      app_secret: "Secret: omnigent-secrets\nDB + cookie + GitHub App + Vault token" {
        class: security
      }
      artifacts: "PVC: omnigent-artifacts\n10Gi local-path" {
        class: state
      }

      postgres: "StatefulSet: PostgreSQL 16\n250m/512Mi request | 1CPU/1Gi limit" {
        class: workload
      }
      postgres_data: "PVC: postgres-data\n10Gi local-path" {
        class: state
      }

      vault: "StatefulSet: HashiCorp Vault\nTransit key: omnigent-connections\n100m/128Mi request | 500m/512Mi limit" {
        class: workload
      }
      vault_data: "PVC: Vault data\n1Gi local-path" {
        class: state
      }
      vault_bootstrap: "Secret: vault-bootstrap\nunseal key + root token" {
        class: security
      }

      server_sa: "ServiceAccount: omnigent-server\nRBAC only in sandbox namespace" {
        class: security
      }

      ingress -> service: "HTTP"
      service -> server: ":8000"
      config -> server: "env + config.yaml"
      app_secret -> server: "env"
      artifacts -> server: "artifacts"
      server -> postgres: "SQL :5432"
      postgres -> postgres_data: "persistent data"
      server -> vault: "Transit encrypt / decrypt :8200"
      vault -> vault_data: "file storage"
      vault_bootstrap -> vault: "automatic unseal"
      server -> server_sa: "identity"
    }

    runners: {
      label: "Namespace: omnigent-sandboxes | Pod Security restricted"
      class: namespace
      direction: down

      jobs: "Ephemeral runner Jobs / Pods\nmax concurrency: 2\n500m/1Gi request | 2CPU/4Gi limit\n8Gi ephemeral + 8Gi home limit" {
        class: workload
      }
      runner_image: "omnigent-runner image\nCodex + Claude CLIs\npinned GHCR digest" {
        class: workload
      }
      runner_sa: "ServiceAccount: omnigent-runner\nno API token; no RBAC" {
        class: security
      }
      manager_rbac: "Role: sandbox manager\nserver may manage Jobs, Pods, logs,\nlaunch Secrets, events, Sandboxes" {
        class: security
      }
      quota: "LimitRange + ResourceQuota\nbounds CPU, RAM, storage, Pods, Jobs" {
        class: security
      }
      runner_creds: "Secret: omnigent-creds\nClaude token + optional GIT_TOKEN" {
        class: security
      }
      codex_home: "PVC: codex-home\n1Gi shared ChatGPT login" {
        class: state
      }
      network: "Network policy: none\nIngress + egress intentionally unrestricted" {
        class: note
      }

      runner_image -> jobs: "container image"
      runner_sa -> jobs: "identity"
      manager_rbac -> jobs: "creation boundary"
      quota -> jobs: "resource enforcement"
      runner_creds -> jobs: "Claude / optional Git"
      codex_home -> jobs: "Codex auth + config"
      network -> jobs
    }

    edge.traefik -> app.ingress: "HTTPS"
    app.server_sa -> runners.manager_rbac: "RoleBinding"
    app.server -> runners.jobs: "create / observe"
  }

  host_security.k3s -> cluster: "runs"
}

operator.ansible -> vm.host_security.ssh: "SSH + sudo" {
  style.stroke: "#0F766E"
  style.stroke-width: 2
}
operator.repo -> delivery.actions: "push" {
  style.stroke-dash: 4
}
delivery.ghcr -> vm.host_security.k3s: "pull by digest" {
  style.stroke: "#9333EA"
}
clients.dns -> vm.cluster.edge.traefik: "TCP :80 / :443" {
  style.stroke: "#2563EB"
  style.stroke-width: 2
}
clients.letsencrypt -> vm.cluster.edge.certmanager: "ACME HTTP-01"
vm.cluster.app.server -> clients.github: "OAuth + repository API" {
  style.stroke: "#9333EA"
}
vm.cluster.runners.jobs -> clients.github: "short-lived user token" {
  style.stroke: "#9333EA"
}
vm.cluster.runners.jobs -> clients.ai: "unrestricted HTTPS" {
  style.stroke: "#DC2626"
}
