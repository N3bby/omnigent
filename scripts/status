#!/usr/bin/env bash
set -euo pipefail

echo "NODE"
k3s kubectl get nodes -o wide
k3s kubectl top nodes 2>/dev/null || echo "metrics are not ready"
df -h / /var/lib/rancher/k3s 2>/dev/null | awk 'NR == 1 || !seen[$6]++'

echo
echo "SERVER AND DATABASE"
k3s kubectl get deployment,statefulset,pods,svc,ingress,pvc -n omnigent -o wide

echo
echo "TLS"
k3s kubectl get certificate,certificaterequest -n omnigent 2>/dev/null || true

echo
echo "RUNNERS (network unrestricted by policy)"
k3s kubectl get jobs,pods,pvc,resourcequota -n omnigent-sandboxes -o wide
credential_keys="$(k3s kubectl get secret omnigent-creds -n omnigent-sandboxes -o json | jq -r '.data // {} | keys | join(", ")')"
echo "Configured optional runner credential keys: ${credential_keys:-none}"

echo
echo "RESOURCE USE"
k3s kubectl top pods -A 2>/dev/null || echo "metrics are not ready"

echo
echo "WARNINGS"
k3s kubectl get events -A --field-selector type=Warning --sort-by=.lastTimestamp 2>/dev/null | tail -n 30 || true
systemctl --no-pager --full status omnigent-health.timer 2>/dev/null | sed -n '1,8p' || true
journalctl -u omnigent-health.service -p warning --since=-24h --no-pager -n 20 2>/dev/null || true

restarts="$(k3s kubectl get pods -A -o json | jq '[.items[].status.containerStatuses[]? | select(.lastState.terminated.reason == "OOMKilled")] | length')"
if (( restarts > 0 )); then
  echo "WARNING: ${restarts} container(s) have an OOMKilled last state"
fi
