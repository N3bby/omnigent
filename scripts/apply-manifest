#!/usr/bin/env bash
set -euo pipefail

KUBECTL=("$(dirname "${BASH_SOURCE[0]}")/kube")

manifest="${1:?usage: apply-manifest MANIFEST}"
[[ -r "$manifest" ]] || { echo "cannot read $manifest" >&2; exit 1; }

set +e
"${KUBECTL[@]}" diff \
  -f "$manifest" >/dev/null
diff_status=$?
set -e
if [[ "$diff_status" -eq 0 ]]; then
  echo "OMNIGENT_DIFF=unchanged"
fi
if [[ "$diff_status" -ne 1 ]]; then
  if [[ "$diff_status" -ne 0 ]]; then
    echo "could not calculate desired-state diff" >&2
    exit "$diff_status"
  fi
else
  echo "OMNIGENT_DIFF=changed"
fi

# Apply even after an empty diff so --prune can remove objects no longer present.
# Only application kinds are listed: the platform (namespaces, policies, RBAC,
# quotas) is labelled omnigent-platform and belongs to `mise run bootstrap`.
"${KUBECTL[@]}" apply \
  --prune \
  -l app.kubernetes.io/managed-by=omnigent-deployment \
  --prune-allowlist=core/v1/ConfigMap \
  --prune-allowlist=core/v1/PersistentVolumeClaim \
  --prune-allowlist=core/v1/Service \
  --prune-allowlist=core/v1/ServiceAccount \
  --prune-allowlist=apps/v1/Deployment \
  --prune-allowlist=apps/v1/StatefulSet \
  --prune-allowlist=networking.k8s.io/v1/Ingress \
  --prune-allowlist=traefik.io/v1alpha1/Middleware \
  -f "$manifest"
