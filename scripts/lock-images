#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import subprocess
from pathlib import Path

from config import ConfigError, ROOT, fail, load_environment


def resolve(reference: str) -> str:
    result = subprocess.run(
        ["docker", "buildx", "imagetools", "inspect", reference, "--format", "{{json .Manifest.Digest}}"],
        check=False, capture_output=True, text=True,
    )
    value = result.stdout.strip().strip('"')
    if result.returncode or not re.fullmatch(r"sha256:[0-9a-f]{64}", value):
        fail(result.stderr.strip() or f"could not resolve {reference}")
    return value


def head_tag() -> str:
    """The tag the publish workflow pushes for the checked-out commit."""
    result = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, check=False, capture_output=True, text=True)
    commit = result.stdout.strip()
    if result.returncode or not re.fullmatch(r"[0-9a-f]{40}", commit):
        fail(result.stderr.strip() or "could not read the checked-out commit")
    return f"sha-{commit}"


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--environment", default="production")
    # Digests a build just produced; otherwise they are resolved from the tag the
    # publish workflow pushed for the checked-out commit.
    parser.add_argument("--runner-digest")
    parser.add_argument("--server-digest")
    args = parser.parse_args()
    try:
        cfg = load_environment(args.environment)
    except ConfigError as exc:
        fail(exc)
    registry = str(cfg["image_registry"]).rstrip("/")
    if "REPLACE_ME" in registry:
        fail("set image_registry before locking images")
    digests = {
        "runner_digest": args.runner_digest or resolve(f"{registry}/{cfg['runner_image']}:{head_tag()}"),
        "server_digest": args.server_digest or resolve(f"{registry}/{cfg['server_image']}:{head_tag()}"),
    }
    for key, digest in digests.items():
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
            fail(f"{key} is not a sha256 digest: {digest!r}")
    path = ROOT / "environments" / f"{args.environment}.toml"
    text = path.read_text()
    for key, digest in digests.items():
        text, count = re.subn(rf'(?m)^{key}\s*=\s*"[^"]*"$', f'{key} = "{digest}"', text)
        if count != 1:
            fail(f"could not update {key} in {path}")
    path.write_text(text)
    print(f"locked {len(digests)} images in {path}")


if __name__ == "__main__":
    main()
