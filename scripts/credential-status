#!/usr/bin/env bash
set -euo pipefail

namespace=omnigent-sandboxes
pod=credential-status
server_keys="$(k3s kubectl get secret omnigent-secrets -n omnigent -o json | jq -r '.data // {} | keys[]')"
if grep -Fxq OMNIGENT_GITHUB_APP_CLIENT_SECRET <<<"$server_keys" \
  && grep -Fxq VAULT_TOKEN <<<"$server_keys"; then
  echo "GitHub App: configured (authorize it per user in Omnigent)"
else
  echo "GitHub App: not configured"
fi
image="$(k3s kubectl get configmap -n omnigent -l app.kubernetes.io/managed-by=omnigent-deployment -o json \
  | jq -r '.items[] | select(.metadata.name | startswith("omnigent-sandbox-config-")) | .data["config.yaml"]' \
  | awk '/^[[:space:]]*image:/ {print $2; exit}')"
[[ -n "$image" ]] || { echo "could not determine runner image" >&2; exit 1; }

keys="$(k3s kubectl get secret omnigent-creds -n "$namespace" -o json | jq -r '.data // {} | keys[]')"
for key in CLAUDE_CODE_OAUTH_TOKEN GIT_TOKEN; do
  if grep -Fxq "$key" <<<"$keys"; then
    echo "$key: present (the provider exposes no locally checkable expiry)"
  else
    echo "$key: absent"
  fi
done

cleanup() {
  k3s kubectl delete pod "$pod" -n "$namespace" --ignore-not-found --wait=false >/dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup

sed "s|RUNNER_IMAGE|${image}|" <<'EOF' | k3s kubectl apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: credential-status
  namespace: omnigent-sandboxes
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: codex
      image: RUNNER_IMAGE
      command: [sleep, infinity]
      env:
        - {name: HOME, value: /home/omnigent}
        - {name: CODEX_HOME, value: /mnt/codex-home}
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
      resources:
        requests: {cpu: 100m, memory: 128Mi, ephemeral-storage: 128Mi}
        limits: {cpu: "1", memory: 1Gi, ephemeral-storage: 1Gi}
      volumeMounts:
        - {name: codex-home, mountPath: /mnt/codex-home, readOnly: true}
  volumes:
    - name: codex-home
      persistentVolumeClaim: {claimName: codex-home}
EOF
k3s kubectl wait -n "$namespace" --for=condition=Ready "pod/${pod}" --timeout=240s >/dev/null
echo "Codex credential status:"
k3s kubectl exec -n "$namespace" "$pod" -- codex login status
