#!/usr/bin/env bash
set -euo pipefail

KUBECTL=("$(dirname "${BASH_SOURCE[0]}")/kube")

namespace=omnigent-sandboxes
pod=credential-status
server_keys="$("${KUBECTL[@]}" get secret omnigent-secrets -n omnigent -o json | jq -r '.data // {} | keys[]')"
if grep -Fxq OMNIGENT_GITHUB_APP_CLIENT_SECRET <<<"$server_keys" \
  && grep -Fxq VAULT_TOKEN <<<"$server_keys"; then
  echo "GitHub App: configured (authorize it per user in Omnigent)"
else
  echo "GitHub App: not configured"
fi
if "${KUBECTL[@]}" get clusterissuer letsencrypt-prod -o json \
  | jq -e 'any(.spec.acme.solvers[]; .dns01.cloudflare)' >/dev/null; then
  if "${KUBECTL[@]}" get secret cloudflare-api-token -n cert-manager -o json \
    | jq -e '.data["api-token"] // "" | length > 0' >/dev/null 2>&1; then
    echo "Cloudflare DNS token: present (renews the TLS certificate)"
  else
    echo "Cloudflare DNS token: absent; run mise run setup-cloudflare-token"
  fi
fi
image="$("${KUBECTL[@]}" get configmap -n omnigent -l app.kubernetes.io/managed-by=omnigent-deployment -o json \
  | jq -r '.items[] | select(.metadata.name | startswith("omnigent-sandbox-config-")) | .data["config.yaml"]' \
  | awk '/^[[:space:]]*image:/ {print $2; exit}')"
[[ -n "$image" ]] || { echo "could not determine runner image" >&2; exit 1; }

# Names only: store.json also holds every saved credential.
store="$("${KUBECTL[@]}" get secret omnigent-subscriptions -n "$namespace" -o json --ignore-not-found \
  | jq -c 'select(.data["store.json"]) | .data["store.json"] | @base64d | fromjson | {active, accounts: [.accounts[] | {id, provider, name}]}')"
# A provider with an active account in Settings ignores its mise-stored login.
managed="$(jq -r '.active // {} | keys[]' <<<"${store:-null}")"
subscriptions="$(jq -r '(.active // {}) as $active | .accounts // [] | group_by(.provider)[]
    | "  \(.[0].provider): \(map(.name + (if $active[.provider] == .id then " (active)" else "" end)) | join(", "))"' <<<"${store:-null}")"
if [[ -n "$subscriptions" ]]; then
  echo "Subscriptions (Settings → Subscriptions; each provider listed here ignores its mise-stored login):"
  echo "$subscriptions"
else
  echo "Subscriptions: none (Settings → Subscriptions)"
fi

keys="$("${KUBECTL[@]}" get secret omnigent-creds -n "$namespace" -o json | jq -r '.data // {} | keys[]')"
for key in CLAUDE_CODE_OAUTH_TOKEN GIT_TOKEN TAILSCALE_AUTHKEY HERMES_REMOTE_SSH_KEY; do
  if [[ "$key" == CLAUDE_CODE_OAUTH_TOKEN ]] && grep -Fxq claude <<<"$managed"; then
    if grep -Fxq "$key" <<<"$keys"; then
      echo "$key: present but unused (Claude uses its account in Settings → Subscriptions)"
    else
      echo "$key: absent (Claude uses its account in Settings → Subscriptions)"
    fi
  elif grep -Fxq "$key" <<<"$keys"; then
    echo "$key: present (the provider exposes no locally checkable expiry)"
  else
    echo "$key: absent"
  fi
done

if "${KUBECTL[@]}" get secret omnigent-hermes-host -n "$namespace" -o json --ignore-not-found \
  | jq -e '.data["refresh-token"] // "" | length > 0' >/dev/null 2>&1; then
  echo "Hermes host sign-in: present (Hermes sessions start on the always-on host)"
elif "${KUBECTL[@]}" get deployment omnigent-hermes-host -n "$namespace" >/dev/null 2>&1; then
  echo "Hermes host sign-in: absent; run mise run setup-hermes-host"
fi

repo_envs="$("${KUBECTL[@]}" get secrets -n "$namespace" -l omnigent.dev/repo-env -o json \
  | jq -r '.items[] | "  \(.metadata.annotations["omnigent.dev/repository"] // .metadata.name): \((.data // {}) | keys | map(if . == "agent-instructions.md" then "(agent instructions)" elif . == "setup.sh" then "(setup script)" elif . == "git-ssh-key" then "(SSH key)" else . end) | join(", "))"')"
if [[ -n "$repo_envs" ]]; then
  echo "Repository variables (names only):"
  echo "$repo_envs"
else
  echo "Repository variables: none (Settings → Repository variables)"
fi

if grep -Fxq codex <<<"$managed"; then
  echo "Codex credential status: uses its account in Settings → Subscriptions"
  exit 0
fi

cleanup() {
  "${KUBECTL[@]}" delete pod "$pod" -n "$namespace" --ignore-not-found --wait=false >/dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup

sed "s|RUNNER_IMAGE|${image}|" <<'EOF' | "${KUBECTL[@]}" apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: credential-status
  namespace: omnigent-sandboxes
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  hostUsers: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: codex
      image: RUNNER_IMAGE
      command: [sleep, infinity]
      env:
        - {name: HOME, value: /home/omnigent}
        - {name: CODEX_HOME, value: /mnt/codex-home}
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
      resources:
        requests: {cpu: 100m, memory: 128Mi, ephemeral-storage: 128Mi}
        limits: {cpu: "1", memory: 1Gi, ephemeral-storage: 1Gi}
      volumeMounts:
        - {name: codex-home, mountPath: /mnt/codex-home, readOnly: true}
  volumes:
    - name: codex-home
      persistentVolumeClaim: {claimName: codex-home}
EOF
"${KUBECTL[@]}" wait -n "$namespace" --for=condition=Ready "pod/${pod}" --timeout=240s >/dev/null
echo "Codex credential status:"
"${KUBECTL[@]}" exec -n "$namespace" "$pod" -- codex login status
