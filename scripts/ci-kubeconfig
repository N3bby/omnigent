#!/usr/bin/env python3
"""Write a kubeconfig that authenticates as the GitHub Actions deploy identity."""

from __future__ import annotations

import argparse
import base64
import json
from pathlib import Path

from config import ConfigError, ROOT, deploy_audience, fail, kubernetes_ca_path, validate


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--environment", default="production")
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    try:
        cfg, _ = validate(args.environment)
    except ConfigError as exc:
        fail(exc)
    if "deploy_github_repository_id" not in cfg:
        fail(f"deploy_github_repository_id is not set in environments/{args.environment}.toml")
    ca = kubernetes_ca_path(args.environment)
    if not ca.is_file():
        fail(f"{ca.relative_to(ROOT)} is missing; run ENV={args.environment} mise run bootstrap and commit it")

    # kubectl reads JSON kubeconfigs too.
    config = {
        "apiVersion": "v1",
        "kind": "Config",
        "clusters": [{
            "name": "omnigent",
            "cluster": {
                "server": f"https://{cfg['kubernetes_api_host']}:6443",
                "certificate-authority-data": base64.b64encode(ca.read_bytes()).decode(),
            },
        }],
        "users": [{
            "name": "github-actions",
            "user": {"exec": {
                "apiVersion": "client.authentication.k8s.io/v1",
                "command": str(ROOT / "scripts" / "github-oidc-token"),
                "args": [deploy_audience(cfg)],
                "interactiveMode": "Never",
            }},
        }],
        "contexts": [{"name": "omnigent", "context": {"cluster": "omnigent", "user": "github-actions"}}],
        "current-context": "omnigent",
    }
    args.output.write_text(json.dumps(config, indent=2) + "\n")
    args.output.chmod(0o600)
    print(args.output)


if __name__ == "__main__":
    main()
