#!/usr/bin/env bash
set -euo pipefail

namespace=omnigent-sandboxes
pod=claude-login
image="$(k3s kubectl get configmap -n omnigent -l app.kubernetes.io/managed-by=omnigent-deployment -o json \
  | jq -r '.items[] | select(.metadata.name | startswith("omnigent-sandbox-config-")) | .data["config.yaml"]' \
  | awk '/^[[:space:]]*image:/ {print $2; exit}')"
[[ -n "$image" ]] || { echo "could not determine runner image" >&2; exit 1; }

cleanup() {
  k3s kubectl delete pod "$pod" -n "$namespace" --ignore-not-found --wait=false >/dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup

sed "s|RUNNER_IMAGE|${image}|" <<'EOF' | k3s kubectl apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: claude-login
  namespace: omnigent-sandboxes
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: claude
      image: RUNNER_IMAGE
      command: [sleep, infinity]
      env:
        - {name: HOME, value: /home/omnigent}
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
      resources:
        requests: {cpu: 100m, memory: 128Mi, ephemeral-storage: 128Mi}
        limits: {cpu: "1", memory: 1Gi, ephemeral-storage: 1Gi}
EOF
k3s kubectl wait -n "$namespace" --for=condition=Ready "pod/${pod}" --timeout=240s >/dev/null

echo "Complete Claude's setup-token flow, then copy the token it prints."
k3s kubectl exec -it -n "$namespace" "$pod" -- claude setup-token
read -rsp "Paste the printed Claude subscription OAuth token (blank cancels): " token
echo
[[ -n "$token" ]] || exit 0
patch="$(jq -nc --arg value "$token" '{stringData:{CLAUDE_CODE_OAUTH_TOKEN:$value}}')"
k3s kubectl patch secret omnigent-creds -n omnigent-sandboxes --type=merge -p "$patch" >/dev/null
unset token patch
echo "Claude token stored. New runner Jobs will receive it."
