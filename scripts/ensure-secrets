#!/usr/bin/env bash
set -euo pipefail

KUBECTL=("$(dirname "${BASH_SOURCE[0]}")/kube")

if ! "${KUBECTL[@]}" get secret omnigent-secrets -n omnigent >/dev/null 2>&1; then
  postgres_password="$(openssl rand -hex 32)"
  cookie_secret="$(openssl rand -hex 32)"
  "${KUBECTL[@]}" create secret generic omnigent-secrets \
    -n omnigent \
    --from-literal="POSTGRES_PASSWORD=${postgres_password}" \
    --from-literal="DATABASE_URL=postgresql+psycopg://omnigent:${postgres_password}@postgres:5432/omnigent" \
    --from-literal="OMNIGENT_ACCOUNTS_COOKIE_SECRET=${cookie_secret}" \
    >/dev/null
  unset postgres_password cookie_secret
  echo "created omnigent-secrets" >&2
fi

required_keys=(POSTGRES_PASSWORD DATABASE_URL OMNIGENT_ACCOUNTS_COOKIE_SECRET)
for key in "${required_keys[@]}"; do
  value="$("${KUBECTL[@]}" get secret omnigent-secrets -n omnigent -o "jsonpath={.data.${key}}")"
  if [[ -z "$value" ]]; then
    echo "omnigent-secrets is missing required key ${key}; refusing to rotate it implicitly" >&2
    exit 1
  fi
done
unset value

if ! "${KUBECTL[@]}" get secret omnigent-creds -n omnigent-sandboxes >/dev/null 2>&1; then
  "${KUBECTL[@]}" create secret generic omnigent-creds -n omnigent-sandboxes >/dev/null
  echo "created omnigent-creds" >&2
fi

"${KUBECTL[@]}" get secret omnigent-secrets -n omnigent -o json \
  | jq -cS '{namespace:.metadata.namespace,name:.metadata.name,data:.data}' \
  | sha256sum | awk '{print $1}'
