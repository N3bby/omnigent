#!/usr/bin/env python3
"""Store, replace or delete the environment variables of one repository.

Sessions started on the repository get the variables in their agent's
environment. See docs/features/repo-env.md.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import termios
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "images" / "server"))
import omnigent_repo_env as repo_env  # noqa: E402

KUBE = str(ROOT / "scripts" / "kube")


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def read_pasted() -> str:
    """Read NAME=value lines from stdin, without echoing them on a terminal."""
    if not sys.stdin.isatty():
        return sys.stdin.read()
    print("Paste NAME=value lines, then press Ctrl-D on an empty line (input is hidden):", file=sys.stderr)
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    hidden = termios.tcgetattr(fd)
    hidden[3] &= ~termios.ECHO
    try:
        termios.tcsetattr(fd, termios.TCSADRAIN, hidden)
        return sys.stdin.read()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        print(file=sys.stderr)


def secret_manifest(name: str, key: str, variables: dict[str, str]) -> str:
    return json.dumps({
        "apiVersion": "v1",
        "kind": "Secret",
        "type": "Opaque",
        "metadata": {
            "name": name,
            "namespace": repo_env.NAMESPACE,
            "labels": {repo_env.LABEL: "true"},
            "annotations": {repo_env.ANNOTATION: key},
        },
        "stringData": variables,
    })


def secret_exists(name: str) -> bool:
    result = subprocess.run(
        [KUBE, "get", "secret", name, "-n", repo_env.NAMESPACE, "--ignore-not-found", "-o", "name"],
        check=True, capture_output=True, text=True,
    )
    return bool(result.stdout.strip())


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="mise run setup-repo-env",
        description="Give sessions started on a repository its environment variables.",
    )
    parser.add_argument("repository", help="owner/repo on github.com, or a clone URL")
    parser.add_argument("file", nargs="?", help="a .env file with NAME=value lines; without it, paste them")
    parser.add_argument("--delete", action="store_true", help="remove the repository's variables")
    args = parser.parse_args()

    try:
        key = repo_env.repo_key(args.repository)
    except ValueError as exc:
        fail(str(exc))
    name = repo_env.secret_name(key)

    if args.delete:
        if args.file:
            fail("--delete takes no file")
        subprocess.run([KUBE, "delete", "secret", name, "-n", repo_env.NAMESPACE, "--ignore-not-found"],
                       check=True, stdout=subprocess.DEVNULL)
        print(f"Removed the variables for {key}. New sessions on it start without them.")
        return

    if args.file:
        # mise runs tasks from the repository root; resolve the path from
        # where the command was typed.
        path = Path(os.environ.get("MISE_ORIGINAL_CWD", ".")) / args.file
        try:
            text = path.read_text()
        except OSError as exc:
            fail(f"cannot read {args.file}: {exc.strerror}")
    else:
        text = read_pasted()
    try:
        variables = repo_env.parse_env(text)
    except ValueError as exc:
        fail(str(exc))
    if not variables:
        fail("no variables given; to remove them, use --delete")

    verb = "replace" if secret_exists(name) else "create"
    # The values go to kubectl on stdin, never on its command line.
    subprocess.run([KUBE, verb, "-f", "-"], input=secret_manifest(name, key, variables),
                   check=True, text=True, stdout=subprocess.DEVNULL)
    print(f"Stored {len(variables)} variable(s) for {key}: {', '.join(sorted(variables))}")
    print(f"Secret {repo_env.NAMESPACE}/{name}. New sessions on the repository get them;")
    print("a running session gets them when it wakes from being idle.")


if __name__ == "__main__":
    main()
