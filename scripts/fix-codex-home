#!/usr/bin/env bash
# Runner Pods are root inside their user namespace, so Codex can leave login
# files owned by root there, which the UID 1000 login and status Pods cannot
# read. Hand them back to UID 1000 from a Pod with the same ID mapping. IDs the
# user namespace cannot map need the host; `mise run bootstrap` fixes those.
set -euo pipefail

environment="${1:?usage: fix-codex-home ENVIRONMENT}"
export ENV="$environment"
scripts="$(dirname "${BASH_SOURCE[0]}")"
KUBECTL=("$scripts/kube")
namespace=omnigent-sandboxes
pod=codex-home-owner
image="$(awk '/^[[:space:]]*image:/ {print $2; exit}' "$scripts/../.generated/$environment/sandbox-config.yaml")"
[[ -n "$image" ]] || { echo "could not determine runner image" >&2; exit 1; }

cleanup() {
  "${KUBECTL[@]}" delete pod "$pod" -n "$namespace" --ignore-not-found --wait=false >/dev/null 2>&1 || true
}
trap cleanup EXIT
"${KUBECTL[@]}" delete pod "$pod" -n "$namespace" --ignore-not-found --wait=true >/dev/null

sed "s|RUNNER_IMAGE|${image}|" <<'MANIFEST' | "${KUBECTL[@]}" apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: codex-home-owner
  namespace: omnigent-sandboxes
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  hostUsers: false
  securityContext:
    runAsUser: 0
    runAsGroup: 0
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: chown
      image: RUNNER_IMAGE
      command:
        - sh
        - -c
        - |
          set -eu
          if [ -n "$(find /mnt/codex-home \( ! -uid 1000 -o ! -gid 1000 \) -print | head -n 1)" ]; then
            chown -R 1000:1000 /mnt/codex-home
            echo "codex-home: ownership fixed"
          else
            echo "codex-home: ownership ok"
          fi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL], add: [CHOWN, DAC_READ_SEARCH]}
      resources:
        requests: {cpu: 100m, memory: 64Mi, ephemeral-storage: 64Mi}
        limits: {cpu: 500m, memory: 256Mi, ephemeral-storage: 256Mi}
      volumeMounts:
        - {name: codex-home, mountPath: /mnt/codex-home}
  volumes:
    - name: codex-home
      persistentVolumeClaim: {claimName: codex-home}
MANIFEST

phase=""
for _ in $(seq 1 120); do
  phase="$("${KUBECTL[@]}" get pod "$pod" -n "$namespace" -o 'jsonpath={.status.phase}')"
  [[ "$phase" == Succeeded || "$phase" == Failed ]] && break
  sleep 2
done
"${KUBECTL[@]}" logs "$pod" -n "$namespace" 2>/dev/null || true
if [[ "$phase" != Succeeded ]]; then
  echo "could not fix codex-home ownership (Pod ${phase:-not started}); files owned by IDs above 65535 need ENV=$environment mise run bootstrap" >&2
  exit 1
fi
