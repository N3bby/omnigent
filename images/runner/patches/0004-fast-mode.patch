+def _fast_command_from_content(content: object) -> str | None:
+    """
+    Parse a standalone ``/fast`` command, like Codex's own ``/fast``.
+
+    :param content: Latest user content, a string or text blocks.
+    :returns: ``"on"``, ``"off"``, or ``"toggle"`` for a bare ``/fast``;
+        ``None`` when the message is anything else.
+    """
+    if isinstance(content, list):
+        if not all(
+            isinstance(block, dict)
+            and block.get("type") in {"input_text", "text"}
+            and isinstance(block.get("text"), str)
+            for block in content
+        ):
+            return None
+        content = "".join(block["text"] for block in content)
+    if not isinstance(content, str):
+        return None
+    words = content.split()
+    if not words or words[0] != "/fast" or len(words) > 2:
+        return None
+    if len(words) == 1:
+        return "toggle"
+    return words[1] if words[1] in {"on", "off"} else None
+
+
+async def _set_codex_fast_mode(
+    client: CodexAppServerClient,
+    *,
+    bridge_dir: Path,
+    state: CodexNativeBridgeState,
+    command: str,
+) -> None:
+    """
+    Switch the thread's Fast service tier for ``/fast`` instead of starting a turn.
+
+    The change applies from the next turn. The forwarder sees the resulting
+    ``thread/settings/updated`` and shows the state in the web composer.
+
+    :param client: Connected app-server client.
+    :param bridge_dir: The session's native-Codex bridge directory.
+    :param state: Bridge state naming the thread.
+    :param command: ``"on"``, ``"off"`` or ``"toggle"``.
+    """
+    if command == "toggle":
+        enabled = not read_codex_config_fast_mode(bridge_dir)
+    else:
+        enabled = command == "on"
+    await client.request(
+        "thread/settings/update",
+        {
+            "threadId": state.thread_id,
+            "serviceTier": CODEX_FAST_SERVICE_TIER if enabled else None,
+        },
+    )
+    if not write_codex_config_fast_mode(bridge_dir, enabled):
+        _logger.warning("Failed to mirror codex fast mode into config.toml: enabled=%s", enabled)
+    _logger.info("Codex native fast mode %s", "on" if enabled else "off")
+
