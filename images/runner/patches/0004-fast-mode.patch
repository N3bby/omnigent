+def resolve_fast_command(content: str, bridge_dir: Path) -> str:
+    """
+    Turn a bare ``/fast`` into an explicit ``/fast on`` or ``/fast off``.
+
+    Claude Code's ``/fast`` toggles fast mode; given ``on`` or ``off`` it
+    applies the change at once, while a bare ``/fast`` may open a picker
+    Omnigent cannot drive. The current state comes from the latest
+    statusLine capture; when no render has reported it yet, ``/fast``
+    turns fast mode on.
+
+    :param content: User text from the Omnigent web UI, e.g. ``"/fast"``.
+    :param bridge_dir: Bridge directory holding the statusLine capture.
+    :returns: ``"/fast on"`` or ``"/fast off"`` for a bare ``/fast``;
+        *content* unchanged otherwise.
+    """
+    if content.strip() != "/fast":
+        return content
+    status_state = read_claude_context_state(bridge_dir)
+    fast_mode = status_state.get("fast_mode") if status_state is not None else None
+    return "/fast off" if fast_mode is True else "/fast on"
+
