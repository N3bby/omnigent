+# Codex's Fast service tier. Its model catalog lists Fast as ``priority``;
+# ``fast`` is the older spelling, which Codex still accepts and reports as
+# ``priority``.
+CODEX_FAST_SERVICE_TIER = "priority"
+_CODEX_FAST_SERVICE_TIERS = frozenset({CODEX_FAST_SERVICE_TIER, "fast"})
+
+
+def is_codex_fast_service_tier(service_tier: object) -> bool:
+    """
+    Return whether a Codex service tier is the Fast tier.
+
+    :param service_tier: A ``serviceTier`` from the app-server or the
+        ``service_tier`` key of ``config.toml``, e.g. ``"priority"``,
+        ``"default"`` or ``None``.
+    :returns: ``True`` for ``"priority"`` and ``"fast"``.
+    """
+    return service_tier in _CODEX_FAST_SERVICE_TIERS
+
+
+def read_codex_config_fast_mode(bridge_dir: Path) -> bool:
+    """
+    Read whether this session's Codex ``config.toml`` selects the Fast tier.
+
+    :param bridge_dir: The session's native-Codex bridge directory.
+    :returns: ``True`` when the top-level ``service_tier`` is Fast; ``False``
+        when it is anything else, absent, or the file is unreadable.
+    """
+    try:
+        data = tomllib.loads((codex_home_for_bridge_dir(bridge_dir) / "config.toml").read_text())
+    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
+        return False
+    return is_codex_fast_service_tier(data.get("service_tier"))
+
+
+def write_codex_config_fast_mode(bridge_dir: Path, enabled: bool) -> bool:
+    """
+    Record a ``/fast`` switch in this session's Codex ``config.toml``.
+
+    ``thread/settings/update`` changes the live thread's service tier but not
+    ``config.toml``, which a resumed thread starts from. On sets the
+    top-level ``service_tier`` to Fast; off removes the key so Codex uses
+    its standard tier.
+
+    Best-effort, like :func:`write_codex_config_model`.
+
+    :param bridge_dir: The session's native-Codex bridge directory.
+    :param enabled: Whether fast mode is now on.
+    :returns: ``True`` when the file was updated.
+    """
+    config_path = codex_home_for_bridge_dir(bridge_dir) / "config.toml"
+    if enabled:
+        return _upsert_top_level_config_key(config_path, "service_tier", CODEX_FAST_SERVICE_TIER)
+    if not config_path.exists():
+        return True
+    import tomlkit
+    from tomlkit.exceptions import TOMLKitError
+
+    try:
+        document = tomlkit.parse(config_path.read_text(encoding="utf-8"))
+        if "service_tier" not in document:
+            return True
+        del document["service_tier"]
+        fd, tmp_name = tempfile.mkstemp(prefix="config.toml.", dir=str(config_path.parent))
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as handle:
+                handle.write(tomlkit.dumps(document))
+            os.replace(tmp_name, config_path)
+        finally:
+            if os.path.exists(tmp_name):
+                os.unlink(tmp_name)
+    except (OSError, UnicodeDecodeError, TOMLKitError):
+        return False
+    return True
+
+
 def _upsert_top_level_config_key(
     config_path: Path,
     key: str,
