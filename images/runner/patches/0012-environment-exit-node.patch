+def read_exit_node_file(path: Path = EXIT_NODE_FILE) -> dict[str, object] | None:
+    """
+    The exit node the Pod's Tailscale service was asked to use, from its file.
+
+    :returns: ``state`` ``conflict`` with the ``names``, ``failed`` with the
+        ``name`` and Tailscale's ``error``, or ``unknown`` with the ``name``
+        until tailscaled says whether it's online; ``None`` without one.
+    """
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    if not isinstance(data, dict):
+        return None
+    listed = data.get("names")
+    names = [
+        name
+        for name in (listed if isinstance(listed, list) else [])
+        if isinstance(name, str) and 0 < len(name) <= _EXIT_NODE_NAME_MAX
+    ]
+    if len(names) > 1:
+        return {"state": "conflict", "names": names[:16]}
+    name = data.get("name")
+    if not isinstance(name, str) or not 0 < len(name) <= _EXIT_NODE_NAME_MAX:
+        return None
+    error = data.get("error")
+    if isinstance(error, str) and error:
+        return {"state": "failed", "name": name, "error": error[:_EXIT_NODE_ERROR_MAX]}
+    return {"state": "unknown", "name": name}
+
+
+async def read_exit_node(
+    path: Path = EXIT_NODE_FILE, *, tailscaled: httpx.AsyncBaseTransport | None = None
+) -> dict[str, object] | None:
+    """
+    The session's exit node, and whether it's online.
+
+    Asks tailscaled's LocalAPI for the Pod's status: ``connected`` or
+    ``offline`` from its ``ExitNodeStatus``, or ``off`` without one, such as
+    after the agent switched it off. ``unknown`` when tailscaled doesn't answer.
+
+    :param tailscaled: The transport to tailscaled; its socket by default.
+    """
+    node = read_exit_node_file(path)
+    if node is None or node["state"] != "unknown":
+        return node
+    transport = tailscaled or httpx.AsyncHTTPTransport(uds=str(TAILSCALED_SOCKET))
+    try:
+        async with httpx.AsyncClient(
+            transport=transport, base_url="http://local-tailscaled.sock", timeout=2.0
+        ) as client:
+            response = await client.get(
+                "/localapi/v0/status",
+                params={"peers": "false"},
+                headers={"Sec-Tailscale": "localapi"},
+            )
+            response.raise_for_status()
+            status = response.json()
+    except (httpx.HTTPError, OSError, ValueError):
+        return node
+    exit_status = status.get("ExitNodeStatus") if isinstance(status, dict) else None
+    if not isinstance(exit_status, dict):
+        return {**node, "state": "off"}
+    return {**node, "state": "connected" if exit_status.get("Online") is True else "offline"}
+
