diff --git a/tests/runner/test_environment_report_exit_node.py b/tests/runner/test_environment_report_exit_node.py
new file mode 100644
index 0000000..0006f87
--- /dev/null
+++ b/tests/runner/test_environment_report_exit_node.py
@@ -0,0 +1,160 @@
+"""The runner's environment reports: the exit node the session's repositories name."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+
+import httpx
+import pytest
+
+from omnigent.runner.environment_report import (
+    EnvironmentReporter,
+    read_exit_node,
+    read_exit_node_file,
+)
+
+pytestmark = pytest.mark.asyncio
+
+
+def _tailscaled(status: object, *, code: int = 200) -> httpx.MockTransport:
+    """tailscaled's LocalAPI, answering its status with ``status``."""
+
+    def _handler(request: httpx.Request) -> httpx.Response:
+        assert request.url.path == "/localapi/v0/status"
+        assert request.url.params["peers"] == "false"
+        assert request.headers["Sec-Tailscale"] == "localapi"
+        return httpx.Response(code, json=status)
+
+    return httpx.MockTransport(_handler)
+
+
+def _written(tmp_path: Path, data: object) -> Path:
+    path = tmp_path / "exit-node.json"
+    path.write_text(json.dumps(data))
+    return path
+
+
+ONLINE = {"ExitNodeStatus": {"ID": "n1", "Online": True, "TailscaleIPs": ["100.1.2.3/32"]}}
+
+
+@pytest.mark.parametrize(
+    ("status", "state"),
+    [
+        (ONLINE, "connected"),
+        ({"ExitNodeStatus": {"ID": "n1", "Online": False}}, "offline"),
+        # The agent switched it off with `tailscale set --exit-node=`.
+        ({"BackendState": "Running"}, "off"),
+    ],
+)
+async def test_says_whether_the_exit_node_is_online(
+    tmp_path: Path, status: object, state: str
+) -> None:
+    path = _written(tmp_path, {"name": "cronos-vpn"})
+    assert await read_exit_node(path, tailscaled=_tailscaled(status)) == {
+        "state": state,
+        "name": "cronos-vpn",
+    }
+
+
+async def test_without_tailscaled_the_state_is_unknown(tmp_path: Path) -> None:
+    def _gone(request: httpx.Request) -> httpx.Response:
+        raise httpx.ConnectError("no socket", request=request)
+
+    path = _written(tmp_path, {"name": "cronos-vpn"})
+    for transport in (_tailscaled({}, code=503), httpx.MockTransport(_gone)):
+        assert await read_exit_node(path, tailscaled=transport) == {
+            "state": "unknown",
+            "name": "cronos-vpn",
+        }
+
+
+async def test_repositories_naming_different_ones_is_a_conflict(tmp_path: Path) -> None:
+    path = _written(tmp_path, {"names": ["cronos-vpn", "office-exit"]})
+    # tailscaled isn't asked: the Pod uses none.
+    assert await read_exit_node(path, tailscaled=_tailscaled({}, code=500)) == {
+        "state": "conflict",
+        "names": ["cronos-vpn", "office-exit"],
+    }
+
+
+async def test_one_tailscale_refused_says_why(tmp_path: Path) -> None:
+    path = _written(tmp_path, {"name": "no-such-node", "error": "x" * 2000})
+    node = read_exit_node_file(path)
+    assert node is not None
+    assert node["state"] == "failed" and node["name"] == "no-such-node"
+    # Short enough for the server to take the report.
+    assert node["error"] == "x" * 500
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        None,
+        "",
+        "not json",
+        "[]",
+        '{"name": ""}',
+        '{"names": []}',
+        '{"names": 7}',
+        '{"name": ["cronos-vpn"]}',
+        json.dumps({"name": "x" * 254}),
+    ],
+)
+async def test_without_an_exit_node_there_is_none(tmp_path: Path, content: str | None) -> None:
+    path = tmp_path / "exit-node.json"
+    if content is not None:
+        path.write_text(content)
+    assert await read_exit_node(path, tailscaled=_tailscaled(ONLINE)) is None
+
+
+async def test_the_report_carries_the_exit_node(tmp_path: Path) -> None:
+    posted: list[dict[str, object]] = []
+
+    def _server(request: httpx.Request) -> httpx.Response:
+        posted.append(json.loads(request.content))
+        return httpx.Response(204)
+
+    client = httpx.AsyncClient(base_url="http://server", transport=httpx.MockTransport(_server))
+    since = asyncio.get_running_loop().time()
+    reporter = EnvironmentReporter(
+        client=client,
+        session_id="conv_1",
+        idle_timeout_s=1800.0,
+        last_activity=lambda: since,
+        has_active_work=lambda: False,
+        cgroup_root=tmp_path,
+        exit_node_file=_written(tmp_path, {"name": "cronos-vpn"}),
+        tailscaled=_tailscaled(ONLINE),
+    )
+    try:
+        await reporter.send()
+    finally:
+        await client.aclose()
+    assert posted[0]["exit_node"] == {"state": "connected", "name": "cronos-vpn"}
+    assert posted[0]["agent_active"] is False
+
+
+async def test_a_failing_exit_node_never_costs_the_report(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    # The report's answer carries "Keep running", so it must go out regardless.
+    from omnigent.runner import environment_report
+
+    async def _broken(*_args: object, **_kwargs: object) -> None:
+        raise RuntimeError("unexpected")
+
+    monkeypatch.setattr(environment_report, "read_exit_node", _broken)
+    since = asyncio.get_running_loop().time()
+    reporter = EnvironmentReporter(
+        client=httpx.AsyncClient(base_url="http://server"),
+        session_id="conv_1",
+        idle_timeout_s=1800.0,
+        last_activity=lambda: since,
+        has_active_work=lambda: False,
+        cgroup_root=tmp_path,
+    )
+    report = await reporter.report()
+    assert report["exit_node"] is None
+    assert report["agent_active"] is False
