+    async def list_file_paths(self, *, limit: int = _FILE_INDEX_LIMIT) -> tuple[list[str], bool]:
+        """List every file path in the workspace, for fuzzy matching.
+
+        Inside a Git repository it lists what ``git ls-files`` does, tracked
+        files plus untracked ones that aren't ignored, so ``.gitignore``
+        keeps out build output and dependencies. A nested repository that
+        isn't a submodule is listed the same way, under its own ignores.
+        Outside any repository it walks the tree the way ``rg --files``
+        would, skipping hidden directories and :data:`_DEFAULT_DEPRIORITIZED_DIRS`.
+
+        :param limit: Maximum number of paths, e.g. ``50000``.
+        :returns: ``(paths, truncated)``: paths relative to the workspace
+            root, sorted, and whether the limit cut the list short.
+        :raises FilesystemPathNotFound: If the root directory is not accessible.
+        """
+        import json as _json
+
+        # Caller-derived values are embedded via json.dumps as Python literals,
+        # and the whole script is shell-quoted below, as in search_files.
+        _header = "\n".join(
+            [
+                "import json, os, subprocess",
+                f"limit = {int(limit)}",
+                f"budget = {_FILE_INDEX_MAX_OUTPUT - 1000}",
+                f"skip = set({_json.dumps(list(_DEFAULT_DEPRIORITIZED_DIRS))})",
+            ]
+        )
+        _body = r"""
+paths = []
+size = 0
+truncated = False
+
+
+class Full(Exception):
+    pass
+
+
+def add(path):
+    global size, truncated
+    # The JSON quoting and separator cost a few bytes beyond the path.
+    size += len(path) + 4
+    if len(paths) >= limit or size > budget:
+        truncated = True
+        raise Full()
+    paths.append(path)
+
+
+def git(cwd, *args):
+    try:
+        done = subprocess.run(
+            ['git', '-c', 'core.quotepath=false', *args],
+            cwd=cwd, capture_output=True, timeout=8,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if done.returncode != 0:
+        return None
+    return [p for p in done.stdout.decode('utf-8', 'replace').split('\0') if p]
+
+
+def repo(root, prefix):
+    tracked = git(root, 'ls-files', '-z', '--recurse-submodules')
+    if tracked is None:
+        return False
+    others = git(root, 'ls-files', '-z', '--others', '--exclude-standard') or []
+    for p in sorted(set(tracked) | set(others)):
+        if p.endswith('/'):
+            # git lists a nested repository as one "dir/" entry.
+            walk(os.path.join(root, p[:-1]), prefix + p)
+        else:
+            add(prefix + p)
+    return True
+
+
+def walk(root, prefix):
+    if os.path.exists(os.path.join(root, '.git')) and repo(root, prefix):
+        return
+    for dirpath, dirnames, filenames in os.walk(root):
+        rel = os.path.relpath(dirpath, root)
+        base = prefix if rel == '.' else prefix + rel.replace(os.sep, '/') + '/'
+        kept = []
+        for d in sorted(dirnames):
+            # A symlinked directory could lead out of the workspace.
+            if d.startswith('.') or d in skip or os.path.islink(os.path.join(dirpath, d)):
+                continue
+            if os.path.exists(os.path.join(dirpath, d, '.git')) and repo(os.path.join(dirpath, d), base + d + '/'):
+                continue
+            kept.append(d)
+        dirnames[:] = kept
+        for f in sorted(filenames):
+            add(base + f)
+
+
+try:
+    walk('.', '')
+except Full:
+    pass
+print(json.dumps({'p': paths, 't': truncated}))
+"""
+        _script = _header + "\n" + _body
+        result = await _run_os_env_async(
+            self._os_env.shell,
+            f"python3 -c {_shell_quote(_script)}",
+            # The server gives the runner 10 seconds to answer.
+            timeout=10,
+            max_output=_FILE_INDEX_MAX_OUTPUT,
+        )
+        if "error" in result:
+            raise FilesystemPathNotFound(f"Root directory not accessible: {result['error']}")
+        stdout = result.get("stdout", "")
+        try:
+            payload = _json.loads(stdout)
+        except _json.JSONDecodeError as exc:
+            raise RuntimeError(
+                f"list_file_paths: unexpected output from sandbox script: {stdout[:200]!r}"
+            ) from exc
+        return sorted(payload.get("p", [])), bool(payload.get("t"))
+
     async def read(
         self,
         path: str,
