+"""Tests for the runner's workspace file index, behind the fuzzy "@" picker."""
+
+from __future__ import annotations
+
+import subprocess
+from collections.abc import AsyncIterator
+from pathlib import Path
+
+import httpx
+import pytest
+from fastapi import FastAPI
+
+from omnigent.entities import DEFAULT_ENVIRONMENT_ID
+from omnigent.inner.datamodel import OSEnvSandboxSpec, OSEnvSpec
+from omnigent.inner.os_env import OSEnvironment, create_os_environment
+from omnigent.runner import create_runner_app
+from omnigent.runner.environment_filesystem import CallerProcessFilesystem
+from omnigent.runner.resource_registry import SessionResourceRegistry
+from tests.runner.helpers import NullServerClient
+
+
+def _git(cwd: Path, *args: str) -> None:
+    subprocess.run(
+        ["git", "-c", "user.name=t", "-c", "user.email=t@t", *args],
+        cwd=cwd,
+        check=True,
+        capture_output=True,
+    )
+
+
+def _os_env(workspace: Path) -> OSEnvironment:
+    os_env = create_os_environment(
+        OSEnvSpec(type="caller_process", cwd=str(workspace), sandbox=OSEnvSandboxSpec(type="none")),
+    )
+    assert os_env is not None
+    return os_env
+
+
+@pytest.fixture
+def workspace(tmp_path: Path) -> Path:
+    """A plain folder holding a Git repository, a hidden folder and node_modules."""
+    ws = tmp_path / "workspace"
+    for path in [
+        "notes.md",
+        "plain/sub/auth.ts",
+        ".cache/blob",
+        "node_modules/pkg/index.js",
+        "repo/src/app.py",
+        "repo/build/out.js",
+        "repo/scratch.py",
+        "repo/vendor/lib/inner.go",
+    ]:
+        (ws / path).parent.mkdir(parents=True, exist_ok=True)
+        (ws / path).write_text("x")
+    repo = ws / "repo"
+    (repo / ".gitignore").write_text("build/\n")
+    _git(repo, "init", "-q")
+    _git(repo / "vendor" / "lib", "init", "-q")
+    _git(repo, "add", ".gitignore", "src")
+    _git(repo, "commit", "-q", "-m", "init")
+    return ws
+
+
+@pytest.fixture
+def app(workspace: Path) -> FastAPI:
+    registry = SessionResourceRegistry()
+    registry._primary_envs["conv_test"] = _os_env(workspace)
+    return create_runner_app(
+        resource_registry=registry,
+        runner_workspace=workspace,
+        server_client=NullServerClient(),  # type: ignore[arg-type]
+    )
+
+
+@pytest.fixture
+async def client(app: FastAPI) -> AsyncIterator[httpx.AsyncClient]:
+    transport = httpx.ASGITransport(app=app)
+    async with httpx.AsyncClient(transport=transport, base_url="http://runner") as c:
+        yield c
+
+
+@pytest.mark.asyncio
+async def test_file_index_lists_every_file_git_aware(client: httpx.AsyncClient) -> None:
+    """Git repositories list tracked and unignored files; elsewhere the tree is walked."""
+    resp = await client.get(
+        f"/v1/sessions/conv_test/resources/environments/{DEFAULT_ENVIRONMENT_ID}/file-index"
+    )
+    assert resp.status_code == 200
+    assert resp.json() == {
+        "object": "list",
+        "paths": [
+            "notes.md",
+            "plain/sub/auth.ts",
+            "repo/.gitignore",
+            "repo/scratch.py",
+            "repo/src/app.py",
+            # A nested repository is listed under its own ignores.
+            "repo/vendor/lib/inner.go",
+        ],
+        "truncated": False,
+    }
+
+
+@pytest.mark.asyncio
+async def test_file_index_stops_at_the_limit(workspace: Path) -> None:
+    paths, truncated = await CallerProcessFilesystem(_os_env(workspace)).list_file_paths(limit=2)
+    assert len(paths) == 2
+    assert truncated is True
+
+
+@pytest.mark.asyncio
+async def test_file_index_skips_symlinked_folders(tmp_path: Path) -> None:
+    """A symlinked folder could lead out of the workspace, so it isn't followed."""
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    (outside / "secret.txt").write_text("x")
+    ws = tmp_path / "ws"
+    ws.mkdir()
+    (ws / "a.txt").write_text("x")
+    (ws / "link").symlink_to(outside, target_is_directory=True)
+    paths, truncated = await CallerProcessFilesystem(_os_env(ws)).list_file_paths()
+    assert paths == ["a.txt"]
+    assert truncated is False
