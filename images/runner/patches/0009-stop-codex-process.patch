+"""Stopping a Codex session must release its old subscription process."""
+from __future__ import annotations
+
+import uuid
+from typing import Any
+import pytest
+from omnigent.runner import create_runner_app
+from omnigent.spec.types import AgentSpec, ExecutorSpec
+from tests.runner.conftest import _FakeProcessManager, _ScriptedHarnessClient, _runner_client
+from tests.runner.helpers import NullServerClient
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("event_type", ["interrupt", "stop_session"])
+async def test_codex_stop_releases_app_server_but_interrupt_keeps_it(
+    monkeypatch: pytest.MonkeyPatch, event_type: str,
+) -> None:
+    from unittest.mock import AsyncMock
+    from starlette.responses import Response
+    from omnigent.runner import app as runner_app
+    from omnigent.runner.native.interrupt import NativeInterruptRunner
+
+    async def fail_launch(**kwargs: Any) -> None:
+        raise RuntimeError("Launch disabled for test")
+
+    monkeypatch.setattr(runner_app, "_codex_native_launch_config", fail_launch)
+    monkeypatch.setattr(NativeInterruptRunner, "_codex_interrupt", AsyncMock(return_value=Response(status_code=204)))
+    teardown = AsyncMock()
+    monkeypatch.setattr(runner_app._native_runtime, "teardown_codex_native_app_server", teardown)
+    native_spec = AgentSpec(spec_version=1, name="test", executor=ExecutorSpec(type="omnigent", config={"harness":"codex-native"}))
+    async def resolver(agent_id: str, session_id: str | None = None) -> AgentSpec:
+        return native_spec
+    app = create_runner_app(process_manager=_FakeProcessManager(_ScriptedHarnessClient([])), spec_resolver=resolver, server_client=NullServerClient())
+    session_id = uuid.uuid4().hex
+    async with _runner_client(app) as client:
+        created = await client.post("/v1/sessions", json={"session_id": session_id, "agent_id":"ag_1"})
+        assert created.status_code == 201, created.text
+        teardown.reset_mock()
+        stopped = await client.post(f"/v1/sessions/{session_id}/events", json={"type":event_type})
+        assert stopped.status_code == 204, stopped.text
+        if event_type == "stop_session":
+            teardown.assert_awaited_once_with(session_id)
+        else:
+            teardown.assert_not_awaited()
