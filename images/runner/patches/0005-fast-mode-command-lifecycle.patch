+    async def _handle_native_fast_mode_command(
+        conv_id: str, harness: str, command: str
+    ) -> Response:
+        """Apply /fast outside the message buffer and turn lifecycle."""
+        try:
+            if harness == "codex-native":
+                from omnigent.harnesses.codex_native.app_server import client_for_transport
+                from omnigent.inner.codex_native_executor import _set_codex_fast_mode
+
+                state = await _codex_native_bridge_state_for_session(conv_id, action="fast mode")
+                if state is None:
+                    return JSONResponse(
+                        status_code=503,
+                        content={
+                            "error": "codex_fast_mode_no_bridge",
+                            "detail": "Codex bridge is not ready.",
+                        },
+                    )
+                bridge_dir = await _codex_native_bridge_dir_for_session(conv_id)
+                client = client_for_transport(state.socket_path, client_name="omnigent-fast-mode")
+                try:
+                    await client.connect()
+                    await _set_codex_fast_mode(
+                        client, bridge_dir=bridge_dir, state=state, command=command
+                    )
+                finally:
+                    await client.close()
+            else:
+                from omnigent.harnesses.claude_native.bridge import (
+                    bridge_dir_for_bridge_id,
+                    inject_slash_command,
+                    resolve_fast_command,
+                )
+
+                bridge_id = await _claude_native_bridge_id_for_session(
+                    server_client=server_client, session_id=conv_id
+                )
+                bridge_dir = bridge_dir_for_bridge_id(bridge_id)
+                await _prepare_claude_native_pane_for_injection(conv_id, bridge_dir)
+                text = "/fast" if command == "toggle" else f"/fast {command}"
+                await asyncio.to_thread(
+                    inject_slash_command,
+                    bridge_dir,
+                    command=resolve_fast_command(text, bridge_dir),
+                    timeout_s=1.0,
+                )
+        except (RuntimeError, ValueError, OSError, httpx.HTTPError) as exc:
+            return JSONResponse(
+                status_code=503,
+                content={
+                    "error": "native_fast_mode_failed",
+                    "detail": _client_safe_error_detail(exc, context="native fast mode change"),
+                },
+            )
+        return Response(status_code=204)
+
