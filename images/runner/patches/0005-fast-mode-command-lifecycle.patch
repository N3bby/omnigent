+++ b/tests/runner/test_fast_mode_command.py
@@ -0,0 +1,107 @@
+"""Fast controls acknowledge delivery without manufacturing a native turn."""
+
+import uuid
+from unittest.mock import AsyncMock
+
+import pytest
+
+from omnigent.native.fast_mode import fast_mode_command
+from omnigent.runner import create_runner_app
+from omnigent.runner.app import _session_event_queues_ref
+from omnigent.spec.types import AgentSpec, ExecutorSpec
+from tests.runner.conftest import (
+    _drain_session_event_queue,
+    _FakeProcessManager,
+    _runner_client,
+    _ScriptedHarnessClient,
+)
+from tests.runner.helpers import NullServerClient
+
+
+@pytest.mark.parametrize(
+    "content,expected",
+    [
+        ("/fast", "toggle"),
+        ("/fast on", "on"),
+        (" /fast off ", "off"),
+        ([{"type": "input_text", "text": "/fast on"}], "on"),
+        ("/fast maybe", None),
+        ("/fast on please", None),
+        ([{"type": "input_text", "text": "/fast"}, {"type": "input_image", "file_id": "x"}], None),
+    ],
+)
+def test_only_standalone_text_is_a_fast_control(content, expected):
+    assert fast_mode_command(content) == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("harness", ["claude-native", "codex-native"])
+@pytest.mark.parametrize("fail", [False, True])
+async def test_fast_control_never_enters_turn_lifecycle(monkeypatch, harness, fail):
+    from omnigent.harnesses.claude_native import bridge as claude_bridge
+    from omnigent.harnesses.codex_native import app_server
+    from omnigent.harnesses.codex_native import bridge as codex_bridge
+    from omnigent.inner import codex_native_executor
+
+    injected = []
+
+    def inject(bridge_dir, *, command, timeout_s):
+        if fail:
+            raise RuntimeError("test unavailable")
+        injected.append(command)
+
+    monkeypatch.setattr(claude_bridge, "inject_slash_command", inject)
+    monkeypatch.setattr(claude_bridge, "resolve_fast_command", lambda text, _: "/fast on")
+    fake_client = AsyncMock()
+    monkeypatch.setattr(app_server, "client_for_transport", lambda *args, **kwargs: fake_client)
+    apply_fast = AsyncMock(side_effect=RuntimeError("test unavailable") if fail else None)
+    monkeypatch.setattr(codex_native_executor, "_set_codex_fast_mode", apply_fast)
+    conv_id = uuid.uuid4().hex
+    spec = AgentSpec(
+        spec_version=1,
+        name="t",
+        executor=ExecutorSpec(type="omnigent", config={"harness": harness}),
+    )
+
+    async def resolver(*args, **kwargs):
+        return spec
+
+    pm = _FakeProcessManager(_ScriptedHarnessClient([]))
+    app = create_runner_app(
+        process_manager=pm, spec_resolver=resolver, server_client=NullServerClient()
+    )
+    async with _runner_client(app) as client:
+        created = await client.post(
+            "/v1/sessions", json={"session_id": conv_id, "agent_id": "test"}
+        )
+        assert created.status_code == 201, created.text
+        if harness == "codex-native":
+            # The control route reads the existing bridge, never starts a native turn.
+            from omnigent.harnesses.codex_native.bridge import CodexNativeBridgeState
+
+            state = CodexNativeBridgeState(
+                session_id=conv_id,
+                thread_id="thread_test",
+                socket_path="/tmp/test.sock",
+                codex_home="/tmp/test-home",
+                active_turn_id="turn_live",
+            )
+            monkeypatch.setattr(codex_bridge, "read_bridge_state", lambda _: state)
+        _drain_session_event_queue(_session_event_queues_ref.get(conv_id))
+        response = await client.post(
+            f"/v1/sessions/{conv_id}/events",
+            json={
+                "type": "message",
+                "role": "user",
+                "content": [{"type": "input_text", "text": "/fast on"}],
+            },
+        )
+        assert response.status_code == (503 if fail else 204), response.text
+        events = _drain_session_event_queue(_session_event_queues_ref.get(conv_id))
+        assert not any(event.get("type") == "session.status" for event in events)
+        assert not app.state.has_active_work()
+        if not fail:
+            if harness == "claude-native":
+                assert injected == ["/fast on"]
+            else:
+                apply_fast.assert_awaited_once()
