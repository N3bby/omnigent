+"""Recognize native fast-mode controls without starting a conversation turn."""
+
+from __future__ import annotations
+
+
+def fast_mode_command(content: object) -> str | None:
+    """Return on/off/toggle for standalone text-only commands, else None."""
+    if isinstance(content, list):
+        if not content or not all(
+            isinstance(block, dict)
+            and block.get("type") in {"input_text", "text"}
+            and isinstance(block.get("text"), str)
+            for block in content
+        ):
+            return None
+        content = "".join(block["text"] for block in content)
+    if not isinstance(content, str):
+        return None
+    words = content.split()
+    if not words or words[0] != "/fast" or len(words) > 2:
+        return None
+    if len(words) == 1:
+        return "toggle"
+    return words[1] if words[1] in {"on", "off"} else None
