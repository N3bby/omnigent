diff --git a/tests/harnesses/claude_native/test_permission_hook_auth_refresh.py b/tests/harnesses/claude_native/test_permission_hook_auth_refresh.py
new file mode 100644
index 0000000..04a3b89
--- /dev/null
+++ b/tests/harnesses/claude_native/test_permission_hook_auth_refresh.py
@@ -0,0 +1,223 @@
+"""The Claude permission hook keeps working after its launch bearer expires."""
+
+from __future__ import annotations
+
+import asyncio
+import io
+import json
+import sys
+from collections.abc import Callable
+from pathlib import Path
+
+import httpx
+import pytest
+
+from omnigent.harnesses.claude_native import hook as claude_native_hook
+from omnigent.harnesses.claude_native.bridge import (
+    build_hook_settings,
+    prepare_bridge_dir,
+    read_permission_hook_config,
+    update_permission_hook_auth_headers,
+)
+from omnigent.native import native_policy_hook
+from omnigent.runner.native.orchestration import _refresh_claude_permission_hook_auth
+
+_SERVER_URL = "http://127.0.0.1:8787"
+_ALLOW = json.dumps(
+    {
+        "hookSpecificOutput": {
+            "hookEventName": "PermissionRequest",
+            "decision": {"behavior": "allow"},
+        }
+    }
+)
+
+
+@pytest.fixture
+def bridge_dir(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    """
+    Stand up a bridge dir whose permission hook holds the launch bearer.
+
+    :param tmp_path: Test-scoped temp directory.
+    :param monkeypatch: Pytest monkeypatch fixture.
+    :returns: The prepared bridge directory.
+    """
+    monkeypatch.setattr("omnigent.harnesses.claude_native.bridge._TRUSTED_PARENT", tmp_path)
+    monkeypatch.setattr("omnigent.harnesses.claude_native.bridge._BRIDGE_ROOT", tmp_path / "root")
+    bridge = prepare_bridge_dir("conv_auth", bridge_id="bridge_auth", workspace=tmp_path)
+    build_hook_settings(
+        bridge,
+        ap_server_url=_SERVER_URL,
+        ap_auth_headers={"Authorization": "Bearer launch-token"},
+    )
+    return bridge
+
+
+@pytest.mark.asyncio
+async def test_runner_refreshes_the_hook_bearer(bridge_dir: Path) -> None:
+    """
+    The runner writes its current bearer into ``permission_hook.json``.
+
+    :param bridge_dir: Bridge dir holding the launch bearer.
+    """
+    task = asyncio.create_task(
+        _refresh_claude_permission_hook_auth(
+            bridge_dir=bridge_dir,
+            server_url=_SERVER_URL,
+            auth_token_factory=lambda: "fresh-token",
+            refresh_interval_s=0.01,
+        )
+    )
+    try:
+
+        async def _wait_for_refresh() -> None:
+            while True:
+                headers = read_permission_hook_config(bridge_dir).get("ap_auth_headers", {})
+                if headers.get("Authorization") == "Bearer fresh-token":
+                    return
+                await asyncio.sleep(0.01)
+
+        await asyncio.wait_for(_wait_for_refresh(), timeout=1.0)
+    finally:
+        task.cancel()
+        _ = await asyncio.gather(task, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_runner_keeps_the_last_bearer_when_minting_fails(bridge_dir: Path) -> None:
+    """
+    A failed mint leaves the snapshot alone and the loop keeps going.
+
+    :param bridge_dir: Bridge dir holding the launch bearer.
+    """
+    calls = 0
+
+    def _factory() -> str | None:
+        nonlocal calls
+        calls += 1
+        raise RuntimeError("mint failed")
+
+    task = asyncio.create_task(
+        _refresh_claude_permission_hook_auth(
+            bridge_dir=bridge_dir,
+            server_url=_SERVER_URL,
+            auth_token_factory=_factory,
+            refresh_interval_s=0.01,
+        )
+    )
+    try:
+        while calls < 3:
+            await asyncio.sleep(0.01)
+    finally:
+        task.cancel()
+        _ = await asyncio.gather(task, return_exceptions=True)
+    headers = read_permission_hook_config(bridge_dir)["ap_auth_headers"]
+    assert headers["Authorization"] == "Bearer launch-token"
+
+
+def _run_hook(
+    bridge_dir: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    respond: Callable[[str], httpx.Response],
+) -> int:
+    """
+    Run the permission hook for one ``AskUserQuestion`` against a stub server.
+
+    :param bridge_dir: Bridge dir the hook reads.
+    :param monkeypatch: Pytest monkeypatch fixture.
+    :param respond: ``(authorization) -> httpx.Response`` for each POST.
+    :returns: The hook's exit code.
+    """
+
+    class _Client:
+        def __init__(self, *, headers: dict[str, str], timeout: object) -> None:
+            del timeout
+            self._authorization = headers.get("Authorization", "")
+
+        def __enter__(self) -> _Client:
+            return self
+
+        def __exit__(self, *args: object) -> None:
+            del args
+
+        def post(self, url: str, *, json: dict[str, object]) -> httpx.Response:
+            del json
+            response = respond(self._authorization)
+            response.request = httpx.Request("POST", url)
+            return response
+
+    monkeypatch.setattr(native_policy_hook.httpx, "Client", _Client)
+    monkeypatch.setattr(claude_native_hook, "_PERMISSION_RETRY_INITIAL_BACKOFF_S", 0.0)
+    payload = {"hook_event_name": "PermissionRequest", "tool_name": "AskUserQuestion"}
+    monkeypatch.setattr(sys, "stdin", io.StringIO(json.dumps(payload)))
+    return claude_native_hook.main(["permission-request", "--bridge-dir", str(bridge_dir)])
+
+
+def test_hook_retries_with_the_runners_newer_bearer(
+    bridge_dir: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    """
+    A 401 re-reads the bearer the runner wrote since, without re-minting.
+
+    In a sandbox runner the hook has nothing to re-mint from; before this
+    fix the 401 left the question in Claude's terminal only.
+
+    :param bridge_dir: Bridge dir holding the launch bearer.
+    :param monkeypatch: Pytest monkeypatch fixture.
+    :param capsys: Pytest capture fixture.
+    """
+    sent: list[str] = []
+
+    def _respond(authorization: str) -> httpx.Response:
+        sent.append(authorization)
+        if authorization != "Bearer fresh-token":
+            # The runner refreshed the file while the stale POST was in flight.
+            update_permission_hook_auth_headers(
+                bridge_dir, {"Authorization": "Bearer fresh-token"}
+            )
+            return httpx.Response(401, text="expired")
+        return httpx.Response(200, text=_ALLOW)
+
+    def _no_mint(self: object) -> None:
+        raise AssertionError("re-minted although the runner had a newer bearer")
+
+    monkeypatch.setattr(native_policy_hook.PolicyHookReauth, "__call__", _no_mint)
+
+    assert _run_hook(bridge_dir, monkeypatch, _respond) == 0
+    assert sent == ["Bearer launch-token", "Bearer fresh-token"]
+    decision = json.loads(capsys.readouterr().out)["hookSpecificOutput"]["decision"]
+    assert decision == {"behavior": "allow"}
+
+
+def test_hook_still_fails_ask_without_a_newer_bearer(
+    bridge_dir: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    """
+    With no newer bearer anywhere, a 401 still falls back to the terminal.
+
+    :param bridge_dir: Bridge dir holding the launch bearer.
+    :param monkeypatch: Pytest monkeypatch fixture.
+    :param capsys: Pytest capture fixture.
+    """
+    sent: list[str] = []
+    minted: list[bool] = []
+
+    def _respond(authorization: str) -> httpx.Response:
+        sent.append(authorization)
+        return httpx.Response(401, text="expired")
+
+    def _mint(self: object) -> None:
+        minted.append(True)
+
+    monkeypatch.setattr(native_policy_hook.PolicyHookReauth, "__call__", _mint)
+
+    assert _run_hook(bridge_dir, monkeypatch, _respond) == 0
+    assert sent == ["Bearer launch-token"]
+    assert minted == [True]
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "401" in captured.err
