+def _permission_hook_reauth(
+    bridge_dir: Path,
+    ap_server_url: str,
+    headers: dict[str, str],
+) -> Callable[[], dict[str, str] | None]:
+    """
+    Build the permission hook's re-auth: the runner's newer bearer first.
+
+    The runner rewrites ``permission_hook.json`` with a fresh bearer while
+    the session runs, so a rejected bearer is usually just older than the
+    file. Re-minting is only the fallback: a sandbox runner has no
+    credential of its own to mint from.
+
+    :param bridge_dir: Bridge directory holding ``permission_hook.json``.
+    :param ap_server_url: Omnigent server base URL the hook POSTs to.
+    :param headers: Headers of the first POST, kept under the fresh ones so
+        routing headers survive.
+    :returns: Callable returning fresh headers, or ``None`` when neither the
+        file nor a re-mint has a newer bearer.
+    """
+    from omnigent.native.native_policy_hook import policy_hook_reauth
+
+    mint = policy_hook_reauth(ap_server_url, headers)
+    sent = headers.get("Authorization")
+
+    def _reauth() -> dict[str, str] | None:
+        nonlocal sent
+        raw = read_permission_hook_config(bridge_dir).get("ap_auth_headers")
+        if isinstance(raw, dict):
+            fresh = {str(key): str(value) for key, value in raw.items()}
+            if fresh.get("Authorization") not in (None, sent):
+                sent = fresh["Authorization"]
+                return {**headers, **fresh}
+        return mint()
+
+    return _reauth
+
