diff --git a/tests/runner/test_claude_native_turn_end_recheck.py b/tests/runner/test_claude_native_turn_end_recheck.py
new file mode 100644
index 0000000..0ba0eeb
--- /dev/null
+++ b/tests/runner/test_claude_native_turn_end_recheck.py
@@ -0,0 +1,174 @@
+"""Claude still at work after ``Stop`` shows as working (this deployment).
+
+When a message, or a background task's notification, reaches Claude while it
+writes its last reply, Claude fires ``Stop`` and goes straight on with it. While
+a background agent it started works on, Claude also reads as busy after
+``Stop``. Its ``sessions/<pid>.json`` says ``busy`` throughout, so it is never
+rewritten, and the forwarder's ``Stop`` → ``idle`` used to stand until it was.
+The registry now re-reads the file shortly after a hook's ``idle`` edge.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+
+import pytest
+
+from omnigent.harnesses.claude_native.status_file import SessionStatusPoller
+from omnigent.runner import resource_registry
+from omnigent.runner.resource_registry import (
+    CLAUDE_NATIVE_TERMINAL_ROLE,
+    SessionResourceRegistry,
+)
+from omnigent.terminals import TerminalRegistry
+from tests.runner.helpers import make_test_terminal_instance
+
+
+def _write_status(config_dir: Path, status: str) -> None:
+    sessions = config_dir / "sessions"
+    sessions.mkdir(parents=True, exist_ok=True)
+    (sessions / "1.json").write_text(
+        json.dumps({"pid": 1, "sessionId": "s", "kind": "interactive", "status": status}),
+        encoding="utf-8",
+    )
+
+
+async def _observe(
+    tmp_path: Path, session_id: str
+) -> tuple[SessionResourceRegistry, list[str], object]:
+    """Watch a claude-native terminal whose status file lives under *tmp_path*.
+
+    :returns: The registry, the statuses it publishes, and the watcher's tick.
+    """
+    terminal_registry = TerminalRegistry()
+    registry = SessionResourceRegistry(terminal_registry=terminal_registry)
+    instance = make_test_terminal_instance("claude", "main", tmp_path)
+    terminal_registry._by_conversation.setdefault(session_id, {})[("claude", "main")] = instance
+    statuses: list[str] = []
+    registry.set_session_status_publisher(
+        lambda _sid, status, _reason=None: statuses.append(status)
+    )
+
+    def _build(*, session_id: str, instance: object, on_status: object) -> SessionStatusPoller:
+        del instance
+        return SessionStatusPoller(
+            on_status=on_status,  # type: ignore[arg-type]
+            pane_pid_getter=lambda: 1,
+            session_id_getter=lambda: "s",
+            config_dir=tmp_path,
+            omnigent_session_id=session_id,
+        )
+
+    registry._build_claude_native_status_poller = _build  # type: ignore[method-assign]
+    callbacks: dict[str, object] = {}
+
+    def _capture_watcher(*_args: object, on_tick: object | None = None, **_kwargs: object) -> None:
+        callbacks["on_tick"] = on_tick
+
+    instance.start_idle_watcher_thread = _capture_watcher  # type: ignore[attr-defined]
+    await registry.observe_required_terminal(
+        session_id, "claude", "main", instance, resource_role=CLAUDE_NATIVE_TERMINAL_ROLE
+    )
+    return registry, statuses, callbacks["on_tick"]
+
+
+@pytest.mark.asyncio
+async def test_a_turn_after_stop_is_published_as_running(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Claude still busy after ``Stop``: the session works again.
+
+    The file reads the same whether Claude went on with a queued message or a
+    background agent it started is still working.
+    """
+    monkeypatch.setattr(resource_registry, "_CLAUDE_NATIVE_TURN_END_RECHECK_SECONDS", 0.05)
+    registry, statuses, tick = await _observe(tmp_path, "conv_next_turn")
+    _write_status(tmp_path, "busy")
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
+
+    # The forwarder's Stop → idle, relayed by the server. Claude went on with
+    # a queued message, so its file still reads busy and isn't rewritten.
+    registry.note_external_session_status("conv_next_turn", "idle")
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
+
+    await asyncio.sleep(0.06)
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running", "running"]
+    assert registry.session_turn_is_active("conv_next_turn")
+
+    # Only once: later ticks of the unchanged file stay quiet.
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running", "running"]
+
+
+@pytest.mark.asyncio
+async def test_a_real_turn_end_stays_idle(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """The file agreeing with ``Stop`` publishes nothing more."""
+    monkeypatch.setattr(resource_registry, "_CLAUDE_NATIVE_TURN_END_RECHECK_SECONDS", 0.05)
+    registry, statuses, tick = await _observe(tmp_path, "conv_turn_end")
+    _write_status(tmp_path, "busy")
+    tick()  # type: ignore[operator]
+    registry.note_external_session_status("conv_turn_end", "idle")
+    _write_status(tmp_path, "idle")
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0.06)
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
+    assert not registry.session_turn_is_active("conv_turn_end")
+
+
+@pytest.mark.asyncio
+async def test_no_recheck_before_it_is_due(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A file that hasn't caught up with ``Stop`` yet isn't read as a new turn."""
+    monkeypatch.setattr(resource_registry, "_CLAUDE_NATIVE_TURN_END_RECHECK_SECONDS", 60.0)
+    registry, statuses, tick = await _observe(tmp_path, "conv_not_due")
+    _write_status(tmp_path, "busy")
+    tick()  # type: ignore[operator]
+    registry.note_external_session_status("conv_not_due", "idle")
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
+
+
+@pytest.mark.asyncio
+async def test_a_failed_turn_keeps_its_error(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """No recheck after ``StopFailure``: a ``running`` would clear its error."""
+    monkeypatch.setattr(resource_registry, "_CLAUDE_NATIVE_TURN_END_RECHECK_SECONDS", 0.05)
+    registry, statuses, tick = await _observe(tmp_path, "conv_failed")
+    _write_status(tmp_path, "busy")
+    tick()  # type: ignore[operator]
+    registry.note_external_session_status("conv_failed", "failed")
+    await asyncio.sleep(0.06)
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
+
+
+@pytest.mark.asyncio
+async def test_a_failure_cancels_a_pending_recheck(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A ``failed`` just after an ``idle`` stands too."""
+    monkeypatch.setattr(resource_registry, "_CLAUDE_NATIVE_TURN_END_RECHECK_SECONDS", 0.05)
+    registry, statuses, tick = await _observe(tmp_path, "conv_idle_then_failed")
+    _write_status(tmp_path, "busy")
+    tick()  # type: ignore[operator]
+    registry.note_external_session_status("conv_idle_then_failed", "idle")
+    registry.note_external_session_status("conv_idle_then_failed", "failed")
+    await asyncio.sleep(0.06)
+    tick()  # type: ignore[operator]
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
