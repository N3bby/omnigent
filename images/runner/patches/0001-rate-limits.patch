+# ``account/rateLimits/read`` calls the ChatGPT backend; bound it so a slow
+# answer never pins a refresh task.
+_RATE_LIMITS_READ_TIMEOUT_S = 15.0
+
+
+def _schedule_rate_limits_refresh(
+    client: httpx.AsyncClient,
+    codex_client: CodexAppServerClient | None,
+    *,
+    session_id: str,
+    forwarder_state: _CodexForwarderState | None,
+) -> None:
+    """
+    Refresh the web composer's subscription windows in the background.
+
+    Called at turn start and end. The read runs off the event loop's
+    handling path so the account round-trip never delays turn events.
+    Parent threads only: child threads share the same account.
+
+    :param client: HTTP client for Omnigent event posts.
+    :param codex_client: Connected app-server client, or ``None``.
+    :param session_id: Omnigent conversation id, e.g. ``"conv_abc123"``.
+    :param forwarder_state: Parent forwarder state, or ``None`` for a child.
+    """
+    if codex_client is None or forwarder_state is None:
+        return
+    running = forwarder_state.rate_limits_task
+    if running is not None and not running.done():
+        return
+    forwarder_state.rate_limits_task = asyncio.create_task(
+        _forward_rate_limits(
+            client, codex_client, session_id=session_id, forwarder_state=forwarder_state
+        ),
+        name="codex-native-forwarder-rate-limits",
+    )
+
+
+async def _forward_rate_limits(
+    client: httpx.AsyncClient,
+    codex_client: CodexAppServerClient,
+    *,
+    session_id: str,
+    forwarder_state: _CodexForwarderState,
+) -> None:
+    """
+    Read the account's subscription windows and post any change to Omnigent.
+
+    Best-effort and not retried: the next turn boundary reads again, and a
+    lost snapshot is harmless. Posted directly rather than through
+    :func:`_post_session_event` so a failure neither dead-letters nor counts
+    against forward-sync health.
+
+    :param client: HTTP client for Omnigent event posts.
+    :param codex_client: Connected app-server client.
+    :param session_id: Omnigent conversation id, e.g. ``"conv_abc123"``.
+    :param forwarder_state: Parent forwarder state holding the dedupe baseline.
+    """
+    try:
+        async with asyncio.timeout(_RATE_LIMITS_READ_TIMEOUT_S):
+            response = await codex_client.request("account/rateLimits/read", {})
+    except Exception as exc:  # noqa: BLE001 — a background best-effort read must never raise
+        _logger.debug("Codex rate-limit read failed; session=%s error=%s", session_id, exc)
+        return
+    rate_limits = _rate_limits_from_read_result(response.get("result"))
+    if rate_limits is None or rate_limits == forwarder_state.posted_rate_limits:
+        return
+    try:
+        resp = await client.post(
+            f"/v1/sessions/{url_component(session_id)}/events",
+            json={"type": "external_session_usage", "data": {"rate_limits": rate_limits}},
+        )
+        resp.raise_for_status()
+    except httpx.HTTPError as exc:
+        _logger.debug("Failed to forward Codex rate limits; session=%s error=%s", session_id, exc)
+        return
+    forwarder_state.posted_rate_limits = rate_limits
+
+
+# Fallback window lengths (minutes) when Codex omits ``windowDurationMins``.
+_CODEX_RATE_LIMIT_WINDOWS = (("primary", 300), ("secondary", 7 * 24 * 60))
+
+
+def _rate_limits_from_read_result(result: object) -> _JsonObject | None:
+    """
+    Map an ``account/rateLimits/read`` result to the ``rate_limits`` shape.
+
+    :param result: The JSON-RPC ``result``, e.g. ``{"rateLimits": {"primary":
+        {"usedPercent": 9, "windowDurationMins": 300, "resetsAt": 1790339366},
+        "secondary": {...}}}``.
+    :returns: ``{"windows": [{"window_minutes": 300, "used_percent": 9.0,
+        "resets_at": 1790339366}, ...]}``, or ``None`` when no subscription
+        window is reported (e.g. an API-key login).
+    """
+    if not isinstance(result, dict):
+        return None
+    snapshot = result.get("rateLimits")
+    if not isinstance(snapshot, dict):
+        return None
+    windows: list[_JsonObject] = []
+    for key, fallback_minutes in _CODEX_RATE_LIMIT_WINDOWS:
+        window = snapshot.get(key)
+        if not isinstance(window, dict):
+            continue
+        used = window.get("usedPercent")
+        if not isinstance(used, (int, float)) or isinstance(used, bool):
+            continue
+        minutes = window.get("windowDurationMins")
+        resets_at = window.get("resetsAt")
+        windows.append(
+            {
+                "window_minutes": (
+                    minutes
+                    if isinstance(minutes, int) and not isinstance(minutes, bool) and minutes > 0
+                    else fallback_minutes
+                ),
+                "used_percent": float(used),
+                "resets_at": (
+                    int(resets_at)
+                    if isinstance(resets_at, (int, float)) and not isinstance(resets_at, bool)
+                    else None
+                ),
+            }
+        )
+    return {"windows": windows} if windows else None
+
+
