+async def _forward_rate_limits(
+    client: httpx.AsyncClient,
+    *,
+    session_id: str,
+    bridge_dir: Path,
+    dedupe: _ForwardDedupeState,
+) -> None:
+    """
+    Mirror the statusLine's subscription windows to the web composer.
+
+    Runs once per statusLine render rather than per transcript batch, so the
+    windows update after every API response. Best-effort and not retried: the
+    next render posts again, and a lost snapshot is harmless.
+
+    :param client: Omnigent HTTP client.
+    :param session_id: Omnigent session/conversation id.
+    :param bridge_dir: Native Claude bridge directory.
+    :param dedupe: Per-session baseline; ``posted_rate_limits`` suppresses
+        re-posting unchanged windows.
+    """
+    status_state = await asyncio.to_thread(read_claude_context_state, bridge_dir)
+    rate_limits = status_state.get("rate_limits") if status_state is not None else None
+    if not isinstance(rate_limits, dict) or rate_limits == dedupe.posted_rate_limits:
+        return
+    try:
+        resp = await client.post(
+            f"/v1/sessions/{session_id}/events",
+            json={"type": "external_session_usage", "data": {"rate_limits": rate_limits}},
+        )
+        resp.raise_for_status()
+    except httpx.HTTPError as exc:
+        _logger.debug(
+            "Failed to forward Claude rate limits; session=%s http_status=%s",
+            session_id,
+            _http_status_for_log(exc),
+            extra={"session_id": session_id},
+        )
+        return
+    dedupe.posted_rate_limits = rate_limits
+
+
