+# Claude Code's statusLine subscription windows and their lengths in minutes.
+_RATE_LIMIT_WINDOWS = (("five_hour", 300), ("seven_day", 7 * 24 * 60))
+
+
+def rate_limits_from_status_payload(payload: dict[str, object]) -> dict[str, object] | None:
+    """
+    Extract the claude.ai subscription windows from a raw statusLine payload.
+
+    Claude Code sends ``rate_limits`` only to Pro/Max logins and only after
+    the session's first API response. The result uses the provider-neutral
+    ``external_session_usage`` ``rate_limits`` shape that codex-native posts
+    too.
+
+    :param payload: Decoded statusLine stdin JSON from Claude Code.
+    :returns: ``{"windows": [{"window_minutes": 300, "used_percent": 23.0,
+        "resets_at": 1790370000}, ...]}``, or ``None`` when no window is
+        reported.
+    """
+    raw = payload.get("rate_limits")
+    if not isinstance(raw, dict):
+        return None
+    windows: list[dict[str, object]] = []
+    for key, minutes in _RATE_LIMIT_WINDOWS:
+        window = raw.get(key)
+        if not isinstance(window, dict):
+            continue
+        used = window.get("used_percentage")
+        if not isinstance(used, (int, float)) or isinstance(used, bool):
+            continue
+        resets_at = window.get("resets_at")
+        windows.append(
+            {
+                "window_minutes": minutes,
+                "used_percent": float(used),
+                "resets_at": (
+                    int(resets_at)
+                    if isinstance(resets_at, (int, float)) and not isinstance(resets_at, bool)
+                    else None
+                ),
+            }
+        )
+    return {"windows": windows} if windows else None
+
