diff --git a/omnigent/runner/environment_report.py b/omnigent/runner/environment_report.py
new file mode 100644
index 0000000..fb5e125
--- /dev/null
+++ b/omnigent/runner/environment_report.py
@@ -0,0 +1,256 @@
+"""
+Report the runner Pod's resource use and the agent's idle deadline.
+
+The composer's environment menu shows how much CPU and memory a sandbox's Pod
+is using and when its agent exits for being idle. Only the runner knows either:
+the server can read the Pod's settings but not its usage, and the runner's
+idle monitor keeps the last activity time. So the runner posts them to
+``POST /v1/sessions/{id}/environment/report`` every :data:`REPORT_INTERVAL_S`,
+and straight away when the agent starts or stops working.
+
+Pushed rather than fetched through the runner tunnel on purpose: every request
+the tunnel delivers counts as activity, so polling the runner would keep an
+idle agent from ever exiting.
+
+Usage comes from cgroup v2, which in a Pod is the runner container's own:
+``cpu.stat`` ``usage_usec`` deltas for CPU, and ``memory.current`` minus
+``inactive_file`` for memory, the working set the kubelet reports.
+
+The server answers each report with the menu's "Keep running" choice. While
+it holds, the runner counts as busy: its idle monitor doesn't exit and its
+native panes aren't reaped, so dev servers in the agent's terminal keep
+running, and the server keeps the Pod alive for as long as the runner is
+connected. Reporting every few seconds means a choice made just before the
+idle deadline still reaches the runner in time.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+import time
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+
+import httpx
+
+from omnigent.process_logging import env_truthy
+
+_logger = logging.getLogger(__name__)
+
+REPORT_INTERVAL_S = 5.0
+"""How often the runner reports while nothing changes: as often as the open menu polls."""
+
+_CHECK_INTERVAL_S = 2.0
+"""How often the reporter looks for a change to report straight away."""
+
+_KEEP_RUNNING_MAX_AGE_S = 90.0
+"""A "Keep running" the server hasn't confirmed for this long no longer holds,
+so a runner that can't reach the server, or was replaced, still exits when idle.
+Long enough to ride out a server restart."""
+
+CGROUP_ROOT = Path("/sys/fs/cgroup")
+
+
+def reporting_enabled() -> bool:
+    """
+    Whether this runner is in a sandbox, the only place it reports from.
+
+    Read from ``IS_SANDBOX``, which the sandbox image sets and the host passes
+    on to the runners it starts. Not ``KUBERNETES_SERVICE_HOST``: the host
+    passes runners only the variables on its allowlist, and that isn't one.
+    """
+    return env_truthy(os.environ.get("IS_SANDBOX"))
+
+
+def _read_stat(path: Path, key: str) -> int | None:
+    """Read one ``key value`` line of a cgroup stat file, or ``None``."""
+    try:
+        for line in path.read_text(encoding="utf-8").splitlines():
+            name, _, value = line.partition(" ")
+            if name == key:
+                return int(value)
+    except (OSError, ValueError):
+        return None
+    return None
+
+
+def read_cpu_usage_usec(root: Path = CGROUP_ROOT) -> int | None:
+    """CPU time the cgroup has used, in microseconds, or ``None`` without cgroup v2."""
+    return _read_stat(root / "cpu.stat", "usage_usec")
+
+
+def read_memory_working_set(root: Path = CGROUP_ROOT) -> int | None:
+    """
+    Memory the cgroup uses, in bytes, as the kubelet counts it.
+
+    ``memory.current`` less the page cache the kernel can drop at once
+    (``inactive_file``), so a big file read doesn't read as memory in use.
+
+    :returns: Bytes, or ``None`` without cgroup v2.
+    """
+    try:
+        current = int((root / "memory.current").read_text(encoding="utf-8").strip())
+    except (OSError, ValueError):
+        return None
+    inactive = _read_stat(root / "memory.stat", "inactive_file") or 0
+    return max(0, current - inactive)
+
+
+@dataclass
+class _CpuSample:
+    usage_usec: int
+    at: float
+
+
+class EnvironmentReporter:
+    """
+    Builds and sends the runner's reports.
+
+    :param client: The runner's HTTP client for the server, authenticated as
+        the session's owner and carrying the runner's tunnel token.
+    :param session_id: The session the runner was started for.
+    :param idle_timeout_s: The runner's idle timeout (``runner.idle_timeout_s``),
+        ``0`` when it never exits for being idle.
+    :param last_activity: Monotonic time of the runner's last activity, on the
+        event loop's clock, as the idle monitor reads it.
+    :param has_active_work: Whether the agent is working on something.
+    :param cgroup_root: Where cgroup v2 is mounted.
+    """
+
+    def __init__(
+        self,
+        *,
+        client: httpx.AsyncClient,
+        session_id: str,
+        idle_timeout_s: float,
+        last_activity: Callable[[], float],
+        has_active_work: Callable[[], bool],
+        cgroup_root: Path = CGROUP_ROOT,
+    ) -> None:
+        self._client = client
+        self._session_id = session_id
+        self._idle_timeout_s = idle_timeout_s
+        self._last_activity = last_activity
+        self._has_active_work = has_active_work
+        self._cgroup_root = cgroup_root
+        self._cpu: _CpuSample | None = None
+        # "Keep running" from the server: until when (Unix seconds), or for good.
+        self._keep_running_until: float | None = None
+        self._keep_running_forever = False
+        self._keep_running_at = 0.0
+
+    def keeps_running(self) -> bool:
+        """Whether the user asked to keep the Pod running, and it still holds."""
+        if time.monotonic() - self._keep_running_at > _KEEP_RUNNING_MAX_AGE_S:
+            return False
+        if self._keep_running_forever:
+            return True
+        until = self._keep_running_until
+        return until is not None and time.time() < until
+
+    def _idle_exit_at(self) -> float | None:
+        """When the idle monitor would exit, ignoring "Keep running"; ``None`` while working."""
+        if self._has_active_work() or self._idle_timeout_s <= 0:
+            return None
+        idle_for = max(0.0, asyncio.get_running_loop().time() - self._last_activity())
+        return time.time() + max(0.0, self._idle_timeout_s - idle_for)
+
+    def _cpu_cores(self) -> float | None:
+        """CPUs in use since the previous report, e.g. ``1.5``; ``None`` the first time."""
+        usage = read_cpu_usage_usec(self._cgroup_root)
+        if usage is None:
+            return None
+        now = time.monotonic()
+        previous, self._cpu = self._cpu, _CpuSample(usage, now)
+        if previous is None or now <= previous.at:
+            return None
+        return max(0.0, (usage - previous.usage_usec) / 1e6 / (now - previous.at))
+
+    def snapshot(self) -> dict[str, object]:
+        """The report: resource use, and whether and since when the agent is idle."""
+        loop_now = asyncio.get_running_loop().time()
+        idle_for = max(0.0, loop_now - self._last_activity())
+        active = self._has_active_work()
+        # The idle monitor only exits once the work is done, and not while kept running.
+        exits_at = self._idle_exit_at()
+        if exits_at is not None and self.keeps_running():
+            exits_at = (
+                None
+                if self._keep_running_forever
+                else max(exits_at, self._keep_running_until or exits_at)
+            )
+        return {
+            "cpu_cores": self._cpu_cores(),
+            "memory_bytes": read_memory_working_set(self._cgroup_root),
+            "agent_active": active,
+            "agent_idle_since": time.time() - idle_for,
+            "agent_exits_at": exits_at,
+        }
+
+    def _keep_running_from(self, response: httpx.Response) -> None:
+        """Take the "Keep running" choice from the server's answer to a report."""
+        try:
+            body = response.json()
+        except ValueError:
+            return
+        if not isinstance(body, dict):
+            return
+        until = body.get("keep_running_until")
+        self._keep_running_until = float(until) if isinstance(until, int | float) else None
+        self._keep_running_forever = body.get("keep_running_forever") is True
+        self._keep_running_at = time.monotonic()
+
+    def _forget_keep_running(self) -> None:
+        """The server refused the report: this runner no longer answers for the session."""
+        self._keep_running_until = None
+        self._keep_running_forever = False
+
+    async def send(self) -> None:
+        """Post one report. Best-effort: a failed post waits for the next."""
+        try:
+            response = await self._client.post(
+                f"/v1/sessions/{self._session_id}/environment/report",
+                json=self.snapshot(),
+                timeout=5.0,
+            )
+            if 400 <= response.status_code < 500:
+                self._forget_keep_running()
+            if response.status_code >= 400:
+                _logger.debug(
+                    "environment report rejected: %s",
+                    response.status_code,
+                    extra={"session_id": self._session_id},
+                )
+            elif response.status_code == 200:
+                self._keep_running_from(response)
+        except (httpx.HTTPError, ConnectionError):
+            _logger.debug(
+                "environment report failed", exc_info=True, extra={"session_id": self._session_id}
+            )
+
+    async def run(self) -> None:
+        """Report every :data:`REPORT_INTERVAL_S`, and when the agent starts or stops working."""
+        loop = asyncio.get_running_loop()
+        last_sent = -REPORT_INTERVAL_S
+        last_active: bool | None = None
+        last_activity = self._last_activity()
+        while True:
+            active = self._has_active_work()
+            activity = self._last_activity()
+            changed = active != last_active or (not active and activity != last_activity)
+            if changed or loop.time() - last_sent >= REPORT_INTERVAL_S:
+                try:
+                    await self.send()
+                except Exception:  # noqa: BLE001 — a report must never end the loop
+                    _logger.warning(
+                        "environment report failed",
+                        exc_info=True,
+                        extra={"session_id": self._session_id},
+                    )
+                last_sent = loop.time()
+                last_active = active
+                last_activity = activity
+            await asyncio.sleep(_CHECK_INTERVAL_S)
