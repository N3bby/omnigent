+@pytest.mark.asyncio
+async def test_a_refused_or_unconfirmed_keep_running_lets_the_runner_exit(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    client = _answering({"keep_running_forever": True})
+    reporter = _reporter(tmp_path, client=client)
+    try:
+        await reporter.send()
+    finally:
+        await client.aclose()
+    assert reporter.keeps_running()
+    # The session moved to another runner: this one's reports are refused.
+    reporter._client = httpx.AsyncClient(
+        base_url="http://server",
+        transport=httpx.MockTransport(lambda _request: httpx.Response(403)),
+    )
+    try:
+        await reporter.send()
+    finally:
+        await reporter._client.aclose()
+    assert not reporter.keeps_running()
+    # Unconfirmed for too long (the server unreachable): it lapses too.
+    reporter._keep_running_forever = True
+    monkeypatch.setattr(
+        reporter,
+        "_keep_running_at",
+        time.monotonic() - environment_report._KEEP_RUNNING_MAX_AGE_S - 1,
+    )
+    assert not reporter.keeps_running()
