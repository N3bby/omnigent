+@pytest.mark.asyncio
+async def test_a_held_pane_reaper_reaps_nothing() -> None:
+    from omnigent.terminals.pane_reaper import NativePaneReaper, PaneRef
+
+    reaped: list[str] = []
+    pane = PaneRef(
+        conversation_id="conv_1",
+        terminal_id="t1",
+        terminal_name="claude",
+        socket_path=Path("/tmp/none"),
+    )
+
+    async def _never_busy(_pane: PaneRef) -> bool:
+        return False
+
+    async def _reap(target: PaneRef) -> None:
+        reaped.append(target.conversation_id)
+
+    held = [True]
+    reaper = NativePaneReaper(
+        list_native_panes=lambda: [pane],
+        is_busy=_never_busy,
+        reap=_reap,
+        idle_timeout_s=0.001,
+    )
+    reaper.hold_while(lambda: held[0])
+    reaper._last_busy_at["conv_1"] = time.monotonic() - 3600
+    await reaper._scan_once()
+    assert reaped == []
+    # Once released, a pane gets a full window again, then goes.
+    held[0] = False
+    await asyncio.sleep(0.01)
+    await reaper._scan_once()
+    assert reaped == ["conv_1"]
+
