diff --git a/tests/runner/test_environment_report.py b/tests/runner/test_environment_report.py
new file mode 100644
index 0000000..f23c23c
--- /dev/null
+++ b/tests/runner/test_environment_report.py
@@ -0,0 +1,302 @@
+"""The runner's environment reports: Pod resource use and the agent's idle deadline."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+from pathlib import Path
+
+import httpx
+import pytest
+
+from omnigent.runner import environment_report
+from omnigent.runner.environment_report import (
+    EnvironmentReporter,
+    read_cpu_usage_usec,
+    read_memory_working_set,
+)
+
+
+def _cgroup(root: Path, *, usage_usec: int, current: int, inactive_file: int) -> Path:
+    (root / "cpu.stat").write_text(f"usage_usec {usage_usec}\nuser_usec 1\nsystem_usec 2\n")
+    (root / "memory.current").write_text(f"{current}\n")
+    (root / "memory.stat").write_text(f"anon 5\ninactive_file {inactive_file}\nactive_file 7\n")
+    return root
+
+
+def test_reads_cgroup_v2_usage(tmp_path: Path) -> None:
+    root = _cgroup(tmp_path, usage_usec=1_500_000, current=8_000, inactive_file=3_000)
+    assert read_cpu_usage_usec(root) == 1_500_000
+    # The page cache the kernel can drop isn't memory in use.
+    assert read_memory_working_set(root) == 5_000
+
+
+def test_without_cgroup_v2_there_is_nothing_to_report(tmp_path: Path) -> None:
+    assert read_cpu_usage_usec(tmp_path) is None
+    assert read_memory_working_set(tmp_path) is None
+
+
+@pytest.mark.parametrize(
+    ("host_env", "reports"),
+    [
+        ({"IS_SANDBOX": "1", "KUBERNETES_SERVICE_HOST": "10.43.0.1"}, True),
+        ({"KUBERNETES_SERVICE_HOST": "10.43.0.1"}, False),
+        ({}, False),
+    ],
+)
+def test_reports_only_from_a_sandbox(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, host_env: dict[str, str], reports: bool
+) -> None:
+    # The runner sees only what the host passes it: sandbox images set
+    # IS_SANDBOX, and KUBERNETES_SERVICE_HOST doesn't get through.
+    from omnigent.host.connect import _build_runner_env
+
+    runner_env = _build_runner_env(
+        {"PATH": "/usr/bin", **host_env},
+        server_url="http://omnigent.omnigent.svc.cluster.local",
+        runner_id="runner_test",
+        binding_token="test-binding-token",
+        workspace=str(tmp_path),
+        parent_pid=1,
+    )
+    monkeypatch.setattr(environment_report.os, "environ", runner_env)
+    assert environment_report.reporting_enabled() is reports
+
+
+def _reporter(
+    tmp_path: Path,
+    *,
+    client: httpx.AsyncClient | None = None,
+    active: list[bool] | None = None,
+    idle_for: float = 0.0,
+    idle_timeout_s: float = 1800.0,
+) -> EnvironmentReporter:
+    state = {"active": active if active is not None else [False]}
+    loop = asyncio.get_running_loop()
+    since = loop.time() - idle_for
+    return EnvironmentReporter(
+        client=client or httpx.AsyncClient(base_url="http://server"),
+        session_id="conv_1",
+        idle_timeout_s=idle_timeout_s,
+        last_activity=lambda: since,
+        has_active_work=lambda: state["active"][0],
+        cgroup_root=tmp_path,
+    )
+
+
+@pytest.mark.asyncio
+async def test_an_idle_agent_reports_when_it_exits(tmp_path: Path) -> None:
+    _cgroup(tmp_path, usage_usec=0, current=8_000, inactive_file=0)
+    snapshot = _reporter(tmp_path, idle_for=600.0).snapshot()
+    assert snapshot["agent_active"] is False
+    assert snapshot["memory_bytes"] == 8_000
+    # The first report has no earlier sample to measure CPU against.
+    assert snapshot["cpu_cores"] is None
+    now = time.time()
+    assert abs(snapshot["agent_idle_since"] - (now - 600.0)) < 2  # type: ignore[operator]
+    assert abs(snapshot["agent_exits_at"] - (now + 1200.0)) < 2  # type: ignore[operator]
+
+
+@pytest.mark.asyncio
+async def test_a_working_agent_doesnt_exit(tmp_path: Path) -> None:
+    snapshot = _reporter(tmp_path, active=[True], idle_for=4000.0).snapshot()
+    assert snapshot["agent_active"] is True
+    assert snapshot["agent_exits_at"] is None
+
+
+@pytest.mark.asyncio
+async def test_cpu_is_measured_between_reports(tmp_path: Path) -> None:
+    reporter = _reporter(tmp_path)
+    _cgroup(tmp_path, usage_usec=1_000_000, current=1, inactive_file=0)
+    reporter.snapshot()
+    # Two seconds ago, as the previous report would have left it.
+    assert reporter._cpu is not None
+    reporter._cpu.at -= 2.0
+    # 3 CPU-seconds over 2 seconds.
+    _cgroup(tmp_path, usage_usec=4_000_000, current=1, inactive_file=0)
+    assert reporter.snapshot()["cpu_cores"] == pytest.approx(1.5, rel=0.01)
+
+
+@pytest.mark.asyncio
+async def test_reports_at_once_when_the_agent_starts_working(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(environment_report, "_CHECK_INTERVAL_S", 0.01)
+    posted: list[dict[str, object]] = []
+
+    def _handler(request: httpx.Request) -> httpx.Response:
+        assert request.url.path == "/v1/sessions/conv_1/environment/report"
+        posted.append(json.loads(request.content))
+        return httpx.Response(204)
+
+    client = httpx.AsyncClient(base_url="http://server", transport=httpx.MockTransport(_handler))
+    active = [False]
+    task = asyncio.create_task(_reporter(tmp_path, client=client, active=active).run())
+    try:
+        while not posted:
+            await asyncio.sleep(0.01)
+        active[0] = True
+        while len(posted) < 2:
+            await asyncio.sleep(0.01)
+    finally:
+        task.cancel()
+        await client.aclose()
+    assert [report["agent_active"] for report in posted[:2]] == [False, True]
+
+
+@pytest.mark.asyncio
+async def test_keeps_reporting_while_nothing_changes(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The open menu polls every 5 seconds, so the runner reports as often."""
+    assert environment_report.REPORT_INTERVAL_S == 5.0
+    monkeypatch.setattr(environment_report, "_CHECK_INTERVAL_S", 0.01)
+    monkeypatch.setattr(environment_report, "REPORT_INTERVAL_S", 0.05)
+    posted: list[object] = []
+
+    def _handler(request: httpx.Request) -> httpx.Response:
+        posted.append(request.url.path)
+        return httpx.Response(204)
+
+    client = httpx.AsyncClient(base_url="http://server", transport=httpx.MockTransport(_handler))
+    task = asyncio.create_task(_reporter(tmp_path, client=client).run())
+    try:
+        while len(posted) < 3:
+            await asyncio.sleep(0.01)
+    finally:
+        task.cancel()
+        await client.aclose()
+
+
+@pytest.mark.asyncio
+async def test_a_failed_report_is_not_an_error(tmp_path: Path) -> None:
+    def _handler(request: httpx.Request) -> httpx.Response:
+        raise httpx.ConnectError("server unreachable")
+
+    client = httpx.AsyncClient(base_url="http://server", transport=httpx.MockTransport(_handler))
+    try:
+        await _reporter(tmp_path, client=client).send()
+    finally:
+        await client.aclose()
+
+
+def _answering(body: object) -> httpx.AsyncClient:
+    return httpx.AsyncClient(
+        base_url="http://server",
+        transport=httpx.MockTransport(lambda _request: httpx.Response(200, json=body)),
+    )
+
+
+@pytest.mark.asyncio
+async def test_keep_running_comes_back_with_the_report(tmp_path: Path) -> None:
+    until = time.time() + 2 * 3600
+    client = _answering({"keep_running_until": until, "keep_running_forever": False})
+    reporter = _reporter(tmp_path, client=client, idle_for=600.0)
+    try:
+        assert not reporter.keeps_running()
+        await reporter.send()
+    finally:
+        await client.aclose()
+    assert reporter.keeps_running()
+    # The agent stays until the user's time is up, not its usual 20 minutes.
+    assert reporter.snapshot()["agent_exits_at"] == pytest.approx(until)
+
+
+@pytest.mark.asyncio
+async def test_kept_running_for_good_never_exits(tmp_path: Path) -> None:
+    client = _answering({"keep_running_forever": True})
+    reporter = _reporter(tmp_path, client=client, idle_for=600.0)
+    try:
+        await reporter.send()
+    finally:
+        await client.aclose()
+    assert reporter.keeps_running()
+    assert reporter.snapshot()["agent_exits_at"] is None
+
+
+@pytest.mark.asyncio
+async def test_keep_running_ends_on_time_and_when_cleared(tmp_path: Path) -> None:
+    reporter = _reporter(tmp_path)
+    client = _answering({"keep_running_until": time.time() - 1})
+    try:
+        await reporter.send()
+        assert not reporter.keeps_running()
+        reporter._keep_running_forever = True
+        await reporter.send()
+    finally:
+        await client.aclose()
+    # Stop sandbox, or "Usual idle timeout", clears it on the server.
+    reporter._client = _answering({})
+    try:
+        await reporter.send()
+    finally:
+        await reporter._client.aclose()
+    assert not reporter.keeps_running()
+
