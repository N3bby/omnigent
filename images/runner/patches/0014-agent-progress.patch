+"""Runner dispatch and native-relay coverage for the chat's progress bar (this deployment)."""
+
+from __future__ import annotations
+
+import json
+
+import httpx
+import pytest
+
+from omnigent.runner.tool_dispatch import (
+    _granted_tool_names,
+    build_native_relay_tool_schemas,
+    execute_tool,
+    should_dispatch_locally,
+)
+from omnigent.spec.types import AgentSpec
+
+
+def test_native_relay_exposes_session_progress() -> None:
+    schemas = build_native_relay_tool_schemas(AgentSpec(spec_version=1))
+
+    progress = next(schema for schema in schemas if schema["name"] == "sys_session_progress")
+
+    assert set(progress["parameters"]["properties"]) == {"label", "percent", "log_file", "clear"}
+    # An empty call fails in the agent's own tool validation, with the reason.
+    assert progress["parameters"]["required"] == ["label"]
+    assert progress["parameters"]["additionalProperties"] is False
+    assert should_dispatch_locally("sys_session_progress")
+
+
+def test_the_spec_less_fallback_leaves_session_progress_out() -> None:
+    # The fallback's tool set is pinned by upstream's comment relay tests.
+    names = {schema["name"] for schema in build_native_relay_tool_schemas(None)}
+
+    assert "sys_session_progress" not in names
+
+
+def test_session_progress_stays_out_of_the_spec_surface() -> None:
+    # Allowed for every agent without joining the ToolManager surface, which
+    # SDK harnesses and the spec's granted set are built from.
+    assert "sys_session_progress" not in _granted_tool_names(AgentSpec(spec_version=1))
+
+
+@pytest.mark.asyncio
+async def test_session_progress_posts_the_update() -> None:
+    requests: list[httpx.Request] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        requests.append(request)
+        body = json.loads(request.content)
+        if body.get("clear"):
+            return httpx.Response(200, json={"progress": None})
+        return httpx.Response(200, json={"progress": {**body, "updated_at": 1.0}})
+
+    async with httpx.AsyncClient(
+        transport=httpx.MockTransport(handler), base_url="http://server"
+    ) as server_client:
+        outputs = [
+            await execute_tool(
+                tool_name="sys_session_progress",
+                arguments=json.dumps(arguments),
+                server_client=server_client,
+                conversation_id="conv_current",
+                agent_spec=AgentSpec(spec_version=1),
+            )
+            for arguments in (
+                {"label": "Migrating components (12/40)", "percent": 30},
+                {"label": "Running the test suite"},
+                {"clear": True},
+            )
+        ]
+
+    assert [json.loads(output) for output in outputs] == [
+        {"shown": True, "label": "Migrating components (12/40)", "percent": 30},
+        {"shown": True, "label": "Running the test suite", "percent": None},
+        {"shown": False},
+    ]
+    assert all(request.method == "POST" for request in requests)
+    assert all(request.url.path == "/v1/sessions/conv_current/progress" for request in requests)
+    assert [json.loads(request.content) for request in requests] == [
+        {"label": "Migrating components (12/40)", "percent": 30},
+        {"label": "Running the test suite"},
+        {"clear": True},
+    ]
+
+
+@pytest.mark.asyncio
+async def test_session_progress_returns_the_server_refusal() -> None:
