+async def _set_session_progress_via_rest(
+    args: _JsonObject,
+    conversation_id: str | None,
+    server_client: httpx.AsyncClient | None,
+) -> str:
+    """Set or end the calling session's progress bar through the server API.
+
+    The server checks the update and keeps the bar for the web UI; a
+    ``log_file`` is then followed for the bar (:mod:`omnigent.runner.progress_log`).
+    Like a rename, a failure comes back as a tool result, never an exception.
+    """
+    name = SysSessionProgressTool.name()
+    if server_client is None:
+        return json.dumps({"error": f"{name} requires server access"})
+    if conversation_id is None:
+        return json.dumps({"error": f"{name} requires a session id"})
+    body = {key: args[key] for key in ("label", "percent", "clear", "log_file") if key in args}
+    try:
+        response = await server_client.post(
+            f"/v1/sessions/{conversation_id}/progress",
+            json=body,
+            timeout=30.0,
+        )
+    except Exception as exc:  # noqa: BLE001
+        return json.dumps({"error": f"{name} failed: {exc}"})
+    if response.status_code >= 400:
+        try:
+            detail = response.json().get("detail")
+        except (ValueError, AttributeError):
+            detail = None
+        return json.dumps(
+            {
+                "error": f"{name} returned {response.status_code}",
+                "detail": detail if isinstance(detail, str) else response.text[:200],
+            }
+        )
+    try:
+        payload = response.json()
+    except ValueError as exc:
+        return json.dumps({"error": f"{name} returned invalid JSON: {exc}"})
+    progress = payload.get("progress") if isinstance(payload, dict) else None
+    if not isinstance(progress, dict):
+        return json.dumps({"shown": False})
+    result: _JsonObject = {
+        "shown": True,
+        "label": progress.get("label"),
+        "percent": progress.get("percent"),
+    }
+    log_file = body.get("log_file")
+    bar_id = progress.get("id")
+    if isinstance(log_file, str) and isinstance(bar_id, str):
+        from omnigent.runner import progress_log
+
+        progress_log.follow(server_client, conversation_id, bar_id, log_file)
+        result["log_file"] = log_file
+    return json.dumps(result)
+
