index 0000000..45ce8bb
--- /dev/null
+++ b/omnigent/runner/progress_log.py
@@ -0,0 +1,198 @@
+"""Follow the log file an agent names for its progress bar.
+
+``sys_session_progress`` takes a ``log_file``: a file a long command writes its
+output to, such as a test run or a dev server. The runner follows it here and
+posts its new lines to the server, which keeps them under the bar for the web
+UI (``POST /v1/sessions/{id}/progress/{bar id}/log``). Following carries on
+after the agent's turn, so a dev server's log keeps streaming, and stops when
+the server no longer keeps the bar, or when the file hasn't grown for
+:data:`QUIET_STOP_S`.
+
+Values of the session's repository variables, mounted under
+:data:`REPO_ENV_DIR`, are hidden before a line leaves the Pod, as in the
+startup log.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import os
+import re
+import stat
+import time
+
+import httpx
+
+_logger = logging.getLogger(__name__)
+
+POLL_S = 1.0
+START_BYTES = 64 * 1024
+"""How much of a file written just now is sent when following starts."""
+STALE_S = 30.0
+"""A file not written for this long is an earlier run's, so following starts at its end."""
+READ_BYTES = 1024 * 1024
+MAX_POST_LINES = 500
+MAX_PENDING_LINES = 2000
+MAX_LINE_CHARS = 1000
+PARTIAL_FLUSH_S = 3.0
+"""A line without its newline yet is sent once the file has been still this long."""
+WAIT_FOR_FILE_S = 120.0
+"""How long a file that doesn't exist yet is waited for."""
+QUIET_STOP_S = 2 * 3600.0
+MAX_PER_SESSION = 5
+REPO_ENV_DIR = os.environ.get("OMNIGENT_REPO_ENV_DIR", "/run/omnigent/repo-env")
+
+_ANSI = re.compile(r"\x1b(?:\[[0-9;?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\-_])")
+_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
+
+_tails: dict[tuple[str, str], asyncio.Task[None]] = {}
+_bars: dict[tuple[str, str], str] = {}
+"""The bar each followed file belongs to."""
+
+
+def follow(client: httpx.AsyncClient, session_id: str, bar_id: str, path: str) -> None:
+    """
+    Start following *path* for a bar, in place of any earlier follower of it.
+
+    The same file for the same bar keeps its follower, so a later update that
+    names it again doesn't send its lines twice.
+
+    :param client: The runner's client for the server, which outlives the call.
+    :param session_id: The session, e.g. ``"conv_abc123"``.
+    :param bar_id: The bar the server returned, e.g. ``"bar_1a2b3c4d5e6f"``.
+    :param path: The absolute path of the log file.
+    """
+    key = (session_id, path)
+    if key in _tails and _bars.get(key) == bar_id and not _tails[key].done():
+        return
+    old = _tails.pop(key, None)
+    if old is not None:
+        old.cancel()
+    mine = [k for k in _tails if k[0] == session_id]
+    for oldest in mine[: max(0, len(mine) - MAX_PER_SESSION + 1)]:
+        _tails.pop(oldest).cancel()
+    task = asyncio.get_running_loop().create_task(_follow(client, session_id, bar_id, path))
+    _tails[key] = task
+    _bars[key] = bar_id
+
+    def _done(done: asyncio.Task[None]) -> None:
+        if _tails.get(key) is done:
+            del _tails[key]
+            _bars.pop(key, None)
+
+    task.add_done_callback(_done)
+
+
+def clean(raw: bytes, secrets: list[str]) -> str:
+    """
+    One line of a log as the chat shows it.
+
+    :param raw: The line's bytes, without its newline.
+    :param secrets: Values to hide, longest first.
+    :returns: The text after the line's last carriage return, as a terminal
+        shows it, without colour codes, secrets hidden, cut to
+        :data:`MAX_LINE_CHARS`.
+    """
+    text = raw.decode("utf-8", errors="replace")
+    text = _ANSI.sub("", text).rstrip("\r")
+    if "\r" in text:
+        text = text.rsplit("\r", 1)[1]
+    for value in secrets:
+        text = text.replace(value, "[hidden]")
+    return text[:MAX_LINE_CHARS]
+
+
+def repo_secrets(directory: str = REPO_ENV_DIR) -> list[str]:
+    """The values of the session's repository variables, longest first."""
+    values: set[str] = set()
+    with contextlib.suppress(OSError):
+        for repo in os.listdir(directory):
+            folder = os.path.join(directory, repo)
+            with contextlib.suppress(OSError):
+                for name in os.listdir(folder):
+                    if not _NAME.match(name):
+                        continue
+                    with contextlib.suppress(OSError):
+                        with open(
+                            os.path.join(folder, name), encoding="utf-8", errors="replace"
+                        ) as f:
+                            value = f.read().strip()
+                        if len(value) >= 6:
+                            values.add(value)
+    return sorted(values, key=len, reverse=True)
+
+
+async def _follow(client: httpx.AsyncClient, session_id: str, bar_id: str, path: str) -> None:
+    secrets = repo_secrets()
+    started = time.monotonic()
+    last_growth = started
+    offset: int | None = None
+    skip_first = False
+    partial = b""
+    pending: list[str] = []
+    url = f"/v1/sessions/{session_id}/progress/{bar_id}/log"
+    try:
+        while True:
+            now = time.monotonic()
+            try:
+                info = os.stat(path)
+            except OSError:
+                info = None
+            if info is not None and not stat.S_ISREG(info.st_mode):
+                return
+            if info is None:
+                if now - (started if offset is None else last_growth) > (
+                    WAIT_FOR_FILE_S if offset is None else QUIET_STOP_S
+                ):
+                    return
+            else:
+                if offset is None:
+                    # A command often rewrites its log after the bar is set:
+                    # don't show the last run's lines first.
+                    if time.time() - info.st_mtime > STALE_S:
+                        offset = info.st_size
+                    else:
+                        offset = max(0, info.st_size - START_BYTES)
+                        skip_first = offset > 0
+                if info.st_size < offset:
+                    # Truncated or replaced: read it again from the start.
+                    offset, partial, skip_first = 0, b"", False
+                if info.st_size > offset:
+                    with open(path, "rb") as f:
+                        f.seek(offset)
+                        chunk = f.read(READ_BYTES)
+                    offset += len(chunk)
+                    last_growth = now
+                    *lines, partial = (partial + chunk).split(b"\n")
+                    if skip_first and lines:
+                        lines, skip_first = lines[1:], False
+                    pending.extend(clean(line, secrets) for line in lines)
+                    if len(partial) > MAX_LINE_CHARS * 4:
+                        pending.append(clean(partial, secrets))
+                        partial = b""
+                elif partial and now - last_growth > PARTIAL_FLUSH_S:
+                    pending.append(clean(partial, secrets))
+                    partial = b""
+                elif now - last_growth > QUIET_STOP_S:
+                    return
+            del pending[:-MAX_PENDING_LINES]
+            while pending:
+                batch = pending[:MAX_POST_LINES]
+                try:
+                    response = await client.post(url, json={"lines": batch}, timeout=30.0)
+                except httpx.TransportError:
+                    break
+                if response.status_code >= 400:
+                    _logger.warning("progress log post returned %s", response.status_code)
+                    return
+                del pending[: len(batch)]
+                with contextlib.suppress(ValueError):
+                    if response.json().get("kept") is False:
+                        return
+            await asyncio.sleep(POLL_S)
+    except asyncio.CancelledError:
+        raise
+    except Exception:  # noqa: BLE001 - a log must never take the runner down
+        _logger.warning("following %s for a progress bar failed", path, exc_info=True)
