+++ b/omnigent/tools/builtins/session_progress.py
@@ -0,0 +1,90 @@
+"""Tool for showing a progress bar in the current session's chat."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from omnigent.tools.base import Tool
+
+#: Longest label the web UI shows; the server cuts longer ones.
+SESSION_PROGRESS_LABEL_MAX_CHARS = 120
+
+
+class SysSessionProgressTool(Tool):
+    """Schema-only tool that sets or clears the calling session's progress bar."""
+
+    @classmethod
+    def name(cls) -> str:
+        """Return the tool name."""
+        return "sys_session_progress"
+
+    @classmethod
+    def description(cls) -> str:
+        """Return the LLM-facing description."""
+        return (
+            "Show the user a progress bar in the chat while you work on a long, "
+            "multi-step task, such as a migration across many files, a long test run "
+            "or a batch job, or while a long-running process such as a dev server "
+            "starts. Call it right before each long step, saying what that step does; "
+            "each call replaces this turn's bar. The bar can't move while a single "
+            "command runs, so before one command that does all of the work, such as a "
+            "loop over every file or a whole test suite, leave `percent` out and the "
+            "bar sweeps instead of sitting at 0%. When you go step by step, give counts "
+            "in the label and `percent` (0-100) before each step. When the command "
+            "writes its output to a file, give it as `log_file`: the chat streams the "
+            "file under the bar, and keeps streaming it after your turn. Once your "
+            "turn ends, the bar stays in the chat as a line under it, with its log, so "
+            "when you finish, set it once more to say how it went. Skip it for quick "
+            "tasks."
+        )
+
+    def get_schema(self) -> dict[str, Any]:
+        """Return the OpenAI-format schema."""
+        return {
+            "type": "function",
+            "function": {
+                "name": self.name(),
+                "description": self.description(),
+                "parameters": {
+                    "type": "object",
+                    "properties": {
+                        "label": {
+                            "type": "string",
+                            "description": (
+                                "What's in progress, short and specific, with counts when "
+                                "you have them, e.g. 'Migrating components (12/40)' or "
+                                "'Running the integration tests'."
+                            ),
+                            "maxLength": SESSION_PROGRESS_LABEL_MAX_CHARS,
+                        },
+                        "percent": {
+                            "type": "number",
+                            "description": (
+                                "How far along, from 0 to 100. Leave it out when you can't "
+                                "tell, or before one command that does all of the work."
+                            ),
+                            "minimum": 0,
+                            "maximum": 100,
+                        },
+                        "log_file": {
+                            "type": "string",
+                            "description": (
+                                "Absolute path of the file the command writes its output "
+                                "to, e.g. '/home/omnigent/logs/tests.log' after running "
+                                "`./run-tests.sh > /home/omnigent/logs/tests.log 2>&1`. "
+                                "The user can open its lines under the bar."
+                            ),
+                        },
+                        "clear": {
+                            "type": "boolean",
+                            "description": (
+                                "End the bar now instead of updating it; the label is "
+                                "then ignored."
+                            ),
+                        },
+                    },
+                    "required": ["label"],
+                    "additionalProperties": False,
+                },
+            },
+        }
