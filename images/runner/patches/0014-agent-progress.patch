+++ b/tests/runner/test_progress_log.py
@@ -0,0 +1,141 @@
+"""Following the log file an agent names for its progress bar (this deployment)."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import time
+from pathlib import Path
+
+import httpx
+import pytest
+
+from omnigent.runner import progress_log
+
+
+@pytest.fixture(autouse=True)
+def _fast(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    monkeypatch.setattr(progress_log, "POLL_S", 0.01)
+    monkeypatch.setattr(progress_log, "PARTIAL_FLUSH_S", 0.05)
+    monkeypatch.setattr(progress_log, "REPO_ENV_DIR", str(tmp_path / "repo-env"))
+
+
+def test_a_line_reads_as_a_terminal_shows_it() -> None:
+    raw = b"\x1b[32m  VITE v6\x1b[0m ready\r\x1b[2K  Building 10%\r  Building 100%\r"
+
+    assert progress_log.clean(raw, []) == "  Building 100%"
+    assert progress_log.clean(b"token=abcdef123 ok", ["abcdef123"]) == "token=[hidden] ok"
+    assert len(progress_log.clean(b"x" * 5000, [])) == progress_log.MAX_LINE_CHARS
+
+
+def test_repository_variable_values_are_hidden(tmp_path: Path) -> None:
+    folder = tmp_path / "repo-env" / "roadpass"
+    folder.mkdir(parents=True)
+    (folder / "NPM_TOKEN").write_text("npm_secret_value\n")
+    (folder / "SHORT").write_text("abc")
+    (folder / "agent-instructions.md").write_text("Use pnpm, never npm.")
+
+    assert progress_log.repo_secrets(str(tmp_path / "repo-env")) == ["npm_secret_value"]
+
+
+class _Server:
+    def __init__(self, keep_for: int = 1_000_000) -> None:
+        self.lines: list[str] = []
+        self.keep_for = keep_for
+
+    def handler(self, request: httpx.Request) -> httpx.Response:
+        assert request.url.path.startswith("/v1/sessions/conv_1/progress/bar_")
+        self.lines.extend(json.loads(request.content)["lines"])
+        return httpx.Response(200, json={"kept": len(self.lines) < self.keep_for})
+
+
+async def _wait(condition, timeout: float = 3.0) -> None:  # type: ignore[no-untyped-def]
+    deadline = asyncio.get_running_loop().time() + timeout
+    while not condition():
+        assert asyncio.get_running_loop().time() < deadline, "timed out"
+        await asyncio.sleep(0.01)
+
+
+@pytest.mark.asyncio
+async def test_new_lines_stream_until_the_bar_is_gone(tmp_path: Path) -> None:
+    log = tmp_path / "dev.log"
+    log.write_text("starting\n")
+    server = _Server(keep_for=4)
+    async with httpx.AsyncClient(
+        transport=httpx.MockTransport(server.handler), base_url="http://server"
+    ) as client:
+        progress_log.follow(client, "conv_1", "bar_1", str(log))
+        await _wait(lambda: server.lines == ["starting"])
+        with log.open("a") as f:
+            f.write("ready in 312 ms\nwaiting for ")
+        await _wait(lambda: server.lines == ["starting", "ready in 312 ms", "waiting for "])
+        with log.open("a") as f:
+            f.write("changes\nGET /\n")
+        await _wait(lambda: not progress_log._tails)
+
+    # The server stopped keeping the bar after 4 lines, so following stopped.
+    assert server.lines == ["starting", "ready in 312 ms", "waiting for ", "changes", "GET /"]
+
+
+@pytest.mark.asyncio
+async def test_a_big_file_starts_from_its_end_and_a_truncated_one_again(tmp_path: Path) -> None:
+    log = tmp_path / "tests.log"
+    log.write_text("".join(f"line {n}\n" for n in range(20000)))
+    server = _Server()
+    async with httpx.AsyncClient(
+        transport=httpx.MockTransport(server.handler), base_url="http://server"
+    ) as client:
+        progress_log.follow(client, "conv_1", "bar_1", str(log))
+        await _wait(lambda: server.lines and server.lines[-1] == "line 19999")
+        assert len("".join(f"{line}\n" for line in server.lines)) <= progress_log.START_BYTES
+        # Every line sent is whole: the cut-off line at the start was skipped.
+        assert all(line.startswith("line ") for line in server.lines)
+        log.write_text("run 2\n")
+        await _wait(lambda: server.lines[-1] == "run 2")
+        for task in list(progress_log._tails.values()):
+            task.cancel()
+
+
+@pytest.mark.asyncio
+async def test_the_same_file_again_keeps_or_moves_its_follower(tmp_path: Path) -> None:
+    log = tmp_path / "dev.log"
+    log.write_text("ready\n")
+    server = _Server()
+    async with httpx.AsyncClient(
+        transport=httpx.MockTransport(server.handler), base_url="http://server"
+    ) as client:
+        progress_log.follow(client, "conv_1", "bar_1", str(log))
+        first = progress_log._tails[("conv_1", str(log))]
+        await _wait(lambda: server.lines == ["ready"])
+        # A later update of the same bar names the file again: no lines twice.
+        progress_log.follow(client, "conv_1", "bar_1", str(log))
+        await asyncio.sleep(0.05)
+        assert progress_log._tails[("conv_1", str(log))] is first
+        assert server.lines == ["ready"]
+        # A new bar takes the file over.
+        progress_log.follow(client, "conv_1", "bar_2", str(log))
+        await asyncio.sleep(0.05)
+        assert first.cancelled()
+        assert len(progress_log._tails) == 1
+        for task in list(progress_log._tails.values()):
+            task.cancel()
+
+
+@pytest.mark.asyncio
