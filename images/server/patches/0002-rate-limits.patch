+# Latest subscription usage windows a native harness reported (JSON), read by
+# the web composer on load; live updates ride on ``session.usage``.
+_RATE_LIMITS_LABEL_KEY = "omnigent.rate_limits"
+# Session, weekly: two windows keep the JSON well under the label length cap.
+_RATE_LIMITS_MAX_WINDOWS = 2
+
+
+def _rate_limits_from_usage_data(
+    raw: object,
+) -> dict[str, list[dict[str, float | int | None]]] | None:
+    """
+    Validate and canonicalize ``external_session_usage`` ``data.rate_limits``.
+
+    :param raw: ``{"windows": [{"window_minutes": 300, "used_percent": 23.0,
+        "resets_at": 1790370000}, ...]}`` from a native forwarder, or ``None``.
+    :returns: The same shape with only the known keys and percentages rounded
+        to one decimal, or ``None`` when absent.
+    :raises OmnigentError: When present but malformed.
+    """
+    if raw is None:
+        return None
+
+    def invalid(detail: str) -> OmnigentError:
+        return OmnigentError(
+            f"external_session_usage data.rate_limits {detail}", code=ErrorCode.INVALID_INPUT
+        )
+
+    windows = raw.get("windows") if isinstance(raw, dict) else None
+    if not isinstance(windows, list) or not 1 <= len(windows) <= _RATE_LIMITS_MAX_WINDOWS:
+        raise invalid(f"must carry 1-{_RATE_LIMITS_MAX_WINDOWS} windows")
+    canonical: list[dict[str, float | int | None]] = []
+    for window in windows:
+        if not isinstance(window, dict):
+            raise invalid("windows must be objects")
+        minutes = window.get("window_minutes")
+        used = window.get("used_percent")
+        resets_at = window.get("resets_at")
+        if not isinstance(minutes, int) or isinstance(minutes, bool) or not 0 < minutes <= 525_600:
+            raise invalid("window_minutes must be a positive int of at most a year")
+        if (
+            not isinstance(used, (int, float))
+            or isinstance(used, bool)
+            or not math.isfinite(used)
+            or not 0 <= used <= 1000
+        ):
+            raise invalid("used_percent must be a number from 0 to 1000")
+        if resets_at is not None and (
+            not isinstance(resets_at, int)
+            or isinstance(resets_at, bool)
+            or not 0 < resets_at < 2**40
+        ):
+            raise invalid("resets_at must be null or Unix epoch seconds")
+        canonical.append(
+            {
+                "window_minutes": minutes,
+                "used_percent": round(float(used), 1),
+                "resets_at": resets_at,
+            }
+        )
+    return {"windows": canonical}
+
+
