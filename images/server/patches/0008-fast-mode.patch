+def _fast_mode_from_usage_data(raw: object) -> bool | None:
+    """
+    Validate ``external_session_usage`` ``data.fast_mode``.
+
+    :param raw: ``True`` or ``False`` from a native forwarder, or ``None``.
+    :returns: The flag, or ``None`` when absent.
+    :raises OmnigentError: When present but not a boolean.
+    """
+    if raw is None or isinstance(raw, bool):
+        return raw
