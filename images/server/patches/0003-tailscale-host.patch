+# The tailnet name of a managed session's runner Pod, read by the web composer
+# on load; live updates ride on ``session.tailscale``. The runner image joins
+# Tailscale as ``omnigent-<first 8 hex of the host id>``, which stays the same
+# when the Pod suspends and wakes.
+_TAILSCALE_HOST_LABEL_KEY = "omnigent.tailscale_host"
+# The tailnet's MagicDNS suffix, e.g. ``tail1234.ts.net``; unset turns it off.
+_TAILSCALE_TAILNET_ENV_VAR = "OMNIGENT_TAILSCALE_TAILNET"
+
+
+def _tailscale_host_for(host_id: str) -> str | None:
+    """
+    The MagicDNS name the runner Pod of managed host *host_id* joins as.
+
+    :param host_id: Managed host id, e.g. ``"e1dcab9b1db64fbc90dd0811d31a0b9b"``.
+    :returns: e.g. ``"omnigent-e1dcab9b.tail1234.ts.net"``, or ``None`` when
+        no tailnet is configured.
+    """
+    tailnet = os.environ.get(_TAILSCALE_TAILNET_ENV_VAR, "").strip().strip(".").lower()
+    if not tailnet:
+        return None
+    return f"omnigent-{host_id[:8].lower()}.{tailnet}"
+
+
+async def _stamp_tailscale_host(
+    session_id: str,
+    host_id: str,
+    conv: Conversation,
+    conversation_store: ConversationStore,
+) -> None:
+    """
+    Record and broadcast the tailnet name of a managed session's Pod.
+
+    Best-effort: the name is a convenience, so a failure is logged and the
+    launch carries on.
+
+    :param session_id: Session/conversation identifier.
+    :param host_id: The managed host the session is bound to.
+    :param conv: The session row, whose labels skip an unchanged write.
+    :param conversation_store: Store holding the session row.
+    """
+    host = _tailscale_host_for(host_id)
+    if host is None or conv.labels.get(_TAILSCALE_HOST_LABEL_KEY) == host:
+        return
+    try:
+        await asyncio.to_thread(
+            conversation_store.set_labels, session_id, {_TAILSCALE_HOST_LABEL_KEY: host}
+        )
+    except Exception:  # noqa: BLE001 - never fail a launch over a display label
+        _logger.warning(
+            "Could not record the tailnet name of session %s",
+            session_id,
+            exc_info=True,
+            extra={"session_id": session_id},
+        )
+        return
+    session_stream.publish(
+        session_id,
+        SessionTailscaleEvent(
+            type="session.tailscale", conversation_id=session_id, host=host
+        ).model_dump(exclude_none=True),
+    )
+
+
 async def _run_managed_launch(
     *,
     session_id: str,
@@ -3377,6 +3442,7 @@ async def _bind_and_launch_managed_runner(
         return
     if relaunch_host is not None:
         await _note_workspace_reset_on_recreate(session_id, conversation_store)
+    await _stamp_tailscale_host(session_id, managed.host_id, conv, conversation_store)
     # Host bound; what remains is launching the runner and waiting
