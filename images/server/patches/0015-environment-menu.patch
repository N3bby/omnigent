@@ -0,0 +1,211 @@
+"""Stop sandbox on the server: suspend_managed_host and the keepalive hold.
+
+``suspend_managed_host`` stops a resumable managed sandbox the way an idle stop
+does. The keepalive hold keeps a runner tunnel that hasn't dropped yet from
+pushing the stopped sandbox's deadline back.
+"""
+
+from __future__ import annotations
+
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+from typing import Any, ClassVar
+
+import click
+import pytest
+from fastapi import HTTPException
+
+from omnigent.db.utils import now_epoch
+from omnigent.onboarding.sandboxes.base import SandboxCapabilityError
+from omnigent.server import managed_host_keepalive
+from omnigent.server.managed_hosts import (
+    ManagedSandboxConfig,
+    ManagedSandboxDeployment,
+    suspend_managed_host,
+)
+from omnigent.stores.host_store import HostStore
+from tests.server.helpers import FakeSandboxLauncher
+
+_OWNER = "alice@example.com"
+
+
+class _Launcher:
+    """Records keep_alive and suspend calls, in order."""
+
+    def __init__(self, raises: BaseException | None = None) -> None:
+        self.calls: list[str] = []
+        self._raises = raises
+
+    def keep_alive(self, sandbox_id: str) -> None:
+        self.calls.append(f"keep_alive {sandbox_id}")
+
+    def suspend(self, sandbox_id: str) -> None:
+        self.calls.append(f"suspend {sandbox_id}")
+        if self._raises is not None:
+            raise self._raises
+
+
+class _ResumableFake(FakeSandboxLauncher):
+    """A provider with a stop/resume lifecycle that records suspends."""
+
+    provider: ClassVar[str] = "islo"
+
+    def __init__(self, raises: BaseException | None = None, **kwargs: Any) -> None:
+        super().__init__(**kwargs)
+        self.suspended: list[str] = []
+        self._raises = raises
+
+    def suspend(self, sandbox_id: str) -> None:
+        if self._raises is not None:
+            raise self._raises
+        self.suspended.append(sandbox_id)
+
+
+def _config(launcher: FakeSandboxLauncher) -> ManagedSandboxDeployment:
+    return ManagedSandboxDeployment.single(
+        ManagedSandboxConfig(
+            server_url="https://srv.example.com",
+            launcher_factory=lambda: launcher,
+            token_ttl_s=3600,
+        )
+    )
+
+
+def _wire_keepalive(monkeypatch: pytest.MonkeyPatch, launcher: _Launcher) -> None:
+    """Point the keepalive at one runner on one agent_sandbox host, sandbox "sbx1"."""
+    monkeypatch.setattr(
+        managed_host_keepalive,
+        "_conversation_store",
+        SimpleNamespace(
+            list_conversations_by_runner_id=lambda _r: [SimpleNamespace(host_id="h1")]
+        ),
+    )
+    monkeypatch.setattr(
+        managed_host_keepalive,
+        "_host_store",
+        SimpleNamespace(
+            get_host=lambda _h: SimpleNamespace(
+                sandbox_id="sbx1", sandbox_provider="agent_sandbox"
+            )
+        ),
+    )
+    monkeypatch.setattr(
+        managed_host_keepalive,
+        "_sandbox_config",
+        SimpleNamespace(
+            for_provider=lambda _p: SimpleNamespace(launcher_factory=lambda: launcher)
+        ),
+    )
+    monkeypatch.setattr(managed_host_keepalive, "_executor", None)
+    monkeypatch.setattr(managed_host_keepalive, "_suspended_at", {})
+
+
+def _register(host_store: HostStore, host_id: str, sandbox_id: str) -> None:
+    host_store.register_managed_host(
+        host_id=host_id,
+        name=f"managed-{sandbox_id}",
+        user_id=_OWNER,
+        token=f"tok-{sandbox_id}",
+        provider="islo",
+        sandbox_id=sandbox_id,
+        token_expires_at=now_epoch() + 3600,
+    )
+
+
+# ── keepalive hold ─────────────────────────────────────
+
+
+def test_a_stopped_sandbox_is_not_extended(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A runner tunnel that hasn't dropped yet can't undo the stop."""
+    launcher = _Launcher()
+    _wire_keepalive(monkeypatch, launcher)
+
+    managed_host_keepalive.suspend(launcher, "sbx1").result()
+    managed_host_keepalive._keep_alive_for_runner("r1")
+
+    assert launcher.calls == ["suspend sbx1"]
+
+
+def test_the_hold_expires(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A woken sandbox gets its keepalives back, however it was woken."""
+    launcher = _Launcher()
+    _wire_keepalive(monkeypatch, launcher)
+    held_since = managed_host_keepalive.time.monotonic() - managed_host_keepalive._SUSPEND_HOLD_S
+    monkeypatch.setattr(managed_host_keepalive, "_suspended_at", {"sbx1": held_since})
+
+    managed_host_keepalive._keep_alive_for_runner("r1")
+
+    assert launcher.calls == ["keep_alive sbx1"]
+    assert managed_host_keepalive._suspended_at == {}
+
+
+def test_a_failed_suspend_lifts_the_hold(monkeypatch: pytest.MonkeyPatch) -> None:
+    """The sandbox is still running, so it must keep getting its keepalives."""
+    launcher = _Launcher(raises=click.ClickException("Forbidden"))
+    _wire_keepalive(monkeypatch, launcher)
+
+    future = managed_host_keepalive.suspend(launcher, "sbx1")
+
+    assert isinstance(future.exception(), click.ClickException)
+    assert managed_host_keepalive._suspended_at == {}
+
+
+def test_suspend_runs_on_the_keepalive_worker(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Behind a queued refresh, so none can land after the suspend."""
+    launcher = _Launcher()
+    _wire_keepalive(monkeypatch, launcher)
+    executor = ThreadPoolExecutor(max_workers=1)
+    monkeypatch.setattr(managed_host_keepalive, "_executor", executor)
+    try:
+        executor.submit(launcher.keep_alive, "sbx1")
+        managed_host_keepalive.suspend(launcher, "sbx1").result(timeout=5)
+    finally:
+        executor.shutdown(wait=True)
+
+    assert launcher.calls == ["keep_alive sbx1", "suspend sbx1"]
+
+
+# ── suspend_managed_host ───────────────────────────────
+
