+"""The environment menu's data: ``GET/POST /v1/sessions/{id}/environment``.
+
+The runner reports its Pod's resource use and its idle deadline
+(``omnigent/runner/environment_report.py``); the server adds the Sandbox's
+times and the VM disk.
+"""
+
+from __future__ import annotations
+
+import time
+from types import SimpleNamespace
+
+import httpx
+import pytest
+from fastapi import FastAPI
+
+from omnigent.runner.identity import RUNNER_TUNNEL_TOKEN_HEADER, token_bound_runner_id
+from omnigent.server.routes.sessions import routes_environment
+from omnigent.stores.conversation_store.sqlalchemy_store import SqlAlchemyConversationStore
+from tests.server.helpers import create_test_agent
+
+pytestmark = pytest.mark.asyncio
+
+TOKEN = "runner-binding-token-for-tests"
+REPORT = {
+    "cpu_cores": 1.5,
+    "memory_bytes": 8_000_000_000,
+    "agent_active": False,
+    "agent_idle_since": 1_000.0,
+    "agent_exits_at": 2_800.0,
+}
