+"""Stop sandbox: ``stop_session`` with ``data.suspend_sandbox`` stops the Pod too.
+
+Reuses the host-wired app and the real host tunnel helpers from
+``test_session_host_launch``, so the runner stop is the real round-trip and
+only the provider-side suspend is stubbed.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from typing import Any
+
+import httpx
+import pytest
+from asgiref.testing import ApplicationCommunicator
+from fastapi import FastAPI, HTTPException
+
+from omnigent.runtime import set_runner_client
+from omnigent.server import managed_hosts
+from tests.server.integration.test_session_host_launch import (  # noqa: F401 (app is a fixture)
+    _HOST_ID,
+    _connect_host,
+    _inline_launch_session,
+    _serve_one_stop,
+    app,
+)
+
+pytestmark = pytest.mark.asyncio
+
+
+async def _stop(
+    client: httpx.AsyncClient,
+    comm: ApplicationCommunicator,
+    session_id: str,
+    data: dict[str, Any],
+) -> tuple[httpx.Response, str]:
+    """POST ``stop_session`` and answer the host's stop_runner.
+
+    :returns: The response and the runner id the host was told to stop.
+    """
+    fake_runner = httpx.AsyncClient(
+        transport=httpx.MockTransport(lambda _request: httpx.Response(204)),
+        base_url="http://runner",
+    )
+    set_runner_client(fake_runner)
+    try:
+        stop_responder = asyncio.create_task(_serve_one_stop(comm))
+        resp = await client.post(
+            f"/v1/sessions/{session_id}/events",
+            json={"type": "stop_session", "data": data},
+        )
+        stopped_runner_id = await stop_responder
+    finally:
+        await fake_runner.aclose()
+        set_runner_client(None)
+    return resp, stopped_runner_id
+
+
+def _record_suspends(monkeypatch: pytest.MonkeyPatch) -> list[str]:
+    suspended: list[str] = []
+
+    async def _suspend(host_id: str, host_store: object, config: object) -> bool:
+        suspended.append(host_id)
+        return True
+
+    monkeypatch.setattr(managed_hosts, "suspend_managed_host", _suspend)
+    return suspended
+
+
+async def test_stop_sandbox_stops_the_runner_then_suspends_the_host(
+    client: httpx.AsyncClient,
+    app: FastAPI,  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The runner is stopped as for a plain Stop, then the session's host is suspended."""
+    suspended = _record_suspends(monkeypatch)
+    comm = await _connect_host(app)
+    session = await _inline_launch_session(client, comm)
+
+    resp, stopped_runner_id = await _stop(client, comm, session["id"], {"suspend_sandbox": True})
+
+    assert resp.status_code == 202, resp.text
+    assert stopped_runner_id == session["runner_id"]
+    assert suspended == [_HOST_ID]
+
+
+async def test_plain_stop_keeps_the_sandbox_running(
+    client: httpx.AsyncClient,
+    app: FastAPI,  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Without the flag, Stop only ends the runner: "Restart agent"."""
+    suspended = _record_suspends(monkeypatch)
+    comm = await _connect_host(app)
+    session = await _inline_launch_session(client, comm)
+
+    resp, _ = await _stop(client, comm, session["id"], {})
+
+    assert resp.status_code == 202, resp.text
+    assert suspended == []
+
+
+async def test_stop_sandbox_reports_a_failed_suspend(
+    client: httpx.AsyncClient,
+    app: FastAPI,  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A suspend the provider rejected fails the request, so the UI can say so."""
+
+    async def _suspend(host_id: str, host_store: object, config: object) -> bool:
+        raise HTTPException(status_code=502, detail="Forbidden")
+
+    monkeypatch.setattr(managed_hosts, "suspend_managed_host", _suspend)
+    comm = await _connect_host(app)
+    session = await _inline_launch_session(client, comm)
+
+    resp, _ = await _stop(client, comm, session["id"], {"suspend_sandbox": True})
+
+    assert resp.status_code == 502, resp.text
+    assert "Forbidden" in resp.text
+
+
+async def test_stop_sandbox_while_waking_cancels_the_start(
+    client: httpx.AsyncClient,
+    app: FastAPI,  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Cancel start: the wake in flight is marked cancelled and the session reads as stopped."""
+    from omnigent.server.routes._sessions.common import _session_sandbox_status_cache
+    from omnigent.server.routes._sessions.helpers import _publish_sandbox_status
+
+    suspended = _record_suspends(monkeypatch)
+    monkeypatch.setattr(managed_hosts, "host_resume_supported", lambda _host, _config: True)
+    monkeypatch.setattr(managed_hosts, "_cancelled_starts", {})
+    comm = await _connect_host(app)
+    session = await _inline_launch_session(client, comm)
+    tracker = app.state.managed_launches
+    tracker.begin(session["id"])
+    tracker.get(session["id"]).wake = True
+    _publish_sandbox_status(session["id"], "provisioning")
+
+    resp, _ = await _stop(client, comm, session["id"], {"suspend_sandbox": True})
+
+    assert resp.status_code == 202, resp.text
+    assert suspended == [_HOST_ID]
+    assert session["id"] in managed_hosts._cancelled_starts
+    assert _session_sandbox_status_cache.get(session["id"]) is None
+    tracker.finish(session["id"])
+
+
+async def test_stop_sandbox_ends_keep_running(
+    client: httpx.AsyncClient,
+    app: FastAPI,  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A stopped sandbox isn't kept running when it wakes again."""
+    from omnigent.server.routes.sessions.routes_environment import KEEP_RUNNING_LABEL_KEY
+
+    _record_suspends(monkeypatch)
+    comm = await _connect_host(app)
+    session = await _inline_launch_session(client, comm)
+    resp = await client.put(
+        f"/v1/sessions/{session['id']}/environment/keep-running", json={"forever": True}
+    )
+    assert resp.status_code == 200, resp.text
+
+    resp, _ = await _stop(client, comm, session["id"], {"suspend_sandbox": True})
+
+    assert resp.status_code == 202, resp.text
+    labels = (await client.get(f"/v1/sessions/{session['id']}")).json()["labels"]
+    assert KEEP_RUNNING_LABEL_KEY not in labels
+
+
+async def test_stop_sandbox_leaves_a_first_launch_alone(
+    client: httpx.AsyncClient,
+    app: FastAPI,  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A first launch that loses its Pod deletes the new sandbox, so it isn't stopped."""
+    suspended = _record_suspends(monkeypatch)
+    monkeypatch.setattr(managed_hosts, "_cancelled_starts", {})
+    comm = await _connect_host(app)
+    session = await _inline_launch_session(client, comm)
+    tracker = app.state.managed_launches
+    tracker.begin(session["id"])
+    try:
+        resp, _ = await _stop(client, comm, session["id"], {"suspend_sandbox": True})
+    finally:
+        tracker.finish(session["id"])
+
+    assert resp.status_code == 409, resp.text
+    assert suspended == []
+    assert session["id"] not in managed_hosts._cancelled_starts
