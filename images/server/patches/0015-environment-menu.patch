+@pytest.mark.asyncio
+async def test_suspend_managed_host_stops_a_resumable_sandbox(
+    db_uri: str, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Stops the host's own sandbox, and only one a message can wake again."""
+    monkeypatch.setattr(managed_host_keepalive, "_executor", None)
+    monkeypatch.setattr(managed_host_keepalive, "_suspended_at", {})
+    host_store = HostStore(db_uri)
+    host_id = "5f0c6b1e2d3a4f5e6d7c8b9a0f1e2d3c"
+    _register(host_store, host_id, "sb-suspend")
+
+    resumable = _ResumableFake(can_resume=True)
+    assert await suspend_managed_host(host_id, host_store, _config(resumable))
+    assert resumable.suspended == ["sb-suspend"]
+
+    non_resumable = _ResumableFake(can_resume=False)
+    assert not await suspend_managed_host(host_id, host_store, _config(non_resumable))
+    assert non_resumable.suspended == []
+    assert not await suspend_managed_host(host_id, host_store, None)
+    assert not await suspend_managed_host("0" * 32, host_store, _config(resumable))
+
+
+@pytest.mark.asyncio
+async def test_suspend_managed_host_reports_a_rejected_suspend(
+    db_uri: str, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A provider error is a 502 with the reason; no suspend support is a no-op."""
+    monkeypatch.setattr(managed_host_keepalive, "_executor", None)
+    monkeypatch.setattr(managed_host_keepalive, "_suspended_at", {})
+    host_store = HostStore(db_uri)
+    host_id = "6a1d7c2f3e4b5a6f7e8d9c0b1a2f3e4d"
+    _register(host_store, host_id, "sb-suspend-fails")
+
+    failing = _ResumableFake(raises=click.ClickException("Forbidden"), can_resume=True)
+    with pytest.raises(HTTPException) as caught:
+        await suspend_managed_host(host_id, host_store, _config(failing))
+    assert caught.value.status_code == 502
+    assert caught.value.detail == "Forbidden"
+
+    unsupported = _ResumableFake(raises=SandboxCapabilityError("nope"), can_resume=True)
+    assert not await suspend_managed_host(host_id, host_store, _config(unsupported))
