--- /dev/null
+++ b/tests/server/test_cancel_start.py
@@ -0,0 +1,157 @@
+"""Cancel start: a cancelled wake stops at its next stage and its sandbox stops.
+
+The composer's "Cancel start" is Stop sandbox while a sandbox wakes. The route
+marks the start cancelled (``cancel_managed_start``); every stage of a start goes
+through ``_publish_sandbox_status``, which then raises so the wake fails at that
+point, and the cleanup runs once it has.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from omnigent.server import managed_hosts
+from omnigent.server.managed_hosts import (
+    ManagedLaunchTracker,
+    StartCancelledError,
+    cancel_managed_start,
+    settle_cancelled_start,
+)
+from omnigent.server.routes._sessions.common import _session_sandbox_status_cache
+
+pytestmark = pytest.mark.asyncio
+
+
+@pytest.fixture(autouse=True)
+def _no_cancelled_starts(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(managed_hosts, "_cancelled_starts", {})
+
+
+def _waking(tracker: ManagedLaunchTracker, session_id: str) -> None:
+    """Mark the start in flight as a wake, as _kick_managed_wake does."""
+    launch = tracker.get(session_id)
+    assert launch is not None
+    launch.wake = True
+
+
+async def _settle_tasks() -> None:
+    for _ in range(3):
+        await asyncio.sleep(0)
+    await asyncio.gather(*managed_hosts._cancel_cleanup_tasks)
+
+
+async def test_only_a_start_in_flight_can_be_cancelled() -> None:
+    tracker = ManagedLaunchTracker()
+
+    async def _cleanup() -> None:
+        return None
+
+    assert not cancel_managed_start("conv_1", tracker, _cleanup)
+    tracker.begin("conv_1")
+    # A first launch can't be cancelled: losing its Pod deletes the new sandbox.
+    assert not cancel_managed_start("conv_1", tracker, _cleanup)
+    _waking(tracker, "conv_1")
+    assert cancel_managed_start("conv_1", tracker, _cleanup)
+    tracker.finish("conv_1")
+    assert not cancel_managed_start("conv_1", tracker, _cleanup)
+
+
+async def test_a_cancelled_start_stops_at_its_next_stage() -> None:
+    tracker = ManagedLaunchTracker()
+    tracker.begin("conv_1")
+    _waking(tracker, "conv_1")
+    ran: list[str] = []
+
+    async def _cleanup() -> None:
+        ran.append("cleanup")
+
+    cancel_managed_start("conv_1", tracker, _cleanup)
+
+    with pytest.raises(StartCancelledError):
+        settle_cancelled_start("conv_1", "connecting")
+    assert settle_cancelled_start("conv_1", "failed")
+    await _settle_tasks()
+
+    assert ran == ["cleanup"]
+    # Settled once: later stages publish normally.
+    assert not settle_cancelled_start("conv_1", "ready")
+
+
+async def test_a_new_start_isnt_cancelled_by_an_old_cancel() -> None:
+    tracker = ManagedLaunchTracker()
+    tracker.begin("conv_1")
+    _waking(tracker, "conv_1")
+
+    async def _cleanup() -> None:
+        return None
+
+    cancel_managed_start("conv_1", tracker, _cleanup)
+    tracker.begin("conv_1")
+
+    assert not settle_cancelled_start("conv_1", "provisioning")
+
+
+async def test_a_cancelled_wake_fails_its_waiters_and_runs_the_cleanup(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The wake stops at the stage it reports next; the cleanup publishes the outcome."""
+    from omnigent.server.routes._sessions import orchestration
+    from omnigent.server.routes._sessions.helpers import _publish_sandbox_status
+
+    async def _resume(*args: object, **kwargs: object) -> None:
+        # The provider reports its stage from start_host, as a real wake does.
+        kwargs["on_stage"]("starting")  # type: ignore[operator]
+        raise AssertionError("the wake should have stopped at its stage")
+
+    monkeypatch.setattr("omnigent.server.managed_hosts.resume_managed_host", _resume)
+    conv = SimpleNamespace(inference_snapshot=None, labels={}, host_id="host_1")
+    tracker = ManagedLaunchTracker()
+    tracker.begin("conv_1")
+    _waking(tracker, "conv_1")
+    launch = tracker.get("conv_1")
+    assert launch is not None
+    ran: list[str] = []
+
+    async def _cleanup() -> None:
+        ran.append("cleanup")
+        _publish_sandbox_status("conv_1", "ready")
+
+    cancel_managed_start("conv_1", tracker, _cleanup)
+    await orchestration._run_managed_wake(
+        session_id="conv_1",
+        conv=conv,
+        sandbox_config=SimpleNamespace(configs=()),
+        tracker=tracker,
+        conversation_store=SimpleNamespace(get_conversation=lambda _sid: conv),
+        host_store=SimpleNamespace(),
+        host_registry=None,
+        tunnel_registry=None,
+    )
+    await _settle_tasks()
+
+    # The message waiting on the wake gets an error instead of being sent.
+    assert launch.settled.is_set() and launch.error == managed_hosts.START_CANCELLED_REASON
+    assert ran == ["cleanup"]
+    # The session reads as stopped, not failed.
+    assert _session_sandbox_status_cache.get("conv_1") is None
+
+
+async def test_a_cancelled_wake_that_got_through_still_fails_its_waiters() -> None:
+    """Cancelled after its last stage, a wake that finishes mustn't send the message."""
+    tracker = ManagedLaunchTracker()
+    tracker.begin("conv_1")
+    _waking(tracker, "conv_1")
+    launch = tracker.get("conv_1")
+    assert launch is not None
+
+    async def _cleanup() -> None:
+        return None
+
+    cancel_managed_start("conv_1", tracker, _cleanup)
+    tracker.finish("conv_1")
+
+    assert launch.settled.is_set()
+    assert launch.error == managed_hosts.START_CANCELLED_REASON
