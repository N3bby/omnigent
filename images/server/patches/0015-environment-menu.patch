diff --git a/omnigent/server/routes/sessions/routes_environment.py b/omnigent/server/routes/sessions/routes_environment.py
new file mode 100644
index 0000000..dda2b35
--- /dev/null
+++ b/omnigent/server/routes/sessions/routes_environment.py
@@ -0,0 +1,262 @@
+"""The composer's environment menu: what a sandbox session's Pod is doing.
+
+``GET /v1/sessions/{id}/environment`` gathers what the menu shows beyond the
+liveness the web UI already has: when the Pod started (or stopped) and when it
+stops for being idle, from the Sandbox and its Pod; how full the VM's disk is;
+and the Pod's CPU and memory use and the agent's idle deadline, which only the
+runner knows and reports to ``POST /v1/sessions/{id}/environment/report``
+(``omnigent/runner/environment_report.py``). The menu polls it only while it's
+open.
+
+Reports are kept in memory, per replica: they're replaced every 5 seconds, and
+a stale one is dropped rather than shown.
+
+"Keep running" (``PUT /v1/sessions/{id}/environment/keep-running``) is stored
+on the session, as the ``omnigent.keep_running_until`` label: ``<Unix
+time>/<hours chosen>``, or ``forever``. The server answers each runner report with it, and while it holds
+the runner neither exits for being idle nor reaps its panes, so the server
+keeps the Pod alive. Stop sandbox clears it.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import time
+
+from fastapi import APIRouter, Request
+from pydantic import BaseModel, Field, model_validator
+
+from omnigent.errors import ErrorCode, OmnigentError
+from omnigent.runner.identity import RUNNER_TUNNEL_TOKEN_HEADER, token_bound_runner_id
+from omnigent.server.auth import LEVEL_EDIT, LEVEL_OWNER, LEVEL_READ, AuthProvider
+from omnigent.server.routes._auth_helpers import get_user_id as _get_user_id
+from omnigent.server.routes._auth_helpers import require_access as _require_access
+from omnigent.stores import ConversationStore
+from omnigent.stores.permission_store import PermissionStore
+
+REPORT_MAX_AGE_S = 30.0
+"""A runner report older than this isn't shown: the runner has likely gone."""
+
+KEEP_RUNNING_LABEL_KEY = "omnigent.keep_running_until"
+"""Session label holding "Keep running": ``<Unix time>/<hours chosen>``, or ``forever``."""
+
+_KEEP_RUNNING_FOREVER = "forever"
+
+
+class KeepRunning(BaseModel):
+    """The menu's "Keep running" choice: for some hours, for good, or neither (the usual timeout)."""
+
+    hours: float | None = Field(default=None, gt=0, le=7 * 24)
+    forever: bool = False
+
+    @model_validator(mode="after")
+    def _one_choice(self) -> KeepRunning:
+        if self.forever and self.hours is not None:
+            raise ValueError("choose hours or forever, not both")
+        return self
+
+
+class KeepRunningState(BaseModel):
+    """The "Keep running" choice in force, as the runner and the menu read it."""
+
+    keep_running_until: float | None = None
+    keep_running_hours: float | None = None
+    """How many hours were chosen, so the menu can tick the choice."""
+    keep_running_forever: bool = False
+
+
+def keep_running_from_labels(labels: dict[str, str] | None) -> KeepRunningState:
+    """Read "Keep running" off a session's labels; a time in the past no longer holds."""
+    raw = (labels or {}).get(KEEP_RUNNING_LABEL_KEY)
+    if raw == _KEEP_RUNNING_FOREVER:
+        return KeepRunningState(keep_running_forever=True)
+    until_text, _, hours_text = (raw or "").partition("/")
+    try:
+        until = float(until_text)
+        hours = float(hours_text) if hours_text else None
+    except ValueError:
+        return KeepRunningState()
+    if until <= time.time():
+        return KeepRunningState()
+    return KeepRunningState(keep_running_until=until, keep_running_hours=hours)
+
+
+def clear_keep_running(conversation_store: ConversationStore, session_id: str) -> None:
+    """Drop the session's "Keep running", as Stop sandbox does. Blocking."""
+    conv = conversation_store.get_conversation(session_id)
+    if conv is not None and KEEP_RUNNING_LABEL_KEY in (conv.labels or {}):
+        conversation_store.delete_label(session_id, KEEP_RUNNING_LABEL_KEY)
+
+
+class EnvironmentReport(BaseModel):
+    """What the runner reports every 5 seconds and when the agent starts or stops working."""
+
+    cpu_cores: float | None = Field(default=None, ge=0, le=4096)
+    memory_bytes: int | None = Field(default=None, ge=0)
+    agent_active: bool = False
+    agent_idle_since: float | None = None
+    agent_exits_at: float | None = None
+
+
+class SessionEnvironment(BaseModel):
+    """What the environment menu shows. Times are Unix seconds."""
+
+    pod_started_at: float | None = None
+    """When the running Pod started; ``None`` when there's no Pod."""
+    shutdown_at: float | None = None
+    """The Sandbox's ``spec.shutdownTime``: when it stops, or when it stopped."""
+    idle_stop_window_s: int | None = None
+    """How long the Pod outlives its agent when idle."""
+    disk_used_bytes: int | None = None
+    disk_total_bytes: int | None = None
+    disk_available_fraction: float | None = None
+    """Free space as the kubelet counts it for eviction (``f_bavail / f_blocks``)."""
+    cpu_cores: float | None = None
+    memory_bytes: int | None = None
+    agent_active: bool | None = None
+    agent_idle_since: float | None = None
+    agent_exits_at: float | None = None
+    reported_at: float | None = None
+    keep_running_until: float | None = None
+    keep_running_hours: float | None = None
+    keep_running_forever: bool | None = None
+
+
+# Prune stale reports once there are more than this many (runners come and go).
+_MAX_REPORTS = 1024
+
+# session_id -> (report, when it arrived).
+# custom-lint: disable-next=workspace-scoped-cache -- keyed by session_id
+_reports: dict[str, tuple[EnvironmentReport, float]] = {}
+
+
+def _disk(path: str = "/") -> dict[str, float | int | None]:
+    """The VM disk as the server's own container sees it (one node, one disk)."""
+    try:
+        stat = os.statvfs(path)
+    except OSError:
+        return {}
+    if stat.f_blocks <= 0:
+        return {}
+    return {
+        "disk_total_bytes": stat.f_blocks * stat.f_frsize,
+        "disk_used_bytes": (stat.f_blocks - stat.f_bfree) * stat.f_frsize,
+        "disk_available_fraction": stat.f_bavail / stat.f_blocks,
+    }
+
+
+def register_environment_routes(
+    router: APIRouter,
+    *,
+    conversation_store: ConversationStore,
+    auth_provider: AuthProvider | None = None,
+    permission_store: PermissionStore | None = None,
+) -> None:
+    """Register the environment routes on router."""
+
+    @router.post(
+        "/sessions/{session_id}/environment/report",
+        include_in_schema=False,
+        response_model=KeepRunningState,
+    )
+    async def report_session_environment(
+        request: Request, session_id: str, body: EnvironmentReport
+    ) -> KeepRunningState:
+        """Keep the session's runner's latest report, and tell it whether to keep running.
+
+        Only the session's bound runner may post.
+        """
+        user_id = _get_user_id(request, auth_provider)
+        await _require_access(
+            user_id, session_id, LEVEL_EDIT, permission_store, conversation_store
+        )
+        conv = await asyncio.to_thread(conversation_store.get_conversation, session_id)
+        token = (request.headers.get(RUNNER_TUNNEL_TOKEN_HEADER) or "").strip()
+        if conv is None or not token or token_bound_runner_id(token) != conv.runner_id:
+            raise OmnigentError(
+                "Only the session's runner reports its environment",
+                code=ErrorCode.FORBIDDEN,
+            )
+        now = time.time()
+        _reports[session_id] = (body, now)
+        if len(_reports) > _MAX_REPORTS:
+            for stale in [sid for sid, (_, at) in _reports.items() if now - at > REPORT_MAX_AGE_S]:
+                _reports.pop(stale, None)
+        return keep_running_from_labels(conv.labels)
+
+    @router.put(
+        "/sessions/{session_id}/environment/keep-running",
+        include_in_schema=False,
+        response_model=KeepRunningState,
+    )
+    async def keep_session_running(
+        request: Request, session_id: str, body: KeepRunning
+    ) -> KeepRunningState:
+        """Keep the session's Pod running when idle, for some hours or for good, or stop doing so.
+
+        Owner-only, like Stop sandbox: it holds the Pod's resources. The runner
+        learns it with its next report, within seconds near its idle deadline.
+        """
+        user_id = _get_user_id(request, auth_provider)
+        await _require_access(
+            user_id, session_id, LEVEL_OWNER, permission_store, conversation_store
+        )
+        if body.forever:
+            value: str | None = _KEEP_RUNNING_FOREVER
+        elif body.hours is not None:
+            value = f"{int(time.time() + body.hours * 3600)}/{body.hours:g}"
+        else:
+            value = None
+        if value is None:
+            await asyncio.to_thread(clear_keep_running, conversation_store, session_id)
+        else:
+            await asyncio.to_thread(
+                conversation_store.set_labels, session_id, {KEEP_RUNNING_LABEL_KEY: value}
+            )
+        return keep_running_from_labels({KEEP_RUNNING_LABEL_KEY: value} if value else {})
+
+    @router.get(
+        "/sessions/{session_id}/environment",
+        include_in_schema=False,
+        response_model=SessionEnvironment,
+        response_model_exclude_none=True,
+    )
+    async def get_session_environment(request: Request, session_id: str) -> SessionEnvironment:
+        """What the session's sandbox is doing, for the composer's environment menu."""
+        from omnigent.server.managed_hosts import _launcher_for_teardown
+
+        user_id = _get_user_id(request, auth_provider)
+        await _require_access(
+            user_id, session_id, LEVEL_READ, permission_store, conversation_store
+        )
+        result = SessionEnvironment(**_disk())
+        conv = await asyncio.to_thread(conversation_store.get_conversation, session_id)
+        if conv is not None:
+            kept = keep_running_from_labels(conv.labels)
+            result.keep_running_until = kept.keep_running_until
+            result.keep_running_hours = kept.keep_running_hours
+            result.keep_running_forever = kept.keep_running_forever or None
+        host_store = getattr(request.app.state, "host_store", None)
+        sandbox_config = getattr(request.app.state, "sandbox_config", None)
+        if conv is not None and conv.host_id and host_store is not None:
+            host = await asyncio.to_thread(host_store.get_host, conv.host_id)
+            launcher = _launcher_for_teardown(host, sandbox_config) if host is not None else None
+            read = getattr(launcher, "environment", None)
+            if host is not None and host.sandbox_id and callable(read):
+                from omnigent.onboarding.sandboxes.agent_sandbox import resolve_shutdown_window_s
+
+                times = await asyncio.to_thread(read, host.sandbox_id)
+                result.pod_started_at = times.get("pod_started_at")
+                result.shutdown_at = times.get("shutdown_at")
+                result.idle_stop_window_s = resolve_shutdown_window_s()
+        report = _reports.get(session_id)
+        if report is not None and time.time() - report[1] <= REPORT_MAX_AGE_S:
+            body, reported_at = report
+            result.cpu_cores = body.cpu_cores
+            result.memory_bytes = body.memory_bytes
+            result.agent_active = body.agent_active
+            result.agent_idle_since = body.agent_idle_since
+            result.agent_exits_at = body.agent_exits_at
+            result.reported_at = reported_at
+        return result
