+"""``AgentSandboxLauncher.environment``: the Pod's start and the Sandbox's deadline."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from types import SimpleNamespace
+
+import pytest
+
+from tests.onboarding.sandboxes.test_agent_sandbox import (  # noqa: F401 (fake_clients is a fixture)
+    _SANDBOX_ID,
+    _FakeApiException,
+    _FakeCore,
+    _FakeCustom,
+    _launcher,
+    fake_clients,
+)
+
+STARTED = datetime(2026, 10, 13, 14, 0, tzinfo=UTC)
+
+
+def _running(
+    core: _FakeCore,
+    custom: _FakeCustom,
+    monkeypatch: pytest.MonkeyPatch,
+    *,
+    shutdown_time: str = "2026-10-13T15:12:00Z",
+) -> None:
+    monkeypatch.setattr(
+        custom,
+        "get_namespaced_custom_object",
+        lambda *args, **kwargs: {"spec": {"shutdownTime": shutdown_time}},
+    )
+    monkeypatch.setattr(
+        core,
+        "read_namespaced_pod",
+        lambda *args, **kwargs: SimpleNamespace(
+            metadata=SimpleNamespace(deletion_timestamp=None),
+            status=SimpleNamespace(start_time=STARTED),
+        ),
+    )
+
+
+def test_a_running_sandbox(
+    fake_clients: tuple[_FakeCore, _FakeCustom],  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    core, custom = fake_clients
+    _running(core, custom, monkeypatch)
+    assert _launcher().environment(_SANDBOX_ID) == {
+        "pod_started_at": STARTED.timestamp(),
+        "shutdown_at": datetime(2026, 10, 13, 15, 12, tzinfo=UTC).timestamp(),
+    }
+
+
+def test_a_stopped_sandbox_has_no_pod(
+    fake_clients: tuple[_FakeCore, _FakeCustom],  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    core, custom = fake_clients
+    _running(core, custom, monkeypatch)
+    monkeypatch.setattr(
+        core,
+        "read_namespaced_pod",
+        lambda *args, **kwargs: (_ for _ in ()).throw(_FakeApiException(status=404)),
+    )
+    env = _launcher().environment(_SANDBOX_ID)
+    assert env["pod_started_at"] is None
+    assert env["shutdown_at"] is not None
+
+
+def test_a_pod_on_its_way_out_isnt_running(
+    fake_clients: tuple[_FakeCore, _FakeCustom],  # noqa: F811  (imported fixture)
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    core, custom = fake_clients
+    _running(core, custom, monkeypatch)
+    monkeypatch.setattr(
+        core,
+        "read_namespaced_pod",
+        lambda *args, **kwargs: SimpleNamespace(
+            metadata=SimpleNamespace(deletion_timestamp="2026-10-13T15:00:00Z"),
+            status=SimpleNamespace(start_time=STARTED),
+        ),
+    )
+    assert _launcher().environment(_SANDBOX_ID)["pod_started_at"] is None
+
+
+def test_unreadable_is_unknown_not_an_error(
+    fake_clients: tuple[_FakeCore, _FakeCustom],  # noqa: F811  (imported fixture)
+) -> None:
+    core, custom = fake_clients
+    custom.get_error = _FakeApiException(status=403, reason="Forbidden")
+    core.read_pod_error = _FakeApiException(status=403, reason="Forbidden")
+    assert _launcher().environment(_SANDBOX_ID) == {"pod_started_at": None, "shutdown_at": None}
