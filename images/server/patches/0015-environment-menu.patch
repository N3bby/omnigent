+def suspend(launcher: SandboxHostLauncher, sandbox_id: str) -> Future[None]:
+    """Stop *sandbox_id* now and keep keepalives from pushing its deadline back.
+
+    The hold starts before the suspend runs, so a refresh queued after it skips
+    the sandbox. The suspend runs on the keepalive worker, behind any refresh
+    already queued or running, so none can land after it. Raises through the
+    returned future when the provider call fails, and lifts the hold then: the
+    sandbox is still running and still needs its keepalives.
+
+    :param launcher: The provider-matched launcher for the sandbox.
+    :param sandbox_id: The sandbox to stop, e.g. ``"omnigent-d8ee7424"``.
+    :returns: A future that resolves once the provider accepted the suspend.
+    """
+    _suspended_at[sandbox_id] = time.monotonic()
+
+    def _run() -> None:
+        try:
+            launcher.suspend(sandbox_id)
+        except BaseException:
+            _suspended_at.pop(sandbox_id, None)
+            raise
+
+    if _executor is None:
+        future: Future[None] = Future()
+        try:
+            _run()
+        except BaseException as exc:  # noqa: BLE001
+            future.set_exception(exc)
+        else:
+            future.set_result(None)
+        return future
+    return _executor.submit(contextvars.copy_context().run, _run)
+
+
+def _is_suspended(sandbox_id: str) -> bool:
+    """Whether *sandbox_id* was stopped within :data:`_SUSPEND_HOLD_S`."""
+    stopped = _suspended_at.get(sandbox_id)
+    if stopped is None:
+        return False
+    if time.monotonic() - stopped < _SUSPEND_HOLD_S:
+        return True
+    _suspended_at.pop(sandbox_id, None)
+    return False
+
+
