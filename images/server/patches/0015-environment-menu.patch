+START_CANCELLED_REASON = "you cancelled the start"
+"""Why a cancelled start's waiting message wasn't sent."""
+
+
+class StartCancelledError(Exception):
+    """Raised at a cancelled start's next stage, so the start stops there."""
+
+
+# Starts the user cancelled ("Cancel start"), by session id: the event loop and
+# the cleanup to run there once the start has stopped. Read by
+# _publish_sandbox_status, which every stage of a start goes through, possibly
+# from a worker thread. See cancel_managed_start.
+# custom-lint: disable-next=workspace-scoped-cache -- keyed by session_id
+_cancelled_starts: dict[
+    str, tuple[asyncio.AbstractEventLoop, Callable[[], Coroutine[Any, Any, None]]]
+] = {}
+
+# Cleanups scheduled by settle_cancelled_start, kept until they finish.
+_cancel_cleanup_tasks: set[asyncio.Task[None]] = set()
+
+
+def cancel_managed_start(
+    session_id: str,
+    tracker: ManagedLaunchTracker,
+    cleanup: Callable[[], Coroutine[Any, Any, None]],
+) -> bool:
+    """
+    Cancel *session_id*'s start in flight: "Cancel start" in the composer.
+
+    The start isn't interrupted mid-call; its next stage raises
+    :class:`StartCancelledError` instead (see ``_publish_sandbox_status``), its
+    failure path settles the tracker, which fails the message that was waiting
+    on it, and *cleanup* then runs to stop the sandbox and show it stopped.
+
+    :param session_id: Session/conversation identifier.
+    :param tracker: The app's launch tracker.
+    :param cleanup: Runs once the start has stopped, instead of publishing its
+        final stage.
+    :returns: ``True`` when a wake was in flight and is now cancelled;
+        ``False`` for no start, or a first launch, which can't be.
+    """
+    launch = tracker.get(session_id)
+    if launch is None or launch.settled.is_set() or not launch.wake:
+        return False
+    launch.cancelled = True
+    _cancelled_starts[session_id] = (asyncio.get_running_loop(), cleanup)
+    return True
+
+
+def settle_cancelled_start(session_id: str, stage: str) -> bool:
+    """
+    Stop a cancelled start at *stage*, or run its cleanup once it has stopped.
+
+    Called for every stage a start publishes, from the event loop or a worker
+    thread.
+
+    :param session_id: Session/conversation identifier.
+    :param stage: The stage the start is about to publish, e.g. ``"connecting"``.
+    :returns: ``True`` when the start was cancelled and the stage must not be
+        published.
+    :raises StartCancelledError: For a cancelled start's non-final stage.
+    """
+    cancelled = _cancelled_starts.get(session_id)
+    if cancelled is None:
+        return False
+    if stage not in ("ready", "failed"):
+        raise StartCancelledError("the start was cancelled")
+    if _cancelled_starts.pop(session_id, None) is None:
+        return True
+    loop, cleanup = cancelled
+
+    def _spawn() -> None:
+        task = loop.create_task(cleanup())
+        _cancel_cleanup_tasks.add(task)
+        task.add_done_callback(_cancel_cleanup_tasks.discard)
+
+    loop.call_soon_threadsafe(_spawn)
+    return True
+
