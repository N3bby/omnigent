+"""``AgentSandboxLauncher.suspend``: Stop sandbox moves ``spec.shutdownTime`` to now."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+
+import click
+import pytest
+
+from tests.onboarding.sandboxes.test_agent_sandbox import (  # noqa: F401 (fake_clients is a fixture)
+    _SANDBOX_ID,
+    _FakeApiException,
+    _FakeCore,
+    _FakeCustom,
+    _launcher,
+    fake_clients,
+)
+
+
+def test_suspend_moves_the_deadline_to_now(
+    fake_clients: tuple[_FakeCore, _FakeCustom],  # noqa: F811  (imported fixture)
+) -> None:
+    """The same single-field patch as keep_alive, with the deadline at now."""
+    _, custom = fake_clients
+    _launcher().suspend(_SANDBOX_ID)
+
+    assert custom.calls == ["patch"]
+    name, body = custom.patches[0]
+    assert name == _SANDBOX_ID
+    assert list(body) == ["spec"] and list(body["spec"]) == ["shutdownTime"]
+    when = datetime.strptime(body["spec"]["shutdownTime"], "%Y-%m-%dT%H:%M:%SZ").replace(
+        tzinfo=UTC
+    )
+    assert abs((when - datetime.now(UTC)).total_seconds()) <= 2
+
+
+def test_suspend_raises_when_the_patch_fails(
+    fake_clients: tuple[_FakeCore, _FakeCustom],  # noqa: F811  (imported fixture)
+) -> None:
+    """Unlike keep_alive, a user asked for this, so a failure must surface."""
+    _, custom = fake_clients
+    custom.patch_error = _FakeApiException(status=403, reason="Forbidden")
+    with pytest.raises(click.ClickException):
+        _launcher().suspend(_SANDBOX_ID)
+
+
+def test_suspend_of_a_vanished_sandbox_is_success(
+    fake_clients: tuple[_FakeCore, _FakeCustom],  # noqa: F811  (imported fixture)
+) -> None:
+    """A deleted sandbox has nothing left to stop."""
+    _, custom = fake_clients
+    custom.patch_error = _FakeApiException(status=404, reason="NotFound")
+    _launcher().suspend(_SANDBOX_ID)
+
+
+def test_a_warm_pool_handle_cant_be_suspended() -> None:
+    """Its Sandbox isn't named by the handle, so a plain suspend would patch nothing."""
+    from omnigent.onboarding.sandboxes.agent_sandbox_warm_pool import (
+        _HANDLE_PREFIX,
+        AgentSandboxWarmPoolLauncher,
+    )
+    from omnigent.onboarding.sandboxes.base import SandboxCapabilityError
+
+    launcher = AgentSandboxWarmPoolLauncher(
+        warm_pool="warm-pool-v1",
+        image="host-image:test",
+        namespace="omnigent-sandboxes",
+        env=(),
+        in_cluster=True,
+    )
+    with pytest.raises(SandboxCapabilityError):
+        launcher.suspend(f"{_HANDLE_PREFIX}ns:claim:uid")
