+
+
+async def test_a_lapsed_keep_running_no_longer_holds(
+    client: httpx.AsyncClient, db_uri: str
+) -> None:
+    session_id = await _session(client, db_uri)
+    SqlAlchemyConversationStore(db_uri).set_labels(
+        session_id, {routes_environment.KEEP_RUNNING_LABEL_KEY: f"{int(time.time()) - 60}/2"}
+    )
+    assert (await _report(client, session_id))["keep_running_until"] is None
