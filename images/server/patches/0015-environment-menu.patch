+async def test_keep_running_reaches_the_runner_and_the_menu(
+    client: httpx.AsyncClient, db_uri: str
+) -> None:
+    session_id = await _session(client, db_uri)
+    before = time.time()
+
+    resp = await client.put(
+        f"/v1/sessions/{session_id}/environment/keep-running", json={"hours": 8}
+    )
+    assert resp.status_code == 200, resp.text
+
+    reported = await _report(client, session_id)
