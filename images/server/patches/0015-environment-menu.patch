+    assert reported["keep_running_hours"] == 8
+    env = (await client.get(f"/v1/sessions/{session_id}/environment")).json()
+    assert env["keep_running_until"] == reported["keep_running_until"]
+    assert env["keep_running_hours"] == 8
+
+    resp = await client.put(
+        f"/v1/sessions/{session_id}/environment/keep-running", json={"forever": True}
+    )
+    assert resp.json()["keep_running_forever"] is True
