+def test_a_runner_that_exits_ends_the_wait_with_its_log(monkeypatch: pytest.MonkeyPatch) -> None:
+    published: list[tuple[str, str | None]] = []
+    monkeypatch.setattr(
+        helpers,
+        "_publish_sandbox_status",
+        lambda _sid, stage, error=None: published.append((stage, error)),
+    )
+    tracker = ManagedLaunchTracker()
+    tracker.begin(SESSION)
+
+    async def scenario() -> bool:
+        wait = asyncio.ensure_future(
+            helpers._wait_for_managed_runner_tunnel(
+                SESSION, "runner_1", _Tunnels(30, None), tracker
+            )
+        )
+        await asyncio.sleep(0.05)
+        startup.runner_exited("runner_1", "runner process exited with code 1\nImportError: x")
+        return await asyncio.wait_for(wait, 2)
+
+    assert asyncio.run(scenario()) is False
+    stage, error = published[-1]
+    assert stage == "failed"
+    assert (
+        error
+        == "the agent exited while starting: runner process exited with code 1\nImportError: x"
+    )
+    launch = tracker.get(SESSION)
+    assert launch is not None and launch.error == error
+
