+class _Tunnels:
+    def __init__(self, delay: float, runner: object | None) -> None:
+        self.delay = delay
+        self.runner = runner
+
+    async def wait_for_runner(self, runner_id: str, timeout_s: float) -> object | None:  # noqa: ARG002
+        await asyncio.sleep(self.delay)
+        return self.runner
+
