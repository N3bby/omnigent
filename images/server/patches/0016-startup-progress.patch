@@ -0,0 +1,241 @@
+"""The server side of the startup card (this deployment).
+
+Covers the startup routes, the runner wait that ends when the runner exits,
+and the host log read while the host connects. The record itself is tested in
+the deployment repo (tests/test_startup_progress.py).
+"""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+
+import omnigent_startup as startup
+import pytest
+from fastapi import FastAPI, HTTPException
+from fastapi.testclient import TestClient
+from omnigent_startup_api import create_startup_router
+
+import omnigent.server.managed_hosts as managed_hosts
+from omnigent.server.managed_hosts import ManagedLaunchTracker
+from omnigent.server.routes._sessions import helpers
+
+SESSION = "conv_startup_routes"
+
+
+@pytest.fixture(autouse=True)
+def _fresh_record() -> None:
+    startup._records.clear()
+    startup._host_sessions.clear()
+    startup._runner_exits.clear()
+    startup.set_publisher(None)
+
+
+class _HostStore:
+    def __init__(self, online_after: int | None = None) -> None:
+        self.polls = 0
+        self.online_after = online_after
+
+    def resolve_launch_token(self, host_id: str, token: str) -> object | None:
+        return (
+            SimpleNamespace(user_id="alice") if (host_id, token) == ("host_1", "secret") else None
+        )
+
+    def is_online(self, host_id: str) -> bool:  # noqa: ARG002
+        self.polls += 1
+        return self.online_after is not None and self.polls > self.online_after
+
+
+def _client() -> TestClient:
+    app = FastAPI()
+    app.include_router(
+        create_startup_router(
+            conversation_store=SimpleNamespace(),  # type: ignore[arg-type]
+            host_store=_HostStore(),  # type: ignore[arg-type]
+            auth_provider=None,
+            permission_store=None,
+        ),
+        prefix="/v1",
+    )
+    return TestClient(app)
+
+
+def test_the_pod_reports_with_its_launch_token() -> None:
+    startup.on_stage(SESSION, "provisioning")
+    startup.attach_host("host_1", SESSION)
+    client = _client()
+    report = {"steps": [{"step": "setup", "child": "roadpass", "state": "running"}]}
+
+    assert client.post("/v1/hosts/host_1/startup", json=report).status_code == 401
+    assert (
+        client.post(
+            "/v1/hosts/host_1/startup", json=report, headers={"X-Omnigent-Host-Token": "nope"}
+        ).status_code
+        == 401
+    )
+    response = client.post(
+        "/v1/hosts/host_1/startup", json=report, headers={"X-Omnigent-Host-Token": "secret"}
+    )
+    assert response.json() == {"accepted": True}
+    record = startup.snapshot(SESSION)
+    assert record is not None
+    assert [s["id"] for s in record["steps"]] == ["sandbox", "host", "setup", "agent"]
+
+
+def test_a_report_that_is_not_an_object_is_refused() -> None:
+    response = _client().post(
+        "/v1/hosts/host_1/startup",
+        content=b"[1, 2]",
+        headers={"X-Omnigent-Host-Token": "secret", "Content-Type": "application/json"},
+    )
+    assert response.status_code == 400
+
+
+def test_the_log_is_read_after_a_line() -> None:
+    startup.on_stage(SESSION, "provisioning")
+    startup.log(SESSION, "k8s", "Scheduled: to vm-omnigent")
+    client = _client()
+
+    page = client.get(f"/v1/sessions/{SESSION}/startup-log").json()
+    assert [line["text"] for line in page["lines"]] == [
+        "Creating the sandbox",
+        "Scheduled: to vm-omnigent",
+    ]
+    assert page["live"] is True
+    later = client.get(f"/v1/sessions/{SESSION}/startup-log?after={page['next']}").json()
+    assert later["lines"] == []
+    assert client.get("/v1/sessions/conv_none/startup-log").json() == {
+        "started_at": None,
+        "lines": [],
+        "next": 0,
+        "live": False,
+    }
