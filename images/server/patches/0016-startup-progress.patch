+def test_the_host_log_explains_a_host_that_never_connects(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(managed_hosts, "MANAGED_HOST_ONLINE_TIMEOUT_S", 0.05)
