+            status = getattr(pod, "status", None)
+            for cs in getattr(status, "init_container_statuses", None) or []:
+                if getattr(cs, "name", None) != _INIT_CONTAINER_NAME:
+                    continue
+                state = getattr(cs, "state", None)
