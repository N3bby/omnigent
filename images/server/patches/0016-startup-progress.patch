+def test_a_message_waits_as_long_as_the_pod_may_take(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(managed_hosts, "MANAGED_LAUNCH_RENDEZVOUS_TIMEOUT_S", 0.05)
+    monkeypatch.setattr(startup, "_pod_budget_s", 0.0)
+    tracker = ManagedLaunchTracker()
+    tracker.begin(SESSION)
+    launch = tracker.get(SESSION)
+    assert launch is not None
+
+    async def scenario() -> None:
+        async def settle() -> None:
+            # The launch notes its Pod budget once it reaches the Pod wait.
+            startup.note_pod_budget(0.2)
+            await asyncio.sleep(0.12)
+            tracker.finish(SESSION)
+
+        task = asyncio.ensure_future(settle())
+        await helpers._await_settled_managed_launch(launch)
+        await task
+
+    asyncio.run(scenario())
