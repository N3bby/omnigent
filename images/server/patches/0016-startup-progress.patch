+"""How the Kubernetes launcher reports a sandbox's start (this deployment).
+
+The launcher feeds ``omnigent_startup``: each repository's clone, the Pod's
+scheduling, image and containers, and the init container's log. It also stops
+a start whose clone failed twice instead of waiting out the deadline.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+
+import click
+import omnigent_startup as startup
+import pytest
+
+import omnigent.onboarding.sandboxes.kubernetes as k8s
+from omnigent.onboarding.sandboxes.base import RUNNER_PYTHON
+from omnigent.onboarding.sandboxes.types import RepoWorkspace
+from tests.onboarding.sandboxes.test_kubernetes import (  # noqa: F401 - fixture
+    _MANIFEST_KW,
+    _FakeBatch,
+    _FakeCore,
+    _launcher,
+    _pod,
+    fake_clients,
+)
+
+SESSION = "conv_k8s_startup"
+
+
+@pytest.fixture(autouse=True)
+def _fresh_record() -> None:
+    startup._records.clear()
+    startup._host_sessions.clear()
+    startup.set_publisher(None)
+
+
+def _init(
+    *, state: str, exit_code: int | None = None, restarts: int = 0, last_exit: int | None = None
+):
+    states = {
+        "running": SimpleNamespace(running=SimpleNamespace(), waiting=None, terminated=None),
+        "waiting": SimpleNamespace(
+            running=None,
+            waiting=SimpleNamespace(reason="CrashLoopBackOff", message=""),
+            terminated=None,
+        ),
+        "terminated": SimpleNamespace(
+            running=None,
+            waiting=None,
+            terminated=SimpleNamespace(exit_code=exit_code, reason="Error"),
+        ),
+    }
+    return SimpleNamespace(
+        name="workspace-prep",
+        state=states[state],
+        last_state=SimpleNamespace(
+            terminated=SimpleNamespace(exit_code=last_exit, reason="Error")
+            if last_exit is not None
+            else None
+        ),
+        restart_count=restarts,
+    )
+
+
+def test_a_clone_that_fails_once_is_retried() -> None:
+    pod = _pod(phase="Pending", init_statuses=[_init(state="terminated", exit_code=128)])
+    assert k8s._terminal_failure(pod) is None
+
+
+def test_a_clone_that_fails_twice_ends_the_start() -> None:
+    waiting = _pod(
+        phase="Pending", init_statuses=[_init(state="waiting", restarts=1, last_exit=128)]
+    )
+    failure = k8s._terminal_failure(waiting)
+    assert failure is not None
+    assert failure[0] == "workspace-prep"
+    assert "workspace prep failed (exit 128, Error, after 2 attempts)" in failure[1]
+    running_again = _pod(
+        phase="Pending", init_statuses=[_init(state="running", restarts=1, last_exit=128)]
+    )
+    assert k8s._terminal_failure(running_again) is None
+
+
+def _run_prep(
+    workspace: Path, monkeypatch: pytest.MonkeyPatch, git: str
+) -> subprocess.CompletedProcess[str]:
+    """Run the real clone script with the runner's Python and git stubbed."""
+    command = k8s._render_workspace_prep_command(
+        str(workspace),
+        [RepoWorkspace(url="https://github.com/org/repo.git", branch=None, repo_name="repo")],
+        ":",
+        "host-test",
+    )
+    script = (
+        # The credential wiring is a no-op; the atomic rename runs for real.
+        f"function {RUNNER_PYTHON} {{\n"
+        '  if [ "$1" = "-c" ]; then return 0; fi; command python3 "$@"\n'
+        "}\n"
+        f'git() {{\n  if [ "$1" = "-C" ]; then command git "$@"; return; fi\n{git}\n}}\n'
+        + command[2]
+    )
+    monkeypatch.setenv("GIT_CONFIG_GLOBAL", "/dev/null")
+    monkeypatch.setenv("GIT_CONFIG_NOSYSTEM", "1")
+    monkeypatch.delenv("GIT_DIR", raising=False)
+    monkeypatch.delenv("GIT_WORK_TREE", raising=False)
+    return subprocess.run(
+        ["bash", "-c", script], capture_output=True, text=True, env=os.environ.copy()
+    )
+
+
+_CLONES = (
+    '  clone_dir="${@: -1}"\n'
+    '  mkdir -p "$clone_dir/.git"\n'
+    '  printf "ref: refs/heads/main\\n" > "$clone_dir/.git/HEAD"'
+)
+
+
+def test_the_clone_prints_a_line_per_repository(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    workspace = tmp_path / "workspace"
+    result = _run_prep(workspace, monkeypatch, _CLONES)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines() == [
+        "omnigent-prep: cloning repo",
+        "omnigent-prep: cloned repo",
+    ]
+
+    # A woken Pod finds a real checkout and keeps it.
+    subprocess.run(["rm", "-rf", str(workspace / "repo")], check=True)
+    subprocess.run(["git", "init", "-q", str(workspace / "repo")], check=True)
+    result = _run_prep(workspace, monkeypatch, _CLONES)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines() == ["omnigent-prep: kept repo"]
+
+
+def test_a_failed_clone_says_which_repository(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    result = _run_prep(
+        tmp_path / "workspace",
+        monkeypatch,
+        "  echo \"fatal: Authentication failed for 'https://github.com/org/repo.git/'\" >&2\n"
+        "  return 128",
+    )
+    assert result.returncode != 0
+    assert "omnigent-prep: failed repo" in result.stdout.splitlines()
+    assert "omnigent-prep: cloned repo" not in result.stdout
+
+
+def test_the_host_container_knows_where_to_report() -> None:
+    manifest = k8s.build_job_manifest(
+        **{**_MANIFEST_KW, "host_id": "host_1", "server_url": "http://omnigent.svc:8000/"}
+    )
+    host = manifest["spec"]["template"]["spec"]["containers"][0]  # type: ignore[index]
+    env = {e["name"]: e.get("value") for e in host["env"]}
+    assert env["OMNIGENT_STARTUP_REPORT_URL"] == "http://omnigent.svc:8000/v1/hosts/host_1/startup"
+
+
+def test_the_pod_wait_reports_progress_to_the_session(
+    fake_clients: tuple[_FakeCore, _FakeBatch],  # noqa: F811 - the imported fixture
+) -> None:
+    core, _ = fake_clients
+    startup.on_stage(SESSION, "provisioning")
+    scheduled = [SimpleNamespace(type="PodScheduled", status="True", reason=None, message=None)]
+    cloning = _pod(
+        phase="Pending",
+        init_statuses=[_init(state="running")],
+        conditions=scheduled,
+    )
+    running = _pod(
+        phase="Running",
+        init_statuses=[_init(state="terminated", exit_code=0)],
+        container_statuses=[
+            SimpleNamespace(
+                name="host",
+                state=SimpleNamespace(running=SimpleNamespace(), waiting=None, terminated=None),
+                last_state=SimpleNamespace(terminated=None),
+                restart_count=0,
+            )
+        ],
+        conditions=scheduled,
+    )
+    core.pod_list_items = [cloning]
+    core.read_queue = [cloning, running]
+    core.logs["workspace-prep"] = "omnigent-prep: cloning repo\nCloning into 'repo'...\n"
+    startup.bind(SESSION)
+    _launcher()._wait_for_pod_running("omnigent-sandboxes", "omnigent-job-1")
+
+    record = startup.snapshot(SESSION)
+    assert record is not None
+    steps = {step["id"]: step for step in record["steps"]}
+    assert steps["schedule"]["state"] == "done"
+    assert steps["image"]["state"] == "done"
+    assert steps["clone"]["state"] == "done"
+    assert [c["name"] for c in steps["clone"]["children"]] == ["repo"]
+    assert steps["host"]["state"] == "running"
+    page = startup.log_page(SESSION)
+    assert page is not None
+    assert "Cloning into 'repo'..." in [line["text"] for line in page["lines"]]
+
+
+def test_a_missing_pod_explains_itself_with_events(
+    fake_clients: tuple[_FakeCore, _FakeBatch],  # noqa: F811 - the imported fixture
+) -> None:
+    core, _ = fake_clients
+    core.events = [SimpleNamespace(reason="FailedCreate", message="exceeded quota: runner-quota")]
+    launcher = _launcher()
+    launcher._pod_ready_timeout_s = 0
+    with pytest.raises(click.ClickException) as raised:
+        launcher._wait_for_pod_running("omnigent-sandboxes", "omnigent-job-1")
+    assert "did not create a child pod" in raised.value.message
+    assert "FailedCreate: exceeded quota: runner-quota" in raised.value.message
+
+
+def test_a_log_reads_as_its_text_with_the_real_client() -> None:
+    """kubernetes 36 decodes a plain-text log to ``'b"..."'``; read it as text."""
+    client = pytest.importorskip("kubernetes.client")
+    import threading
+    from http.server import BaseHTTPRequestHandler, HTTPServer
+
+    body = b"omnigent-prep: cloning repo\nCloning into 'repo'...\nomnigent-prep: cloned repo\n"
+
+    class _Log(BaseHTTPRequestHandler):
+        def do_GET(self) -> None:
+            self.send_response(200)
+            self.send_header("Content-Type", "text/plain")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *_args: object) -> None:
+            pass
+
+    server = HTTPServer(("127.0.0.1", 0), _Log)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    try:
+        core = client.CoreV1Api(
+            client.ApiClient(client.Configuration(host=f"http://127.0.0.1:{server.server_port}"))
+        )
+        text = k8s._read_pod_log(core, "omnigent-job-1", "ns", "workspace-prep", 500)
+    finally:
+        server.shutdown()
+    assert text.splitlines() == [
+        "omnigent-prep: cloning repo",
+        "Cloning into 'repo'...",
+        "omnigent-prep: cloned repo",
+    ]
diff --git a/tests/server/test_startup_progress.py b/tests/server/test_startup_progress.py
