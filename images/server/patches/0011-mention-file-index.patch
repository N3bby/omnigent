+"""The server route behind the composer's fuzzy "@" picker.
+
+The runner builds the file index (``tests/runner/test_file_index.py`` in the
+runner image's patch); the server only authorizes and proxies.
+"""
+
+from __future__ import annotations
+
+import httpx
+import pytest
+
+from tests.server.helpers import create_test_agent
+
+pytestmark = pytest.mark.asyncio
+
+
+async def test_file_index_no_runner(client: httpx.AsyncClient) -> None:
+    """GET .../environments/default/file-index returns 502 without a runner."""
+    agent = await create_test_agent(client)
+    resp = await client.post("/v1/sessions", json={"agent_id": agent["id"]})
+    assert resp.status_code == 201, resp.text
+    sid = resp.json()["id"]
+
+    resp = await client.get(f"/v1/sessions/{sid}/resources/environments/default/file-index")
+    assert resp.status_code == 502
+
+
+async def test_file_index_unknown_session(client: httpx.AsyncClient) -> None:
+    resp = await client.get("/v1/sessions/conv_missing/resources/environments/default/file-index")
+    assert resp.status_code == 404
