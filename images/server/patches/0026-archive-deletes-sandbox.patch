diff --git a/tests/server/test_archive_deletes_sandbox.py b/tests/server/test_archive_deletes_sandbox.py
new file mode 100644
index 000000000..c4f5f5cda
--- /dev/null
+++ b/tests/server/test_archive_deletes_sandbox.py
@@ -0,0 +1,192 @@
+"""Archiving a session deletes its managed sandbox and keeps the conversation.
+
+A stopped agent-sandbox keeps its home volume until the session is deleted, so
+archive deletes the sandbox too. The host row stays, so an unarchived session
+reads as asleep and its next message starts a fresh sandbox.
+"""
+
+from __future__ import annotations
+
+import uuid
+from typing import Any, ClassVar
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from omnigent.db.utils import now_epoch
+from omnigent.server.managed_hosts import ManagedSandboxConfig, ManagedSandboxDeployment
+from omnigent.server.routes import sessions as _sessions_facade
+from omnigent.server.routes._sessions import orchestration
+from omnigent.stores.conversation_store.sqlalchemy_store import SqlAlchemyConversationStore
+from omnigent.stores.host_store import HostStore
+from tests.server.helpers import FakeSandboxLauncher
+
+pytestmark = pytest.mark.asyncio
+
+_OWNER = "alice@example.com"
+
+
+class _Launcher(FakeSandboxLauncher):
+    """A provider that keeps stopped sandboxes, like agent-sandbox."""
+
+    provider: ClassVar[str] = "islo"
+
+    def __init__(self, fail: bool = False, **kwargs: Any) -> None:
+        super().__init__(**kwargs)
+        self._fail = fail
+
+    def terminate(self, sandbox_id: str) -> None:
+        if self._fail:
+            raise RuntimeError("API server unavailable")
+        super().terminate(sandbox_id)
+
+
+def _config(launcher: FakeSandboxLauncher) -> ManagedSandboxDeployment:
+    return ManagedSandboxDeployment.single(
+        ManagedSandboxConfig(
+            server_url="https://srv.example.com",
+            launcher_factory=lambda: launcher,
+            token_ttl_s=3600,
+        )
+    )
+
+
+def _session(
+    conv_store: SqlAlchemyConversationStore,
+    host_store: HostStore,
+    sandbox_id: str,
+    *,
+    archived: bool = True,
+    host_id: str | None = None,
+) -> tuple[str, str]:
+    """Create a session bound to a managed host; returns (session id, host id)."""
+    if host_id is None:
+        host_id = uuid.uuid4().hex
+        host_store.register_managed_host(
+            host_id=host_id,
+            name=f"managed-{sandbox_id}",
+            user_id=_OWNER,
+            token=f"tok-{sandbox_id}",
+            provider="islo",
+            sandbox_id=sandbox_id,
+            token_expires_at=now_epoch() + 3600,
+        )
+    conv = conv_store.create_conversation(host_id=host_id, workspace="/root")
+    if archived:
+        conv_store.update_conversation(conv.id, archived=True)
+    return conv.id, host_id
+
+
+async def _delete(
+    conv_store: SqlAlchemyConversationStore,
+    host_store: HostStore,
+    session_id: str,
+    config: ManagedSandboxDeployment | None,
+) -> bool:
+    conv = conv_store.get_conversation(session_id)
+    return await orchestration._delete_archived_session_sandbox(
+        session_id, conv, conv_store, host_store, config
+    )
+
+
+async def test_archive_deletes_the_sandbox_and_keeps_the_host(db_uri: str) -> None:
+    """The host row keeps its sandbox id, so the session still reads as asleep."""
+    conv_store, host_store = SqlAlchemyConversationStore(db_uri), HostStore(db_uri)
+    session_id, host_id = _session(conv_store, host_store, "sb-archived")
+    launcher = _Launcher(can_resume=True)
+
+    assert await _delete(conv_store, host_store, session_id, _config(launcher))
+
+    assert launcher.terminated == ["sb-archived"]
+    host = host_store.get_host(host_id)
+    assert host is not None and host.sandbox_id == "sb-archived"
+    assert conv_store.get_conversation(session_id) is not None
+
+
+async def test_only_sandboxes_a_message_can_recreate(db_uri: str) -> None:
+    """Providers without stop/resume, CLI hosts and no sandbox config are left alone."""
+    conv_store, host_store = SqlAlchemyConversationStore(db_uri), HostStore(db_uri)
+    session_id, _ = _session(conv_store, host_store, "sb-modal")
+    launcher = _Launcher(can_resume=False)
+
+    assert not await _delete(conv_store, host_store, session_id, _config(launcher))
+    assert not await _delete(conv_store, host_store, session_id, None)
+    cli = conv_store.create_conversation(host_id="f" * 32, workspace="/home/me")
+    assert not await _delete(conv_store, host_store, cli.id, _config(launcher))
+    assert launcher.terminated == []
+
+
+async def test_a_host_another_live_session_uses_is_kept(db_uri: str) -> None:
+    """Such as a session a terminal was moved to; once it's archived too, it goes."""
+    conv_store, host_store = SqlAlchemyConversationStore(db_uri), HostStore(db_uri)
+    session_id, host_id = _session(conv_store, host_store, "sb-shared")
+    other, _ = _session(conv_store, host_store, "", archived=False, host_id=host_id)
+    launcher = _Launcher(can_resume=True)
+
+    assert not await _delete(conv_store, host_store, session_id, _config(launcher))
+    assert launcher.terminated == []
+
+    conv_store.update_conversation(other, archived=True)
+    assert await _delete(conv_store, host_store, session_id, _config(launcher))
+    assert launcher.terminated == ["sb-shared"]
+
+
+async def test_a_failed_delete_is_logged_not_raised(db_uri: str) -> None:
+    conv_store, host_store = SqlAlchemyConversationStore(db_uri), HostStore(db_uri)
+    session_id, _ = _session(conv_store, host_store, "sb-fails")
+
+    assert not await _delete(
+        conv_store, host_store, session_id, _config(_Launcher(fail=True, can_resume=True))
+    )
+
+
+async def test_the_archive_teardown_deletes_the_sandbox(db_uri: str) -> None:
+    conv_store, host_store = SqlAlchemyConversationStore(db_uri), HostStore(db_uri)
+    session_id, _ = _session(conv_store, host_store, "sb-teardown")
+    launcher = _Launcher(can_resume=True)
+
+    with patch.object(_sessions_facade, "_best_effort_stop", AsyncMock()):
+        await orchestration._archive_stop(
+            session_id,
+            conv_store,
+            runner_router=None,
+            host_registry=None,
+            host_store=host_store,
+            sandbox_config=_config(launcher),
+        )
+
+    assert launcher.terminated == ["sb-teardown"]
+
+
+async def test_the_teardown_keeps_an_unarchived_sessions_sandbox(db_uri: str) -> None:
+    """Undo landed before the teardown fired."""
+    conv_store, host_store = SqlAlchemyConversationStore(db_uri), HostStore(db_uri)
+    session_id, _ = _session(conv_store, host_store, "sb-undone", archived=False)
+    launcher = _Launcher(can_resume=True)
+
+    with patch.object(_sessions_facade, "_best_effort_stop", AsyncMock()):
+        await orchestration._archive_stop(
+            session_id,
+            conv_store,
+            runner_router=None,
+            host_registry=None,
+            host_store=host_store,
+            sandbox_config=_config(launcher),
+        )
+
+    assert launcher.terminated == []
+
+
+async def test_the_startup_sweep_covers_every_archived_session(db_uri: str) -> None:
+    """Sessions archived before this existed lose their sandbox; live ones keep it."""
+    conv_store, host_store = SqlAlchemyConversationStore(db_uri), HostStore(db_uri)
+    archived = [_session(conv_store, host_store, f"sb-old-{i}")[0] for i in range(3)]
+    _session(conv_store, host_store, "sb-live", archived=False)
+    launcher = _Launcher(can_resume=True)
+
+    deleted = await orchestration.delete_archived_session_sandboxes(
+        conv_store, host_store, _config(launcher)
+    )
+
+    assert deleted == len(archived)
+    assert sorted(launcher.terminated) == ["sb-old-0", "sb-old-1", "sb-old-2"]
