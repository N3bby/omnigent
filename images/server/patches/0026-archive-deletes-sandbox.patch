+async def _delete_archived_session_sandbox(
+    session_id: str,
+    conv: Any,
+    conversation_store: ConversationStore,
+    host_store: Any,
+    sandbox_config: Any,
+) -> bool:
+    """
+    Delete an archived session's managed sandbox, keeping the conversation.
+
+    A stopped sandbox keeps its home volume until the session is deleted, so
+    archived sessions would otherwise keep using the node's disk. Only
+    providers that keep a stopped sandbox (``resume_stopped``) are touched;
+    the others have nothing left once the runner stops.
+
+    The host row is left as it is, so an unarchived session still reads as
+    asleep: its next message tries to wake the sandbox, finds it gone, and
+    starts a fresh one with the workspace-reset notice
+    (:func:`_run_managed_wake`).
+
+    Skipped while another unarchived session is bound to the same host, such
+    as one a terminal was moved to.
+
+    :param session_id: The archived session's id.
+    :param conv: Its conversation row.
+    :param conversation_store: Store for the shared-host check.
+    :param host_store: Persistent host registrations, or ``None``.
+    :param sandbox_config: The deployment's managed-sandbox config, or
+        ``None``.
+    :returns: ``True`` when a sandbox was deleted.
+    """
+    from omnigent.server.managed_hosts import _launcher_for_teardown
+
+    if conv.host_id is None or host_store is None or sandbox_config is None:
+        return False
+    try:
+        host = await asyncio.to_thread(host_store.get_host, conv.host_id)
+        if host is None or host.sandbox_provider is None or host.sandbox_id is None:
+            return False
+        launcher = _launcher_for_teardown(host, sandbox_config)
+        if launcher is None or not launcher.capabilities.resume_stopped:
+            return False
+        # Every workspace is absolute, so "/" with subdirectories covers the host.
+        if await asyncio.to_thread(
+            conversation_store.has_other_live_session_in_workspace,
+            host_id=conv.host_id,
+            workspace="/",
+            exclude_conversation_id=session_id,
+            include_subdirectories=True,
+        ):
+            return False
+        await asyncio.to_thread(launcher.terminate, host.sandbox_id)
+    except Exception:  # noqa: BLE001 — the session stays archived either way.
+        _logger.warning(
+            "Could not delete the sandbox of archived session %s",
+            session_id,
+            exc_info=True,
+            extra={"session_id": session_id},
+        )
+        return False
+    _logger.info(
+        "Deleted sandbox %s of archived session %s",
+        host.sandbox_id,
+        session_id,
+        extra={"session_id": session_id},
+    )
+    return True
+
+
+async def delete_archived_session_sandboxes(
+    conversation_store: ConversationStore,
+    host_store: Any,
+    sandbox_config: Any,
+) -> int:
+    """
+    Delete the managed sandboxes of every session that is already archived.
+
+    Covers sessions archived before archiving deleted the sandbox, and any
+    whose teardown didn't run, such as a server restart inside the Undo
+    window. Deleting a sandbox that's already gone succeeds, so this is safe
+    to run on every start.
+
+    :param conversation_store: Store to list archived sessions from.
+    :param host_store: Persistent host registrations.
+    :param sandbox_config: The deployment's managed-sandbox config.
+    :returns: How many sessions it deleted a sandbox for.
+    """
+    deleted = 0
+    after: str | None = None
+    while True:
+        page = await asyncio.to_thread(
+            conversation_store.list_conversations,
+            limit=100,
+            after=after,
+            kind=None,
+            include_archived=True,
+            archived_only=True,
+        )
+        for conv in page.data:
+            if conv.host_id is None:
+                continue
+            # Unarchived since the page was read: leave its sandbox alone.
+            current = await asyncio.to_thread(conversation_store.get_conversation, conv.id)
+            if current is None or not current.archived:
+                continue
+            if await _delete_archived_session_sandbox(
+                conv.id, current, conversation_store, host_store, sandbox_config
+            ):
+                deleted += 1
+        if not page.has_more or page.last_id is None:
+            return deleted
+        after = page.last_id
+
+
