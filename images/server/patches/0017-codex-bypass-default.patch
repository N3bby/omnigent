--- /dev/null
+++ b/tests/server/routes/test_codex_bypass_default.py
@@ -0,0 +1,110 @@
+"""Tests for this deployment's default Codex bypass on new sessions.
+
+With ``OMNIGENT_CODEX_BYPASS_APPROVALS=1`` a new codex-native session gets
+upstream's ``omnigent.codex_native.bypass_sandbox`` label, unless it already
+chose an approval or sandbox stance itself.
+"""
+
+from __future__ import annotations
+
+import httpx
+import pytest
+
+from omnigent.server.routes._sessions.orchestration import _codex_bypass_by_default
+from omnigent.stores.conversation_store import CODEX_NATIVE_BYPASS_SANDBOX_LABEL_KEY
+
+
+@pytest.fixture
+def bypass_on(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Turn on ``codex_bypass_approvals`` for the test."""
+    monkeypatch.setenv("OMNIGENT_CODEX_BYPASS_APPROVALS", "1")
+
+
+@pytest.mark.usefixtures("bypass_on")
+def test_new_codex_session_gets_bypass() -> None:
+    """
+    A Codex session that says nothing about its stance gets bypass.
+
+    A failure here means Codex sessions run inside Codex's own sandbox, with
+    no network or tailnet, although the deployment turned bypass on.
+    """
+    assert _codex_bypass_by_default("codex-native", {}, None) is True
+    assert _codex_bypass_by_default("codex-native", {}, ["--model", "gpt-5.5"]) is True
+
+
+@pytest.mark.usefixtures("bypass_on")
+@pytest.mark.parametrize("value", ["0", "1"])
+def test_a_session_label_wins(value: str) -> None:
+    """
+    A bypass label the client set, on or off, is kept as it is.
+
+    A failure here means a user who picked Default, Full access or Read only
+    in the new-session form still gets bypass.
+    """
+    labels = {CODEX_NATIVE_BYPASS_SANDBOX_LABEL_KEY: value}
+    assert _codex_bypass_by_default("codex-native", labels, None) is False
+
+
+@pytest.mark.usefixtures("bypass_on")
+@pytest.mark.parametrize(
+    "args",
+    [
+        ["--sandbox", "read-only", "--ask-for-approval", "on-request"],
+        ["--sandbox=workspace-write"],
+        ["-a", "never"],
+        ["--full-auto"],
+    ],
+)
+def test_launch_args_with_their_own_stance_win(args: list[str]) -> None:
+    """
+    Launch args that pick an approval or sandbox stance keep it.
+
+    A failure here means bypass would strip an API client's explicit
+    ``--sandbox`` / ``--ask-for-approval`` flags.
+    """
+    assert _codex_bypass_by_default("codex-native", {}, args) is False
+
+
+@pytest.mark.usefixtures("bypass_on")
+def test_other_harnesses_are_left_alone() -> None:
+    """Only Codex gets the label; Claude's bypass works another way."""
+    assert _codex_bypass_by_default("claude-native", {}, None) is False
+
+
+@pytest.mark.parametrize("value", [None, "0", ""])
+def test_off_when_the_deployment_turns_it_off(
+    monkeypatch: pytest.MonkeyPatch, value: str | None
+) -> None:
+    """
+    Without ``codex_bypass_approvals`` new sessions keep Codex's own default.
+
+    A failure here means turning the setting off in the environment file
+    doesn't stop new Codex sessions from bypassing.
+    """
+    if value is None:
+        monkeypatch.delenv("OMNIGENT_CODEX_BYPASS_APPROVALS", raising=False)
+    else:
+        monkeypatch.setenv("OMNIGENT_CODEX_BYPASS_APPROVALS", value)
+    assert _codex_bypass_by_default("codex-native", {}, None) is False
+
+
+@pytest.mark.parametrize(("value", "expected"), [("1", True), ("0", False), (None, False)])
+async def test_info_tells_the_web_ui_the_default(
+    client: httpx.AsyncClient,
+    monkeypatch: pytest.MonkeyPatch,
+    value: str | None,
+    expected: bool,
+) -> None:
+    """
+    ``/v1/info`` says whether bypass is the default, so the form can show it.
+
+    A failure here means the new-session form shows Default for Codex while the
+    server stamps bypass on, or never says "0" when the user picks Default.
+    """
+    if value is None:
+        monkeypatch.delenv("OMNIGENT_CODEX_BYPASS_APPROVALS", raising=False)
+    else:
+        monkeypatch.setenv("OMNIGENT_CODEX_BYPASS_APPROVALS", value)
+    resp = await client.get("/v1/info")
+    assert resp.status_code == 200
+    assert resp.json()["codex_bypass_default"] is expected
