+# Codex flags that pick an approval or sandbox stance of their own.
+_CODEX_PERMISSION_FLAGS = ("--sandbox", "-s", "--ask-for-approval", "-a", "--full-auto")
+
+
+def _codex_bypass_by_default(
+    harness: str, labels: dict[str, str], launch_args: list[str] | None
+) -> bool:
+    """
+    Whether a new Codex session gets this deployment's bypass stance.
+
+    ``OMNIGENT_CODEX_BYPASS_APPROVALS=1`` (``codex_bypass_approvals``) makes
+    full bypass the default, as for Claude: the session's Pod is what
+    contains the agent, and Codex's own command sandbox would cut it off from
+    the network and the tailnet. Codex's app-server never sees the wrapper's
+    flag, so the session carries upstream's bypass label instead. A session
+    that already says what it wants keeps it: the label set to anything, or
+    launch args with their own approval or sandbox flags.
+
+    :param harness: The session's native harness, e.g. ``"codex-native"``.
+    :param labels: The labels the session is created with.
+    :param launch_args: The session's validated terminal launch args, e.g.
+        ``["--sandbox", "read-only"]``, or ``None``.
+    :returns: ``True`` when the bypass label should be added.
+    """
+    if harness != "codex-native" or os.environ.get("OMNIGENT_CODEX_BYPASS_APPROVALS") != "1":
+        return False
+    if CODEX_NATIVE_BYPASS_SANDBOX_LABEL_KEY in labels:
+        return False
+    return not any(
+        arg == flag or arg.startswith(f"{flag}=")
+        for arg in launch_args or ()
+        for flag in _CODEX_PERMISSION_FLAGS
+    )
+
