+"""Tests for this deployment's push-to-talk speech server in ``/v1/info``.
+
+``OMNIGENT_PUSH_TO_TALK_URL`` (``push_to_talk_url`` in the environment file)
+is the speech server the web composer streams the microphone to; ``/v1/info``
+passes it on, and the mic button shows only when it's set.
+"""
+
+from __future__ import annotations
+
+import httpx
+import pytest
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("wss://mac-mini.tail1234.ts.net:8443", "wss://mac-mini.tail1234.ts.net:8443"),
+        (" wss://speech.example ", "wss://speech.example"),
+        ("", None),
+        (None, None),
+    ],
+)
+async def test_info_tells_the_web_ui_the_speech_server(
+    client: httpx.AsyncClient,
+    monkeypatch: pytest.MonkeyPatch,
+    value: str | None,
+    expected: str | None,
+) -> None:
+    """
+    ``/v1/info`` says where the speech server is, or ``null`` without one.
+
+    A failure here means the composer shows no mic button although the
+    deployment set a speech server, or shows one that streams nowhere.
+    """
+    if value is None:
+        monkeypatch.delenv("OMNIGENT_PUSH_TO_TALK_URL", raising=False)
+    else:
+        monkeypatch.setenv("OMNIGENT_PUSH_TO_TALK_URL", value)
+    resp = await client.get("/v1/info")
+    assert resp.status_code == 200
+    assert resp.json()["push_to_talk_url"] == expected
