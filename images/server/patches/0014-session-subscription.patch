+++ b/tests/server/integration/test_session_subscription_usage.py
@@ -0,0 +1,72 @@
+"""The subscription account a native agent uses, as the composer reads it.
+
+The runner reports it (``tests/runner/test_subscription_record.py`` in the
+runner image's patch); the server stores it on the session and broadcasts it.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+import pytest
+
+from tests.server.helpers import create_test_agent
+
+pytestmark = pytest.mark.asyncio
+
+ACCOUNT = "42e6ad4455f84134ad3fa7ed390767aa"
+WORK = "9f0c3e1d2b7a4c5e8d6f1a2b3c4d5e6f"
+
+
+async def test_external_session_usage_records_the_subscription_account(
+    client: httpx.AsyncClient,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """``data.subscription`` lands on the session label and ``session.usage``."""
+    published: list[tuple[str, dict[str, Any]]] = []
+    monkeypatch.setattr(
+        "omnigent.server.routes.sessions.session_stream.publish",
+        lambda sid, ev: published.append((sid, ev)),
+    )
+    agent = await create_test_agent(client)
+    resp = await client.post("/v1/sessions", json={"agent_id": agent["id"]})
+    assert resp.status_code == 201, resp.text
+    sid = resp.json()["id"]
+
+    for value in (ACCOUNT, WORK):
+        resp = await client.post(
+            f"/v1/sessions/{sid}/events",
+            json={"type": "external_session_usage", "data": {"subscription": value}},
+        )
+        assert resp.status_code == 202, resp.text
+        assert published[-1][1]["type"] == "session.usage"
+        assert published[-1][1]["subscription"] == value
+        snapshot = (await client.get(f"/v1/sessions/{sid}")).json()
+        assert snapshot["labels"]["omnigent.subscription"] == value
+
+    # Alongside context usage, as one post.
+    resp = await client.post(
+        f"/v1/sessions/{sid}/events",
+        json={
+            "type": "external_session_usage",
+            "data": {"context_tokens": 1200, "subscription": ACCOUNT},
+        },
+    )
+    assert resp.status_code == 202, resp.text
+    assert published[-1][1]["subscription"] == ACCOUNT
+    assert published[-1][1]["context_tokens"] == 1200
+
+
+@pytest.mark.parametrize("bad", ["", "default", "Personal", ACCOUNT.upper(), 42])
+async def test_external_session_usage_rejects_other_subscriptions(
+    client: httpx.AsyncClient, bad: object
+) -> None:
+    agent = await create_test_agent(client)
+    resp = await client.post("/v1/sessions", json={"agent_id": agent["id"]})
+    sid = resp.json()["id"]
+    resp = await client.post(
+        f"/v1/sessions/{sid}/events",
+        json={"type": "external_session_usage", "data": {"subscription": bad}},
+    )
+    assert resp.status_code == 400, resp.text
