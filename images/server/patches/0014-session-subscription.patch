+# The subscription account the session's native agent started with: an account
+# ID from Settings → Subscriptions.
+# Read by the web composer on load; live updates ride on ``session.usage``.
+_SUBSCRIPTION_LABEL_KEY = "omnigent.subscription"
+_SUBSCRIPTION_ID_RE = re.compile(r"[0-9a-f]{32}")
+
+
+def _subscription_from_usage_data(raw: object) -> str | None:
+    """
+    Validate ``external_session_usage`` ``data.subscription``.
+
+    :param raw: An account ID such as ``"42e6ad4455f84134ad3fa7ed390767aa"``,
+        or ``None``.
+    :returns: The account, or ``None`` when absent.
+    :raises OmnigentError: When present but not an account ID.
+    """
+    if raw is None:
+        return None
+    if isinstance(raw, str) and _SUBSCRIPTION_ID_RE.fullmatch(raw):
+        return raw
+    raise OmnigentError(
+        "external_session_usage data.subscription must be an account ID",
+        code=ErrorCode.INVALID_INPUT,
+    )
+
