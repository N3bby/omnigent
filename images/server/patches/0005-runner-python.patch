Start runner Pods with the runner image's own Python.

The init container (config.yaml writer, clone credential wiring) and the
main container (the PID-1 reaper) run in a login shell, where mise's shims
come first on PATH, and called bare python3 from /home/omnigent. With Python
pinned for the home directory (mise use -g python@..., or ~/.tool-versions),
python3 was mise's interpreter, which lacks yaml, so the config writer failed,
the init container failed, and the session could never start or wake again:
the pin lives on its home volume. These commands now run RUNNER_PYTHON,
/opt/venv/bin/python3, which the runner image checks at build time.
Base: omnigent v0.15.0 (c8b9b85f822f).

diff --git a/omnigent/onboarding/sandboxes/base.py b/omnigent/onboarding/sandboxes/base.py
index 33623af..605e38c 100644
--- a/omnigent/onboarding/sandboxes/base.py
+++ b/omnigent/onboarding/sandboxes/base.py
@@ -263,6 +263,12 @@ def foreground_kill_command(pidfile: str) -> str:
 # ``default`` scope. User-created entries under OTHER names are never in the
 # marker and so are never touched. A missing or corrupt marker skips removal
 # entirely — never delete without evidence of what was injected.
+# The runner image's own Python, which has omnigent and its dependencies. Pod
+# startup runs in a login shell, where mise's shims come before it on PATH, so
+# a Python pinned for the home directory (``mise use -g python@...``) would
+# otherwise run these commands without them.
+RUNNER_PYTHON: str = "/opt/venv/bin/python3"
+
 _HOST_CONFIG_WRITE_SCRIPT: str = """\
 import base64, json, os, tempfile, yaml
 
@@ -376,7 +382,7 @@ def render_host_config_write_command(host_config: dict[str, object]) -> str:
     """
     payload = base64.b64encode(json.dumps(host_config).encode()).decode()
     script = _HOST_CONFIG_WRITE_SCRIPT.replace("__PAYLOAD__", repr(payload))
-    return f"python3 -c {shlex.quote(script)}"
+    return f"{RUNNER_PYTHON} -c {shlex.quote(script)}"
 
 
 class SandboxCapabilityError(click.ClickException, _sandbox_types.SandboxError):
