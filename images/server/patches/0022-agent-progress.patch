+++ b/tests/server/test_agent_progress.py
@@ -0,0 +1,237 @@
+"""The server side of agents' progress bars and their logs (this deployment).
+
+Runs the real app with header auth: the progress routes it mounts, the
+``session.progress`` event, the snapshot's ``progress`` field, a message from
+the user starting a new bar, and the session status ending one. The bars
+themselves are tested in the deployment repo (tests/test_agent_progress.py).
+"""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator, Iterator
+from pathlib import Path
+from typing import Any
+
+import httpx
+import omnigent_progress as progress
+import pytest
+import pytest_asyncio
+from fastapi import FastAPI
+from pydantic import TypeAdapter
+
+from omnigent.entities import Conversation
+from omnigent.runtime.agent_cache import AgentCache
+from omnigent.server.app import create_app
+from omnigent.server.auth import LEVEL_OWNER, LEVEL_READ, UnifiedAuthProvider
+from omnigent.server.routes._sessions import helpers
+from omnigent.server.schemas import ServerStreamEvent, SessionProgressEvent
+from omnigent.stores.agent_store.sqlalchemy_store import SqlAlchemyAgentStore
+from omnigent.stores.artifact_store.local import LocalArtifactStore
+from omnigent.stores.conversation_store.sqlalchemy_store import SqlAlchemyConversationStore
+from omnigent.stores.file_store.sqlalchemy_store import SqlAlchemyFileStore
+from omnigent.stores.permission_store.sqlalchemy_store import SqlAlchemyPermissionStore
+from tests.server.helpers import create_test_agent
+
+OWNER = "owner@example.test"
+READER = "reader@example.test"
+_STATUS_SESSION = "5" * 32
+
+
+@pytest.fixture(autouse=True)
+def _fresh() -> Iterator[None]:
+    progress._sessions.clear()
+    progress._logs.clear()
+    yield
+    progress._sessions.clear()
+    progress._logs.clear()
+
+
+@pytest.fixture
+def app(runtime_init: None, db_uri: str, tmp_path: Path) -> FastAPI:
+    artifact_store = LocalArtifactStore(str(tmp_path / "artifacts"))
+    return create_app(
+        agent_store=SqlAlchemyAgentStore(db_uri),
+        file_store=SqlAlchemyFileStore(db_uri),
+        conversation_store=SqlAlchemyConversationStore(db_uri),
+        artifact_store=artifact_store,
+        agent_cache=AgentCache(artifact_store=artifact_store, cache_dir=tmp_path / "cache"),
+        permission_store=SqlAlchemyPermissionStore(db_uri),
+        auth_provider=UnifiedAuthProvider(source="header", local_single_user=False),
+    )
+
+
+@pytest_asyncio.fixture
+async def client(app: FastAPI) -> AsyncIterator[httpx.AsyncClient]:
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(app=app),
+        base_url="http://test",
+        headers={"X-Forwarded-Email": OWNER},
+    ) as client:
+        yield client
+    await app.state.background_title_coordinator.shutdown()
+
+
+@pytest_asyncio.fixture
+async def session(db_uri: str, client: httpx.AsyncClient) -> Conversation:
+    agent = await create_test_agent(client)
+    session = SqlAlchemyConversationStore(db_uri).create_conversation(
+        kind="default", title="Progress", agent_id=agent["id"]
+    )
+    permissions = SqlAlchemyPermissionStore(db_uri)
+    permissions.grant(OWNER, session.id, LEVEL_OWNER)
+    permissions.grant(READER, session.id, LEVEL_READ)
+    return session
+
+
+async def test_a_bar_is_published_and_in_the_snapshot(
+    client: httpx.AsyncClient, session: Conversation, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from omnigent.server.routes._sessions import common
+
+    events: list[dict[str, Any]] = []
+    real_publish = common.session_stream.publish
+    monkeypatch.setattr(
+        common.session_stream,
+        "publish",
+        lambda sid, event: (events.append(event), real_publish(sid, event))[1],
+    )
+
+    response = await client.post(
+        f"/v1/sessions/{session.id}/progress", json={"label": "Running tests", "percent": 40}
+    )
+
+    assert response.status_code == 200, response.text
+    bar = response.json()["progress"]
+    assert bar["label"] == "Running tests"
+    assert bar["percent"] == 40.0
+    assert bar["id"].startswith("bar_")
+    progress_events = [e for e in events if e["type"] == "session.progress"]
+    assert progress_events[-1]["progress"] == [bar]
+    snapshot = (await client.get(f"/v1/sessions/{session.id}?include_items=false")).json()
+    assert snapshot["progress"] == [bar]
+
+
+async def test_a_reader_can_read_a_log_but_not_set_a_bar(
+    app: FastAPI, client: httpx.AsyncClient, session: Conversation
+) -> None:
+    bar = (
+        await client.post(
+            f"/v1/sessions/{session.id}/progress",
+            json={"label": "Dev server on :5173", "log_file": "/home/omnigent/dev.log"},
+        )
+    ).json()["progress"]
+    added = await client.post(
+        f"/v1/sessions/{session.id}/progress/{bar['id']}/log",
+        json={"lines": ["VITE v6 ready in 312 ms", "➜  Local: http://localhost:5173/"]},
+    )
+    assert added.json() == {"kept": True}
+
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(app=app),
+        base_url="http://test",
+        headers={"X-Forwarded-Email": READER},
+    ) as reader:
+        page = (await reader.get(f"/v1/sessions/{session.id}/progress/{bar['id']}/log")).json()
+        later = (
+            await reader.get(f"/v1/sessions/{session.id}/progress/{bar['id']}/log?after=1")
+        ).json()
+        refused = await reader.post(
+            f"/v1/sessions/{session.id}/progress", json={"label": "Not mine"}
+        )
+
+    assert [line["text"] for line in page["lines"]] == [
+        "VITE v6 ready in 312 ms",
+        "➜  Local: http://localhost:5173/",
+    ]
+    assert page["log_files"] == ["/home/omnigent/dev.log"]
+    assert [line["seq"] for line in later["lines"]] == [2]
+    assert refused.status_code == 403
+    snapshot = (await client.get(f"/v1/sessions/{session.id}?include_items=false")).json()
+    assert snapshot["progress"][0]["has_log"] is True
+
+
+async def test_lines_for_a_bar_that_is_gone_say_so(
+    client: httpx.AsyncClient, session: Conversation
+) -> None:
+    added = await client.post(
+        f"/v1/sessions/{session.id}/progress/bar_gone/log", json={"lines": ["x"]}
+    )
+    missing = await client.get(f"/v1/sessions/{session.id}/progress/bar_gone/log")
+
+    assert added.json() == {"kept": False}
+    assert missing.status_code == 404
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        {"percent": 10},
+        {"label": "  "},
+        {"label": "Building", "percent": 101},
+        {"label": "Building", "percent": "half"},
+        {"label": "Building", "clear": "yes"},
+        {"label": "Building", "log_file": "dev.log"},
+        [1, 2],
+    ],
+)
+async def test_a_malformed_update_is_refused_with_why(
+    client: httpx.AsyncClient, session: Conversation, body: Any
+) -> None:
+    response = await client.post(f"/v1/sessions/{session.id}/progress", json=body)
+
+    assert response.status_code == 422
+    assert response.json()["detail"]
+    assert progress.snapshot(session.id) is None
+
+
+async def test_malformed_log_lines_are_refused(
+    client: httpx.AsyncClient, session: Conversation
+) -> None:
+    response = await client.post(
+        f"/v1/sessions/{session.id}/progress/bar_x/log", json={"lines": "one line"}
+    )
+    assert response.status_code == 422
+
+
+async def test_a_message_from_the_user_starts_a_new_bar(
+    client: httpx.AsyncClient, session: Conversation
+) -> None:
+    await client.post(f"/v1/sessions/{session.id}/progress", json={"label": "Migrating (3/10)"})
+    # No runner serves this session, so the message itself goes nowhere; the
+    # server has seen it by then.
+    await client.post(
+        f"/v1/sessions/{session.id}/events",
+        json={
+            "type": "message",
+            "data": {"role": "user", "content": [{"type": "input_text", "text": "Also docs"}]},
+        },
+    )
+    await client.post(f"/v1/sessions/{session.id}/progress", json={"label": "Writing docs"})
+
+    bars = progress.snapshot(session.id)
+    assert bars is not None
+    assert [bar["label"] for bar in bars] == ["Migrating (3/10)", "Writing docs"]
+
+
+def test_the_session_status_ends_a_bar(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(helpers.session_live_state, "persist_live_status", lambda *_a: None)
+    monkeypatch.setattr(
+        helpers.session_live_state, "persist_scheduled_run_completion", lambda *_a, **_k: None
+    )
+    monkeypatch.setattr(helpers.session_stream, "publish", lambda *_a: None)
+    progress.update(_STATUS_SESSION, {"label": "Migrating", "percent": 50})
+
+    helpers._publish_status(_STATUS_SESSION, "idle")
+
+    bars = progress.snapshot(_STATUS_SESSION)
+    assert bars is not None
+    assert bars[-1]["outcome"] == "done"
+    assert bars[-1]["ended_at"] is not None
+
+
+def test_the_event_validates() -> None:
+    bar = {"id": "bar_1", "label": "Running tests", "percent": None}
+    event = SessionProgressEvent(type="session.progress", conversation_id="c", progress=[bar])
+    adapter: TypeAdapter[ServerStreamEvent] = TypeAdapter(ServerStreamEvent)
+
+    assert isinstance(adapter.validate_python(event.model_dump()), SessionProgressEvent)
