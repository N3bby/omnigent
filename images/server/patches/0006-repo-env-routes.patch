Mount the repository variables routes behind Settings → Repository variables.

The router is this deployment's omnigent_repo_env_api module, which the server
image installs next to omnigent_repo_env. Admin checks use the same sources as
/v1/me's is_admin, so the Settings nav and the routes agree.
Base: omnigent v0.15.0 (c8b9b85f822f).

diff --git a/omnigent/server/app.py b/omnigent/server/app.py
index 8b7e6c2..f9c345c 100644
--- a/omnigent/server/app.py
+++ b/omnigent/server/app.py
@@ -116,6 +116,7 @@ from omnigent.server.routes.sessions import (
     set_server_runner_router,
 )
 from omnigent.server.routes.sharing import create_sharing_router
+from omnigent_repo_env_api import create_repo_env_router
 from omnigent.server.routes.terminal_attach import create_terminal_attach_router
 from omnigent.server.routes.usage import create_usage_router
 from omnigent.server.runner_session_init import RunnerSessionInitializer
@@ -3217,6 +3218,20 @@ def create_app(
         prefix="/v1",
         tags=["sharing"],
     )
+    # This deployment's repository variables, behind Settings → Repository
+    # variables. Admin checks match /v1/me's is_admin, like the sharing gate.
+    app.include_router(
+        create_repo_env_router(
+            auth_provider=auth_provider,
+            is_admin=lambda user_id: (
+                (permission_store is not None and permission_store.is_admin(user_id))
+                or admin_list.is_admin(user_id)
+            ),
+            multi_user=permission_store is not None,
+        ),
+        prefix="/v1",
+        tags=["repo_env"],
+    )
     # First-class projects (owner-private session containers). Mounted only
