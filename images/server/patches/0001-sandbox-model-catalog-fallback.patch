--- /dev/null
+++ b/omnigent/server/sandbox_catalog_fallback.py
@@ -0,0 +1,94 @@
+"""Last live native model catalog per harness, reused as a managed-sandbox preview.
+
+Subscription CLI logins expose no server-side model listing, so a managed
+sandbox's new-session picker has nothing to show until a runner probes the
+harness. When ``OMNIGENT_SANDBOX_CATALOG_FALLBACK_PATH`` names a writable JSON
+file, the catalog a runner last reported for a harness is kept there and served
+as that preview. Launch still validates the pick inside the sandbox.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import tempfile
+import threading
+from pathlib import Path
+from typing import Any
+
+from omnigent.inference_config import normalize_inference_harness
+from omnigent.native.native_coding_agents import native_coding_agent_for_wrapper_label
+
+PATH_ENV_VAR = "OMNIGENT_SANDBOX_CATALOG_FALLBACK_PATH"
+
+_logger = logging.getLogger(__name__)
+_lock = threading.Lock()
+_catalogs: dict[str, list[dict[str, Any]]] | None = None
+
+
+def _path() -> Path | None:
+    raw = os.environ.get(PATH_ENV_VAR, "").strip()
+    return Path(raw) if raw else None
+
+
+def enabled() -> bool:
+    return _path() is not None
+
+
+def _loaded(path: Path) -> dict[str, list[dict[str, Any]]]:
+    global _catalogs
+    if _catalogs is None:
+        try:
+            raw = json.loads(path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            raw = {}
+        except (OSError, ValueError):
+            _logger.warning("Ignoring unreadable sandbox model catalogs at %s", path, exc_info=True)
+            raw = {}
+        _catalogs = {
+            str(harness): [row for row in rows if isinstance(row, dict)]
+            for harness, rows in (raw.items() if isinstance(raw, dict) else ())
+            if isinstance(rows, list)
+        }
+    return _catalogs
+
+
+def _write(path: Path, catalogs: dict[str, list[dict[str, Any]]]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(catalogs, handle)
+        os.replace(tmp, path)
+    except BaseException:
+        Path(tmp).unlink(missing_ok=True)
+        raise
+
+
+def record(wrapper: str | None, options: list[dict[str, Any]]) -> None:
+    """Remember a runner-reported catalog for the session wrapper's harness."""
+    path = _path()
+    agent = native_coding_agent_for_wrapper_label(wrapper)
+    if path is None or agent is None or not options:
+        return
+    harness = normalize_inference_harness(agent.harness)
+    with _lock:
+        catalogs = _loaded(path)
+        if catalogs.get(harness) == options:
+            return
+        catalogs[harness] = list(options)
+        try:
+            _write(path, catalogs)
+        except OSError:
+            _logger.warning("Could not persist sandbox model catalogs to %s", path, exc_info=True)
+
+
+def lookup(harness: str) -> list[dict[str, Any]] | None:
+    """Return the last recorded catalog for ``harness``, or ``None``."""
+    path = _path()
+    if path is None:
+        return None
+    with _lock:
+        rows = _loaded(path).get(normalize_inference_harness(harness))
+    return list(rows) if rows else None
