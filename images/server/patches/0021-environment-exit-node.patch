+class ExitNode(BaseModel):
+    """The tailnet exit node the session's repositories name, as the runner finds it.
+
+    ``connected`` and ``offline`` say whether the exit node is online; ``off``
+    that the Pod doesn't use it, such as after the agent switched it off;
+    ``failed`` that Tailscale refused it (``error`` says why); ``conflict`` that
+    the repositories name different ones (``names``), so the Pod uses none; and
+    ``unknown`` that tailscaled didn't answer.
+    """
+
+    state: Literal["connected", "offline", "off", "failed", "conflict", "unknown"]
+    name: str | None = Field(default=None, max_length=253)
+    names: list[Annotated[str, Field(max_length=253)]] = Field(default_factory=list, max_length=16)
+    error: str | None = Field(default=None, max_length=1000)
+
