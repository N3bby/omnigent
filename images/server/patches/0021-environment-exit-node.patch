@@ -0,0 +1,79 @@
+"""The environment menu's exit node: the runner reports it, the menu reads it back.
+
+The runner reports the tailnet exit node the session's repositories name with
+its other numbers (``omnigent/runner/environment_report.py``).
+"""
+
+from __future__ import annotations
+
+import httpx
+import pytest
+
+from omnigent.runner.identity import RUNNER_TUNNEL_TOKEN_HEADER, token_bound_runner_id
+from omnigent.server.routes.sessions import routes_environment
+from omnigent.stores.conversation_store.sqlalchemy_store import SqlAlchemyConversationStore
+from tests.server.helpers import create_test_agent
+
+pytestmark = pytest.mark.asyncio
+
+TOKEN = "runner-binding-token-for-tests"
+REPORT = {"cpu_cores": 0.5, "memory_bytes": 1_000_000, "agent_active": False}
+
+
+@pytest.fixture(autouse=True)
+def _no_reports(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(routes_environment, "_reports", {})
+
+
+async def _session(client: httpx.AsyncClient, db_uri: str) -> str:
+    """A session bound to the runner holding ``TOKEN``."""
+    agent = await create_test_agent(client)
+    resp = await client.post("/v1/sessions", json={"agent_id": agent["id"]})
+    assert resp.status_code == 201, resp.text
+    session_id = resp.json()["id"]
+    SqlAlchemyConversationStore(db_uri).replace_runner_id(session_id, token_bound_runner_id(TOKEN))
+    return session_id
+
+
+async def _report(client: httpx.AsyncClient, session_id: str, body: dict) -> httpx.Response:
+    return await client.post(
+        f"/v1/sessions/{session_id}/environment/report",
+        json=body,
+        headers={RUNNER_TUNNEL_TOKEN_HEADER: TOKEN},
+    )
+
+
+@pytest.mark.parametrize(
+    "exit_node",
+    [
+        {"state": "connected", "name": "cronos-vpn", "names": []},
+        {"state": "offline", "name": "cronos-vpn", "names": []},
+        {"state": "conflict", "names": ["cronos-vpn", "office-exit"]},
+        {"state": "failed", "name": "no-such-node", "names": [], "error": "no node found"},
+    ],
+)
+async def test_the_exit_node_reaches_the_menu(
+    client: httpx.AsyncClient, db_uri: str, exit_node: dict
+) -> None:
+    session_id = await _session(client, db_uri)
+    resp = await _report(client, session_id, {**REPORT, "exit_node": exit_node})
+    assert resp.status_code == 200, resp.text
+    env = (await client.get(f"/v1/sessions/{session_id}/environment")).json()
+    assert env["exit_node"] == exit_node
+
+
+async def test_without_an_exit_node_the_menu_gets_none(
+    client: httpx.AsyncClient, db_uri: str
+) -> None:
+    # Also what a runner from before exit nodes sends.
+    session_id = await _session(client, db_uri)
+    assert (await _report(client, session_id, REPORT)).status_code == 200
+    env = (await client.get(f"/v1/sessions/{session_id}/environment")).json()
+    assert env["cpu_cores"] == 0.5
+    assert "exit_node" not in env
+
+
+async def test_an_unknown_state_is_refused(client: httpx.AsyncClient, db_uri: str) -> None:
+    session_id = await _session(client, db_uri)
+    resp = await _report(client, session_id, {**REPORT, "exit_node": {"state": "maybe"}})
+    assert resp.status_code == 422, resp.text
