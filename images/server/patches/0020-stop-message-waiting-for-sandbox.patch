+# Messages waiting for their session's sandbox to start, by session id: each
+# waits until its event is set, which Stop does.
+_messages_waiting_for_sandbox: WorkspaceScopedCache[str, set[asyncio.Event]] = (
+    WorkspaceScopedCache()
+)
+
+
+async def _await_sandbox_unless_stopped(session_id: str, launch: Any) -> None:
+    """
+    Wait for a starting sandbox, as ``_await_settled_managed_launch`` does,
+    unless Stop takes the message back first.
+
+    The web UI posts a session's first message as soon as it's created, so the
+    message is safe on the server if the browser goes away, and Stop during the
+    start still means it never runs.
+
+    :param session_id: Session/conversation identifier.
+    :param launch: The session's ``ManagedLaunch``.
+    :raises OmnigentError: The launch's failure, or a conflict when Stop came
+        first.
+    """
+    stopped = asyncio.Event()
+    waiting = _messages_waiting_for_sandbox.get(session_id)
+    if waiting is None:
+        waiting = _messages_waiting_for_sandbox[session_id] = set()
+    waiting.add(stopped)
+    started = asyncio.ensure_future(_await_settled_managed_launch(launch))
+    stop = asyncio.ensure_future(stopped.wait())
+    try:
+        await asyncio.wait({started, stop}, return_when=asyncio.FIRST_COMPLETED)
+    finally:
+        stop.cancel()
+        waiting.discard(stopped)
+        if not waiting and _messages_waiting_for_sandbox.get(session_id) is waiting:
+            del _messages_waiting_for_sandbox[session_id]
+        if not started.done():
+            started.cancel()
+    if not started.done():
+        raise OmnigentError(
+            "Stopped before the sandbox started, so the message wasn't sent.",
+            code=ErrorCode.CONFLICT,
+        )
+    started.result()
+
+
+def _stop_messages_waiting_for_sandbox(session_id: str) -> None:
+    """
+    Take back the messages still waiting for *session_id*'s sandbox to start.
+
+    :param session_id: Session/conversation identifier.
+    """
+    for stopped in _messages_waiting_for_sandbox.get(session_id, set()):
+        stopped.set()
+
 
