diff --git a/tests/server/integration/test_message_waiting_for_sandbox.py b/tests/server/integration/test_message_waiting_for_sandbox.py
new file mode 100644
index 000000000..02dc88b3f
--- /dev/null
+++ b/tests/server/integration/test_message_waiting_for_sandbox.py
@@ -0,0 +1,134 @@
+"""A session's first message waits on the server while its sandbox starts.
+
+The web UI posts it as soon as the session exists, so closing the app during
+the start doesn't lose it. Stop during the start still takes it back.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import threading
+from collections.abc import Callable
+
+import pytest
+from asgiref.testing import ApplicationCommunicator
+
+from omnigent.server.routes._sessions.orchestration import _session_is_starting
+from tests.server.helpers import (
+    FakeSandboxLauncher,
+    create_test_agent,
+    install_fake_modal_launcher,
+)
+from tests.server.integration.test_host_session_binding import (
+    ManagedSessionEnv,
+    managed_session_env,  # noqa: F401 - fixture
+)
+
+pytestmark = pytest.mark.asyncio
+
+_MESSAGE = {
+    "type": "message",
+    "data": {"role": "user", "content": [{"type": "input_text", "text": "hello sandbox"}]},
+}
+
+
+async def _start_session(
+    env: ManagedSessionEnv, monkeypatch: pytest.MonkeyPatch
+) -> tuple[str, threading.Event]:
+    """Create a managed session whose sandbox is held mid-start, and its gate."""
+    gate = threading.Event()
+    install_fake_modal_launcher(
+        monkeypatch, FakeSandboxLauncher(provision_gate=gate, fail_on_host_start=True)
+    )
+    agent = await create_test_agent(env.client, name="waiting-message-agent")
+    resp = await env.client.post(
+        "/v1/sessions", json={"agent_id": agent["id"], "host_type": "managed"}
+    )
+    assert resp.status_code == 201, resp.text
+    return resp.json()["id"], gate
+
+
+async def _wait_until(condition: Callable[[], bool], timeout_s: float = 5.0) -> None:
+    deadline = asyncio.get_running_loop().time() + timeout_s
+    while not condition():
+        assert asyncio.get_running_loop().time() < deadline, "condition never held"
+        await asyncio.sleep(0.02)
+
+
+def _post_scope(path: str, body: bytes) -> dict[str, object]:
+    return {
+        "type": "http",
+        "asgi": {"version": "3.0"},
+        "http_version": "1.1",
+        "method": "POST",
+        "scheme": "http",
+        "path": path,
+        "raw_path": path.encode(),
+        "root_path": "",
+        "query_string": b"",
+        "headers": [
+            (b"host", b"test"),
+            (b"content-type", b"application/json"),
+            (b"content-length", str(len(body)).encode()),
+        ],
+        "client": ("127.0.0.1", 50000),
+        "server": ("test", 80),
+    }
+
+
+async def test_a_waiting_message_outlives_a_client_that_disconnects(
+    managed_session_env: ManagedSessionEnv,  # noqa: F811
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    env = managed_session_env
+    session_id, gate = await _start_session(env, monkeypatch)
+    body = json.dumps(_MESSAGE).encode()
+    client = ApplicationCommunicator(
+        env.app, _post_scope(f"/v1/sessions/{session_id}/events", body)
+    )
+    await client.send_input({"type": "http.request", "body": body, "more_body": False})
+    await _wait_until(lambda: _session_is_starting(session_id))
+
+    # The phone app closes. The message keeps waiting for the sandbox.
+    await client.send_input({"type": "http.disconnect"})
+    await asyncio.sleep(0.3)
+    assert _session_is_starting(session_id)
+
+    # It finishes once the start settles (here, failed).
+    gate.set()
+    await _wait_until(lambda: not _session_is_starting(session_id), timeout_s=15.0)
+    response = await client.receive_output(timeout=5.0)
+    assert response["type"] == "http.response.start"
+    assert response["status"] == 503
+
+
+async def test_stop_takes_back_a_message_waiting_for_the_sandbox(
+    managed_session_env: ManagedSessionEnv,  # noqa: F811
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    env = managed_session_env
+    session_id, gate = await _start_session(env, monkeypatch)
+    message = asyncio.create_task(
+        env.client.post(f"/v1/sessions/{session_id}/events", json=_MESSAGE)
+    )
+    await _wait_until(lambda: _session_is_starting(session_id))
+
+    stop = await env.client.post(f"/v1/sessions/{session_id}/events", json={"type": "interrupt"})
+    assert stop.status_code < 400, stop.text
+
+    resp = await asyncio.wait_for(message, timeout=5.0)
+    # A coded refusal, so the web UI gives the draft back.
+    assert resp.status_code == 409, resp.text
+    assert "Stopped before the sandbox started" in resp.text
+    assert not _session_is_starting(session_id)
+
+    # A message sent after Stop waits for the sandbox as usual.
+    later = asyncio.create_task(
+        env.client.post(f"/v1/sessions/{session_id}/events", json=_MESSAGE)
+    )
+    await _wait_until(lambda: _session_is_starting(session_id))
+    gate.set()
+    resp = await asyncio.wait_for(later, timeout=15.0)
+    assert resp.status_code == 503, resp.text
+    assert "managed sandbox failed to launch" in resp.text
