+"""Native settings commands never become pending prompts or routed turns."""
+
+import pytest
+from fastapi import HTTPException
+
+from omnigent.runtime import pending_inputs
+from omnigent.server.routes._sessions.orchestration import _dispatch_session_event_to_runner_impl
+from omnigent.server.schemas import SessionEventInput
+from tests.server.routes.test_session_resources import _ConversationStore, _FakeRunnerClient
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("wrapper", ["claude-code-native-ui", "codex-native-ui"])
+@pytest.mark.parametrize("fail", [False, True])
+async def test_fast_command_skips_pending_inputs_and_routing(wrapper, fail):
+    pending_inputs.reset_for_tests()
+    store = _ConversationStore()
+    conv_id = "64a784c3aa907d1774f44313546947c6"
+    conv = store.get_conversation(conv_id)
+    assert conv is not None
+    conv.labels["omnigent.wrapper"] = wrapper
+    conv.cost_control_mode_override = "on"
+    event_path = f"/v1/sessions/{conv_id}/events"
+    client = _FakeRunnerClient(responses={event_path: (503, {})} if fail else {})
+    body = SessionEventInput(
+        type="message",
+        data={
+            "role": "user",
+            "content": [{"type": "input_text", "text": "/fast on"}],
+        },
+    )
+
+    async def dispatch():
+        return await _dispatch_session_event_to_runner_impl(
+            conv_id,
+            conv,
+            body,
+            store,
+            client,
+            agent_name=wrapper,
+            file_store=None,
+            artifact_store=None,
+            native_terminal_ready=True,
+        )
+
+    try:
+        if fail:
+            with pytest.raises(HTTPException):
+                await dispatch()
+        else:
+            result = await dispatch()
+            assert result.pending_id is None
+            assert result.item_id is None
+        assert pending_inputs.snapshot_for(conv_id) == []
+        assert store.appended_items == []
+        assert [call[0] for call in client.post_json_calls] == [event_path]
+        assert client.post_json_calls[0][1]["content"] == body.data["content"]
+    finally:
+        pending_inputs.reset_for_tests()
