+/**
+ * The text a pick from the ``@`` menu writes into the composer: ``@src/app.ts``,
+ * ``@src/`` for a whole folder, and ``@"my notes.md"`` when the path has a
+ * space, the forms Claude Code's own ``@`` mentions take. Claude Code reads
+ * the file when the message reaches it; other agents see the path.
+ */
+export function mentionToken(path: string, isDir: boolean): string {
+  const target = isDir ? `${path}/` : path;
+  return /\s/.test(target) ? `@"${target}"` : `@${target}`;
+}
+
+// An "@" mention: at the start or after whitespace, then a quoted path or a
+// run without whitespace. Sentence punctuation after it isn't part of the path.
+const MENTION_PATH_RE = /(^|\s)(@(?:"([^"\n]+)"|([^\s@`"]+?)))(?=[.,;:!?)\]]*(?:\s|$))/g;
+// Fenced code blocks and inline code spans, which keep their text as is.
+const CODE_FENCE_RE = /^ {0,3}(`{3,}|~{3,})/;
+const INLINE_CODE_RE = /(`+)[^`]*?\1/g;
+
+/** A run of text, or an ``@`` path mention with the path it names. */
+export interface MentionSegment {
+  text: string;
+  path?: string;
+}
+
+/**
+ * Split text into plain runs and ``@`` path mentions, for showing mentions
+ * apart from the rest. Only path-shaped mentions count (one with a ``/`` or
+ * ``.``, or a quoted one), so ``@alice`` stays prose. Text in code blocks and
+ * code spans is left alone. Joining every segment's ``text`` gives the input.
+ */
+export function mentionSegments(text: string): MentionSegment[] {
+  const out: MentionSegment[] = [];
+  const plain = (t: string) => {
+    if (!t) return;
+    const last = out[out.length - 1];
+    if (last && last.path === undefined) last.text += t;
+    else out.push({ text: t });
+  };
+  const prose = (t: string) => {
+    let last = 0;
+    for (const m of t.matchAll(MENTION_PATH_RE)) {
+      const path = m[3] ?? m[4] ?? "";
+      if (m[3] === undefined && !/[/.]/.test(path)) continue;
+      const at = m.index + m[1].length;
+      plain(t.slice(last, at));
+      out.push({ text: m[2], path });
+      last = at + m[2].length;
+    }
+    plain(t.slice(last));
+  };
+  let fence: string | null = null;
+  text.split("\n").forEach((line, i) => {
+    if (i > 0) plain("\n");
+    const opener = CODE_FENCE_RE.exec(line)?.[1];
+    if (fence) {
+      if (opener && opener[0] === fence[0] && opener.length >= fence.length) fence = null;
+      plain(line);
+      return;
+    }
+    if (opener) {
+      fence = opener;
+      plain(line);
+      return;
+    }
+    let last = 0;
+    for (const span of line.matchAll(INLINE_CODE_RE)) {
+      prose(line.slice(last, span.index));
+      plain(span[0]);
+      last = span.index + span[0].length;
+    }
+    prose(line.slice(last));
+  });
+  return out;
+}
+
+/**
+ * Show each ``@path`` mention in a sent message as an inline code path, so the
+ * user bubble draws it like one, opens the file when clicked, and Markdown
+ * can't read a ``__init__.py`` as bold.
+ */
+export function markMentionPaths(text: string): string {
+  if (!text.includes("@")) return text;
+  return mentionSegments(text)
+    .map((s) => (s.path === undefined ? s.text : `@\`${s.path}\``))
+    .join("");
+}
