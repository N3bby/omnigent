@@ -0,0 +1,85 @@
+import { type ReactNode, type RefObject, useLayoutEffect, useRef } from "react";
+
+import { mentionSegments } from "@/lib/composerMentions";
+
+/**
+ * How an ``@`` path mention looks in the composer. Colour and background only:
+ * padding or a bolder weight would change the text's width and move the
+ * textarea's caret away from the letters drawn here.
+ */
+const MENTION_CLASS =
+  "rounded-sm bg-brand-accent/15 text-brand-accent [box-decoration-break:clone]";
+
+/** True when the text has an ``@`` path mention to highlight. */
+export function hasMentionPaths(text: string): boolean {
+  return text.includes("@") && mentionSegments(text).some((s) => s.path !== undefined);
+}
+
+/** The text with each ``@`` path mention wrapped in a highlight. */
+export function MentionHighlights({ text }: { text: string }): ReactNode {
+  let offset = 0;
+  return mentionSegments(text).map((s) => {
+    const at = offset;
+    offset += s.text.length;
+    if (s.path === undefined) return s.text;
+    return (
+      <span key={at} data-composer-mention={s.path} className={MENTION_CLASS}>
+        {s.text}
+      </span>
+    );
+  });
+}
+
+/**
+ * A copy of the composer's text drawn behind its textarea, for colouring parts
+ * of it: a textarea paints all its text one colour, so the caller makes the
+ * textarea's text transparent (keeping its caret) while this is mounted.
+ * ``children`` is ``text`` drawn with its highlights. It takes the textarea's
+ * exact box and typography, and its scroll, so every letter lands under the
+ * textarea's own, however the theme pads the composer.
+ */
+export function ComposerHighlightBackdrop({
+  text,
+  textarea,
+  children,
+  ...props
+}: {
+  text: string;
+  textarea: RefObject<HTMLTextAreaElement | null>;
+  children: ReactNode;
+  "data-testid"?: string;
+}) {
+  const ref = useRef<HTMLDivElement>(null);
+  useLayoutEffect(() => {
+    const ta = textarea.current;
+    const copy = ref.current;
+    if (!ta || !copy) return;
+    const place = () => {
+      copy.style.top = `${ta.offsetTop}px`;
+      copy.style.left = `${ta.offsetLeft}px`;
+      copy.style.width = `${ta.clientWidth}px`;
+      copy.style.height = `${ta.clientHeight}px`;
+      copy.scrollTop = ta.scrollTop;
+    };
+    place();
+    const resized = new ResizeObserver(place);
+    resized.observe(ta);
+    ta.addEventListener("scroll", place);
+    return () => {
+      resized.disconnect();
+      ta.removeEventListener("scroll", place);
+    };
+  }, [textarea, text]);
+  return (
+    <div
+      ref={ref}
+      aria-hidden
+      className="composer-input-text pointer-events-none absolute overflow-hidden whitespace-pre-wrap break-words text-ui text-foreground"
+      {...props}
+    >
+      {children}
+      {/* A last empty line still takes its height, as in the textarea. */}
+      {text.endsWith("\n") && " "}
+    </div>
+  );
+}
