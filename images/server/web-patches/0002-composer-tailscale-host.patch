diff --git a/web/src/lib/tailscale.ts b/web/src/lib/tailscale.ts
new file mode 100644
index 0000000..c5754fc
--- /dev/null
+++ b/web/src/lib/tailscale.ts
@@ -0,0 +1,33 @@
+/**
+ * The tailnet name of a managed session's runner Pod, e.g.
+ * `omnigent-e1dcab9b.tail1234.ts.net`. The deployment's runner image joins
+ * Tailscale under it, so a device on the tailnet can reach the Pod by name.
+ */
+
+/** Session label holding the name, for a reload before any update. */
+export const TAILSCALE_HOST_LABEL_KEY = "omnigent.tailscale_host";
+
+const DNS_NAME =
+  /^(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/;
+
+/**
+ * Parse a wire tailnet name (`session.tailscale` event or the session label).
+ *
+ * @param raw - e.g. `"omnigent-e1dcab9b.tail1234.ts.net"`.
+ * @returns The lowercased name, or `null` when absent or not a DNS name.
+ */
+export function parseTailscaleHost(raw: unknown): string | null {
+  if (typeof raw !== "string") return null;
+  const host = raw.trim().toLowerCase().replace(/\.$/, "");
+  return DNS_NAME.test(host) ? host : null;
+}
+
+/** Read the session label; anything unusable reads as no name. */
+export function tailscaleHostFromLabels(labels: Record<string, string> | undefined): string | null {
+  return parseTailscaleHost(labels?.[TAILSCALE_HOST_LABEL_KEY]);
+}
+
+/** The MagicDNS short name, e.g. `"omnigent-e1dcab9b"`. */
+export function tailscaleShortName(host: string): string {
+  return host.split(".", 1)[0];
+}
