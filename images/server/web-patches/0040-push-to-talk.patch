diff --git a/web/src/pushToTalk.css b/web/src/pushToTalk.css
new file mode 100644
index 0000000..54bf76d
--- /dev/null
+++ b/web/src/pushToTalk.css
@@ -0,0 +1,251 @@
+/* Push-to-talk in the composer (components/PushToTalk.tsx).
+ *
+ * While a take runs, the composer card carries data-ptt-state ("listening",
+ * then "finishing"): its tools give way to the listening bar, only the bar
+ * and the buttons marked data-ptt-keep stay, and its edge darkens a little.
+ * For a moment after, it says "ended" while the tools fade back in. The bar
+ * is never taller than the buttons, so the card keeps its height throughout.
+ * --ptt-level (0–1, set every frame) is how loud the microphone is. */
+
+[data-composer-card][data-ptt-state="listening"],
+[data-composer-card][data-ptt-state="finishing"] {
+  border-color: color-mix(in srgb, var(--foreground) 28%, transparent);
+}
+
+[data-composer-card]:is([data-ptt-state="listening"], [data-ptt-state="finishing"])
+  [data-composer-group="left"] {
+  display: none;
+}
+
+[data-composer-card]:is([data-ptt-state="listening"], [data-ptt-state="finishing"])
+  [data-composer-group="right"] {
+  flex: 1 1 auto;
+  margin-left: 0;
+}
+
+[data-composer-card]:is([data-ptt-state="listening"], [data-ptt-state="finishing"])
+  [data-composer-group="right"]
+  > :not([data-ptt-keep]) {
+  display: none;
+}
+
+[data-composer-card][data-ptt-state="ended"] [data-composer-group] > :not([data-ptt-keep]) {
+  animation: ptt-fade-in 0.25s ease both;
+}
+
+/* ---- The listening bar ---------------------------------------------------- */
+
+.ptt-bar {
+  display: flex;
+  flex: 1 1 auto;
+  align-items: center;
+  gap: 0.625rem;
+  min-width: 0;
+  /* Clear of the mic button, which grows and gets a halo while you talk. */
+  margin-right: 0.5rem;
+  padding-left: 0.25rem;
+  overflow: hidden;
+  font-size: 0.8125rem;
+  white-space: nowrap;
+}
+
+/* After a take: pinned where it was (PushToTalkBar sets the box) and fading
+ * out over the tools, which fade in underneath. */
+.ptt-bar[data-ptt-state="ended"] {
+  position: absolute;
+  z-index: 1;
+  margin: 0;
+  pointer-events: none;
+  animation: ptt-fade-out 0.2s ease both;
+}
+
+.ptt-rec {
+  flex: none;
+  width: 0.5rem;
+  height: 0.5rem;
+  border-radius: 999px;
+  background: var(--destructive);
+  animation: ptt-rec 1.2s ease-in-out infinite;
+}
+
+.ptt-bar:is([data-ptt-state="finishing"], [data-ptt-state="ended"]) .ptt-rec {
+  background: var(--muted-foreground);
+  animation: none;
+}
+
+.ptt-label {
+  font-weight: 500;
+}
+
+.ptt-bar:is([data-ptt-state="finishing"], [data-ptt-state="ended"]) .ptt-label {
+  background: linear-gradient(
+      90deg,
+      var(--muted-foreground) 30%,
+      var(--foreground) 50%,
+      var(--muted-foreground) 70%
+    )
+    0 0 / 200% 100%;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  animation: ptt-shimmer 1.2s linear infinite;
+}
+
+.ptt-timer {
+  color: var(--muted-foreground);
+  font-variant-numeric: tabular-nums;
+}
+
+.ptt-wave {
+  flex: 1 1 auto;
+  min-width: 2.5rem;
+  height: 1.5rem;
+  color: var(--foreground);
+}
+
+.ptt-chip {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  gap: 0.3rem;
+  padding: 0.125rem 0.5rem;
+  border-radius: 999px;
+  background: var(--muted);
+  color: var(--muted-foreground);
+  font-size: 0.75rem;
+}
+
+.ptt-hint {
+  flex: none;
+  color: var(--muted-foreground);
+  font-size: 0.75rem;
+  transform: translateX(calc(var(--ptt-slide, 0px) * 0.6));
+  opacity: calc(1 + var(--ptt-slide, 0px) / 110px);
+}
+
+/* A narrow composer (a phone) keeps the dot, the time, the waveform and the hint. */
+@container composer-actions (max-width: 30rem) {
+  .ptt-chip {
+    display: none;
+  }
+}
+
+@container composer-actions (max-width: 24rem) {
+  .ptt-label {
+    display: none;
+  }
+}
+
+/* ---- The mic button -------------------------------------------------------- */
+
+.ptt-button[data-ptt-state="listening"],
+.ptt-button[data-ptt-state="listening"]:hover {
+  background: var(--primary);
+  color: var(--primary-foreground);
+  transform: scale(1.06);
+}
+
+.ptt-button[data-ptt-state="listening"][data-ptt-touch] {
+  transform: scale(1.15);
+}
+
+.ptt-button {
+  transition:
+    transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1),
+    background-color 0.2s,
+    color 0.2s;
+}
+
+/* A soft halo that grows with your voice, and a slow ripple. */
+.ptt-button::before,
+.ptt-button::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  pointer-events: none;
+  opacity: 0;
+  background: color-mix(in srgb, var(--foreground) 12%, transparent);
+}
+
+.ptt-button[data-ptt-state="listening"]::before {
+  opacity: 1;
+  transform: scale(calc(1.15 + 0.6 * var(--ptt-level, 0)));
+  transition: transform 0.08s linear;
+}
+
+.ptt-button[data-ptt-state="listening"]::after {
+  animation: ptt-ripple 1.6s ease-out infinite;
+}
+
+[data-theme="codex"] .ptt-button {
+  border-radius: 999px;
+}
+
+/* ---- Words in the composer -------------------------------------------------- */
+
+.ptt-word {
+  animation: ptt-word-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+
+.ptt-word-partial {
+  color: var(--muted-foreground);
+}
+
+@keyframes ptt-word-in {
+  from {
+    opacity: 0;
+    filter: blur(4px);
+  }
+  to {
+    opacity: 1;
+    filter: none;
+  }
+}
+
+@keyframes ptt-fade-in {
+  from {
+    opacity: 0;
+  }
+}
+
+@keyframes ptt-fade-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes ptt-rec {
+  50% {
+    box-shadow: 0 0 0 4px color-mix(in srgb, var(--destructive) 22%, transparent);
+  }
+}
+
+@keyframes ptt-shimmer {
+  to {
+    background-position: -200% 0;
+  }
+}
+
+@keyframes ptt-ripple {
+  from {
+    opacity: 0.5;
+    transform: scale(1);
+  }
+  to {
+    opacity: 0;
+    transform: scale(1.9);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ptt-rec,
+  .ptt-button::after,
+  .ptt-bar:is([data-ptt-state="finishing"], [data-ptt-state="ended"]) .ptt-label {
+    animation: none;
+  }
+  .ptt-word {
+    animation-duration: 0.2s;
+    filter: none;
+  }
+}
