+              data-testid="push-to-talk-key"
+            >
+              {capturing ? "Press a key…" : settings.key.label}
+            </kbd>
+            <Button
+              type="button"
+              variant="outline"
+              size="sm"
+              onClick={() => setCapturing((on) => !on)}
+              data-testid="push-to-talk-key-change"
+            >
+              {capturing ? "Cancel" : "Change"}
+            </Button>
+          </div>
+        </div>
+        <div className="mt-4 flex items-start justify-between gap-6 border-t border-border pt-4">
+          <SettingsLabel
+            label="Send when you let go"
+            labelId={sendLabelId}
+            className="flex-1"
+            descriptionClassName="text-ui"
+            description="Off: the words stay in the composer for you to check. On: they're sent straight away."
+          />
+          <Switch
+            aria-labelledby={sendLabelId}
+            checked={settings.afterRelease === "send"}
+            onCheckedChange={(on) =>
+              writePushToTalkSettings({ afterRelease: on ? "send" : "keep" })
+            }
+            className="mt-0.5 shrink-0"
+            data-testid="push-to-talk-send-toggle"
+            componentId="settings.speech.send_on_release"
+          />
+        </div>
+      </SettingsGroup>
+
+      <SettingsGroup title="Words to listen for" testId="push-to-talk-settings-hints">
+        <div className={cn("flex flex-col gap-3", !engine.hints && "opacity-60")}>
+          <SettingsLabel
+            label="Names and jargon"
+            labelId={hintsLabelId}
+            descriptionClassName="text-ui"
+            description={
+              engine.hints
+                ? "Project names and terms the model should expect, such as Omnigent or k3s."
+                : "Voxtral on your own server can't take hints, so these only help Mistral's cloud and Deepgram."
+            }
+          />
+          <div
+            className="flex flex-wrap items-center gap-1.5 rounded-lg border border-border p-1.5"
+            aria-labelledby={hintsLabelId}
+          >
+            {settings.hints.map((hint) => (
+              <span
+                key={hint}
+                className="inline-flex items-center gap-1 rounded-full bg-muted py-0.5 pr-1 pl-2.5 text-ui"
+              >
+                {hint}
+                <button
+                  type="button"
+                  aria-label={`Remove ${hint}`}
+                  className="inline-flex size-5 items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground"
+                  onClick={() =>
+                    writePushToTalkSettings({ hints: settings.hints.filter((h) => h !== hint) })
+                  }
+                >
+                  <XIcon className="size-3" />
+                </button>
+              </span>
+            ))}
+            <input
+              value={hintDraft}
+              onChange={(event) => setHintDraft(event.target.value)}
+              onKeyDown={(event) => {
+                if (event.key === "Enter" || event.key === ",") {
+                  event.preventDefault();
+                  addHint();
+                }
+              }}
+              onBlur={addHint}
+              placeholder="Add a word, then Enter"
+              aria-label="Add a word to listen for"
+              data-testid="push-to-talk-hint-input"
+              className="min-w-40 flex-1 bg-transparent px-1.5 py-1 text-ui outline-none placeholder:text-muted-foreground"
+            />
+          </div>
+        </div>
+      </SettingsGroup>
+
+      <SettingsGroup title="Speech server" testId="push-to-talk-settings-server">
+        <div className="flex flex-col gap-2">
+          <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
+            <code className="text-xs break-all">{server}</code>
+            <span
+              className="inline-flex items-center gap-1.5 text-xs text-muted-foreground"
+              data-testid="push-to-talk-server-status"
+            >
+              <span
+                aria-hidden
+                className={cn(
+                  "size-1.5 rounded-full",
+                  reachability === "online"
+                    ? "bg-emerald-500"
+                    : reachability === "offline"
+                      ? "bg-destructive"
+                      : "bg-muted-foreground",
+                )}
+              />
+              {reachability === "online"
+                ? "Online"
+                : reachability === "offline"
+                  ? "Can't reach it from this device"
+                  : "Checking…"}
+            </span>
+          </div>
+          <p className="text-ui text-muted-foreground">
+            Set by the deployment. The microphone only opens while you hold the key or the button. A
+            take ends when you let go, when Omnigent loses focus, or after 2 minutes.
+          </p>
+        </div>
+      </SettingsGroup>
+    </div>
+  );
+}
