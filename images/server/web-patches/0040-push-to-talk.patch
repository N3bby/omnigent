diff --git a/web/src/hooks/usePushToTalk.test.tsx b/web/src/hooks/usePushToTalk.test.tsx
new file mode 100644
index 0000000..310e772
--- /dev/null
+++ b/web/src/hooks/usePushToTalk.test.tsx
@@ -0,0 +1,197 @@
+// Tests for usePushToTalk: words stream into the draft at the caret, Esc puts
+// the draft back, a tap is dropped, and letting go ends the stream.
+
+import { act, render } from "@testing-library/react";
+import { useRef, useState } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type * as PushToTalkModule from "@/lib/pushToTalk";
+import type { PushToTalkStreamEvents } from "@/lib/pushToTalk";
+import { usePushToTalk, type PushToTalk } from "./usePushToTalk";
+
+const streams = vi.hoisted(() => ({
+  last: null as null | {
+    events: PushToTalkStreamEvents;
+    stop: ReturnType<typeof vi.fn>;
+    cancel: ReturnType<typeof vi.fn>;
+    finish: () => void;
+  },
+}));
+
+vi.mock("@/lib/pushToTalk", async (importOriginal) => {
+  const actual = await importOriginal<typeof PushToTalkModule>();
+  return {
+    ...actual,
+    PushToTalkStream: {
+      start: (_server: string, _settings: unknown, events: PushToTalkStreamEvents) => {
+        let finish = () => {};
+        const stopped = new Promise<void>((resolve) => {
+          finish = resolve;
+        });
+        const stream = {
+          events,
+          stop: vi.fn(() => stopped),
+          cancel: vi.fn(),
+          finish,
+          level: () => 0,
+        };
+        streams.last = stream;
+        return stream;
+      },
+    },
+  };
+});
+
+const serverInfo = vi.hoisted(() => ({
+  push_to_talk_url: "wss://speech.example" as string | null,
+}));
+vi.mock("@/lib/CapabilitiesContext", () => ({ useServerInfo: () => serverInfo }));
+vi.mock("@/components/ui/toast", () => ({ showToast: vi.fn() }));
+
+function renderComposer(initial = "", onSend = vi.fn()) {
+  const box: { ptt: PushToTalk | null; ta: HTMLTextAreaElement | null } = { ptt: null, ta: null };
+  function Composer() {
+    const [value, setValue] = useState(initial);
+    const ref = useRef<HTMLTextAreaElement>(null);
+    box.ptt = usePushToTalk({
+      value,
+      setValue,
+      textareaRef: ref,
+      enabled: true,
+      onSend,
+      hotkey: true,
+    });
+    return (
+      <textarea
+        ref={(el) => {
+          ref.current = el;
+          box.ta = el;
+        }}
+        value={value}
+        onChange={(e) => setValue(e.target.value)}
+      />
+    );
+  }
+  render(<Composer />);
+  return box;
+}
+
+let now = 1000;
+
+beforeEach(() => {
+  localStorage.clear();
+  serverInfo.push_to_talk_url = "wss://speech.example";
+  now = 1000;
+  vi.spyOn(performance, "now").mockImplementation(() => now);
+});
+afterEach(() => vi.restoreAllMocks());
+
+describe("usePushToTalk", () => {
+  it("streams words in at the caret, then keeps them when you let go", async () => {
+    const box = renderComposer("Fix  please");
+    act(() => {
+      box.ta!.focus();
+      box.ta!.setSelectionRange(4, 4);
+    });
+    act(() => box.ptt!.start("key"));
+    expect(box.ptt!.phase).toBe("listening");
+    act(() => streams.last!.events.onText(" the"));
+    act(() => streams.last!.events.onText(" flaky"));
+    expect(box.ta!.value).toBe("Fix the flaky please");
+    expect(box.ptt!.region).toMatchObject({ before: "Fix ", final: "the flaky" });
+
+    now += 2000;
+    act(() => box.ptt!.release());
+    expect(box.ptt!.phase).toBe("finishing");
+    expect(streams.last!.stop).toHaveBeenCalled();
+    act(() => streams.last!.events.onText(" test"));
+    await act(async () => streams.last!.finish());
+    expect(box.ptt!.phase).toBe("idle");
+    expect(box.ta!.value).toBe("Fix the flaky test please");
+  });
+
+  it("dims Deepgram's unsure words, and keeps them if they never settle", async () => {
+    const box = renderComposer();
+    act(() => box.ptt!.start("pointer"));
+    act(() => streams.last!.events.onText("Add a retry "));
+    act(() => streams.last!.events.onPartial("with back"));
+    expect(box.ptt!.region).toMatchObject({ final: "Add a retry ", partial: "with back" });
+    now += 2000;
+    act(() => box.ptt!.release());
+    await act(async () => streams.last!.finish());
+    expect(box.ta!.value).toBe("Add a retry with back");
+  });
+
+  it("puts the draft back on Esc and drops the stream", () => {
+    const box = renderComposer("Keep this");
+    act(() => box.ptt!.start("key"));
+    act(() => streams.last!.events.onText(" and this"));
+    expect(box.ta!.value).toBe("Keep this and this");
+    act(() => {
+      window.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", code: "Escape" }));
+    });
+    expect(streams.last!.cancel).toHaveBeenCalled();
+    expect(box.ptt!.phase).toBe("idle");
+    // The card says "ended" for a moment, while its tools fade back in.
+    expect(box.ptt!.cardState).toBe("ended");
+    expect(box.ta!.value).toBe("Keep this");
+  });
+
+  it("starts and ends with the push-to-talk key, and drops a tap", async () => {
+    const box = renderComposer();
+    act(() => {
+      window.dispatchEvent(new KeyboardEvent("keydown", { key: "Alt", code: "AltRight" }));
+    });
+    expect(box.ptt!.phase).toBe("listening");
+    now += 100;
+    act(() => {
+      window.dispatchEvent(new KeyboardEvent("keyup", { key: "Alt", code: "AltRight" }));
+    });
+    // Too short to be a take: nothing streams on, nothing is kept.
+    expect(streams.last!.cancel).toHaveBeenCalled();
+    expect(box.ptt!.phase).toBe("idle");
+  });
+
+  it("drops the take when the key turns out to be part of a shortcut", () => {
+    const box = renderComposer();
+    act(() => {
+      window.dispatchEvent(new KeyboardEvent("keydown", { key: "Alt", code: "AltRight" }));
+    });
+    act(() => {
+      window.dispatchEvent(new KeyboardEvent("keydown", { key: "e", code: "KeyE", altKey: true }));
+    });
+    expect(streams.last!.cancel).toHaveBeenCalled();
+    expect(box.ptt!.phase).toBe("idle");
+  });
+
+  it("ends a take when the window loses focus", () => {
+    const box = renderComposer();
+    act(() => box.ptt!.start("key"));
+    now += 1500;
+    act(() => {
+      window.dispatchEvent(new Event("blur"));
+    });
+    expect(streams.last!.stop).toHaveBeenCalled();
+    expect(box.ptt!.phase).toBe("finishing");
+  });
+
+  it("sends the words when you let go, if that's the setting", async () => {
+    localStorage.setItem("omnigent:push-to-talk", JSON.stringify({ afterRelease: "send" }));
+    const onSend = vi.fn();
+    const box = renderComposer("", onSend);
+    act(() => box.ptt!.start("pointer"));
+    act(() => streams.last!.events.onText(" Ship it."));
+    now += 1500;
+    act(() => box.ptt!.release());
+    await act(async () => streams.last!.finish());
+    expect(box.ta!.value).toBe("Ship it.");
+    expect(onSend).toHaveBeenCalledTimes(1);
+  });
+
+  it("stays off without a speech server", () => {
+    serverInfo.push_to_talk_url = null;
+    const box = renderComposer();
+    expect(box.ptt!.available).toBe(false);
+    act(() => box.ptt!.start("key"));
+    expect(box.ptt!.phase).toBe("idle");
+  });
+});
diff --git a/web/src/hooks/usePushToTalk.ts b/web/src/hooks/usePushToTalk.ts
new file mode 100644
index 0000000..44fc0f7
--- /dev/null
+++ b/web/src/hooks/usePushToTalk.ts
@@ -0,0 +1,430 @@
+// Push-to-talk in a composer: hold a key or the mic button, talk, let go.
+//
+// The words stream into the draft at the caret while the person talks (see
+// lib/pushToTalk.ts for the transport). The draft is rebuilt on every update
+// from what it was when the take started, so a take only ever owns its own
+// span: `before + lead + words + trail + after`. The textarea is read-only for
+// the take, so nothing else edits it meanwhile; Esc, or sliding off the
+// button on a phone, puts the draft back as it was.
+//
+// A take ends when the key or button is let go, and also when the window
+// loses focus or the tab is hidden (the key-up would never arrive), and after
+// PUSH_TO_TALK_MAX_TAKE_MS. The microphone and the socket close with it.
+
+import { type RefObject, useCallback, useEffect, useLayoutEffect, useRef, useState } from "react";
+import { showToast } from "@/components/ui/toast";
+import { useServerInfo } from "@/lib/CapabilitiesContext";
+import {
+  PUSH_TO_TALK_MAX_TAKE_MS,
+  PUSH_TO_TALK_MIN_TAKE_MS,
+  PushToTalkStream,
+  readPushToTalkSettings,
+  usePushToTalkSettings,
+  type PushToTalkSettings,
+} from "@/lib/pushToTalk";
+
+export type PushToTalkPhase = "idle" | "listening" | "finishing";
+/** The composer card's data-ptt-state: a take's phase, or "ended" for a moment after one. */
+export type PushToTalkCardState = PushToTalkPhase | "ended";
+export type PushToTalkSource = "key" | "pointer";
+
+/** The take's span of the draft, for the composer's word-by-word backdrop. */
+export interface PushToTalkRegion {
+  before: string;
+  lead: string;
+  /** Words the server won't change. */
+  final: string;
+  /** Words that may still change (Deepgram). */
+  partial: string;
+  trail: string;
+  after: string;
+}
+
+/** The draft a region spells out; it must equal the draft to be drawn over it. */
+export function pushToTalkRegionText(region: PushToTalkRegion): string {
+  return region.before + region.lead + region.final + region.partial + region.trail + region.after;
+}
+
+/** Characters the dictated words sit flush against, on either side. */
+const HUGS_RIGHT = /[\s([{<]$/;
+const HUGS_LEFT = /^[\s,.;:!?)\]}>]/;
+/** How long the backdrop stays after a take, so the last words finish fading in. */
+const SETTLE_MS = 700;
+/** How long the card says "ended" after a take, while its tools fade back in. */
+const ENDED_MS = 400;
+
+function buildRegion(
+  base: string,
+  at: number,
+  final: string,
+  partial: string,
+): { region: PushToTalkRegion; value: string; caret: number } {
+  const before = base.slice(0, at);
+  const after = base.slice(at);
+  const finalShown = final.replace(/^\s+/, "");
+  const partialShown = finalShown ? partial : partial.replace(/^\s+/, "");
+  const spacer = finalShown && partialShown && !/\s$/.test(finalShown) ? " " : "";
+  const words = finalShown + spacer + partialShown;
+  const lead = words && before && !HUGS_RIGHT.test(before) ? " " : "";
+  const trail = words && after && !HUGS_LEFT.test(after) ? " " : "";
+  const region = {
+    before,
+    lead,
+    final: finalShown + spacer,
+    partial: partialShown,
+    trail,
+    after,
+  };
+  return {
+    region,
+    value: before + lead + words + trail + after,
+    caret: before.length + lead.length + words.length,
+  };
+}
+
+export interface UsePushToTalkOptions {
+  value: string;
+  setValue: (next: string) => void;
+  textareaRef: RefObject<HTMLTextAreaElement | null>;
+  /** False while the composer can't take input (read-only, sending, ...). */
+  enabled: boolean;
+  /** Sends the draft, for the "Send it" setting. */
+  onSend?: () => void;
+  /** Listen for the push-to-talk key. Enable on one mounted composer only. */
+  hotkey?: boolean;
+}
+
+export interface PushToTalk {
+  /** Whether this deployment has a speech server, so the button shows. */
+  available: boolean;
+  phase: PushToTalkPhase;
+  /** For the composer card's data-ptt-state. */
+  cardState: PushToTalkCardState;
+  source: PushToTalkSource | null;
+  /** Whether the take started with a finger, which can slide off to cancel. */
+  touch: boolean;
+  /** When the take started (performance.now()), for the timer. */
+  startedAt: number;
+  /** When the person let go, or null while they're still talking. */
+  releasedAt: number | null;
+  region: PushToTalkRegion | null;
+  settings: PushToTalkSettings;
+  server: string | null;
+  start: (source: PushToTalkSource, touch?: boolean) => void;
+  release: () => void;
+  cancel: () => void;
+  /** How loud the microphone is, from 0 to 1. */
+  level: () => number;
+}
+
+export function usePushToTalk({
+  value,
+  setValue,
+  textareaRef,
+  enabled,
+  onSend,
+  hotkey = false,
+}: UsePushToTalkOptions): PushToTalk {
+  const info = useServerInfo();
+  const server = info !== "loading" ? (info.push_to_talk_url ?? null) : null;
+  const settings = usePushToTalkSettings();
+  const available = server !== null;
+
+  const [phase, setPhase] = useState<PushToTalkPhase>("idle");
+  const [source, setSource] = useState<PushToTalkSource | null>(null);
+  const [touch, setTouch] = useState(false);
+  const [region, setRegion] = useState<PushToTalkRegion | null>(null);
+  const [startedAt, setStartedAt] = useState(0);
+  const [releasedAt, setReleasedAt] = useState<number | null>(null);
+  const [ended, setEnded] = useState(false);
+  const endedTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  const streamRef = useRef<PushToTalkStream | null>(null);
+  const phaseRef = useRef<PushToTalkPhase>("idle");
+  const sourceRef = useRef<PushToTalkSource | null>(null);
+  const takeRef = useRef<{
+    base: string;
+    at: number;
+    final: string;
+    partial: string;
+    written: string;
+    startedAt: number;
+    caret: number;
+  } | null>(null);
+  const valueRef = useRef(value);
+  valueRef.current = value;
+  const sendAfterRef = useRef<string | null>(null);
+  // Bumped to run the send effect even when the finished draft reads as before.
+  const [sendNonce, setSendNonce] = useState(0);
+  const caretRef = useRef<number | null>(null);
+  const settleTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const maxTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const onSendRef = useRef(onSend);
+  onSendRef.current = onSend;
+
+  const setPhaseBoth = useCallback((next: PushToTalkPhase) => {
+    phaseRef.current = next;
+    setPhase(next);
+  }, []);
+
+  const write = useCallback(() => {
+    const take = takeRef.current;
+    if (!take) return;
+    const built = buildRegion(take.base, take.at, take.final, take.partial);
+    take.written = built.value;
+    take.caret = built.caret;
+    caretRef.current = built.caret;
+    setRegion(built.region);
+    setValue(built.value);
+  }, [setValue]);
+
+  // Keep the caret right after the words while they arrive, where it's visible.
+  useLayoutEffect(() => {
+    const caret = caretRef.current;
+    const ta = textareaRef.current;
+    if (caret === null || !ta || ta !== document.activeElement) return;
+    caretRef.current = null;
+    ta.setSelectionRange(caret, caret);
+  });
+
+  const clearTimers = useCallback(() => {
+    if (maxTimer.current) clearTimeout(maxTimer.current);
+    maxTimer.current = null;
+  }, []);
+
+  const end = useCallback(
+    (keep: boolean) => {
+      const take = takeRef.current;
+      takeRef.current = null;
+      streamRef.current = null;
+      clearTimers();
+      setPhaseBoth("idle");
+      setSource(null);
+      sourceRef.current = null;
+      setEnded(true);
+      if (endedTimer.current) clearTimeout(endedTimer.current);
+      endedTimer.current = setTimeout(() => setEnded(false), ENDED_MS);
+      if (!take) return;
+      // Somebody else changed the draft (a session switch): it isn't ours.
+      if (valueRef.current !== take.written) {
+        setRegion(null);
+        return;
+      }
+      // Words Deepgram never finalized are still the person's words: keep them.
+      const gap = take.final && take.partial && !/\s$/.test(take.final) ? " " : "";
+      const words = (take.final + gap + take.partial).trim();
+      if (!keep || !words) {
+        setRegion(null);
+        setValue(take.base);
+        return;
+      }
+      const built = buildRegion(take.base, take.at, words, "");
+      caretRef.current = built.caret;
+      setRegion(built.region);
+      setValue(built.value);
+      if (settleTimer.current) clearTimeout(settleTimer.current);
+      settleTimer.current = setTimeout(() => setRegion(null), SETTLE_MS);
+      if (readPushToTalkSettings().afterRelease === "send") {
+        sendAfterRef.current = built.value;
+        setSendNonce((n) => n + 1);
+      }
+    },
+    [clearTimers, setPhaseBoth, setValue],
+  );
+
+  // "Send it": send once the composer has rendered the finished draft.
+  useEffect(() => {
+    if (sendAfterRef.current !== null && sendAfterRef.current === value) {
+      sendAfterRef.current = null;
+      onSendRef.current?.();
+    }
+  }, [value, sendNonce]);
+
+  const cancel = useCallback(() => {
+    const stream = streamRef.current;
+    if (phaseRef.current === "idle") return;
+    stream?.cancel();
+    end(false);
+  }, [end]);
+
+  const release = useCallback(() => {
+    const take = takeRef.current;
+    const stream = streamRef.current;
+    if (phaseRef.current !== "listening" || !take || !stream) return;
+    if (performance.now() - take.startedAt < PUSH_TO_TALK_MIN_TAKE_MS) {
+      stream.cancel();
+      end(false);
+      showToast(
+        sourceRef.current === "key"
+          ? `Hold ${readPushToTalkSettings().key.label} while you talk.`
+          : "Hold the mic button while you talk.",
+        { duration: 2500 },
+      );
+      return;
+    }
+    clearTimers();
+    setPhaseBoth("finishing");
+    setReleasedAt(performance.now());
+    void stream.stop().then(() => {
+      if (streamRef.current === stream) end(true);
+    });
+  }, [clearTimers, end, setPhaseBoth]);
+
+  const start = useCallback(
+    (from: PushToTalkSource, byTouch = false) => {
+      if (!server || !enabled || phaseRef.current !== "idle") return;
+      const ta = textareaRef.current;
+      const base = valueRef.current;
+      // Insert at the caret when the composer has focus; at the end otherwise.
+      const at = ta && ta === document.activeElement ? ta.selectionEnd : base.length;
+      if (settleTimer.current) clearTimeout(settleTimer.current);
+      const now = performance.now();
+      takeRef.current = {
+        base,
+        at,
+        final: "",
+        partial: "",
+        written: base,
+        startedAt: now,
+        caret: at,
+      };
+      const stream = PushToTalkStream.start(server, readPushToTalkSettings(), {
+        onText: (text) => {
+          const take = takeRef.current;
+          if (!take || streamRef.current !== stream) return;
+          take.final += text;
+          write();
+        },
+        onPartial: (text) => {
+          const take = takeRef.current;
+          if (!take || streamRef.current !== stream) return;
+          take.partial = text;
+          write();
+        },
+        onError: (message) => {
+          if (streamRef.current !== stream) return;
+          // Keep the words that made it, and say what went wrong.
+          end(true);
+          showToast(message);
+        },
+      });
+      streamRef.current = stream;
+      sourceRef.current = from;
+      setSource(from);
+      setTouch(byTouch);
+      setStartedAt(now);
+      setReleasedAt(null);
+      setRegion(null);
+      setPhaseBoth("listening");
+      maxTimer.current = setTimeout(() => release(), PUSH_TO_TALK_MAX_TAKE_MS);
+    },
+    [enabled, end, release, server, setPhaseBoth, textareaRef, write],
+  );
+
+  // Losing focus or hiding the tab ends a take: the key-up would never arrive.
+  useEffect(() => {
+    if (phase !== "listening") return;
+    const onBlur = () => release();
+    const onVisibility = () => {
+      if (document.hidden) release();
+    };
+    window.addEventListener("blur", onBlur);
+    document.addEventListener("visibilitychange", onVisibility);
+    return () => {
+      window.removeEventListener("blur", onBlur);
+      document.removeEventListener("visibilitychange", onVisibility);
+    };
+  }, [phase, release]);
+
+  // The push-to-talk key, and Esc to cancel a take however it started.
+  useEffect(() => {
+    if (!hotkey && phase === "idle") return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      const current = phaseRef.current;
+      if (current !== "idle" && event.key === "Escape") {
+        event.preventDefault();
+        event.stopPropagation();
+        cancel();
+        return;
+      }
+      if (!hotkey) return;
+      const key = readPushToTalkSettings().key;
+      if (event.code === key.code) {
+        if (current === "idle" && !event.repeat && canStartFrom(event.target, textareaRef)) {
+          event.preventDefault();
+          start("key");
+        } else if (current !== "idle") {
+          event.preventDefault();
+        }
+        return;
+      }
+      // The key held with another key is a shortcut or a special character.
+      if (current === "listening" && sourceRef.current === "key") cancel();
+    };
+    const onKeyUp = (event: KeyboardEvent) => {
+      if (!hotkey) return;
+      if (event.code === readPushToTalkSettings().key.code && sourceRef.current === "key") {
+        event.preventDefault();
+        release();
+      }
+    };
+    window.addEventListener("keydown", onKeyDown, true);
+    window.addEventListener("keyup", onKeyUp, true);
+    return () => {
+      window.removeEventListener("keydown", onKeyDown, true);
+      window.removeEventListener("keyup", onKeyUp, true);
+    };
+  }, [cancel, hotkey, phase, release, start, textareaRef]);
+
+  // Unmounting mid-take (leaving the session) drops it.
+  useEffect(
+    () => () => {
+      streamRef.current?.cancel();
+      streamRef.current = null;
+      if (maxTimer.current) clearTimeout(maxTimer.current);
+      if (settleTimer.current) clearTimeout(settleTimer.current);
+      if (endedTimer.current) clearTimeout(endedTimer.current);
+    },
+    [],
+  );
+
+  // A disabled composer (the agent took it over, it went read-only) ends a take.
+  useEffect(() => {
+    if (!enabled && phaseRef.current === "listening") release();
+  }, [enabled, release]);
+
+  const level = useCallback(() => streamRef.current?.level() ?? 0, []);
+
+  return {
+    available,
+    phase,
+    cardState: phase === "idle" && ended ? "ended" : phase,
+    source,
+    touch,
+    startedAt,
+    releasedAt,
+    region,
+    settings,
+    server,
+    start,
+    release,
+    cancel,
+    level,
+  };
+}
+
+/** Whether the push-to-talk key may start a take while focus is on *target*. */
+function canStartFrom(
+  target: EventTarget | null,
+  textareaRef: RefObject<HTMLTextAreaElement | null>,
+): boolean {
+  if (!(target instanceof HTMLElement)) return true;
+  if (target === textareaRef.current) return true;
+  // Another text field keeps its keys: typing there isn't dictation.
+  if (target.isContentEditable) return false;
+  if (target instanceof HTMLTextAreaElement) return false;
+  if (target instanceof HTMLInputElement) {
+    return ["button", "checkbox", "radio", "range", "submit", "reset"].includes(target.type);
+  }
+  return true;
+}
