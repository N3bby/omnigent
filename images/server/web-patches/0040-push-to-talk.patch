index 0000000..db022af
--- /dev/null
+++ b/web/src/lib/pushToTalk.ts
@@ -0,0 +1,538 @@
+// Push-to-talk dictation through this deployment's own speech server.
+//
+// The server (`push_to_talk_url` in the deployment's environment, advertised
+// as `push_to_talk_url` by GET /v1/info) is a Voxtral Realtime server on the
+// user's tailnet. It transcribes with Voxtral on its own machine, or relays
+// the same audio to Mistral's hosted Voxtral or to Deepgram Nova-3, and
+// streams the words back as they're recognized. The browser talks to it
+// directly over a WebSocket:
+//
+//   wss://<server>/stream?engines=local&delay=480&hint=Omnigent
+//   → binary frames: 16 kHz mono s16le PCM, as it's recorded
+//   → {"type": "stop"} when the person lets go
+//   ← {"type": "ready"}, then per engine {"type": "text"|"partial"|"done"|"error", ...}
+//
+// One PushToTalkStream is one take: it owns the microphone, an AudioWorklet
+// that converts the capture to 16 kHz PCM, and the socket. The socket and the
+// microphone open together, so the first words aren't lost while either
+// starts; audio captured before the server says "ready" is held and sent then.
+// Everything is released the moment the take ends: the microphone and the
+// socket close, so nothing streams (or is billed) once the person lets go.
+
+import { useSyncExternalStore } from "react";
+
+export type PushToTalkEngine = "local" | "cloud" | "deepgram";
+
+export interface PushToTalkEngineInfo {
+  id: PushToTalkEngine;
+  name: string;
+  /** Short name for the listening bar, e.g. "Voxtral · Mac". */
+  short: string;
+  description: string;
+  /** Whether a take costs money (the server relays it to a paid service). */
+  billed: boolean;
+  /** Whether the engine can use the words to listen for. */
+  hints: boolean;
+}
+
+export const PUSH_TO_TALK_ENGINES: readonly PushToTalkEngineInfo[] = [
+  {
+    id: "local",
+    name: "Voxtral on your server",
+    short: "Voxtral",
+    description:
+      "Runs on the speech server's own machine, so it's free and stays private. Last words arrive about 0.8 s after you let go.",
+    billed: false,
+    hints: false,
+  },
+  {
+    id: "cloud",
+    name: "Voxtral on Mistral's cloud",
+    short: "Voxtral cloud",
+    description:
+      "The same model on Mistral's servers. It listens for your words below. Last words arrive about 1.3 s after you let go.",
+    billed: true,
+    hints: true,
+  },
+  {
+    id: "deepgram",
+    name: "Deepgram Nova-3",
+    short: "Nova-3",
+    description:
+      "Shows words while you're still saying them, then corrects them. Last words arrive about 0.2 s after you let go.",
+    billed: true,
+    hints: true,
+  },
+];
+
+export function pushToTalkEngine(id: PushToTalkEngine): PushToTalkEngineInfo {
+  return PUSH_TO_TALK_ENGINES.find((engine) => engine.id === id) ?? PUSH_TO_TALK_ENGINES[0];
+}
+
+export interface PushToTalkKey {
+  /** KeyboardEvent.code, e.g. "AltRight". */
+  code: string;
+  label: string;
+}
+
+export interface PushToTalkSettings {
+  engine: PushToTalkEngine;
+  key: PushToTalkKey;
+  /** Names and jargon to listen for (Mistral's context bias, Deepgram's keyterms). */
+  hints: string[];
+  /** What letting go does: leave the words in the composer, or send them. */
+  afterRelease: "keep" | "send";
+}
+
+export const DEFAULT_PUSH_TO_TALK_SETTINGS: PushToTalkSettings = {
+  engine: "local",
+  key: { code: "AltRight", label: "Right ⌥" },
+  hints: [],
+  afterRelease: "keep",
+};
+
+/** How long a take may last. The server stops one at 2 minutes too. */
+export const PUSH_TO_TALK_MAX_TAKE_MS = 120_000;
+/** A press shorter than this is a tap, not a take, and is dropped. */
+export const PUSH_TO_TALK_MIN_TAKE_MS = 300;
+/** The Voxtral delay: how far the text may trail the voice. 480 ms is Mistral's recommendation. */
+const VOXTRAL_DELAY_MS = 480;
+/** How long to wait for the last words after letting go before closing anyway. */
+const STOP_TIMEOUT_MS = 10_000;
+/** At most this much audio is held while the socket opens (16 kHz × 2 bytes × 10 s). */
+const MAX_PENDING_BYTES = 320_000;
+
+const STORAGE_KEY = "omnigent:push-to-talk";
+const KEY_LABELS: Record<string, string> = {
+  AltRight: "Right ⌥",
+  AltLeft: "Left ⌥",
+  ControlRight: "Right Ctrl",
+  ControlLeft: "Left Ctrl",
+  MetaRight: "Right ⌘",
+  MetaLeft: "Left ⌘",
+  ShiftRight: "Right Shift",
+  ShiftLeft: "Left Shift",
+  CapsLock: "Caps Lock",
+  Space: "Space",
+  Backquote: "`",
+};
+
+/** A readable name for the key a KeyboardEvent reports. */
+export function pushToTalkKeyLabel(code: string, key: string): string {
+  if (KEY_LABELS[code]) return KEY_LABELS[code];
+  if (/^F\d+$/.test(code)) return code;
+  if (key.length === 1) return key.toUpperCase();
+  return key || code;
+}
+
+function parseSettings(raw: string | null): PushToTalkSettings {
+  if (!raw) return DEFAULT_PUSH_TO_TALK_SETTINGS;
+  try {
+    const data = JSON.parse(raw) as Partial<PushToTalkSettings>;
+    const engine = PUSH_TO_TALK_ENGINES.some((e) => e.id === data.engine)
+      ? (data.engine as PushToTalkEngine)
+      : DEFAULT_PUSH_TO_TALK_SETTINGS.engine;
+    const key =
+      data.key && typeof data.key.code === "string" && typeof data.key.label === "string"
+        ? { code: data.key.code, label: data.key.label }
+        : DEFAULT_PUSH_TO_TALK_SETTINGS.key;
+    const hints = Array.isArray(data.hints)
+      ? data.hints.filter((h): h is string => typeof h === "string" && h.trim() !== "")
+      : [];
+    const afterRelease = data.afterRelease === "send" ? "send" : "keep";
+    return { engine, key, hints, afterRelease };
+  } catch {
+    return DEFAULT_PUSH_TO_TALK_SETTINGS;
+  }
+}
+
+let cachedRaw: string | null | undefined;
+let cachedSettings = DEFAULT_PUSH_TO_TALK_SETTINGS;
+const listeners = new Set<() => void>();
+
+function readRaw(): string | null {
+  try {
+    return window.localStorage.getItem(STORAGE_KEY);
+  } catch {
+    return null;
+  }
+}
+
+/** This browser's push-to-talk settings. */
+export function readPushToTalkSettings(): PushToTalkSettings {
+  const raw = typeof window === "undefined" ? null : readRaw();
+  if (raw !== cachedRaw) {
+    cachedRaw = raw;
+    cachedSettings = parseSettings(raw);
+  }
+  return cachedSettings;
+}
+
+export function writePushToTalkSettings(patch: Partial<PushToTalkSettings>): void {
+  const next = { ...readPushToTalkSettings(), ...patch };
+  try {
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+  } catch {
+    // Private mode or blocked storage: keep it for this page only.
+    cachedRaw = JSON.stringify(next);
+    cachedSettings = next;
+  }
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  const onStorage = (event: StorageEvent) => {
+    if (event.key === STORAGE_KEY) listener();
+  };
+  window.addEventListener("storage", onStorage);
+  return () => {
+    listeners.delete(listener);
+    window.removeEventListener("storage", onStorage);
+  };
+}
+
+export function usePushToTalkSettings(): PushToTalkSettings {
+  return useSyncExternalStore(
+    subscribe,
+    readPushToTalkSettings,
+    () => DEFAULT_PUSH_TO_TALK_SETTINGS,
+  );
+}
+
+/** The speech server's /stream URL for a take with these settings. */
+export function pushToTalkStreamUrl(server: string, settings: PushToTalkSettings): string {
+  const base = server.replace(/\/+$/, "").replace(/^http(s?):/, "ws$1:");
+  const query = new URLSearchParams({ engines: settings.engine, delay: String(VOXTRAL_DELAY_MS) });
+  if (pushToTalkEngine(settings.engine).hints) {
+    for (const hint of settings.hints.slice(0, 100)) query.append("hint", hint);
+  }
+  return `${base}/stream?${query}`;
+}
+
+/** The speech server's https:// address, for checking it's reachable. */
+export function pushToTalkHttpUrl(server: string): string {
+  return server.replace(/\/+$/, "").replace(/^ws(s?):/, "http$1:");
+}
+
+/** One message from the speech server, for the engine this take uses. */
+export type PushToTalkMessage =
+  | { type: "ready" }
+  | { type: "text"; text: string }
+  | { type: "partial"; text: string }
+  | { type: "done" }
+  | { type: "error"; message: string };
+
+/** Parse a frame from the server; null for anything else, including other engines' frames. */
+export function parsePushToTalkMessage(
+  raw: string,
+  engine: PushToTalkEngine,
+): PushToTalkMessage | null {
+  let data: unknown;
+  try {
+    data = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  if (typeof data !== "object" || data === null) return null;
+  const frame = data as { type?: unknown; source?: unknown; text?: unknown; message?: unknown };
+  if (frame.type === "ready") return { type: "ready" };
+  if (frame.source !== undefined && frame.source !== engine) return null;
+  switch (frame.type) {
+    case "text":
+    case "partial":
+      return typeof frame.text === "string" ? { type: frame.type, text: frame.text } : null;
+    case "done":
+      return { type: "done" };
+    case "error":
+      return {
+        type: "error",
+        message: typeof frame.message === "string" ? frame.message : "The speech server failed.",
+      };
+    default:
+      return null;
+  }
+}
+
+export interface PushToTalkStreamEvents {
+  /** New final words; append them as they are (they carry their own spaces). */
+  onText: (text: string) => void;
+  /** Words that may still change (Deepgram); replaces the previous partial. */
+  onPartial: (text: string) => void;
+  /** The take failed. The stream has already released the microphone and socket. */
+  onError: (message: string) => void;
+}
+
+const TARGET_RATE = 16_000;
+
+// AudioWorklet processor, inlined as a Blob module so no separate asset has to
+// survive the build: linear-interpolation downsample from the capture rate to
+// 16 kHz, Float32 → Int16, posted in 80 ms chunks (Voxtral's frame). Any
+// message on the port means "flush": the partial chunk is posted, then null.
+const WORKLET_SOURCE = `
+const TARGET_RATE = ${TARGET_RATE};
+const CHUNK_SAMPLES = 1280;
+class PushToTalkPcm16 extends AudioWorkletProcessor {
+  constructor() {
+    super();
+    this.step = sampleRate / TARGET_RATE;
+    this.pos = 0;
+    this.pending = new Int16Array(CHUNK_SAMPLES);
+    this.filled = 0;
+    this.port.onmessage = () => {
+      if (this.filled > 0) {
+        const out = this.pending.slice(0, this.filled);
+        this.filled = 0;
+        this.port.postMessage(out, [out.buffer]);
+      }
+      this.port.postMessage(null);
+    };
+  }
+  process(inputs) {
+    const channel = inputs[0] && inputs[0][0];
+    if (!channel || channel.length === 0) return true;
+    let pos = this.pos;
+    while (pos < channel.length) {
+      const i = Math.floor(pos);
+      const s0 = channel[i];
+      const s1 = i + 1 < channel.length ? channel[i + 1] : s0;
+      const sample = Math.max(-1, Math.min(1, s0 + (s1 - s0) * (pos - i)));
+      this.pending[this.filled++] = sample < 0 ? sample * 0x8000 : sample * 0x7fff;
+      if (this.filled === CHUNK_SAMPLES) {
+        const out = this.pending;
+        this.pending = new Int16Array(CHUNK_SAMPLES);
+        this.filled = 0;
+        this.port.postMessage(out, [out.buffer]);
+      }
+      pos += this.step;
+    }
+    this.pos = pos - channel.length;
+    return true;
+  }
+}
+registerProcessor("omnigent-push-to-talk-pcm16", PushToTalkPcm16);
+`;
+
+let cachedWorkletUrl: string | null = null;
+
+function workletUrl(): string {
+  cachedWorkletUrl ??= URL.createObjectURL(
+    new Blob([WORKLET_SOURCE], { type: "application/javascript" }),
+  );
+  return cachedWorkletUrl;
+}
+
+function microphoneError(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === "NotAllowedError" || error.name === "SecurityError") {
+      return "Omnigent isn't allowed to use the microphone. Allow it in the browser's site settings, then try again.";
+    }
+    if (error.name === "NotFoundError") return "No microphone was found.";
+  }
+  return "The microphone couldn't be opened.";
+}
+
+/**
+ * One take: the microphone, its conversion to PCM, and the socket to the
+ * speech server. Start it with {@link PushToTalkStream.start}; end it with
+ * {@link stop} (waits for the last words) or {@link cancel} (drops them).
+ */
+export class PushToTalkStream {
+  private readonly events: PushToTalkStreamEvents;
+  private readonly engine: PushToTalkEngine;
+  private readonly ws: WebSocket;
+  private media: MediaStream | null = null;
+  private context: AudioContext | null = null;
+  private node: AudioWorkletNode | null = null;
+  private analyser: AnalyserNode | null = null;
+  private samples: Float32Array<ArrayBuffer> | null = null;
+  private pending: ArrayBuffer[] = [];
+  private pendingBytes = 0;
+  private ready = false;
+  private stopping = false;
+  private finished = false;
+  private flushed: (() => void) | null = null;
+  private closed: Promise<void>;
+
+  private constructor(url: string, engine: PushToTalkEngine, events: PushToTalkStreamEvents) {
+    this.events = events;
+    this.engine = engine;
+    this.ws = new WebSocket(url);
+    this.ws.binaryType = "arraybuffer";
+    this.closed = new Promise((resolve) => {
+      this.ws.addEventListener("close", () => resolve());
+    });
+    this.ws.addEventListener("message", (event) => this.receive(event));
+    this.ws.addEventListener("error", () => {
+      if (!this.ready) this.fail("Omnigent can't reach the speech server.");
+    });
+    this.ws.addEventListener("close", () => {
+      this.releaseAudio();
+      if (!this.stopping && !this.finished) this.fail("The speech server closed the connection.");
+    });
+  }
+
+  /** Open the microphone and the socket together, and start streaming. */
+  static start(
+    server: string,
+    settings: PushToTalkSettings,
+    events: PushToTalkStreamEvents,
+  ): PushToTalkStream {
+    const stream = new PushToTalkStream(
+      pushToTalkStreamUrl(server, settings),
+      settings.engine,
+      events,
+    );
+    void stream.openMicrophone();
+    return stream;
+  }
+
+  /** How loud the microphone is right now, from 0 to 1. */
+  level(): number {
+    if (!this.analyser || !this.samples) return 0;
+    this.analyser.getFloatTimeDomainData(this.samples);
+    let sum = 0;
+    for (const sample of this.samples) sum += sample * sample;
+    // Speech sits around 0.02–0.2 RMS; scale that onto 0–1.
+    return Math.min(1, Math.sqrt(sum / this.samples.length) * 6);
+  }
+
+  /** Stop recording, wait for the last words, and close. */
+  async stop(): Promise<void> {
+    if (this.stopping || this.finished) return;
+    this.stopping = true;
+    await this.flushWorklet();
+    this.releaseAudio();
+    if (this.ready) this.sendStop();
+    else if (this.ws.readyState !== WebSocket.CONNECTING) this.ws.close();
+    // Not ready yet: receive() flushes the held audio and stops once it is.
+    const timeout = new Promise<void>((resolve) => {
+      setTimeout(resolve, STOP_TIMEOUT_MS);
+    });
+    await Promise.race([this.closed, timeout]);
+    this.finished = true;
+    this.ws.close();
+  }
+
+  /** Drop the take: release the microphone and close the socket now. */
+  cancel(): void {
+    this.finished = true;
+    this.releaseAudio();
+    this.ws.close();
+  }
+
+  private async openMicrophone(): Promise<void> {
+    let media: MediaStream;
+    try {
+      media = await navigator.mediaDevices.getUserMedia({
+        audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true },
+      });
+    } catch (error) {
+      this.fail(microphoneError(error));
+      return;
+    }
+    if (this.stopping || this.finished) {
+      // Let go before the microphone opened: nothing to record.
+      for (const track of media.getTracks()) track.stop();
+      return;
+    }
+    this.media = media;
+    try {
+      // Ask for 16 kHz so the browser resamples; some platforms refuse the hint.
+      try {
+        this.context = new AudioContext({ sampleRate: TARGET_RATE });
+      } catch {
+        this.context = new AudioContext();
+      }
+      await this.context.audioWorklet.addModule(workletUrl());
+      if (this.finished || !this.media) return;
+      const source = this.context.createMediaStreamSource(media);
+      this.node = new AudioWorkletNode(this.context, "omnigent-push-to-talk-pcm16");
+      this.node.port.onmessage = (msg: MessageEvent<Int16Array<ArrayBuffer> | null>) => {
+        if (msg.data === null) {
+          this.flushed?.();
+          this.flushed = null;
+        } else {
+          this.send(msg.data.buffer);
+        }
+      };
+      this.analyser = this.context.createAnalyser();
+      this.analyser.fftSize = 1024;
+      this.samples = new Float32Array(this.analyser.fftSize);
+      // The worklet only runs while it reaches the destination; mute it there.
+      const mute = this.context.createGain();
+      mute.gain.value = 0;
+      source.connect(this.analyser);
+      source.connect(this.node);
+      this.node.connect(mute);
+      mute.connect(this.context.destination);
+    } catch {
+      this.fail("The microphone couldn't be opened.");
+    }
+  }
+
+  private send(chunk: ArrayBuffer): void {
+    if (this.finished) return;
+    if (this.ready && this.ws.readyState === WebSocket.OPEN) {
+      this.ws.send(chunk);
+    } else if (this.pendingBytes < MAX_PENDING_BYTES) {
+      this.pending.push(chunk);
+      this.pendingBytes += chunk.byteLength;
+    }
+  }
+
+  private sendStop(): void {
+    if (this.ws.readyState === WebSocket.OPEN) this.ws.send(JSON.stringify({ type: "stop" }));
+  }
+
+  private receive(event: MessageEvent): void {
+    if (typeof event.data !== "string") return;
+    const msg = parsePushToTalkMessage(event.data, this.engine);
+    if (msg === null) return;
+    if (msg.type === "ready") {
+      this.ready = true;
+      for (const chunk of this.pending) this.ws.send(chunk);
+      this.pending = [];
+      this.pendingBytes = 0;
+      if (this.stopping) this.sendStop();
+    } else if (msg.type === "text") {
+      this.events.onText(msg.text);
+    } else if (msg.type === "partial") {
+      this.events.onPartial(msg.text);
+    } else if (msg.type === "error") {
+      this.fail(msg.message);
+    }
+  }
+
+  private flushWorklet(): Promise<void> {
+    const node = this.node;
+    if (!node) return Promise.resolve();
+    return new Promise<void>((resolve) => {
+      this.flushed = resolve;
+      try {
+        node.port.postMessage("flush");
+      } catch {
+        resolve();
+        return;
+      }
+      setTimeout(resolve, 250);
+    });
+  }
+
+  private releaseAudio(): void {
+    for (const track of this.media?.getTracks() ?? []) track.stop();
+    this.media = null;
+    if (this.context && this.context.state !== "closed") void this.context.close();
+    this.context = null;
+    this.node = null;
+    this.analyser = null;
+  }
+
+  private fail(message: string): void {
+    if (this.finished) return;
+    this.finished = true;
+    this.releaseAudio();
+    this.ws.close();
+    this.events.onError(message);
+  }
+}
