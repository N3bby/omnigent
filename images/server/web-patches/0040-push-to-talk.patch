@@ -0,0 +1,332 @@
+// The composer's push-to-talk pieces: the mic button you hold, the bar that
+// replaces the composer's tools while you talk, and the words fading in over
+// the draft. usePushToTalk (hooks/usePushToTalk.ts) runs the take.
+
+import {
+  type PointerEvent,
+  type KeyboardEvent,
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from "react";
+import { CloudIcon, MicIcon, ServerIcon, ZapIcon } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import type { PushToTalk, PushToTalkRegion } from "@/hooks/usePushToTalk";
+import { pushToTalkEngine, type PushToTalkEngine } from "@/lib/pushToTalk";
+import { cn } from "@/lib/utils";
+
+/** Sliding a finger this far left off the button cancels the take. */
+const SLIDE_TO_CANCEL_PX = 90;
+/** One waveform bar per this many milliseconds of sound. */
+const BAR_MS = 45;
+const BAR_WIDTH = 5;
+
+/** The speech server's machine, e.g. "mac-mini" for wss://mac-mini.tailnet.ts.net:8443. */
+export function pushToTalkServerName(server: string | null): string {
+  if (!server) return "";
+  try {
+    return new URL(server.replace(/^ws/, "http")).hostname.split(".")[0];
+  } catch {
+    return server;
+  }
+}
+
+/** "Voxtral · mac-mini", "Voxtral · Mistral", "Nova-3 · Deepgram". */
+export function pushToTalkEngineLabel(engine: PushToTalkEngine, server: string | null): string {
+  if (engine === "cloud") return "Voxtral · Mistral";
+  if (engine === "deepgram") return "Nova-3 · Deepgram";
+  const name = pushToTalkServerName(server);
+  return name ? `Voxtral · ${name}` : "Voxtral";
+}
+
+const ENGINE_ICONS = { local: ServerIcon, cloud: CloudIcon, deepgram: ZapIcon } as const;
+
+function composerCard(element: Element | null): HTMLElement | null {
+  return element?.closest<HTMLElement>("[data-composer-card]") ?? null;
+}
+
+/**
+ * The mic button: hold it to talk. A mouse or a finger holds it with the
+ * pointer; Space or Enter holds it from the keyboard. On a touch screen,
+ * sliding off it to the left cancels the take.
+ */
+export function PushToTalkButton({
+  ptt,
+  disabled,
+  className,
+}: {
+  ptt: PushToTalk;
+  disabled?: boolean;
+  className?: string;
+}) {
+  const startX = useRef<number | null>(null);
+  const active = ptt.phase !== "idle";
+
+  const setSlide = (target: Element, px: number) => {
+    composerCard(target)?.style.setProperty("--ptt-slide", `${px}px`);
+  };
+
+  const onPointerDown = (event: PointerEvent<HTMLButtonElement>) => {
+    if (event.button !== 0 || disabled || active) return;
+    // Keep focus (and the caret) in the composer, and don't start a text selection.
+    event.preventDefault();
+    event.currentTarget.setPointerCapture(event.pointerId);
+    startX.current = event.clientX;
+    ptt.start("pointer", event.pointerType !== "mouse");
+  };
+  const onPointerMove = (event: PointerEvent<HTMLButtonElement>) => {
+    if (startX.current === null || ptt.phase !== "listening" || !ptt.touch) return;
+    const dx = Math.min(0, event.clientX - startX.current);
+    setSlide(event.currentTarget, dx);
+    if (dx < -SLIDE_TO_CANCEL_PX) {
+      startX.current = null;
+      setSlide(event.currentTarget, 0);
+      ptt.cancel();
+    }
+  };
+  const onPointerUp = (event: PointerEvent<HTMLButtonElement>) => {
+    if (startX.current === null) return;
+    startX.current = null;
+    setSlide(event.currentTarget, 0);
+    if (ptt.source === "pointer") ptt.release();
+  };
+  const onKeyDown = (event: KeyboardEvent<HTMLButtonElement>) => {
+    if (event.key !== " " && event.key !== "Enter") return;
+    event.preventDefault();
+    if (!event.repeat && !active && !disabled) ptt.start("pointer");
+  };
+  const onKeyUp = (event: KeyboardEvent<HTMLButtonElement>) => {
+    if (event.key !== " " && event.key !== "Enter") return;
+    event.preventDefault();
+    if (ptt.source === "pointer") ptt.release();
+  };
+
+  const label = `Hold to talk, or hold ${ptt.settings.key.label}`;
+  return (
+    <Button
+      type="button"
+      variant="ghost"
+      size="icon"
+      aria-label="Hold to talk"
+      aria-pressed={active}
+      title={active ? undefined : label}
+      disabled={disabled && !active}
+      data-ptt-keep
+      data-ptt-state={ptt.phase}
+      data-ptt-touch={ptt.touch ? "true" : undefined}
+      data-testid="push-to-talk-button"
+      className={cn(
+        "ptt-button relative size-8 shrink-0 touch-none select-none rounded-lg text-muted-foreground md:size-7",
+        className,
+      )}
+      onPointerDown={onPointerDown}
+      onPointerMove={onPointerMove}
+      onPointerUp={onPointerUp}
+      onPointerCancel={onPointerUp}
+      onLostPointerCapture={onPointerUp}
+      onKeyDown={onKeyDown}
+      onKeyUp={onKeyUp}
+      onContextMenu={(event) => event.preventDefault()}
+    >
+      <MicIcon className="relative z-[1] size-4" />
+    </Button>
+  );
+}
+
+/**
+ * What the composer's tools turn into while you talk: a recording dot, the
+ * time, a live waveform, which model is listening, and how to cancel.
+ *
+ * Once the take ends it stays a moment where it was, out of the row's flow,
+ * and fades out while the tools fade back in underneath it, so the row is
+ * never empty for a frame.
+ */
+export function PushToTalkBar({ ptt }: { ptt: PushToTalk }) {
+  const barRef = useRef<HTMLDivElement>(null);
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  // Where the bar sat in the row on the take's last frame.
+  const place = useRef<{ left: number; top: number; width: number; height: number } | null>(null);
+  // The take's waveform so far. It outlives the drawing effect, which restarts
+  // when listening turns to finishing, so letting go doesn't blank it.
+  const wave = useRef({ take: -1, history: [] as number[], smooth: 0, lastBar: 0 });
+  const [elapsed, setElapsed] = useState(0);
+  const { phase, startedAt, releasedAt } = ptt;
+  const level = ptt.level;
+
+  useEffect(() => {
+    if (phase === "idle") return;
+    const tick = () => setElapsed(((releasedAt ?? performance.now()) - startedAt) / 1000);
+    tick();
+    if (releasedAt !== null) return;
+    const timer = setInterval(tick, 250);
+    return () => clearInterval(timer);
+  }, [phase, startedAt, releasedAt]);
+
+  // The waveform, and the level the mic button's halo follows, at the
+  // display's frame rate. Bars slide between samples instead of jumping, and
+  // after you let go they keep sliding out while the level falls to silence.
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (phase === "idle" || !canvas) return;
+    const card = composerCard(canvas);
+    const state = wave.current;
+    if (state.take !== startedAt) {
+      state.take = startedAt;
+      state.history = [];
+      state.smooth = 0;
+      state.lastBar = performance.now();
+    }
+    const { history } = state;
+    let lastFrame = performance.now();
+    let frame = 0;
+    const draw = (now: number) => {
+      const dt = now - lastFrame;
+      lastFrame = now;
+      const bar = barRef.current;
+      if (bar) {
+        place.current = {
+          left: bar.offsetLeft,
+          top: bar.offsetTop,
+          width: bar.offsetWidth,
+          height: bar.offsetHeight,
+        };
+      }
+      const target = phase === "listening" ? level() : 0;
+      state.smooth += (target - state.smooth) * (1 - Math.pow(0.6, dt / 16.7));
+      card?.style.setProperty("--ptt-level", state.smooth.toFixed(3));
+      while (now - state.lastBar >= BAR_MS) {
+        history.push(state.smooth);
+        state.lastBar += BAR_MS;
+      }
+      // Only what fits on screen is ever drawn.
+      if (history.length > 400) history.splice(0, history.length - 400);
+      const dpr = window.devicePixelRatio || 1;
+      const w = canvas.clientWidth;
+      const h = canvas.clientHeight;
+      if (w > 0 && h > 0) {
+        if (canvas.width !== Math.round(w * dpr)) {
+          canvas.width = Math.round(w * dpr);
+          canvas.height = Math.round(h * dpr);
+        }
+        const ctx = canvas.getContext("2d");
+        if (ctx) {
+          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+          ctx.clearRect(0, 0, w, h);
+          ctx.fillStyle = getComputedStyle(canvas).color;
+          const shift = ((now - state.lastBar) / BAR_MS) * BAR_WIDTH;
+          const n = Math.ceil(w / BAR_WIDTH) + 1;
+          for (let k = 0; k < n; k++) {
+            const value = history[history.length - n + k] ?? 0;
+            const bh = Math.max(2, Math.min(h, value * h * 1.2));
+            const x = w - (n - k) * BAR_WIDTH + 2 - shift;
+            ctx.globalAlpha = 0.15 + 0.55 * (k / n);
+            ctx.beginPath();
+            if (ctx.roundRect) ctx.roundRect(x, (h - bh) / 2, 3, bh, 1.5);
+            else ctx.rect(x, (h - bh) / 2, 3, bh);
+            ctx.fill();
+          }
+          ctx.globalAlpha = 1;
+        }
+      }
+      frame = requestAnimationFrame(draw);
+    };
+    frame = requestAnimationFrame(draw);
+    return () => {
+      cancelAnimationFrame(frame);
+      card?.style.setProperty("--ptt-level", "0");
+    };
+  }, [phase, level, startedAt]);
+
+  // Pin the fading bar where it was before the row lays out its tools again.
+  const shown = ptt.cardState;
+  useLayoutEffect(() => {
+    const bar = barRef.current;
+    if (!bar) return;
+    const at = place.current;
+    if (shown === "ended" && at) {
+      bar.style.left = `${at.left}px`;
+      bar.style.top = `${at.top}px`;
+      bar.style.width = `${at.width}px`;
+      bar.style.height = `${at.height}px`;
+    } else {
+      for (const side of ["left", "top", "width", "height"] as const) bar.style[side] = "";
+    }
+  }, [shown]);
+
+  if (shown === "idle") return null;
+  const engine = ptt.settings.engine;
+  const Icon = ENGINE_ICONS[engine];
+  const seconds = Math.floor(elapsed);
+  return (
+    <div
+      ref={barRef}
+      className="ptt-bar"
+      data-ptt-keep
+      data-ptt-state={shown}
+      data-testid="push-to-talk-bar"
+      role="status"
+      aria-live="polite"
+    >
+      <span className="ptt-rec" aria-hidden />
+      <span className="ptt-label">{phase === "listening" ? "Listening" : "Finishing"}</span>
+      <span className="ptt-timer">
+        {Math.floor(seconds / 60)}:{String(seconds % 60).padStart(2, "0")}
+      </span>
+      <canvas ref={canvasRef} className="ptt-wave" aria-hidden />
+      <span className="ptt-chip" title={pushToTalkEngine(engine).name}>
+        <Icon className="size-3" aria-hidden />
+        {pushToTalkEngineLabel(engine, ptt.server)}
+      </span>
+      <span className="ptt-hint">{ptt.touch ? "‹ Slide to cancel" : "Esc cancels"}</span>
+      {/* Adding a node makes the action row re-measure whether its labels fit
+          now that the tools are back, instead of once the bar has gone. */}
+      {shown === "ended" && <span hidden />}
+    </div>
+  );
+}
+
+/** Split text into words and the whitespace between them, with where each starts. */
+function tokens(text: string): { text: string; at: number }[] {
+  const out: { text: string; at: number }[] = [];
+  let at = 0;
+  for (const token of text.split(/(\s+)/)) {
+    if (token) out.push({ text: token, at });
+    at += token.length;
+  }
+  return out;
+}
+
+/**
+ * The draft as the composer's backdrop draws it during a take: the words
+ * fade in as they arrive, and words that may still change are dimmed.
+ */
+export function PushToTalkWords({ region }: { region: PushToTalkRegion }) {
+  return (
+    <>
+      {region.before}
+      {region.lead}
+      {tokens(region.final).map((token) =>
+        /^\s+$/.test(token.text) ? (
+          token.text
+        ) : (
+          // Keyed by where the word starts: words only ever arrive after it.
+          <span key={`f${token.at}`} className="ptt-word">
+            {token.text}
+          </span>
+        ),
+      )}
+      {tokens(region.partial).map((token) =>
+        /^\s+$/.test(token.text) ? (
+          token.text
+        ) : (
+          <span key={`p${token.at}`} className="ptt-word ptt-word-partial">
+            {token.text}
+          </span>
+        ),
+      )}
+      {region.trail}
+      {region.after}
+    </>
+  );
+}
