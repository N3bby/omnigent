+                        aria-hidden
+                        className={cn(
+                          "size-1.5 rounded-full",
+                          option.billed ? "bg-amber-500" : "bg-emerald-500",
+                        )}
+                      />
+                      {option.billed ? "Billed per minute" : "Free · private"}
+                    </span>
+                  </span>
+                  <span className="text-ui font-normal text-muted-foreground">
+                    {option.description}
+                  </span>
+                </span>
+              ),
+            }))}
+          />
+        </div>
+      </SettingsGroup>
+
+      <SettingsGroup title="Talking" testId="push-to-talk-settings-talking">
+        <div className="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
+          <SettingsLabel
+            label="Push-to-talk key"
+            labelId={keyLabelId}
+            className="flex-1"
+            descriptionClassName="text-ui"
