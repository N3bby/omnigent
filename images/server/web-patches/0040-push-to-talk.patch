+// Tests for Settings → Speech: the model, the key, the words to listen for.
+
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { readPushToTalkSettings } from "@/lib/pushToTalk";
+import { PushToTalkSettingsBody } from "./PushToTalkSettings";
+
+const serverInfo = vi.hoisted(() => ({
+  push_to_talk_url: "wss://mac-mini.tail.ts.net:8443" as string | null,
+}));
+vi.mock("@/lib/CapabilitiesContext", () => ({ useServerInfo: () => serverInfo }));
+
+beforeEach(() => {
+  localStorage.clear();
+  serverInfo.push_to_talk_url = "wss://mac-mini.tail.ts.net:8443";
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () => new Response(null)),
+  );
+});
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+describe("Settings → Speech", () => {
+  it("picks the model, named after the speech server's machine", async () => {
+    render(<PushToTalkSettingsBody />);
+    expect(screen.getByText("Voxtral on mac-mini")).toBeInTheDocument();
+    expect(screen.getByTestId("push-to-talk-engine-local")).toHaveAttribute("aria-checked", "true");
+    fireEvent.click(screen.getByTestId("push-to-talk-engine-deepgram"));
+    expect(readPushToTalkSettings().engine).toBe("deepgram");
+    expect(screen.getByTestId("push-to-talk-engine-deepgram")).toHaveAttribute(
+      "aria-checked",
+      "true",
+    );
+    expect(await screen.findByText("Online")).toBeInTheDocument();
+  });
+
+  it("takes the next key pressed as the push-to-talk key", () => {
+    render(<PushToTalkSettingsBody />);
+    fireEvent.click(screen.getByTestId("push-to-talk-key-change"));
+    expect(screen.getByTestId("push-to-talk-key")).toHaveTextContent("Press a key…");
+    act(() => {
+      window.dispatchEvent(new KeyboardEvent("keydown", { key: "F13", code: "F13" }));
+    });
+    expect(readPushToTalkSettings().key).toEqual({ code: "F13", label: "F13" });
+    expect(screen.getByTestId("push-to-talk-key")).toHaveTextContent("F13");
+  });
+
+  it("adds and removes words to listen for", () => {
+    render(<PushToTalkSettingsBody />);
+    const input = screen.getByTestId("push-to-talk-hint-input");
+    fireEvent.change(input, { target: { value: "Omnigent, k3s" } });
+    fireEvent.keyDown(input, { key: "Enter" });
+    expect(readPushToTalkSettings().hints).toEqual(["Omnigent", "k3s"]);
+    fireEvent.click(screen.getByRole("button", { name: "Remove k3s" }));
+    expect(readPushToTalkSettings().hints).toEqual(["Omnigent"]);
+  });
+
+  it("sends on release when switched on", () => {
+    render(<PushToTalkSettingsBody />);
+    fireEvent.click(screen.getByTestId("push-to-talk-send-toggle"));
+    expect(readPushToTalkSettings().afterRelease).toBe("send");
+  });
+
+  it("explains how to turn it on when the deployment has no speech server", () => {
+    serverInfo.push_to_talk_url = null;
+    render(<PushToTalkSettingsBody />);
+    expect(screen.getByTestId("push-to-talk-settings-off")).toHaveTextContent("push_to_talk_url");
+  });
+});
