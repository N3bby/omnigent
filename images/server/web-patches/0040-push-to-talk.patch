+// Settings → Speech: which model listens, the push-to-talk key, the words to
+// listen for, what letting go does, and whether the speech server answers.
+// The choices are this browser's (lib/pushToTalk.ts); the server is the
+// deployment's (`push_to_talk_url`).
+
+import { useEffect, useId, useState } from "react";
+import { XIcon } from "lucide-react";
+import { SettingsGroup } from "@/components/SettingsGroup";
+import { SettingsLabel } from "@/components/SettingsLabel";
+import { CardRadioGroup } from "@/components/theme/CardRadioGroup";
+import { Button } from "@/components/ui/button";
+import { Switch } from "@/components/ui/switch";
+import { pushToTalkServerName } from "@/components/PushToTalk";
+import { useServerInfo } from "@/lib/CapabilitiesContext";
+import {
+  PUSH_TO_TALK_ENGINES,
+  pushToTalkEngine,
+  pushToTalkHttpUrl,
+  pushToTalkKeyLabel,
+  usePushToTalkSettings,
+  writePushToTalkSettings,
+  type PushToTalkEngine,
+} from "@/lib/pushToTalk";
+import { cn } from "@/lib/utils";
+
+type Reachability = "checking" | "online" | "offline";
+
+/** Whether the speech server answers. Its /info has no CORS headers, so an
+ *  opaque no-cors request is all a page can make: it resolves when the server
+ *  answers and rejects when it can't be reached. */
+function useReachability(server: string | null): Reachability {
+  const [state, setState] = useState<Reachability>("checking");
+  useEffect(() => {
+    if (!server) return;
+    let live = true;
+    setState("checking");
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), 5000);
+    // The speech server is its own origin, not the Omnigent API hostFetch serves.
+    // oxlint-disable-next-line no-restricted-globals
+    fetch(`${pushToTalkHttpUrl(server)}/info`, { mode: "no-cors", signal: controller.signal })
+      .then(() => live && setState("online"))
+      .catch(() => live && setState("offline"))
+      .finally(() => clearTimeout(timer));
+    return () => {
+      live = false;
+      controller.abort();
+      clearTimeout(timer);
+    };
+  }, [server]);
+  return state;
+}
+
+export function PushToTalkSettingsBody() {
+  const info = useServerInfo();
+  const server = info !== "loading" ? (info.push_to_talk_url ?? null) : null;
+  const settings = usePushToTalkSettings();
+  const reachability = useReachability(server);
+  const modelLabelId = useId();
+  const keyLabelId = useId();
+  const hintsLabelId = useId();
+  const sendLabelId = useId();
+  const [capturing, setCapturing] = useState(false);
+  const [hintDraft, setHintDraft] = useState("");
+  const engine = pushToTalkEngine(settings.engine);
+  const serverName = pushToTalkServerName(server);
+
+  // Changing the key: the next key pressed becomes it; Esc keeps the old one.
+  useEffect(() => {
+    if (!capturing) return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      event.preventDefault();
+      event.stopPropagation();
+      if (event.key !== "Escape") {
+        writePushToTalkSettings({
+          key: { code: event.code, label: pushToTalkKeyLabel(event.code, event.key) },
+        });
+      }
+      setCapturing(false);
+    };
+    window.addEventListener("keydown", onKeyDown, true);
+    return () => window.removeEventListener("keydown", onKeyDown, true);
+  }, [capturing]);
+
+  const addHint = () => {
+    const words = hintDraft
+      .split(",")
+      .map((word) => word.trim())
+      .filter((word) => word && !settings.hints.includes(word));
+    if (words.length)
+      writePushToTalkSettings({ hints: [...settings.hints, ...words].slice(0, 100) });
+    setHintDraft("");
+  };
+
+  if (info !== "loading" && !server) {
+    return (
+      <SettingsGroup title="Speech server" testId="push-to-talk-settings-off">
+        <p className="text-ui text-muted-foreground">
+          This deployment has no speech server, so push-to-talk is off. Set{" "}
+          <code>push_to_talk_url</code> in its environment file to turn it on.
+        </p>
+      </SettingsGroup>
+    );
+  }
+
+  return (
+    <div className="flex flex-col gap-6" data-testid="push-to-talk-settings">
+      <SettingsGroup title="Transcription model" testId="push-to-talk-settings-model">
+        <div className="flex flex-col gap-3">
+          <SettingsLabel
+            label="Model"
+            labelId={modelLabelId}
+            description="Which model turns your voice into text."
+            className="sr-only"
+          />
+          <CardRadioGroup<PushToTalkEngine>
+            labelledBy={modelLabelId}
+            value={settings.engine}
+            onSelect={(next) => writePushToTalkSettings({ engine: next })}
+            componentId="settings.speech.engine"
+            className="grid grid-cols-1 gap-2"
+            cardClassName="items-start gap-1 p-3.5 pr-10 text-left"
+            items={PUSH_TO_TALK_ENGINES.map((option) => ({
+              value: option.id,
