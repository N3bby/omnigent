diff --git a/web/src/lib/pushToTalk.test.ts b/web/src/lib/pushToTalk.test.ts
new file mode 100644
index 0000000..31691d3
--- /dev/null
+++ b/web/src/lib/pushToTalk.test.ts
@@ -0,0 +1,192 @@
+// Tests for push-to-talk's settings and its socket to the speech server.
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  DEFAULT_PUSH_TO_TALK_SETTINGS,
+  PushToTalkStream,
+  parsePushToTalkMessage,
+  pushToTalkHttpUrl,
+  pushToTalkKeyLabel,
+  pushToTalkStreamUrl,
+  readPushToTalkSettings,
+  writePushToTalkSettings,
+} from "./pushToTalk";
+
+describe("push-to-talk settings", () => {
+  beforeEach(() => localStorage.clear());
+
+  it("starts on Voxtral, Right ⌥ and keeping the words", () => {
+    expect(readPushToTalkSettings()).toEqual(DEFAULT_PUSH_TO_TALK_SETTINGS);
+  });
+
+  it("keeps what's written, and ignores what it can't read", () => {
+    writePushToTalkSettings({ engine: "deepgram", hints: ["Omnigent"], afterRelease: "send" });
+    expect(readPushToTalkSettings()).toMatchObject({
+      engine: "deepgram",
+      hints: ["Omnigent"],
+      afterRelease: "send",
+      key: { code: "AltRight" },
+    });
+    localStorage.setItem("omnigent:push-to-talk", '{"engine":"whisper","hints":[1,"k3s",""]}');
+    expect(readPushToTalkSettings()).toMatchObject({ engine: "local", hints: ["k3s"] });
+    localStorage.setItem("omnigent:push-to-talk", "not json");
+    expect(readPushToTalkSettings()).toEqual(DEFAULT_PUSH_TO_TALK_SETTINGS);
+  });
+
+  it("names keys the way a keyboard shows them", () => {
+    expect(pushToTalkKeyLabel("AltRight", "Alt")).toBe("Right ⌥");
+    expect(pushToTalkKeyLabel("F13", "F13")).toBe("F13");
+    expect(pushToTalkKeyLabel("KeyD", "d")).toBe("D");
+  });
+});
+
+describe("the speech server's URLs", () => {
+  it("asks for the chosen engine at Voxtral's 480 ms delay, with hints where they work", () => {
+    const local = new URL(
+      pushToTalkStreamUrl("wss://mac-mini.tail.ts.net:8443/", {
+        ...DEFAULT_PUSH_TO_TALK_SETTINGS,
+        hints: ["Omnigent"],
+      }),
+    );
+    expect(local.origin + local.pathname).toBe("wss://mac-mini.tail.ts.net:8443/stream");
+    expect(local.searchParams.get("engines")).toBe("local");
+    expect(local.searchParams.get("delay")).toBe("480");
+    // Voxtral on the server can't take hints, so none are sent.
+    expect(local.searchParams.getAll("hint")).toEqual([]);
+
+    const cloud = new URL(
+      pushToTalkStreamUrl("https://speech.example", {
+        ...DEFAULT_PUSH_TO_TALK_SETTINGS,
+        engine: "cloud",
+        hints: ["Omnigent", "k3s"],
+      }),
+    );
+    expect(cloud.protocol).toBe("wss:");
+    expect(cloud.searchParams.getAll("hint")).toEqual(["Omnigent", "k3s"]);
+  });
+
+  it("checks the server over https", () => {
+    expect(pushToTalkHttpUrl("wss://mac-mini.tail.ts.net:8443")).toBe(
+      "https://mac-mini.tail.ts.net:8443",
+    );
+  });
+});
+
+describe("parsePushToTalkMessage", () => {
+  it("reads the engine's frames and drops other engines'", () => {
+    expect(parsePushToTalkMessage('{"type":"ready","engines":["local"]}', "local")).toEqual({
+      type: "ready",
+    });
+    expect(
+      parsePushToTalkMessage('{"source":"local","type":"text","text":" Hi"}', "local"),
+    ).toEqual({ type: "text", text: " Hi" });
+    expect(parsePushToTalkMessage('{"source":"cloud","type":"text","text":"x"}', "local")).toBe(
+      null,
+    );
+    expect(
+      parsePushToTalkMessage('{"source":"deepgram","type":"partial","text":"hel"}', "deepgram"),
+    ).toEqual({ type: "partial", text: "hel" });
+    expect(
+      parsePushToTalkMessage('{"source":"local","type":"error","message":"busy"}', "local"),
+    ).toEqual({ type: "error", message: "busy" });
+    expect(parsePushToTalkMessage("garbage", "local")).toBe(null);
+  });
+});
+
+class FakeSocket extends EventTarget {
+  static last: FakeSocket | null = null;
+  static OPEN = 1;
+  static CONNECTING = 0;
+  readyState = 0;
+  binaryType = "blob";
+  sent: unknown[] = [];
+  url: string;
+  constructor(url: string) {
+    super();
+    this.url = url;
+    FakeSocket.last = this;
+  }
+  send(data: unknown) {
+    this.sent.push(data);
+  }
+  close() {
+    if (this.readyState === 3) return;
+    this.readyState = 3;
+    this.dispatchEvent(new Event("close"));
+  }
+  open() {
+    this.readyState = 1;
+    this.dispatchEvent(new Event("open"));
+  }
+  message(data: object) {
+    this.dispatchEvent(new MessageEvent("message", { data: JSON.stringify(data) }));
+  }
+}
+
+describe("PushToTalkStream", () => {
+  const track = { stop: vi.fn() };
+  beforeEach(() => {
+    vi.stubGlobal("WebSocket", FakeSocket);
+    track.stop.mockClear();
+    vi.stubGlobal("navigator", {
+      mediaDevices: { getUserMedia: vi.fn(async () => ({ getTracks: () => [track] })) },
+    });
+    // No AudioContext in jsdom: the microphone opens, the graph fails, and
+    // the stream reports it, which the tests below don't reach.
+  });
+  afterEach(() => vi.unstubAllGlobals());
+
+  it("streams the engine's words and stops on request", async () => {
+    const events = { onText: vi.fn(), onPartial: vi.fn(), onError: vi.fn() };
+    const stream = PushToTalkStream.start(
+      "wss://speech.example",
+      DEFAULT_PUSH_TO_TALK_SETTINGS,
+      events,
+    );
+    const ws = FakeSocket.last!;
+    ws.open();
+    ws.message({ type: "ready" });
+    ws.message({ source: "local", type: "text", text: " Hello" });
+    ws.message({ source: "cloud", type: "text", text: " ignored" });
+    expect(events.onText).toHaveBeenCalledWith(" Hello");
+    expect(events.onText).toHaveBeenCalledTimes(1);
+
+    const stopped = stream.stop();
+    await vi.waitFor(() => expect(ws.sent).toContainEqual(JSON.stringify({ type: "stop" })));
+    ws.message({ source: "local", type: "done", tail: 0.8 });
+    ws.close();
+    await stopped;
+    expect(events.onError).not.toHaveBeenCalled();
+  });
+
+  it("closes at once when cancelled, releasing the microphone", async () => {
+    const events = { onText: vi.fn(), onPartial: vi.fn(), onError: vi.fn() };
+    const stream = PushToTalkStream.start(
+      "wss://speech.example",
+      DEFAULT_PUSH_TO_TALK_SETTINGS,
+      events,
+    );
+    const ws = FakeSocket.last!;
+    ws.open();
+    stream.cancel();
+    expect(ws.readyState).toBe(3);
+    expect(events.onError).not.toHaveBeenCalled();
+  });
+
+  it("reports the server's error, such as a busy model, and closes", () => {
+    const events = { onText: vi.fn(), onPartial: vi.fn(), onError: vi.fn() };
+    PushToTalkStream.start("wss://speech.example", DEFAULT_PUSH_TO_TALK_SETTINGS, events);
+    const ws = FakeSocket.last!;
+    ws.open();
+    ws.message({ source: "local", type: "error", message: "Someone else is using the model." });
+    expect(events.onError).toHaveBeenCalledWith("Someone else is using the model.");
+    expect(ws.readyState).toBe(3);
+  });
+
+  it("says so when the server can't be reached", () => {
+    const events = { onText: vi.fn(), onPartial: vi.fn(), onError: vi.fn() };
+    PushToTalkStream.start("wss://speech.example", DEFAULT_PUSH_TO_TALK_SETTINGS, events);
+    FakeSocket.last!.dispatchEvent(new Event("error"));
+    expect(events.onError).toHaveBeenCalledWith("Omnigent can't reach the speech server.");
+  });
+});
diff --git a/web/src/lib/pushToTalk.ts b/web/src/lib/pushToTalk.ts
