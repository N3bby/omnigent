+// ── File index (every path, for the fuzzy "@" picker) ─────────────────────────
+
+export interface WorkspaceFileIndex {
+  /** Every file path in the workspace, relative to its root. */
+  paths: string[];
+  /** True when the runner stopped listing at its limit (50,000 paths). */
+  truncated: boolean;
+}
+
+async function fetchWorkspaceFileIndex(conversationId: string): Promise<WorkspaceFileIndex | null> {
+  const res = await authenticatedFetch(
+    `/v1/sessions/${encodeURIComponent(conversationId)}/resources/environments/${DEFAULT_ENVIRONMENT_ID}/file-index`,
+  );
+  // No OS environment, or a runner from before the file index: the picker
+  // falls back to browsing folders.
+  if (res.status === 404) return null;
+  if (await isRunnerUnavailable503(res)) return null;
+  if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
+  const body = (await res.json()) as { paths?: string[]; truncated?: boolean };
+  return { paths: body.paths ?? [], truncated: body.truncated === true };
+}
