+import { describe, expect, it } from "vitest";
+import { buildFuzzyPathIndex, fuzzyMatchPaths, fuzzyMentionScope } from "./fuzzyPathMatch";
+
+const PATHS = [
+  "README.md",
+  "src/auth.ts",
+  "src/components/AgentHoverCard.tsx",
+  "src/lib/composerMentions.ts",
+  "src/lib/markdownFence.ts",
+  "src/pages/ChatPage.tsx",
+  "src/pages/ChatPage.test.ts",
+  "tests/auth/test_login.py",
+];
+
+function match(query: string, within = "") {
+  return fuzzyMatchPaths(buildFuzzyPathIndex(PATHS), query, within).map((m) => m.path);
+}
+
+describe("buildFuzzyPathIndex", () => {
+  it("adds every folder on the way to a file, once", () => {
+    const index = buildFuzzyPathIndex(PATHS);
+    expect([...index.dirs].sort()).toEqual([
+      "src",
+      "src/components",
+      "src/lib",
+      "src/pages",
+      "tests",
+      "tests/auth",
+    ]);
+    expect(index.paths.filter((_, i) => index.isDir[i])).toHaveLength(6);
+  });
+});
+
+describe("fuzzyMatchPaths", () => {
+  it("matches the query's characters in order, gaps allowed", () => {
+    expect(match("cmpmen")).toEqual(["src/lib/composerMentions.ts"]);
+  });
+
+  it("ranks an exact file name first", () => {
+    expect(match("chatpage")[0]).toBe("src/pages/ChatPage.tsx");
+    expect(match("auth")[0]).toBe("src/auth.ts");
+  });
+
+  it("prefers a tight match in the name over letters spread across the path", () => {
+    expect(match("men", "src/lib")).toEqual([
+      "src/lib/composerMentions.ts",
+      "src/lib/markdownFence.ts",
+    ]);
+  });
+
+  it("returns where it matched, preferring the file name", () => {
+    const [top] = fuzzyMatchPaths(buildFuzzyPathIndex(PATHS), "auth");
+    expect(top.positions).toEqual([4, 5, 6, 7]);
+  });
+
+  it("ignores case unless the query has an uppercase letter", () => {
+    expect(match("readme")).toEqual(["README.md"]);
+    expect(match("Readme")).toEqual([]);
+    expect(match("CP")).toContain("src/pages/ChatPage.tsx");
+  });
+
+  it("offers folders as well as files", () => {
+    expect(match("components")).toContain("src/components");
+  });
+
+  it("only searches under the given folder, matching the rest of the path", () => {
+    expect(match("auth", "tests")).toEqual(["tests/auth", "tests/auth/test_login.py"]);
+    expect(match("src", "src")).not.toContain("src");
+  });
+
+  it("skips paths early without changing the results", () => {
+    // Once the list is full, paths that can't beat its last entry are skipped
+    // before matching. A short list must still be the long list's head.
+    const index = buildFuzzyPathIndex(PATHS);
+    for (const query of ["a", "s", "ts", "auth", "Chat", "test"]) {
+      const all = fuzzyMatchPaths(index, query, "", 100);
+      for (const cap of [1, 2, 3]) {
+        expect(fuzzyMatchPaths(index, query, "", cap)).toEqual(all.slice(0, cap));
+      }
+    }
+  });
+
+  it("keeps the best matches up to the cap", () => {
+    const index = buildFuzzyPathIndex(PATHS);
+    expect(fuzzyMatchPaths(index, "s", "", 2)).toHaveLength(2);
+    expect(fuzzyMatchPaths(index, "", "", 10)).toEqual([]);
+  });
+});
+
+describe("fuzzyMentionScope", () => {
+  const index = buildFuzzyPathIndex(PATHS);
+
+  it("browses for a bare @ and for a folder ending in a slash", () => {
+    expect(fuzzyMentionScope(index, "")).toBeNull();
+    expect(fuzzyMentionScope(index, "/")).toBeNull();
+    expect(fuzzyMentionScope(index, "src/lib/")).toBeNull();
+  });
+
+  it("searches everywhere for a name", () => {
+    expect(fuzzyMentionScope(index, "auth")).toEqual({ within: "", query: "auth" });
+  });
+
+  it("searches under a known folder for what follows it", () => {
+    expect(fuzzyMentionScope(index, "src/lib/comp")).toEqual({ within: "src/lib", query: "comp" });
+  });
+
+  it("searches everywhere for the whole text when no such folder exists", () => {
+    expect(fuzzyMentionScope(index, "srv/auth")).toEqual({ within: "", query: "srv/auth" });
+    expect(fuzzyMentionScope(index, "nope/")).toEqual({ within: "", query: "nope/" });
+  });
+});
