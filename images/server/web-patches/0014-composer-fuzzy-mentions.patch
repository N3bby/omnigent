+++ b/web/src/lib/fuzzyPathMatch.ts
@@ -0,0 +1,311 @@
+/**
+ * fzf-style fuzzy matching over every path in a workspace, for the composer's
+ * ``@``-file-mention menu. The query's characters must appear in the path in
+ * order but not necessarily together, so ``@ath`` finds ``src/auth.ts``, the
+ * way Claude Code's and Codex's own ``@`` pickers work.
+ *
+ * Kept free of React so the ranking is unit-testable. The index is built once
+ * per file listing; each keystroke then scans it, which stays well under a
+ * frame for tens of thousands of paths.
+ */
+
+/** Every file in the workspace plus the folders derived from them. */
+export interface FuzzyPathIndex {
+  paths: string[];
+  lowerPaths: string[];
+  isDir: boolean[];
+  /** One bit per letter a-z each path contains, to skip hopeless paths fast. */
+  letters: Int32Array;
+  /** Where each path's file or folder name starts, after its last "/". */
+  nameStarts: Int32Array;
+  /** Like ``letters``, for the file or folder name alone. */
+  nameLetters: Int32Array;
+  dirs: Set<string>;
+}
+
+/** One ranked match, with the matched characters' offsets for highlighting. */
+export interface FuzzyPathMatch {
+  path: string;
+  isDir: boolean;
+  score: number;
+  positions: number[];
+}
+
+/** Default cap on how many fuzzy matches the menu renders. */
+export const FUZZY_MATCH_CAP = 50;
+
+// fzf's scores: a matched character, the bonus for where it sits, and the
+// cost of skipping characters between matches.
+const SCORE_MATCH = 16;
+const BONUS_AFTER_SLASH = 10;
+const BONUS_BOUNDARY = 8;
+const BONUS_CAMEL = 7;
+const BONUS_CONSECUTIVE = 4;
+const PENALTY_GAP_START = 3;
+const PENALTY_GAP_EXTENSION = 1;
+// Ours on top: matches in the file or folder name beat matches in the folders
+// above it, as in Claude Code's picker.
+const BONUS_IN_NAME = 24;
+const BONUS_NAME_PREFIX = 16;
+const BONUS_EXACT_NAME = 40;
+// A file is what you usually mean, so a folder needs a clearly better match:
+// "auth" puts auth.py ahead of a tests/auth/ folder with a shorter path.
+const PENALTY_FOLDER = 4;
+
+function letterBits(text: string): number {
+  let bits = 0;
+  for (let i = 0; i < text.length; i++) {
+    const c = text.charCodeAt(i);
+    if (c >= 97 && c <= 122) bits |= 1 << (c - 97);
+  }
+  return bits;
+}
+
+/**
+ * Build the index from the workspace's file paths. Every folder on the way
+ * to a file becomes a candidate too, so ``@comp`` can attach ``components/``.
+ */
+export function buildFuzzyPathIndex(filePaths: readonly string[]): FuzzyPathIndex {
+  const dirs = new Set<string>();
+  for (const path of filePaths) {
+    for (let i = path.indexOf("/"); i > 0; i = path.indexOf("/", i + 1)) {
+      dirs.add(path.slice(0, i));
+    }
+  }
+  const paths = [...filePaths, ...dirs];
+  const lowerPaths = paths.map((p) => p.toLowerCase());
+  const letters = new Int32Array(paths.length);
+  const nameStarts = new Int32Array(paths.length);
+  const nameLetters = new Int32Array(paths.length);
+  lowerPaths.forEach((p, i) => {
+    // One pass: the path's letters, and the name's, restarted at each "/".
+    let bits = 0;
+    let nameBits = 0;
+    let nameStart = 0;
+    for (let at = 0; at < p.length; at++) {
+      const c = p.charCodeAt(at);
+      if (c >= 97 && c <= 122) {
+        bits |= 1 << (c - 97);
+        nameBits |= 1 << (c - 97);
+      } else if (c === 47) {
+        nameBits = 0;
+        nameStart = at + 1;
+      }
+    }
+    letters[i] = bits;
+    nameStarts[i] = nameStart;
+    nameLetters[i] = nameBits;
+  });
+  const isDir = paths.map((_, i) => i >= filePaths.length);
+  return { paths, lowerPaths, isDir, letters, nameStarts, nameLetters, dirs };
+}
+
+/** Leftmost positions of ``needle`` in ``text`` as a subsequence, from ``from``. */
+function forwardMatch(text: string, needle: string, from: number): number[] | null {
+  const positions: number[] = [];
+  let at = from - 1;
+  for (let i = 0; i < needle.length; i++) {
+    at = text.indexOf(needle[i], at + 1);
+    if (at < 0) return null;
+    positions.push(at);
+  }
+  return positions;
+}
+
+/**
+ * The tightest match ending where the leftmost one does: walk back from its
+ * last character to find the latest start, then match forward from there.
+ * ``a/b/auth`` for ``auth`` thus matches the filename, not the scattered
+ * ``a…u…t…h``.
+ */
+function tightMatch(text: string, needle: string, from: number): number[] | null {
+  const leftmost = forwardMatch(text, needle, from);
+  // One letter can't be matched any tighter.
+  if (!leftmost || needle.length === 1) return leftmost;
+  const end = leftmost[leftmost.length - 1];
+  // A tighter match starts at a later copy of the first letter, with room for
+  // the other letters before ``end``. Without one, it's the leftmost match.
+  const next = text.indexOf(needle[0], leftmost[0] + 1);
+  if (next < 0 || next > end - (needle.length - 1)) return leftmost;
+  let at = end + 1;
+  for (let i = needle.length - 1; i >= 0; i--) {
+    at = text.lastIndexOf(needle[i], at - 1);
+  }
+  // The latest start is never before the leftmost one. When they're the same,
+  // matching forward again would only rebuild the leftmost match.
+  if (at <= leftmost[0]) return leftmost;
+  return forwardMatch(text, needle, at) ?? leftmost;
+}
+
+/** "/", "-", "_", "." or a space, by character code. */
+function isSeparator(c: number): boolean {
+  return c === 47 || c === 45 || c === 95 || c === 46 || c === 32;
+}
+
+function bonusAt(path: string, lower: string, at: number, from: number): number {
+  if (at === from) return BONUS_AFTER_SLASH;
+  const before = path.charCodeAt(at - 1);
+  if (before === 47) return BONUS_AFTER_SLASH;
+  if (isSeparator(before)) return BONUS_BOUNDARY;
+  // A lowercase-to-uppercase step, e.g. the M in "composerMentions".
+  if (before === lower.charCodeAt(at - 1) && path.charCodeAt(at) !== lower.charCodeAt(at)) {
+    return BONUS_CAMEL;
+  }
+  return 0;
+}
+
+function scorePositions(
+  path: string,
+  lower: string,
+  positions: number[],
+  from: number,
+  nameStart: number,
+  needle: string,
+): number {
+  let score = 0;
+  let chunkBonus = 0;
+  for (let i = 0; i < positions.length; i++) {
+    const at = positions[i];
+    let bonus = bonusAt(path, lower, at, from);
+    const gap = i === 0 ? -1 : at - positions[i - 1] - 1;
+    if (gap === 0) {
+      // As in fzf, a run of consecutive matches keeps the bonus of where it
+      // started, so "Men" in "composerMentions" counts as a camel-case hit.
+      if (bonus >= BONUS_BOUNDARY && bonus > chunkBonus) chunkBonus = bonus;
+      bonus = Math.max(bonus, chunkBonus, BONUS_CONSECUTIVE);
+    } else {
+      chunkBonus = bonus;
+      if (gap > 0) score -= PENALTY_GAP_START + (gap - 1) * PENALTY_GAP_EXTENSION;
+    }
+    // Where the match starts matters most.
+    score += SCORE_MATCH + (i === 0 ? bonus * 2 : bonus);
+  }
+  if (positions[0] >= nameStart) {
+    score += BONUS_IN_NAME;
+    const name = lower.slice(nameStart);
+    const lowerNeedle = needle.toLowerCase();
+    if (name.startsWith(lowerNeedle)) score += BONUS_NAME_PREFIX;
+    const dot = name.lastIndexOf(".");
+    if (name === lowerNeedle || (dot > 0 && name.slice(0, dot) === lowerNeedle)) {
+      score += BONUS_EXACT_NAME;
+    }
+  }
+  // Shorter paths first, all else being equal.
+  return score + Math.max(0, 24 - ((path.length - from) >> 2));
+}
+
+function better(a: FuzzyPathMatch, b: FuzzyPathMatch): boolean {
+  if (a.score !== b.score) return a.score > b.score;
+  if (a.isDir !== b.isDir) return !a.isDir;
+  if (a.path.length !== b.path.length) return a.path.length < b.path.length;
+  return a.path < b.path;
+}
+
+/**
+ * Rank the index's paths against ``query``, best first.
+ *
+ * A query with an uppercase letter matches case-sensitively; otherwise case
+ * is ignored. With ``within`` set (a folder from the index), only paths under
+ * it are candidates and ``query`` is matched against the part after
+ * ``within/``, so ``@src/au`` searches all of ``src`` recursively.
+ *
+ * :param index: From :func:`buildFuzzyPathIndex`.
+ * :param query: The typed text, e.g. ``"auth"``. Empty matches nothing.
+ * :param within: Folder to search under, e.g. ``"src"``; ``""`` for all.
+ * :param cap: Maximum number of matches, e.g. ``50``.
+ */
+export function fuzzyMatchPaths(
+  index: FuzzyPathIndex,
+  query: string,
+  within = "",
+  cap: number = FUZZY_MATCH_CAP,
+): FuzzyPathMatch[] {
+  if (!query || cap <= 0) return [];
+  const caseSensitive = query !== query.toLowerCase();
+  const needle = caseSensitive ? query : query.toLowerCase();
+  const needed = letterBits(query.toLowerCase());
+  const prefix = within ? `${within}/` : "";
+  const lowerNeedle = needle.toLowerCase();
+  // The most the letters can score, before any name bonus: the first at the
+  // biggest position bonus (doubled), the rest at the biggest too, no gaps.
+  const maxLetters =
+    SCORE_MATCH + 2 * BONUS_AFTER_SLASH + (needle.length - 1) * (SCORE_MATCH + BONUS_AFTER_SLASH);
+  const top: FuzzyPathMatch[] = [];
+  const { paths, lowerPaths, isDir, letters, nameStarts, nameLetters } = index;
+  for (let i = 0; i < paths.length; i++) {
+    if ((letters[i] & needed) !== needed) continue;
+    const path = paths[i];
+    if (prefix && (!path.startsWith(prefix) || path.length === prefix.length)) continue;
+    const lower = lowerPaths[i];
+    const from = prefix.length;
+    const nameStart = Math.max(from, nameStarts[i]);
+    // Once the top list is full, skip a path whose best possible score can't
+    // beat its last entry, before matching it at all. Only a name that starts
+    // with the query can earn the name prefix and exact-name bonuses.
+    if (top.length === cap) {
+      let best = maxLetters + Math.max(0, 24 - ((path.length - from) >> 2));
+      // Name bonuses need every letter of the query in the name.
+      if ((nameLetters[i] & needed) === needed) {
+        best += BONUS_IN_NAME;
+        if (lower.startsWith(lowerNeedle, nameStart)) {
+          best += BONUS_NAME_PREFIX;
+          const end = nameStart + lowerNeedle.length;
+          if (end === lower.length || (lower[end] === "." && lower.lastIndexOf(".") === end)) {
+            best += BONUS_EXACT_NAME;
+          }
+        }
+      }
+      if (isDir[i]) best -= PENALTY_FOLDER;
+      // Strictly below: an equal score could still win the tie-break.
+      if (best < top[cap - 1].score) continue;
+    }
+    const text = caseSensitive ? path : lower;
+    const anywhere = tightMatch(text, needle, from);
+    if (!anywhere) continue;
+    let positions = anywhere;
+    let score = scorePositions(path, lower, anywhere, from, nameStart, needle);
+    // A match inside the file or folder name usually beats one spread across
+    // the path, but scoring both lets a strong path match still win.
+    if (anywhere[0] < nameStart && (nameLetters[i] & needed) === needed) {
+      const inName = tightMatch(text, needle, nameStart);
+      if (inName) {
+        const nameScore = scorePositions(path, lower, inName, from, nameStart, needle);
+        if (nameScore > score) {
+          positions = inName;
+          score = nameScore;
+        }
+      }
+    }
+    if (isDir[i]) score -= PENALTY_FOLDER;
+    const match = { path, isDir: isDir[i], score, positions };
+    if (top.length === cap && !better(match, top[top.length - 1])) continue;
+    let at = top.length;
+    while (at > 0 && better(match, top[at - 1])) at--;
+    top.splice(at, 0, match);
+    if (top.length > cap) top.pop();
+  }
+  return top;
+}
+
+/**
+ * Decide whether a mention token is a fuzzy search, and over what.
+ *
+ * ``""`` and ``"<folder>/"`` keep browsing that folder, which is how Enter on
+ * a folder drills in. ``"<folder>/rest"`` searches that folder recursively
+ * for ``rest``. Anything else, including a slash path that names no folder
+ * (``"srv/auth"``), searches the whole workspace for the full text.
+ *
+ * :returns: ``{ within, query }`` for :func:`fuzzyMatchPaths`, or ``null``
+ *     to browse instead.
+ */
+export function fuzzyMentionScope(
+  index: FuzzyPathIndex,
+  token: string,
+): { within: string; query: string } | null {
+  const slash = token.lastIndexOf("/");
+  if (slash < 0) return token ? { within: "", query: token } : null;
+  const dir = token.slice(0, slash);
+  const rest = token.slice(slash + 1);
+  if (dir === "" || index.dirs.has(dir)) return rest ? { within: dir, query: rest } : null;
+  return { within: "", query: token };
+}
