+
+// test-setup replaces react-virtual with a pass-through that renders every
+// row; what's under test here is which rows the real one measures, so use it,
+// and give rows the size jsdom's lack of layout leaves out.
+vi.mock("@tanstack/react-virtual", async (importOriginal) => await importOriginal());
+
+// Every row is 100px tall, against the virtualizer's 280px estimate, so the
+// list's height tells how many rows have been measured.
+const ROW_PX = 100;
+const GAP_PX = 16;
+const measuredHeight = (rows: number) => rows * ROW_PX + (rows - 1) * GAP_PX;
+
+const user = (n: number): Bubble => ({
+  kind: "user",
+  itemId: `user-${n}`,
+  content: [{ type: "input_text", text: `message ${n}` }],
+});
+const users = (from: number, to: number) =>
+  Array.from({ length: to - from }, (_, i) => user(from + i));
+
+function scrollElement(): HTMLElement {
+  const el = document.createElement("div");
+  Object.defineProperties(el, {
+    scrollTop: { configurable: true, writable: true, value: 0 },
+    clientHeight: { configurable: true, value: 500 },
+    offsetHeight: { configurable: true, value: 500 },
+    offsetWidth: { configurable: true, value: 800 },
+    scrollHeight: { configurable: true, value: 100_000 },
+  });
+  el.getBoundingClientRect = () => ({ top: 0, height: 500 }) as DOMRect;
+  el.scrollTo = ((options: ScrollToOptions) => {
+    el.scrollTop = options.top ?? el.scrollTop;
+  }) as typeof el.scrollTo;
+  document.body.append(el);
+  return el;
+}
+
+function transcript(bubbles: Bubble[], scrollEl: HTMLElement) {
+  return (
+    <Conversation>
+      <ConversationContent>
+        <VirtualBubbleList
+          bubbles={bubbles}
+          scrollEl={scrollEl}
+          lastAssistantIndex={-1}
+          showsWorking={false}
+          sessionIdle
+          conversationId="conv-1"
+          hasTasks={false}
+          disableVirtualization={false}
+          onGeometryChange={vi.fn()}
+        />
+      </ConversationContent>
+    </Conversation>
+  );
+}
+
+function listHeight(view: ReturnType<typeof render>): number {
+  const row = view.container.querySelector<HTMLElement>("[data-index]")!;
+  return parseFloat(row.parentElement!.style.height);
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.spyOn(HTMLElement.prototype, "offsetHeight", "get").mockImplementation(function (
+    this: HTMLElement,
+  ) {
+    return this.dataset.index === undefined ? 0 : ROW_PX;
+  });
+  const rect = HTMLElement.prototype.getBoundingClientRect;
+  vi.spyOn(HTMLElement.prototype, "getBoundingClientRect").mockImplementation(function (
+    this: HTMLElement,
+  ) {
+    return this.dataset.index === undefined
+      ? rect.call(this)
+      : ({ top: 0, height: ROW_PX, width: 800 } as DOMRect);
+  });
+});
+
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+  document.body.innerHTML = "";
+});
+
+it("measures every row of a history page in the commit that lands it", () => {
+  const scrollEl = scrollElement();
+  const view = render(transcript(users(40, 43), scrollEl));
+  expect(listHeight(view)).toBe(measuredHeight(3));
+
+  // A page of 30 older rows lands. Most sit far outside the window, but the
+  // reader scrolls into them next, so none may be left at the estimate.
+  view.rerender(transcript(users(10, 43), scrollEl));
+
+  expect(listHeight(view)).toBe(measuredHeight(33));
+});
+
+it("measures the rows outside the window while the pane is idle", () => {
+  const scrollEl = scrollElement();
+  const view = render(transcript(users(0, 40), scrollEl));
+  const opened = listHeight(view);
+  expect(opened).toBeGreaterThan(measuredHeight(40));
+
+  act(() => vi.advanceTimersByTime(2_000));
+
+  expect(listHeight(view)).toBe(measuredHeight(40));
+  // Rows mounted only to be measured leave again.
+  expect(view.container.querySelectorAll("[data-index]").length).toBeLessThan(40);
+});
+
+it("leaves the measuring to after a touch on the pane ends", () => {
+  const scrollEl = scrollElement();
+  const view = render(transcript(users(0, 40), scrollEl));
+  const opened = listHeight(view);
+
+  scrollEl.dispatchEvent(new Event("touchstart"));
+  act(() => vi.advanceTimersByTime(2_000));
+  expect(listHeight(view)).toBe(opened);
+
+  scrollEl.dispatchEvent(new Event("touchend"));
+  act(() => vi.advanceTimersByTime(2_000));
+  expect(listHeight(view)).toBe(measuredHeight(40));
+});
