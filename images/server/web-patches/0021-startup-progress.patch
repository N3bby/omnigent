+            {problem.log.trim()}
+          </pre>
+          {problem.source && (
+            <span className="font-mono text-[11px] text-muted-foreground">{problem.source}</span>
+          )}
+        </div>
+      )}
+      <div className="flex flex-wrap gap-1.5">
+        {tone === "failed" && canRetry && (
+          <Button
+            type="button"
+            size="sm"
+            variant="default"
+            disabled={retry.isPending}
+            onClick={() =>
+              retry.mutate(undefined, {
+                onError: (error) =>
+                  toast.error(
+                    `Couldn't start the sandbox${error instanceof Error && error.message ? `: ${error.message}` : ""}.`,
+                  ),
+              })
+            }
+          >
+            {retry.isPending ? (
+              <Loader2Icon className="size-3.5 animate-spin" aria-hidden />
+            ) : (
+              <RotateCcwIcon className="size-3.5" aria-hidden />
+            )}
+            Try again
+          </Button>
+        )}
+        {cloneProblem && (
+          <Button size="sm" variant="outline" asChild>
+            <Link to="/settings/repo-env">Repository variables</Link>
+          </Button>
+        )}
+        <Button type="button" size="sm" variant="outline" onClick={onShowLog}>
+          <ScrollTextIcon className="size-3.5" aria-hidden />
+          Show log
+        </Button>
+        <Button
+          type="button"
+          size="sm"
+          variant="ghost"
+          onClick={() =>
+            void copyText(problemDetails(problem)).then(
+              () => toast.success("Copied the error details."),
+              () => toast.error("Couldn't copy the error details."),
+            )
+          }
+        >
+          <CopyIcon className="size-3.5" aria-hidden />
+          Copy error details
+        </Button>
+        {onDismiss && (
+          <Button type="button" size="sm" variant="ghost" onClick={onDismiss}>
+            Dismiss
+          </Button>
+        )}
+      </div>
+      {tone === "failed" && !canRetry && (
+        <p className="text-xs text-muted-foreground">Your next message starts it again.</p>
+      )}
+    </div>
+  );
+}
+
+/** What the card's header says. */
+function headline(
+  startup: SandboxStartup,
+  now: number,
+): { title: string; note: string | null; state: StartupState; tone: "warning" | null } {
+  const total = (startup.endedAt ?? now) - startup.startedAt;
+  if (startup.outcome === "failed") {
+    return {
+      title: "The sandbox couldn't start",
+      note: `after ${formatStepDuration(total)}`,
+      state: "failed",
+      tone: null,
+    };
+  }
+  if (startup.outcome === "cancelled") {
+    return { title: "Start cancelled", note: null, state: "skipped", tone: null };
+  }
+  if (startup.outcome === "ready") {
+    const setup = startup.steps.find((s) => s.id === "setup");
+    const note = startup.warning
+      ? "a setup script failed"
+      : setup?.state === "running"
+        ? "a setup script is still running"
+        : null;
+    return {
+      title: `Sandbox ready in ${formatStepDuration(total)}`,
+      note,
+      state: startup.warning ? "failed" : "done",
+      tone: startup.warning ? "warning" : null,
+    };
+  }
+  const waiting = startup.steps.some((s) => s.state === "running" && s.tone === "warning");
+  return {
+    title: startup.kind === "wake" ? "Starting your sandbox again" : "Starting your sandbox",
+    note: waiting ? "waiting" : null,
+    state: "running",
+    tone: waiting ? "warning" : null,
+  };
+}
+
+/**
+ * How the session's sandbox start is going: each step with its time, what
+ * went wrong in plain words, and a link to the full startup log.
+ *
+ * Open while the sandbox starts or after it failed; a finished start folds
+ * into one line ("Sandbox ready in 30s") that opens again on click.
+ */
+export function SandboxStartupCard({
+  startup,
+  sessionId,
+  canRetry,
+  agentLabel = null,
+  onDismiss,
+  className,
+}: {
+  startup: SandboxStartup;
+  sessionId: string;
+  /** Whether Try again can start the sandbox without a message. */
+  canRetry: boolean;
+  /** e.g. `"Claude Code"`, for the agent step. */
+  agentLabel?: string | null;
+  /** Hides a finished start's warning (a failed setup script). */
+  onDismiss?: () => void;
+  className?: string;
+}) {
+  const live = startupInFlight(startup);
+  const now = useNow(live);
+  const settledQuietly = startup.outcome === "ready" && !startup.warning;
+  const [open, setOpen] = useState(!settledQuietly);
+  const [logOpen, setLogOpen] = useState(false);
+  // Fold once a start finishes without trouble, open again for a new one.
+  const startKey = `${startup.startedAt}:${settledQuietly}`;
+  const lastKey = useRef(startKey);
+  useEffect(() => {
+    if (lastKey.current === startKey) return;
+    lastKey.current = startKey;
+    setOpen(!settledQuietly);
+  }, [startKey, settledQuietly]);
+  const head = headline(startup, now);
+  const steps = startup.steps.filter(
+    (step) => step.state !== "pending" || startup.outcome === "running",
+  );
+  const problem = startup.failure ?? startup.warning;
+
+  return (
+    <div
+      data-testid="sandbox-startup-card"
+      data-outcome={startup.outcome}
+      role="status"
+      aria-live="polite"
+      className={cn(
+        "w-full overflow-hidden rounded-xl border bg-card text-card-foreground",
+        startup.outcome === "failed"
+          ? "border-destructive/40"
+          : head.tone === "warning"
+            ? "border-warning/45"
+            : "border-border",
+        className,
+      )}
+    >
+      <div className="flex items-center gap-2.5 px-3 py-2.5">
+        {head.state === "failed" && head.tone === "warning" ? (
+          <TriangleAlertIcon aria-hidden className="size-4 text-warning" />
+        ) : head.state === "running" && head.tone === "warning" ? (
+          <CircleAlertIcon aria-hidden className="size-4 text-warning" />
+        ) : (
+          <StateIcon state={head.state} />
+        )}
+        {/* The chevron is the keyboard's way in; this is the bigger target. */}
+        <button
+          type="button"
+          tabIndex={-1}
+          className="min-w-0 flex-1 cursor-pointer truncate text-left text-ui font-medium outline-none"
+          onClick={() => setOpen((value) => !value)}
+          aria-expanded={open}
+        >
+          {head.title}
+          {head.note && (
+            <span className="ml-1.5 font-normal text-muted-foreground">· {head.note}</span>
+          )}
+        </button>
+        {startup.outcome === "running" && (
+          <span className="font-mono text-xs text-muted-foreground tabular-nums">
+            {formatClock(now - startup.startedAt)}
+          </span>
+        )}
+        <Button type="button" size="xs" variant="ghost" onClick={() => setLogOpen(true)}>
+          Log
+        </Button>
+        <Button
+          type="button"
+          size="icon-xs"
+          variant="ghost"
+          aria-label={open ? "Hide the steps" : "Show the steps"}
+          onClick={() => setOpen((value) => !value)}
+        >
+          <ChevronDownIcon className={cn("size-4 transition-transform", !open && "-rotate-90")} />
+        </Button>
+      </div>
+      {open && (
+        <>
+          <ul className="flex flex-col px-3 pb-2.5" data-testid="sandbox-startup-steps">
+            {steps.map((step) => (
+              <StepRow
+                key={step.id}
+                step={step}
+                kind={startup.kind}
+                agentLabel={agentLabel}
+                now={now}
+              />
+            ))}
+          </ul>
+          {problem && (
+            <ProblemCallout
+              problem={problem}
+              tone={startup.failure ? "failed" : "warning"}
+              sessionId={sessionId}
+              canRetry={canRetry}
+              onShowLog={() => setLogOpen(true)}
+              onDismiss={startup.failure ? undefined : onDismiss}
+            />
+          )}
+          {startup.outcome === "running" &&
+            startup.steps.some((s) => s.id === "setup" && s.state === "running") && (
+              <p className="px-3 pb-3 text-xs text-muted-foreground">
+                The agent waits up to 45 seconds for setup scripts, then starts beside them.
+              </p>
+            )}
+        </>
+      )}
+      <StartupLogDialog
+        sessionId={sessionId}
+        open={logOpen}
+        onOpenChange={setLogOpen}
+        startedAt={startup.startedAt}
+      />
+    </div>
+  );
+}
+
+// Finished starts whose warning someone dismissed, by session and start.
+const dismissed = new Set<string>();
+const DISMISSED_KEY = "omnigent.startup-dismissed";
+try {
+  for (const key of JSON.parse(sessionStorage.getItem(DISMISSED_KEY) ?? "[]") as string[]) {
+    dismissed.add(key);
+  }
+} catch {
+  // Storage can be unavailable; dismissals then last for this page only.
+}
+
+/**
+ * Whether the thread shows the startup card.
+ *
+ * Always while the sandbox starts and after it failed. A finished start stays
+ * until the thread moves on after it: the agent works, or a new message comes.
+ * So a start a message asked for goes when the agent gets to it, one no message
+ * asked for (Start now, Try again) stays until the next message, and one in the
+ * middle of a turn goes with the agent's next step. With a warning (a failed
+ * setup script), it stays until it's dismissed. A cancelled one doesn't show.
+ *
+ * @param startup - The session's current or last start.
+ * @param isDismissed - Whether its warning was dismissed.
+ * @param lastActivityAt - When the thread's newest message or agent activity
+ *   came, in Unix seconds; `null` when unknown or there's none. Leave it out
+ *   where there's no thread, and a finished start stays.
+ */
+export function startupCardVisible(
+  startup: SandboxStartup,
+  isDismissed: boolean,
+  lastActivityAt?: number | null,
+): boolean {
+  if (startup.outcome === "running" || startup.outcome === "failed") return true;
+  if (startup.outcome === "cancelled") return false;
+  if (startup.warning && !isDismissed) return true;
+  if (startup.steps.some((s) => s.id === "setup" && s.state === "running")) return true;
+  if (startup.endedAt === null || lastActivityAt == null) return true;
+  return lastActivityAt <= startup.endedAt + CLOCK_SLACK_S;
+}
+
+// The thread's times are the browser's while live, and the start's the
+// server's. A message that woke the sandbox can also be stored just after.
+const CLOCK_SLACK_S = 5;
+
+/**
+ * The open session's startup card, from the chat store, or nothing when the
+ * session has no start to show.
+ *
+ * @param lastActivityAt - When the thread last moved; see
+ *   {@link startupCardVisible}.
+ */
+export function SessionStartupCard({
+  lastActivityAt,
+  className,
+}: {
+  lastActivityAt?: number | null;
+  className?: string;
+}) {
+  const startup = useChatStore((s) => s.sandboxStartup);
+  const sessionId = useChatStore((s) => s.conversationId);
+  const { session } = useSession(sessionId);
+  const [, setDismissals] = useState(0);
+  if (!startup || !sessionId) return null;
+  const key = `${sessionId}:${startup.startedAt}`;
+  if (!startupCardVisible(startup, dismissed.has(key), lastActivityAt)) return null;
+  const agentLabel =
+    nativeCodingAgentForWrapper(session?.labels?.[WRAPPER_LABEL_KEY])?.displayName ?? null;
+  return (
+    <SandboxStartupCard
+      startup={startup}
+      sessionId={sessionId}
+      canRetry={Boolean(session?.hostId && session.hostResumable)}
+      agentLabel={agentLabel}
+      className={className}
+      onDismiss={() => {
+        dismissed.add(key);
+        try {
+          sessionStorage.setItem(DISMISSED_KEY, JSON.stringify([...dismissed].slice(-200)));
+        } catch {
+          // Not kept past this page.
+        }
+        setDismissals((n) => n + 1);
+      }}
+    />
+  );
+}
+
+const SOURCE_LABELS: Record<StartupLogSource, string> = {
+  server: "Omnigent",
+  k8s: "Kubernetes",
+  clone: "Clone",
+  host: "Host",
+  setup: "Setup script",
+  agent: "Agent",
+};
+
+const LOG_POLL_MS = 1500;
+
+/**
+ * The start's log: Kubernetes events, the clone, the host, setup scripts and
+ * the agent, polled while open and while the start is still going.
+ */
+export function StartupLogDialog({
+  sessionId,
+  open,
+  onOpenChange,
+  startedAt,
+}: {
+  sessionId: string;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  /** The start whose log to show; a new start clears the lines. */
+  startedAt: number;
+}) {
+  const [lines, setLines] = useState<StartupLogLine[]>([]);
+  const [live, setLive] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [filter, setFilter] = useState<StartupLogSource | "all">("all");
+  const nextRef = useRef(0);
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const pinnedRef = useRef(true);
+
+  useEffect(() => {
+    setLines([]);
+    nextRef.current = 0;
+    setLive(true);
+  }, [startedAt, sessionId]);
+
+  useEffect(() => {
+    if (!open) return;
+    let cancelled = false;
+    let timer: number | undefined;
+    const poll = async () => {
+      try {
+        const page = await fetchStartupLog(sessionId, nextRef.current);
+        if (cancelled) return;
+        if (page.startedAt !== null && Math.abs(page.startedAt - startedAt) > 0.001) {
+          // A newer start than this card's: show it from the top.
+          nextRef.current = 0;
+        }
+        if (page.lines.length > 0) {
+          const fresh = page.lines;
+          setLines((previous) =>
+            nextRef.current === 0 && fresh[0]?.seq === 1 ? fresh : [...previous, ...fresh],
+          );
+          nextRef.current = page.next;
+        }
+        setLive(page.live);
+        setError(null);
+        if (page.live) timer = window.setTimeout(poll, LOG_POLL_MS);
+      } catch (err) {
+        if (cancelled) return;
+        setError(err instanceof Error ? err.message : String(err));
+        timer = window.setTimeout(poll, LOG_POLL_MS * 2);
+      }
+    };
+    void poll();
+    return () => {
+      cancelled = true;
+      if (timer !== undefined) window.clearTimeout(timer);
+    };
+  }, [open, sessionId, startedAt]);
+
+  const shown = useMemo(
+    () => (filter === "all" ? lines : lines.filter((line) => line.source === filter)),
+    [lines, filter],
+  );
+  const counts = useMemo(() => {
+    const result = new Map<StartupLogSource, number>();
+    for (const line of lines) result.set(line.source, (result.get(line.source) ?? 0) + 1);
+    return result;
+  }, [lines]);
+
+  useEffect(() => {
+    const el = scrollRef.current;
+    if (el && pinnedRef.current) el.scrollTop = el.scrollHeight;
+  }, [shown]);
+
+  const copyAll = () =>
+    void copyText(
+      lines.map((l) => `${formatTime(l.at)} ${SOURCE_LABELS[l.source]}: ${l.text}`).join("\n"),
+    ).then(
+      () => toast.success("Copied the startup log."),
+      () => toast.error("Couldn't copy the startup log."),
+    );
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent
+        className="flex max-h-[85vh] flex-col gap-3 sm:max-w-3xl"
+        data-testid="startup-log-dialog"
+      >
+        <DialogHeader>
+          <DialogTitle>Startup log</DialogTitle>
+          <DialogDescription>
+            What happened while the sandbox started: Kubernetes, the clone, the host, setup scripts
+            and the agent.
+          </DialogDescription>
+        </DialogHeader>
+        <div className="flex flex-wrap gap-1.5" role="group" aria-label="Show lines from">
+          {(["all", "k8s", "clone", "host", "setup", "agent", "server"] as const).map((source) => {
+            const count = source === "all" ? lines.length : (counts.get(source) ?? 0);
+            if (source !== "all" && count === 0) return null;
+            return (
+              <button
+                key={source}
+                type="button"
+                aria-pressed={filter === source}
+                onClick={() => setFilter(source)}
+                className={cn(
+                  "cursor-pointer rounded-full border px-2.5 py-0.5 text-xs",
+                  filter === source
+                    ? "border-foreground bg-foreground text-background"
+                    : "border-border text-muted-foreground hover:text-foreground",
+                )}
+              >
+                {source === "all" ? "All" : SOURCE_LABELS[source]}
+                <span className="ml-1 tabular-nums opacity-70">{count}</span>
+              </button>
+            );
+          })}
+        </div>
+        <div
+          ref={scrollRef}
+          onScroll={(event) => {
+            const el = event.currentTarget;
+            pinnedRef.current = el.scrollHeight - el.scrollTop - el.clientHeight < 24;
+          }}
+          className="min-h-48 flex-1 overflow-auto rounded-md border border-border bg-muted/30 py-2 font-mono text-[11.5px] leading-[1.6]"
+        >
+          {shown.length === 0 ? (
+            <p className="px-3 text-muted-foreground">
+              {error
+                ? `Couldn't load the log: ${error}`
+                : live
+                  ? "Waiting for the first lines…"
+                  : "No lines."}
+            </p>
+          ) : (
+            shown.map((line) => (
+              <div
+                key={line.seq}
+                className="grid grid-cols-[4.5rem_6.5rem_minmax(0,1fr)] gap-2 px-3 max-sm:grid-cols-[4.5rem_minmax(0,1fr)]"
+              >
+                <span className="text-muted-foreground tabular-nums">{formatTime(line.at)}</span>
+                <span className="truncate text-muted-foreground max-sm:hidden">
+                  {SOURCE_LABELS[line.source]}
+                </span>
+                <span
+                  className={cn(
+                    "break-words whitespace-pre-wrap",
+                    line.level === "error"
+                      ? "text-destructive"
+                      : line.level === "warning"
+                        ? "text-warning"
+                        : "text-foreground",
+                  )}
+                >
+                  {line.text}
+                </span>
+              </div>
+            ))
+          )}
+        </div>
+        <div className="flex items-center gap-2 text-xs text-muted-foreground">
+          {live ? (
+            <>
+              <Loader2Icon className="size-3.5 animate-spin" aria-hidden />
+              Following the start
+            </>
+          ) : (
+            <span>The start has finished.</span>
+          )}
+          <span className="flex-1" />
+          <Button
+            type="button"
+            size="xs"
+            variant="ghost"
+            onClick={copyAll}
+            disabled={lines.length === 0}
+          >
+            <CopyIcon className="size-3.5" aria-hidden />
+            Copy log
+          </Button>
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+function formatTime(epochSeconds: number): string {
+  return new Date(epochSeconds * 1000).toLocaleTimeString([], {
+    hour: "2-digit",
+    minute: "2-digit",
+    second: "2-digit",
+  });
+}
