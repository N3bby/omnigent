+  return {
+    id,
+    state,
+    detail: null,
+    tone: null,
+    startedAt: state === "pending" ? null : NOW - 10,
+    endedAt: state === "done" || state === "failed" ? NOW - 8 : null,
+    children: [],
+    ...extra,
+  };
+}
+
+function startup(extra: Partial<SandboxStartup> = {}): SandboxStartup {
+  return {
+    kind: "launch",
+    outcome: "running",
+    startedAt: NOW - 12,
+    endedAt: null,
+    steps: [
+      step("sandbox", "done"),
+      step("schedule", "done", { detail: "on vm-omnigent" }),
+      step("image", "done", { detail: "Already on the VM" }),
+      step("clone", "running", {
+        children: [
+          { name: "omnigent", state: "done", detail: null, startedAt: NOW - 9, endedAt: NOW - 6 },
+          { name: "roadpass", state: "running", detail: null, startedAt: NOW - 9, endedAt: null },
