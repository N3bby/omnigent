@@ -0,0 +1,161 @@
+import type * as UseTerminalsModule from "@/hooks/useTerminals";
+
+import { cleanup, render, screen } from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { type TerminalInfo, useTerminals } from "@/hooks/useTerminals";
+import type { SandboxStartup } from "@/lib/sandboxStartup";
+import { useChatStore } from "@/store/chatStore";
+import { MainTerminalView } from "./MainTerminalView";
+import type { TerminalFirstContextValue } from "./TerminalFirstContext";
+import { TerminalFirstContextProvider } from "./TerminalFirstContext";
+
+vi.mock("@/components/blocks/TerminalView", () => ({
+  TerminalView: ({ onResume }: { onResume?: () => void }) => (
+    <div data-testid="terminal-view">
+      {onResume && (
+        <button type="button" onClick={onResume}>
+          Resume session
+        </button>
+      )}
+    </div>
+  ),
+}));
+vi.mock("@/hooks/useTerminals", async (importOriginal) => ({
+  ...(await importOriginal<typeof UseTerminalsModule>()),
+  useTerminals: vi.fn(),
+}));
+vi.mock("@/hooks/useSession", () => ({
+  useSession: () => ({
+    session: { hostId: "host_1", hostResumable: true, labels: {} },
+    isLoading: false,
+    error: null,
+  }),
+}));
+
+const useTerminalsMock = vi.mocked(useTerminals);
+
+const AGENT_TERMINAL: TerminalInfo = {
+  id: "terminal_claude_main",
+  name: "claude",
+  session: "main",
+  running: true,
+};
+
+const NOW = Date.now() / 1000;
+
+const WAKING: SandboxStartup = {
+  kind: "wake",
+  outcome: "running",
+  startedAt: NOW - 5,
+  endedAt: null,
+  steps: [
+    {
+      id: "sandbox",
+      state: "running",
+      detail: null,
+      tone: null,
+      startedAt: NOW - 5,
+      endedAt: null,
+      children: [],
+    },
+  ],
+  failure: null,
+  warning: null,
+  logSize: 1,
+};
+
+function ctx(): TerminalFirstContextValue {
+  return {
+    isClaudeNative: true,
+    isNativeWrapper: true,
+    isTerminalFirst: true,
+    isShellView: false,
+    view: "terminal",
+    terminalViewKey: null,
+    setView: () => {},
+    terminalsAvailable: true,
+    terminalStartingUp: false,
+  } as TerminalFirstContextValue;
+}
+
+function renderView(terminals: TerminalInfo[], onResume = vi.fn()) {
+  useTerminalsMock.mockReturnValue({ terminals, isLoading: false, error: null });
+  render(
+    <QueryClientProvider client={new QueryClient()}>
+      <MemoryRouter>
+        <TerminalFirstContextProvider value={ctx()}>
+          <MainTerminalView conversationId="conv_1" runnerOnline={false} onResume={onResume} />
+        </TerminalFirstContextProvider>
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+  return onResume;
+}
+
+beforeEach(() => useTerminalsMock.mockReset());
+
+afterEach(() => {
+  cleanup();
+  useChatStore.setState({ conversationId: null, sandboxStatus: null, sandboxStartup: null });
+});
+
+describe("MainTerminalView while the sandbox starts", () => {
+  it("offers no Resume while the sandbox wakes, and shows how the start is going", () => {
+    useChatStore.setState({
+      conversationId: "conv_1",
+      sandboxStatus: { stage: "starting", error: null },
+      sandboxStartup: WAKING,
+    });
+    renderView([]);
+
+    expect(screen.queryByRole("button", { name: "Resume session" })).toBeNull();
+    expect(screen.queryByText("The harness is not running.")).toBeNull();
+    expect(screen.getByTestId("sandbox-startup-card")).toBeInTheDocument();
+    expect(screen.getByText("Starting your sandbox again")).toBeInTheDocument();
+  });
+
+  it("keeps the passive startup state when there is no startup record", () => {
+    useChatStore.setState({
+      conversationId: "conv_1",
+      sandboxStatus: { stage: "provisioning", error: null },
+      sandboxStartup: null,
+    });
+    renderView([]);
+
+    expect(screen.getByText("Starting up…")).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Resume session" })).toBeNull();
+  });
+
+  it("hides the stale terminal's Resume while the sandbox wakes", async () => {
+    useChatStore.setState({
+      conversationId: "conv_1",
+      sandboxStatus: { stage: "connecting", error: null },
+      sandboxStartup: WAKING,
+    });
+    renderView([AGENT_TERMINAL]);
+
+    expect(await screen.findByTestId("terminal-view")).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Resume session" })).toBeNull();
+  });
+
+  it("offers Resume again once nothing is starting", async () => {
+    useChatStore.setState({ conversationId: "conv_1", sandboxStatus: null, sandboxStartup: null });
+    renderView([AGENT_TERMINAL]);
+
+    expect(await screen.findByRole("button", { name: "Resume session" })).toBeInTheDocument();
+  });
+
+  it("ignores another session's start", () => {
+    useChatStore.setState({
+      conversationId: "conv_other",
+      sandboxStatus: { stage: "starting", error: null },
+      sandboxStartup: WAKING,
+    });
+    renderView([]);
+
+    expect(screen.getByRole("button", { name: "Resume session" })).toBeInTheDocument();
+  });
+});
