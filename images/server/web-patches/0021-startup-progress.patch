@@ -0,0 +1,178 @@
+import { afterEach, describe, expect, it } from "vitest";
+
+import { parseEvent } from "@/lib/sse";
+import { handleSessionEvent, useChatStore } from "@/store/chatStore";
+import {
+  elapsed,
+  formatClock,
+  formatStepDuration,
+  parseSandboxStartup,
+  parseStartupLogPage,
+  problemDetails,
+  startupInFlight,
+  stepLabel,
+} from "./sandboxStartup";
+
+const WIRE = {
+  kind: "launch",
+  outcome: "running",
+  started_at: 1000,
+  ended_at: null,
+  steps: [
+    {
+      id: "sandbox",
+      state: "done",
+      detail: null,
+      tone: null,
+      started_at: 1000,
+      ended_at: 1000.4,
+      children: [],
+    },
+    {
+      id: "clone",
+      state: "running",
+      detail: null,
+      tone: null,
+      started_at: 1001,
+      ended_at: null,
+      children: [
+        { name: "roadpass", state: "running", detail: null, started_at: 1001, ended_at: null },
+      ],
+    },
+    { id: "mystery", state: "done" },
+    { id: "host", state: "exploded" },
+  ],
+  failure: null,
+  warning: null,
+  log_size: 7,
+};
+
+describe("parseSandboxStartup", () => {
+  it("reads the server's record, skipping steps it doesn't know", () => {
+    const startup = parseSandboxStartup(WIRE);
+    expect(startup).not.toBeNull();
+    expect(startup?.steps.map((s) => s.id)).toEqual(["sandbox", "clone"]);
+    expect(startup?.steps[1].children[0]).toEqual({
+      name: "roadpass",
+      state: "running",
+      detail: null,
+      startedAt: 1001,
+      endedAt: null,
+    });
+    expect(startup?.logSize).toBe(7);
+  });
+
+  it("rejects anything that isn't a record", () => {
+    expect(parseSandboxStartup(null)).toBeNull();
+    expect(parseSandboxStartup({ outcome: "running" })).toBeNull();
+    expect(parseSandboxStartup({ ...WIRE, outcome: "exploded" })).toBeNull();
+  });
+
+  it("reads a failure", () => {
+    const startup = parseSandboxStartup({
+      ...WIRE,
+      outcome: "failed",
+      failure: {
+        title: "Couldn't clone roadpass",
+        body: "b",
+        log: "fatal: x",
+        source: "workspace-prep",
+        raw: "r",
+      },
+    });
+    expect(startup?.failure).toEqual({
+      title: "Couldn't clone roadpass",
+      body: "b",
+      log: "fatal: x",
+      source: "workspace-prep",
+      raw: "r",
+      child: null,
+    });
+  });
+});
+
+describe("parseStartupLogPage", () => {
+  it("reads lines, defaulting unknown sources and levels", () => {
+    const page = parseStartupLogPage({
+      started_at: 1000,
+      next: 2,
+      live: true,
+      lines: [
+        { seq: 1, at: 1000, source: "k8s", level: "warning", text: "FailedScheduling: no room" },
+        { seq: 2, at: 1001, source: "elsewhere", level: "loud", text: "x" },
+        { seq: "3", text: "bad" },
+      ],
+    });
+    expect(page.lines).toEqual([
+      { seq: 1, at: 1000, source: "k8s", level: "warning", text: "FailedScheduling: no room" },
+      { seq: 2, at: 1001, source: "server", level: "info", text: "x" },
+    ]);
+    expect(page.live).toBe(true);
+    expect(page.next).toBe(2);
+  });
+});
+
+describe("labels and times", () => {
+  it("names each step for its state", () => {
+    expect(stepLabel({ id: "clone", state: "running" }, "launch")).toBe("Cloning repositories");
+    expect(stepLabel({ id: "clone", state: "skipped" }, "wake")).toBe(
+      "Repositories kept from last time",
+    );
+    expect(stepLabel({ id: "schedule", state: "failed" }, "launch")).toBe("No room on the VM");
+    expect(stepLabel({ id: "sandbox", state: "done" }, "wake")).toBe("Sandbox started again");
+  });
+
+  it("formats durations and clocks", () => {
+    expect(formatStepDuration(0.43)).toBe("0.4s");
+    expect(formatStepDuration(12.4)).toBe("12s");
+    expect(formatStepDuration(65)).toBe("1m 05s");
+    expect(formatClock(78.9)).toBe("1:18");
+  });
+
+  it("times running steps up to now, and not skipped ones", () => {
+    expect(elapsed({ state: "running", startedAt: 100, endedAt: null }, 112)).toBe(12);
+    expect(elapsed({ state: "done", startedAt: 100, endedAt: 103 }, 112)).toBe(3);
+    expect(elapsed({ state: "skipped", startedAt: null, endedAt: 100 }, 112)).toBeNull();
+  });
+
+  it("keeps a start in flight while its setup script runs", () => {
+    const startup = parseSandboxStartup({
+      ...WIRE,
+      outcome: "ready",
+      steps: [{ id: "setup", state: "running", started_at: 1000, children: [] }],
+    });
+    expect(startup && startupInFlight(startup)).toBe(true);
+  });
+
+  it("puts the raw error and the log in the copied details", () => {
+    expect(
+      problemDetails({
+        title: "T",
+        body: "B",
+        log: "L",
+        source: "host",
+        raw: "R",
+        child: null,
+      }),
+    ).toBe("T\n\nB\n\nR\n\nhost:\nL");
+  });
+});
+
+describe("session.startup events", () => {
+  afterEach(() => useChatStore.setState({ conversationId: null, sandboxStartup: null }));
+
+  it("are parsed and replace the open session's record", () => {
+    const event = parseEvent("session.startup", { conversation_id: "conv_1", startup: WIRE });
+    expect(event?.type).toBe("session_startup");
+    useChatStore.setState({ conversationId: "conv_1", sandboxStartup: null });
+    handleSessionEvent(event!, "conv_1");
+    expect(useChatStore.getState().sandboxStartup?.steps.map((s) => s.id)).toEqual([
+      "sandbox",
+      "clone",
+    ]);
+  });
+
+  it("without a record are dropped", () => {
+    expect(parseEvent("session.startup", { conversation_id: "conv_1", startup: null })).toBeNull();
+  });
+});
diff --git a/web/src/lib/sandboxStartup.ts b/web/src/lib/sandboxStartup.ts
new file mode 100644
index 0000000..500cb31
--- /dev/null
+++ b/web/src/lib/sandboxStartup.ts
@@ -0,0 +1,325 @@
+/**
+ * How a session's sandbox starts, step by step: what the startup card shows.
+ *
+ * The server keeps a record of each session's current or last start
+ * (`omnigent_startup` in this deployment's server image), sends it as the
+ * session snapshot's `startup` field and as `session.startup` events, and
+ * serves its log from `GET /v1/sessions/{id}/startup-log`.
+ */
+
+import { authenticatedFetch } from "@/lib/identity";
+
+export type StartupStepId = "sandbox" | "schedule" | "image" | "clone" | "host" | "setup" | "agent";
+export type StartupState = "pending" | "running" | "done" | "failed" | "skipped";
+export type StartupOutcome = "running" | "ready" | "failed" | "cancelled";
+export type StartupLogSource = "server" | "k8s" | "clone" | "host" | "setup" | "agent";
+
+/** A repository's clone or setup script, or one of the host's services. */
+export interface StartupChild {
+  name: string;
+  state: StartupState;
+  detail: string | null;
+  startedAt: number | null;
+  endedAt: number | null;
+}
+
+export interface StartupStep {
+  id: StartupStepId;
+  state: StartupState;
+  /** One line under the step, e.g. `"on vm-omnigent"`. */
+  detail: string | null;
+  /** `"warning"` while a running step is held up, e.g. no room on the VM. */
+  tone: "warning" | null;
+  startedAt: number | null;
+  endedAt: number | null;
+  children: StartupChild[];
+}
+
+/** Why a start failed, or why a finished one needs a look (a setup script). */
+export interface StartupProblem {
+  title: string;
+  body: string;
+  /** The failed container's or script's log, when there is one. */
+  log: string | null;
+  /** Where `log` came from, e.g. `"workspace-prep"`. */
+  source: string | null;
+  /** The error as the server reported it, for Copy error details. */
+  raw: string | null;
+  /** The repository it's about, e.g. `"roadpass"`. */
+  child: string | null;
+}
+
+export interface SandboxStartup {
+  /** `launch` for a new sandbox, `wake` for a stopped one starting again. */
+  kind: "launch" | "wake";
+  outcome: StartupOutcome;
+  startedAt: number;
+  endedAt: number | null;
+  steps: StartupStep[];
+  failure: StartupProblem | null;
+  warning: StartupProblem | null;
+  logSize: number;
+}
+
+export interface StartupLogLine {
+  seq: number;
+  at: number;
+  source: StartupLogSource;
+  level: "info" | "warning" | "error";
+  text: string;
+}
+
+export interface StartupLogPage {
+  startedAt: number | null;
+  lines: StartupLogLine[];
+  next: number;
+  live: boolean;
+}
+
+const STEP_IDS: readonly StartupStepId[] = [
+  "sandbox",
+  "schedule",
+  "image",
+  "clone",
+  "host",
+  "setup",
+  "agent",
+];
+const STATES: readonly StartupState[] = ["pending", "running", "done", "failed", "skipped"];
+const OUTCOMES: readonly StartupOutcome[] = ["running", "ready", "failed", "cancelled"];
+const SOURCES: readonly StartupLogSource[] = ["server", "k8s", "clone", "host", "setup", "agent"];
+
+function str(value: unknown): string | null {
+  return typeof value === "string" && value !== "" ? value : null;
+}
+
+function num(value: unknown): number | null {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
+
+function record(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+function oneOf<T extends string>(value: unknown, allowed: readonly T[]): T | null {
+  return typeof value === "string" && (allowed as readonly string[]).includes(value)
+    ? (value as T)
+    : null;
+}
+
+function parseProblem(value: unknown): StartupProblem | null {
+  const raw = record(value);
+  const title = str(raw?.title);
+  if (!raw || !title) return null;
+  return {
+    title,
+    body: str(raw.body) ?? "",
+    log: str(raw.log),
+    source: str(raw.source),
+    raw: str(raw.raw),
+    child: str(raw.child),
+  };
+}
+
+function parseChild(value: unknown): StartupChild | null {
+  const raw = record(value);
+  const name = str(raw?.name);
+  const state = oneOf(raw?.state, STATES);
+  if (!raw || !name || !state) return null;
+  return {
+    name,
+    state,
+    detail: str(raw.detail),
+    startedAt: num(raw.started_at),
+    endedAt: num(raw.ended_at),
+  };
+}
+
+function parseStep(value: unknown): StartupStep | null {
+  const raw = record(value);
+  const id = oneOf(raw?.id, STEP_IDS);
+  const state = oneOf(raw?.state, STATES);
+  if (!raw || !id || !state) return null;
+  const children = Array.isArray(raw.children)
+    ? raw.children.map(parseChild).filter((c): c is StartupChild => c !== null)
+    : [];
+  return {
+    id,
+    state,
+    detail: str(raw.detail),
+    tone: raw.tone === "warning" ? "warning" : null,
+    startedAt: num(raw.started_at),
+    endedAt: num(raw.ended_at),
+    children,
+  };
+}
+
+/**
+ * Parse the wire record (snapshot `startup` field or `session.startup` event).
+ *
+ * @returns `null` for anything that isn't a record.
+ */
+export function parseSandboxStartup(value: unknown): SandboxStartup | null {
+  const raw = record(value);
+  const outcome = oneOf(raw?.outcome, OUTCOMES);
+  const startedAt = num(raw?.started_at);
+  if (!raw || !outcome || startedAt === null || !Array.isArray(raw.steps)) return null;
+  return {
+    kind: raw.kind === "wake" ? "wake" : "launch",
+    outcome,
+    startedAt,
+    endedAt: num(raw.ended_at),
+    steps: raw.steps.map(parseStep).filter((s): s is StartupStep => s !== null),
+    failure: parseProblem(raw.failure),
+    warning: parseProblem(raw.warning),
+    logSize: num(raw.log_size) ?? 0,
+  };
+}
+
+/** Parse a `GET /startup-log` page. */
+export function parseStartupLogPage(value: unknown): StartupLogPage {
+  const raw = record(value);
+  const lines = Array.isArray(raw?.lines)
+    ? raw.lines.flatMap((line): StartupLogLine[] => {
+        const l = record(line);
+        const seq = num(l?.seq);
+        const text = typeof l?.text === "string" ? l.text : null;
+        if (!l || seq === null || text === null) return [];
+        return [
+          {
+            seq,
+            at: num(l.at) ?? 0,
+            source: oneOf(l.source, SOURCES) ?? "server",
+            level: l.level === "warning" || l.level === "error" ? l.level : "info",
+            text,
+          },
+        ];
+      })
+    : [];
+  return {
+    startedAt: num(raw?.started_at),
+    lines,
+    next: num(raw?.next) ?? 0,
+    live: raw?.live === true,
+  };
+}
+
+/** Fetch the startup log's lines after `after`. */
+export async function fetchStartupLog(sessionId: string, after: number): Promise<StartupLogPage> {
+  const res = await authenticatedFetch(
+    `/v1/sessions/${encodeURIComponent(sessionId)}/startup-log?after=${after}`,
+  );
+  if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
+  return parseStartupLogPage(await res.json());
+}
+
+/** What each step is called, while it runs, once done, and when it fails or is skipped. */
+const STEP_LABELS: Record<
+  StartupStepId,
+  Partial<Record<StartupState, string>> & { running: string; done: string }
+> = {
+  sandbox: {
+    pending: "Create the sandbox",
+    running: "Creating the sandbox",
+    done: "Sandbox created",
+    failed: "Couldn't create the sandbox",
+  },
+  schedule: {
+    pending: "Find room on the VM",
+    running: "Finding room on the VM",
+    done: "Pod scheduled",
+    failed: "No room on the VM",
+  },
+  image: {
+    pending: "Get the runner image",
+    running: "Getting the runner image",
+    done: "Runner image ready",
+    failed: "Couldn't get the runner image",
+  },
+  clone: {
+    pending: "Clone repositories",
+    running: "Cloning repositories",
+    done: "Repositories cloned",
+    failed: "Couldn't clone repositories",
+    skipped: "Repositories kept from last time",
+  },
+  host: {
+    pending: "Start the host",
+    running: "Starting the host",
+    done: "Host connected",
+    failed: "The host didn't start",
+  },
+  setup: {
+    pending: "Run setup scripts",
+    running: "Running setup scripts",
+    done: "Setup scripts finished",
+    failed: "Setup script failed",
+    skipped: "Setup scripts already ran",
+  },
+  agent: {
+    pending: "Start the agent",
+    running: "Starting the agent",
+    done: "Agent ready",
+    failed: "The agent didn't start",
+  },
+};
+
+/** The step's label for its state, e.g. `"Cloning repositories"`. */
+export function stepLabel(
+  step: Pick<StartupStep, "id" | "state">,
+  kind: SandboxStartup["kind"],
+): string {
+  if (step.id === "sandbox" && kind === "wake") {
+    return step.state === "done"
+      ? "Sandbox started again"
+      : step.state === "failed"
+        ? "Couldn't start the sandbox again"
+        : "Starting the stopped sandbox";
+  }
+  const labels = STEP_LABELS[step.id];
+  return labels[step.state] ?? (step.state === "skipped" ? labels.done : labels.running);
+}
+
+/** A duration for the card, e.g. `"0.4s"`, `"12s"`, `"1m 05s"`. */
+export function formatStepDuration(seconds: number): string {
+  if (seconds < 0) return "0s";
+  if (seconds < 10) return `${(Math.round(seconds * 10) / 10).toFixed(1)}s`;
+  if (seconds < 60) return `${Math.round(seconds)}s`;
+  const s = Math.round(seconds);
+  return `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, "0")}s`;
+}
+
+/** A running clock for the card's header, e.g. `"0:18"`. */
+export function formatClock(seconds: number): string {
+  const s = Math.max(0, Math.floor(seconds));
+  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
+}
+
+/** How long a step or child took, or has been running, at `now` (Unix seconds). */
+export function elapsed(
+  item: { state: StartupState; startedAt: number | null; endedAt: number | null },
+  now: number,
+): number | null {
+  if (item.startedAt === null || item.state === "pending" || item.state === "skipped") return null;
+  return (item.endedAt ?? now) - item.startedAt;
+}
+
+/** The text Copy error details puts on the clipboard. */
+export function problemDetails(problem: StartupProblem): string {
+  const parts = [problem.title, problem.body];
+  if (problem.raw) parts.push(problem.raw);
+  if (problem.log && !(problem.raw ?? "").includes(problem.log)) {
+    parts.push(`${problem.source ?? "log"}:\n${problem.log}`);
+  }
+  return parts.filter(Boolean).join("\n\n");
+}
+
+/** Whether the start still has something in flight (a setup script can outlive it). */
+export function startupInFlight(startup: SandboxStartup): boolean {
+  if (startup.outcome === "running") return true;
+  return startup.steps.some(
+    (step) => step.id === "setup" && (step.state === "running" || step.state === "pending"),
+  );
+}
