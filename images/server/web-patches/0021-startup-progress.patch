+/** The current time in Unix seconds, ticking every second while `live`. */
+function useNow(live: boolean): number {
+  const [now, setNow] = useState(() => Date.now() / 1000);
+  useEffect(() => {
+    setNow(Date.now() / 1000);
+    if (!live) return;
+    const timer = window.setInterval(() => setNow(Date.now() / 1000), 1000);
+    return () => window.clearInterval(timer);
+  }, [live]);
+  return now;
+}
+
+function StateIcon({
+  state,
+  tone,
+  small = false,
+}: {
+  state: StartupState;
+  tone?: "warning" | null;
+  small?: boolean;
+}) {
+  const size = small ? "size-3.5" : "size-4";
+  if (state === "running") {
+    return (
+      <Loader2Icon
+        aria-hidden
+        className={cn(
+          size,
+          "animate-spin",
+          tone === "warning" ? "text-warning" : "text-muted-foreground",
+        )}
+      />
+    );
+  }
+  if (state === "done") return <CheckIcon aria-hidden className={cn(size, "text-success")} />;
+  if (state === "failed")
+    return <CircleXIcon aria-hidden className={cn(size, "text-destructive")} />;
+  if (state === "skipped")
+    return <MinusIcon aria-hidden className={cn(size, "text-muted-foreground")} />;
+  return (
+    <span aria-hidden className={cn("flex items-center justify-center", size)}>
+      <span className="size-1.5 rounded-full border border-muted-foreground/60" />
+    </span>
+  );
+}
+
+function Duration({ seconds }: { seconds: number | null }) {
+  if (seconds === null) return null;
+  return (
+    <span className="shrink-0 font-mono text-[11px] leading-5 text-muted-foreground tabular-nums">
+      {formatStepDuration(seconds)}
+    </span>
+  );
+}
+
+function ChildRow({ child, now }: { child: StartupChild; now: number }) {
+  return (
+    <li className="flex items-start gap-2 text-xs leading-5" data-state={child.state}>
+      <span className="mt-0.5">
+        <StateIcon state={child.state} small />
+      </span>
+      <span className="min-w-0 flex-1">
+        <span className={child.state === "pending" ? "text-muted-foreground" : "text-foreground"}>
+          {child.name}
+        </span>
+        {child.detail && (
+          <span
+            className={cn(
+              "ml-1.5 text-muted-foreground",
+              child.state === "failed" && "text-destructive",
+            )}
+          >
+            · {child.detail}
+          </span>
+        )}
+      </span>
+      <Duration seconds={elapsed(child, now)} />
+    </li>
+  );
+}
+
+function StepRow({
+  step,
+  kind,
+  agentLabel,
+  now,
+}: {
+  step: StartupStep;
+  kind: SandboxStartup["kind"];
+  agentLabel: string | null;
+  now: number;
+}) {
+  let label = stepLabel(step, kind);
+  if (step.id === "agent" && agentLabel) {
+    label =
+      step.state === "done"
+        ? `${agentLabel} ready`
+        : step.state === "failed"
+          ? `${agentLabel} didn't start`
+          : step.state === "pending"
+            ? `Start ${agentLabel}`
+            : `Starting ${agentLabel}`;
+  }
+  return (
+    <li className="flex flex-col py-1" data-step={step.id} data-state={step.state}>
+      <div className="flex items-start gap-2.5">
+        <span className="mt-0.5">
+          <StateIcon state={step.state} tone={step.tone} />
+        </span>
+        <div className="min-w-0 flex-1">
+          <div
+            className={cn(
+              "text-ui leading-5",
+              step.state === "pending" ? "text-muted-foreground" : "text-foreground",
+            )}
+          >
+            {label}
+          </div>
+          {step.detail && (
+            <div
+              className={cn(
+                "text-xs leading-5 break-words",
+                step.tone === "warning" && step.state === "running"
+                  ? "text-warning"
+                  : step.state === "failed"
+                    ? "text-destructive"
+                    : "text-muted-foreground",
+              )}
+            >
+              {step.detail}
+            </div>
+          )}
+        </div>
+        <Duration seconds={elapsed(step, now)} />
+      </div>
+      {/* Below the row, not in its label column, so the times line up. */}
+      {step.children.length > 0 && (
+        <ul className="mt-1 flex flex-col gap-0.5 pl-6.5">
+          {step.children.map((child) => (
+            <ChildRow key={child.name} child={child} now={now} />
+          ))}
+        </ul>
+      )}
+    </li>
+  );
+}
