+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { useState } from "react";
+import { afterEach, describe, expect, it } from "vitest";
+import { HighlightedTextarea, type HighlightLanguage, scriptLanguage } from "./HighlightedTextarea";
+
+afterEach(cleanup);
+
+function Editor({ initial, language }: { initial: string; language: HighlightLanguage }) {
+  const [value, setValue] = useState(initial);
+  return (
+    <HighlightedTextarea
+      value={value}
+      language={language}
+      onChange={(e) => setValue(e.target.value)}
+      aria-label="Editor"
+    />
+  );
+}
+
+describe("scriptLanguage", () => {
+  it("follows the #! line, and is shell without one", () => {
+    expect(scriptLanguage("mise install\n")).toBe("shellscript");
+    expect(scriptLanguage("#!/bin/bash\nset -e\n")).toBe("shellscript");
+    expect(scriptLanguage("#!/usr/bin/env bash\n")).toBe("shellscript");
+    expect(scriptLanguage("#!/usr/bin/env python3\n")).toBe("python");
+    expect(scriptLanguage("#!/usr/bin/python3.13\n")).toBe("python");
+    expect(scriptLanguage("#!/usr/bin/env -S node --no-warnings\n")).toBe("javascript");
+    expect(scriptLanguage("#!/usr/bin/env ruby\n")).toBe("ruby");
+    expect(scriptLanguage("#!/usr/bin/env lua\n")).toBe("text");
+  });
+});
+
+describe("HighlightedTextarea", () => {
+  it("highlights a copy of the text under the textarea, and keeps it in step", async () => {
+    const { container } = render(<Editor initial={"echo hi # greet\n"} language="shellscript" />);
+    const textarea = screen.getByRole("textbox", { name: "Editor" });
+    const copy = container.querySelector("pre")!;
+    expect(copy).toHaveAttribute("aria-hidden");
+    // Plain until Shiki has loaded, then coloured spans of the same text.
+    expect(copy.textContent).toBe("echo hi # greet\n ");
+    await waitFor(() => expect(container.querySelector("[data-highlighted]")).not.toBeNull(), {
+      timeout: 10_000,
+    });
+    expect(copy.textContent).toBe("echo hi # greet\n ");
+    const comment = [...copy.querySelectorAll("span[style]")].find((s) =>
+      s.textContent?.includes("# greet"),
+    ) as HTMLElement;
+    expect(comment.style.getPropertyValue("--shiki-dark")).toMatch(/^#/);
+
+    fireEvent.change(textarea, { target: { value: "ls -la" } });
+    expect(copy.textContent).toBe("ls -la");
+  });
+
+  it("scrolls the copy with the textarea, and doesn't wrap code when asked", () => {
+    const { container } = render(
+      <HighlightedTextarea value="a" language="text" wrap={false} onChange={() => {}} />,
+    );
+    const textarea = container.querySelector("textarea")!;
+    const copy = container.querySelector("pre")!;
+    expect(textarea).toHaveAttribute("wrap", "off");
+    textarea.scrollTop = 40;
+    textarea.scrollLeft = 25;
+    fireEvent.scroll(textarea);
+    expect([copy.scrollTop, copy.scrollLeft]).toEqual([40, 25]);
+  });
+});
