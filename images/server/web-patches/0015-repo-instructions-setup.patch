--- /dev/null
+++ b/web/src/components/HighlightedTextarea.tsx
@@ -0,0 +1,188 @@
+/**
+ * A textarea with syntax highlighting, for the repository variables page's
+ * agent instructions and setup script (added by this deployment).
+ *
+ * It stays a native textarea, so typing, selection, the keyboard and
+ * autocorrect work as anywhere else, on phones too. Its own text is
+ * transparent; a copy of the text highlighted by Shiki sits under it, in the
+ * same font, padding and wrapping, and follows its scrolling. Until Shiki has
+ * loaded (lazily, like the chat's code blocks), the copy is plain text.
+ */
+
+import {
+  type ComponentProps,
+  type CSSProperties,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+} from "react";
+import type { BundledLanguage, BundledTheme, HighlighterGeneric, ThemedToken } from "shiki";
+import { Textarea } from "@/components/ui/textarea";
+import { cn } from "@/lib/utils";
+
+export type HighlightLanguage = BundledLanguage | "text";
+
+const THEMES = { light: "github-light", dark: "github-dark" } as const;
+
+// Interpreters a setup script's #! line may name, and their Shiki language.
+const INTERPRETERS: [RegExp, BundledLanguage][] = [
+  [/^(ba|z|k|da)?sh$/, "shellscript"],
+  [/^python[0-9.]*$/, "python"],
+  [/^(node|deno|bun)$/, "javascript"],
+  [/^ruby$/, "ruby"],
+  [/^perl$/, "perl"],
+];
+
+/**
+ * The language of a script: from its ``#!`` line, or shell without one, as
+ * the runner runs it with bash.
+ *
+ * @example scriptLanguage("#!/usr/bin/env python3\n…") // "python"
+ */
+export function scriptLanguage(script: string): HighlightLanguage {
+  const shebang = /^#!\s*(\S+)(?:\s+(?:-\S+\s+)*(\S+))?/.exec(script);
+  if (!shebang) return "shellscript";
+  // "#!/usr/bin/env python3" names the interpreter after env.
+  const program = shebang[1].endsWith("/env") ? shebang[2] : shebang[1];
+  const name = program?.split("/").pop() ?? "";
+  return INTERPRETERS.find(([pattern]) => pattern.test(name))?.[1] ?? "text";
+}
+
+let highlighter: Promise<HighlighterGeneric<BundledLanguage, BundledTheme>> | null = null;
+
+/** One Shiki highlighter for every editor, with each language loaded on first use. */
+async function loadLanguage(
+  language: BundledLanguage,
+): Promise<HighlighterGeneric<BundledLanguage, BundledTheme>> {
+  highlighter ??= import("shiki").then(({ createHighlighter }) =>
+    createHighlighter({ themes: [THEMES.light, THEMES.dark], langs: [] }),
+  );
+  const loaded = await highlighter;
+  if (!loaded.getLoadedLanguages().includes(language)) await loaded.loadLanguage(language);
+  return loaded;
+}
+
+/** The highlighter once ``language`` is ready, or null until then (or for plain text). */
+function useHighlighter(language: HighlightLanguage) {
+  const [ready, setReady] = useState<{
+    language: HighlightLanguage;
+    highlighter: HighlighterGeneric<BundledLanguage, BundledTheme>;
+  } | null>(null);
+  useEffect(() => {
+    if (language === "text") return;
+    let current = true;
+    loadLanguage(language)
+      .then((loaded) => {
+        if (current) setReady({ language, highlighter: loaded });
+      })
+      // Without highlighting the text is still there, in the plain copy.
+      .catch((error: unknown) => console.warn("Couldn't load syntax highlighting:", error));
+    return () => {
+      current = false;
+    };
+  }, [language]);
+  return ready?.language === language ? ready.highlighter : null;
+}
+
+/** The text's lines as highlighted tokens, each keyed by where it starts. */
+function tokenize(
+  loaded: HighlighterGeneric<BundledLanguage, BundledTheme> | null,
+  text: string,
+  language: HighlightLanguage,
+): { start: number; tokens: ThemedToken[] }[] | null {
+  if (!loaded || language === "text") return null;
+  let tokens: ThemedToken[][];
+  try {
+    tokens = loaded.codeToTokens(text, {
+      lang: language,
+      themes: THEMES,
+      defaultColor: false,
+    }).tokens;
+  } catch {
+    return null;
+  }
+  let start = 0;
+  return text.split("\n").map((line, i) => {
+    const keyed = { start, tokens: tokens[i] ?? [] };
+    start += line.length + 1;
+    return keyed;
+  });
+}
+
+export function HighlightedTextarea({
+  value,
+  language,
+  wrap = true,
+  className,
+  onScroll,
+  ...props
+}: Omit<ComponentProps<typeof Textarea>, "value" | "wrap"> & {
+  value: string;
+  language: HighlightLanguage;
+  /** Soft-wrap long lines; off, they scroll sideways, as for code. */
+  wrap?: boolean;
+}) {
+  const copy = useRef<HTMLPreElement>(null);
+  const loaded = useHighlighter(language);
+  const lines = useMemo(() => tokenize(loaded, value, language), [loaded, value, language]);
+  // Shared by the textarea and the copy, so their text lines up exactly. The
+  // copy's own styles come after the caller's, which mustn't undo them.
+  const layout = cn(
+    "m-0 border px-2.5 py-2 text-ui md:text-ui [font-family:inherit] [scrollbar-gutter:stable]",
+    wrap ? "whitespace-pre-wrap wrap-break-word" : "whitespace-pre",
+  );
+  return (
+    <div
+      className="relative rounded-lg bg-transparent dark:bg-input/30"
+      data-language={language}
+      data-highlighted={lines ? "" : undefined}
+    >
+      <pre
+        ref={copy}
+        aria-hidden
+        className={cn(
+          layout,
+          className,
+          "pointer-events-none absolute inset-0 overflow-hidden border-transparent text-foreground",
+        )}
+      >
+        {lines
+          ? lines.map((line, i) => (
+              <span key={line.start}>
+                {line.tokens.map((token) => (
+                  <span
+                    key={token.offset}
+                    style={token.htmlStyle as CSSProperties}
+                    className="text-[var(--shiki-light)] dark:text-[var(--shiki-dark)]"
+                  >
+                    {token.content}
+                  </span>
+                ))}
+                {i < lines.length - 1 && "\n"}
+              </span>
+            ))
+          : value}
+        {/* A last empty line still takes its height, as in the textarea. */}
+        {value.endsWith("\n") && " "}
+      </pre>
+      <Textarea
+        value={value}
+        wrap={wrap ? "soft" : "off"}
+        onScroll={(e) => {
+          if (copy.current) {
+            copy.current.scrollTop = e.currentTarget.scrollTop;
+            copy.current.scrollLeft = e.currentTarget.scrollLeft;
+          }
+          onScroll?.(e);
+        }}
+        className={cn(
+          layout,
+          "relative bg-transparent text-transparent caret-foreground selection:bg-primary/25 selection:text-transparent dark:bg-transparent",
+          className,
+        )}
+        {...props}
+      />
+    </div>
+  );
+}
