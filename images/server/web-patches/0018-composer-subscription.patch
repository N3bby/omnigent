@@ -0,0 +1,16 @@
+import { useQuery } from "@tanstack/react-query";
+import { fetchSubscriptionNames } from "@/lib/subscriptions";
+
+/**
+ * Every subscription account's name, for the composer. Refetched after a
+ * minute, so a rename or switch in Settings shows up without a reload.
+ */
+export function useSubscriptionNames() {
+  return useQuery({
+    queryKey: ["subscription-names"],
+    queryFn: fetchSubscriptionNames,
+    staleTime: 60_000,
+    refetchInterval: 60_000,
+    retry: false,
+  });
+}
