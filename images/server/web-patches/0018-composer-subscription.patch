+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const navigate = vi.fn();
+let isAdmin = true;
+vi.mock("@/hooks/useIsAdmin", () => ({ useIsAdmin: () => isAdmin }));
+vi.mock("@/lib/routing", () => ({ useNavigate: () => navigate }));
+
+import { SubscriptionTag } from "./ComposerSubscription";
+
+afterEach(() => {
+  cleanup();
+  navigate.mockReset();
+  isAdmin = true;
+});
+
+describe("SubscriptionTag", () => {
+  it("renders nothing without a subscription", () => {
+    const { container } = render(<SubscriptionTag subscription={null} provider="claude" />);
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  it("names the account and links admins to Settings", () => {
+    render(
+      <SubscriptionTag
+        subscription={{ kind: "account", name: "Personal", active: true, activeName: "Personal" }}
+        provider="claude"
+      />,
+    );
+    const tag = screen.getByTestId("composer-subscription");
+    expect(tag).toHaveTextContent("Personal");
+    expect(tag).toHaveAccessibleName("Claude account: Personal");
+    fireEvent.click(tag);
+    expect(screen.getByText(/signed in with this account when it started/)).toBeInTheDocument();
+    expect(screen.queryByText(/Settings now selects/)).not.toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: "Manage subscriptions" }));
+    expect(navigate).toHaveBeenCalledWith("/settings/subscriptions");
+  });
+
+  it("says how to switch once Settings selects another account", () => {
+    isAdmin = false;
+    render(
+      <SubscriptionTag
+        subscription={{ kind: "account", name: "Personal", active: false, activeName: "Work" }}
+        provider="codex"
+      />,
+    );
+    const tag = screen.getByTestId("composer-subscription");
+    expect(tag).toHaveAccessibleName("ChatGPT account: Personal, not the account Settings selects");
+    fireEvent.click(tag);
+    expect(
+      screen.getByText(/Settings now selects Work\. To use Work, choose Stop session/),
+    ).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Manage subscriptions" })).not.toBeInTheDocument();
+  });
+
+  it("says when the account has been removed from Settings", () => {
+    render(
+      <SubscriptionTag subscription={{ kind: "removed", activeName: "Work" }} provider="claude" />,
+    );
+    const tag = screen.getByTestId("composer-subscription");
+    expect(tag).toHaveTextContent("Removed account");
+    fireEvent.click(tag);
+    expect(screen.getByText(/has since been removed from Settings/)).toBeInTheDocument();
+    expect(screen.getByText(/To use Work, choose Stop session/)).toBeInTheDocument();
+  });
+});
diff --git a/web/src/components/composer/ComposerSubscription.tsx b/web/src/components/composer/ComposerSubscription.tsx
new file mode 100644
index 0000000..0b39295
--- /dev/null
+++ b/web/src/components/composer/ComposerSubscription.tsx
@@ -0,0 +1,145 @@
+import { KeyRoundIcon } from "lucide-react";
+
+import { COMPOSER_COLLAPSED_LABEL_CLASS } from "./ChatComposer";
+import { Button } from "@/components/ui/button";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import { useIsAdmin } from "@/hooks/useIsAdmin";
+import { useSubscriptionNames } from "@/hooks/useSubscriptionNames";
+import { useNavigate } from "@/lib/routing";
+import {
+  describeSessionSubscription,
+  type Provider,
+  type SessionSubscription,
+} from "@/lib/subscriptions";
+import { cn } from "@/lib/utils";
+
+const PROVIDER_LABEL: Record<Provider, { account: string; agent: string }> = {
+  claude: { account: "Claude account", agent: "Claude Code" },
+  codex: { account: "ChatGPT account", agent: "Codex" },
+};
+
+/** Marks a session that no longer uses the account Settings selects. */
+function StaleDot({ className }: { className?: string }) {
+  return <span aria-hidden="true" className={cn("size-1.5 rounded-full bg-warning", className)} />;
+}
+
+function tagLabel(subscription: SessionSubscription): string {
+  return subscription.kind === "account" ? subscription.name : "Removed account";
+}
+
+/**
+ * The subscription account the session's agent signed in with, left of the
+ * model picker: the account's name from Settings → Subscriptions. Render it
+ * only once the runner has reported an account, so the names are only fetched
+ * for sessions that have one.
+ *
+ * @param subscriptionId - The reported account ID.
+ * @param provider - The provider the session's harness signs in with.
+ */
+export function ComposerSubscription({
+  subscriptionId,
+  provider,
+}: {
+  subscriptionId: string;
+  provider: Provider;
+}) {
+  const names = useSubscriptionNames();
+  return (
+    <SubscriptionTag
+      subscription={describeSessionSubscription(subscriptionId, provider, names.data)}
+      provider={provider}
+    />
+  );
+}
+
+/**
+ * The tag itself. Tapping it explains what it means, since a tooltip never
+ * opens on touch. A session keeps its account until its agent restarts, so a
+ * dot marks one that no longer uses the account Settings selects. Self-nulls
+ * when there's nothing to show (see `describeSessionSubscription`).
+ */
+export function SubscriptionTag({
+  subscription,
+  provider,
+  className,
+}: {
+  subscription: SessionSubscription | null;
+  provider: Provider;
+  className?: string;
+}) {
+  const isAdmin = useIsAdmin();
+  const navigate = useNavigate();
+  if (subscription === null) return null;
+  const labels = PROVIDER_LABEL[provider];
+  const label = tagLabel(subscription);
+  const stale = subscription.kind !== "account" || !subscription.active;
+  const switchHint =
+    subscription.activeName !== null
+      ? `To use ${subscription.activeName}, choose Stop session in this session's menu, then send another message.`
+      : null;
+
+  return (
+    <Popover>
+      <PopoverTrigger asChild>
+        <Button
+          type="button"
+          variant="ghost"
+          size="xs"
+          data-testid="composer-subscription"
+          data-composer-shrinkable=""
+          aria-label={`${labels.account}: ${label}${stale ? ", not the account Settings selects" : ""}`}
+          // Absorbs the squeeze when the action row is tight, so a long name
+          // truncates instead of pushing the send button out of the composer.
+          className={cn(
+            "min-w-0 gap-1 px-1 font-normal text-muted-foreground shrink-[100] md:px-1.5",
+            className,
+          )}
+        >
+          {/* The key goes with the other controls' labels when the row collapses to icons. */}
+          <span className={cn("relative flex shrink-0", COMPOSER_COLLAPSED_LABEL_CLASS)}>
+            <KeyRoundIcon className="size-3.5" aria-hidden />
+            {stale && <StaleDot className="absolute -top-0.5 -right-0.5" />}
+          </span>
+          {stale && (
+            <StaleDot className="hidden shrink-0 group-data-[labels=collapsed]/composer-actions:block" />
+          )}
+          <span className="max-w-[10rem] min-w-0 truncate">{label}</span>
+        </Button>
+      </PopoverTrigger>
+      <PopoverContent
+        side="top"
+        align="end"
+        collisionPadding={8}
+        aria-label={labels.account}
+        className="flex w-[min(18rem,calc(100vw-2rem))] flex-col gap-2 p-3 text-sm"
+      >
+        <p className="text-xs font-medium text-muted-foreground">{labels.account}</p>
+        <p className="font-medium break-words">{label}</p>
+        <p className="text-muted-foreground">
+          {subscription.kind === "account"
+            ? `${labels.agent} in this session signed in with this account when it started.`
+            : `${labels.agent} in this session signed in with an account that has since been removed from Settings.`}
+        </p>
+        {stale && (
+          <p className="text-muted-foreground">
+            {subscription.kind === "account" && subscription.activeName !== null
+              ? `Settings now selects ${subscription.activeName}. `
+              : ""}
+            {switchHint}
+          </p>
+        )}
+        {isAdmin && (
+          <Button
+            type="button"
+            variant="outline"
+            size="sm"
+            className="mt-1 self-start"
+            onClick={() => navigate("/settings/subscriptions")}
+          >
+            Manage subscriptions
+          </Button>
+        )}
+      </PopoverContent>
+    </Popover>
+  );
+}
