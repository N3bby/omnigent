new file mode 100644
index 0000000..8aee211
--- /dev/null
+++ b/web/src/lib/subscriptions.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  describeSessionSubscription,
+  parseSubscription,
+  subscriptionFromLabels,
+  subscriptionProvider,
+  type SubscriptionName,
+} from "./subscriptions";
+import { parseEvent } from "./sse";
+
+const PERSONAL = "42e6ad4455f84134ad3fa7ed390767aa";
+const WORK = "9f0c3e1d2b7a4c5e8d6f1a2b3c4d5e6f";
+const names: SubscriptionName[] = [
+  { id: PERSONAL, provider: "claude", name: "Personal", active: false },
+  { id: WORK, provider: "claude", name: "Work", active: true },
+  { id: "165efa0b0181476e9aa81764945f7798", provider: "codex", name: "ChatGPT", active: true },
+];
+
+describe("session subscription", () => {
+  it("parses account IDs and the deployment login, and nothing else", () => {
+    expect(parseSubscription(PERSONAL)).toBe(PERSONAL);
+    expect(parseSubscription("default")).toBeNull();
+    expect(parseSubscription(undefined)).toBeUndefined();
+    expect(parseSubscription("Personal")).toBeNull();
+    expect(parseSubscription(42)).toBeNull();
+    expect(subscriptionFromLabels({ "omnigent.subscription": PERSONAL })).toBe(PERSONAL);
+    expect(subscriptionFromLabels({ "omnigent.subscription": "junk" })).toBeNull();
+    expect(subscriptionFromLabels(undefined)).toBeNull();
+  });
+
+  it("reads it from session.usage events", () => {
+    expect(
+      parseEvent("session.usage", { conversation_id: "conv_a", subscription: PERSONAL }),
+    ).toEqual({ type: "session_usage", conversationId: "conv_a", subscription: PERSONAL });
+    expect(
+      parseEvent("session.usage", { conversation_id: "conv_a", subscription: "x" }),
+    ).toBeNull();
+  });
+
+  it("only applies to Claude Code and Codex", () => {
+    expect(subscriptionProvider("claude-native")).toBe("claude");
+    expect(subscriptionProvider("codex-native")).toBe("codex");
+    expect(subscriptionProvider("openai-agents")).toBeNull();
+    expect(subscriptionProvider(null)).toBeNull();
+  });
+
+  it("names the account and says whether Settings still selects it", () => {
+    expect(describeSessionSubscription(PERSONAL, "claude", names)).toEqual({
+      kind: "account",
+      name: "Personal",
+      active: false,
+      activeName: "Work",
+    });
+    expect(describeSessionSubscription(WORK, "claude", names)).toMatchObject({
+      kind: "account",
+      active: true,
+    });
+    expect(describeSessionSubscription("0".repeat(32), "claude", names)).toEqual({
+      kind: "removed",
+      activeName: "Work",
+    });
+  });
+
+  it("shows nothing until the account can be named", () => {
+    expect(describeSessionSubscription(null, "claude", names)).toBeNull();
+    expect(describeSessionSubscription(PERSONAL, null, names)).toBeNull();
+    expect(describeSessionSubscription(PERSONAL, "claude", undefined)).toBeNull();
+    // Settings has no Claude account any more, so there's nothing to name it after.
+    expect(describeSessionSubscription(PERSONAL, "claude", names.slice(2))).toBeNull();
+  });
+});
diff --git a/web/src/lib/subscriptions.ts b/web/src/lib/subscriptions.ts
index e7bd6ff..13a1a85 100644
--- a/web/src/lib/subscriptions.ts
+++ b/web/src/lib/subscriptions.ts
@@ -46,3 +46,70 @@ export async function subscriptionRequest<T>(
     );
   return data as T;
 }
+
+/**
+ * The account a session's Claude Code or Codex started with, as its runner
+ * reports it: an account ID from Settings → Subscriptions.
+ */
+export const SUBSCRIPTION_LABEL_KEY = "omnigent.subscription";
+
+const ACCOUNT_ID = /^[0-9a-f]{32}$/;
+
+/**
+ * Parse a wire subscription (`session.usage` event or the session label).
+ *
+ * @returns The account ID, `undefined` when absent, or `null` when malformed.
+ */
+export function parseSubscription(raw: unknown): string | null | undefined {
+  if (raw === undefined || raw === null) return undefined;
+  return typeof raw === "string" && ACCOUNT_ID.test(raw) ? raw : null;
+}
+
+/** Read the session label; `null` when the runner hasn't reported it. */
+export function subscriptionFromLabels(labels: Record<string, string> | undefined): string | null {
+  return parseSubscription(labels?.[SUBSCRIPTION_LABEL_KEY]) ?? null;
+}
+
+/** An account's name, which every signed-in user may read. */
+export interface SubscriptionName {
+  id: string;
+  provider: Provider;
+  name: string;
+  active: boolean;
+}
+
+/** Every account's name, for the composer. */
+export async function fetchSubscriptionNames(): Promise<SubscriptionName[]> {
+  return (await subscriptionRequest<{ data: SubscriptionName[] }>("/names")).data;
+}
+
+/** The subscription provider a native harness signs in with, if any. */
+export function subscriptionProvider(harness: string | null): Provider | null {
+  if (harness === "claude-native") return "claude";
+  if (harness === "codex-native") return "codex";
+  return null;
+}
+
+export type SessionSubscription =
+  /** An account from Settings; `active` is false once Settings selects another. */
+  | { kind: "account"; name: string; active: boolean; activeName: string | null }
+  /** An account that has since been removed from Settings. */
+  | { kind: "removed"; activeName: string | null };
+
+/**
+ * What the composer shows for a session's account, or `null` for nothing:
+ * nothing reported yet, or Settings has no account for the provider.
+ */
+export function describeSessionSubscription(
+  subscription: string | null,
+  provider: Provider | null,
+  names: SubscriptionName[] | undefined,
+): SessionSubscription | null {
+  if (subscription === null || provider === null || names === undefined) return null;
+  const accounts = names.filter((a) => a.provider === provider);
+  if (accounts.length === 0) return null;
+  const activeName = accounts.find((a) => a.active)?.name ?? null;
+  const account = accounts.find((a) => a.id === subscription);
+  if (account === undefined) return { kind: "removed", activeName };
+  return { kind: "account", name: account.name, active: account.active, activeName };
+}
