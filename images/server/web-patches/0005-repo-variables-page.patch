+// repoKey and variableNameError mirror omnigent_repo_env.py; these cases are
+// the ones its tests use, so the page's preview matches what the server stores.
+
+import { describe, expect, it } from "vitest";
+import { parseEnv, repoKey, variableNameError } from "./repoEnv";
+
+describe("repoKey", () => {
+  it("gives every way of writing a repository one key", () => {
+    for (const url of [
+      "https://github.com/kunlabora/roadpass.git",
+      "https://github.com/kunlabora/roadpass",
+      "https://github.com/kunlabora/roadpass/",
+      "git@github.com:kunlabora/roadpass.git",
+      "ssh://git@github.com:22/kunlabora/roadpass.git",
+      "https://x-access-token:secret@github.com/kunlabora/roadpass.git",
+      "https://github.com/Kunlabora/RoadPass.git",
+      "kunlabora/roadpass",
+      "github.com/kunlabora/roadpass",
+    ]) {
+      expect(repoKey(url), url).toBe("github.com/kunlabora/roadpass");
+    }
+  });
+
+  it("keeps other hosts and subgroups", () => {
+    expect(repoKey("https://gitlab.com/group/sub/repo.git")).toBe("gitlab.com/group/sub/repo");
+    expect(repoKey("git@ghe.example.com:org/repo.git")).toBe("ghe.example.com/org/repo");
+  });
+
+  it("rejects what isn't a repository", () => {
+    for (const text of ["", "roadpass", "ftp://github.com/a/b", "https://github.com/a", "a/../b"]) {
+      expect(repoKey(text), text).toBeNull();
+    }
+  });
+});
+
+describe("variableNameError", () => {
+  it("allows ordinary names and rejects bad or reserved ones", () => {
+    expect(variableNameError("GOVFLANDERS_NPM_TOKEN")).toBeNull();
+    expect(variableNameError("1TOKEN")).toMatch(/letters, digits/);
+    expect(variableNameError("MY-TOKEN")).toMatch(/letters, digits/);
+    expect(variableNameError("PATH")).toBe("PATH is reserved for the runner.");
+    expect(variableNameError("CLAUDE_CONFIG_DIR")).toBe(
+      "CLAUDE_CONFIG_DIR is reserved for the runner.",
+    );
+  });
+});
+
+describe("parseEnv", () => {
+  it("parses a .env file without expanding", () => {
+    expect(
+      parseEnv("# comment\n\nexport TOKEN='a b'\nURL=\"https://x\"\nRAW=$HOME\nEMPTY=\n"),
+    ).toEqual({
+      variables: [
+        { name: "TOKEN", value: "a b" },
+        { name: "URL", value: "https://x" },
+        { name: "RAW", value: "$HOME" },
+        { name: "EMPTY", value: "" },
+      ],
+      badLines: [],
+    });
+  });
+
+  it("reports lines that aren't NAME=value", () => {
+    expect(parseEnv("A=1\njust text\n=nameless\n").badLines).toEqual([2, 3]);
+  });
+});
diff --git a/web/src/lib/repoEnv.ts b/web/src/lib/repoEnv.ts
new file mode 100644
index 0000000..d44da2d
--- /dev/null
+++ b/web/src/lib/repoEnv.ts
@@ -0,0 +1,169 @@
+/**
+ * Repository variables: environment variables for sessions started on a
+ * repository (``/v1/repo-env``, added by this deployment).
+ *
+ * Values only go to the server. Listing returns names, and saving a name
+ * with ``null`` keeps its current value. ``repoKey`` and ``checkVariableName``
+ * mirror ``omnigent_repo_env.py`` so the page can preview the key a URL
+ * matches and flag names before saving; the server checks again.
+ */
+
+import { authenticatedFetch } from "./identity";
+
+/** One repository with variables, from ``GET /v1/repo-env``. */
+export interface RepoEnvEntry {
+  /** ``host/owner/repo`` in lower case, e.g. ``"github.com/kunlabora/roadpass"``. */
+  repository: string;
+  /** Variable names, sorted. Never values. */
+  names: string[];
+  /** ISO-8601 time of the last change, or null. */
+  updated_at: string | null;
+  /** Who last saved them from this page, or null (e.g. the CLI). */
+  updated_by: string | null;
+}
+
+const DEFAULT_HOST = "github.com";
+const SEGMENT = /^[a-z0-9._-]+$/;
+const SCP_URL = /^(?:[^@/]+@)?([^:/]+):([^/].*)$/;
+const VARIABLE_NAME = /^[A-Za-z_][A-Za-z0-9_]*$/;
+const RESERVED_NAMES = new Set(["HOME", "PATH", "SHELL", "USER", "LOGNAME", "PWD", "TMPDIR"]);
+const RESERVED_PREFIXES = ["OMNIGENT_", "CLAUDE_", "CODEX_", "MISE_", "TAILSCALE_"];
+
+/**
+ * Normalise a repository to ``host/owner/repo``, as the server does.
+ *
+ * @returns e.g. ``"github.com/kunlabora/roadpass"``, or null when the text
+ *   isn't a clone URL or ``owner/repo``.
+ */
+export function repoKey(repository: string): string | null {
+  const text = repository.trim();
+  let host: string;
+  let path: string;
+  if (text.includes("://")) {
+    let url: URL;
+    try {
+      url = new URL(text);
+    } catch {
+      return null;
+    }
+    if (!["http:", "https:", "ssh:", "git:"].includes(url.protocol)) return null;
+    host = url.hostname;
+    path = url.pathname;
+  } else {
+    const scp = SCP_URL.exec(text);
+    if (scp) {
+      host = scp[1];
+      path = scp[2];
+    } else {
+      const segments = text.replace(/^\/+|\/+$/g, "").split("/");
+      if (segments.length >= 3 && segments[0].includes(".")) {
+        host = segments[0];
+        path = segments.slice(1).join("/");
+      } else {
+        host = DEFAULT_HOST;
+        path = text;
+      }
+    }
+  }
+  path = path.replace(/^\/+|\/+$/g, "").toLowerCase();
+  if (path.endsWith(".git")) path = path.slice(0, -".git".length);
+  host = host.toLowerCase();
+  const segments = path.split("/");
+  if (!host || !SEGMENT.test(host)) return null;
+  if (segments.length < 2 || !segments.every((s) => SEGMENT.test(s) && s !== "." && s !== "..")) {
+    return null;
+  }
+  return `${host}/${segments.join("/")}`;
+}
+
+/** Why a variable name can't be used, or null when it can. */
+export function variableNameError(name: string): string | null {
+  if (!VARIABLE_NAME.test(name)) {
+    return "Use letters, digits and underscores, not starting with a digit.";
+  }
+  if (RESERVED_NAMES.has(name) || RESERVED_PREFIXES.some((p) => name.startsWith(p))) {
+    return `${name} is reserved for the runner.`;
+  }
+  return null;
+}
+
+/**
+ * Parse ``NAME=value`` lines, as in a ``.env`` file, like the CLI does.
+ * Blank lines and ``#`` comments are skipped, ``export`` is allowed and one
+ * pair of matching quotes around a value is removed. Nothing is expanded.
+ *
+ * @returns The pairs in order, and the lines that aren't ``NAME=value``.
+ */
+export function parseEnv(text: string): {
+  variables: { name: string; value: string }[];
+  badLines: number[];
+} {
+  const variables: { name: string; value: string }[] = [];
+  const badLines: number[] = [];
+  text.split(/\r?\n/).forEach((raw, index) => {
+    let line = raw.trim();
+    if (!line || line.startsWith("#")) return;
+    if (line.startsWith("export ")) line = line.slice("export ".length).trimStart();
+    const sep = line.indexOf("=");
+    if (sep < 1) {
+      badLines.push(index + 1);
+      return;
+    }
+    const name = line.slice(0, sep).trim();
+    let value = line.slice(sep + 1).trim();
+    if (value.length >= 2 && value[0] === value[value.length - 1] && `'"`.includes(value[0])) {
+      value = value.slice(1, -1);
+    }
+    variables.push({ name, value });
+  });
+  return { variables, badLines };
+}
+
+async function errorMessage(res: Response): Promise<string> {
+  const body = await res.json().catch(() => ({}));
+  return body?.error?.message ?? `${res.status} ${res.statusText}`;
+}
+
+/** Every repository with variables (admin only). */
+export async function fetchRepoEnv(): Promise<RepoEnvEntry[]> {
+  const res = await authenticatedFetch("/v1/repo-env");
+  if (!res.ok) throw new Error(await errorMessage(res));
+  return ((await res.json()) as { data: RepoEnvEntry[] }).data;
+}
+
+/** The names of one repository's variables, for anyone signed in. */
+export async function fetchRepoEnvNames(repository: string): Promise<string[]> {
+  const res = await authenticatedFetch(
+    `/v1/repo-env/names?repository=${encodeURIComponent(repository)}`,
+  );
+  if (!res.ok) throw new Error(await errorMessage(res));
+  return ((await res.json()) as { names: string[] }).names;
+}
+
+/**
+ * Store a repository's variables, replacing what it had (admin only).
+ *
+ * @param variables Each name's new value, or null to keep the current one.
+ *   Names left out are removed.
+ */
+export async function saveRepoEnv(
+  repository: string,
+  variables: Record<string, string | null>,
+): Promise<RepoEnvEntry> {
+  const res = await authenticatedFetch("/v1/repo-env", {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ repository, variables }),
+  });
+  if (!res.ok) throw new Error(await errorMessage(res));
+  return (await res.json()) as RepoEnvEntry;
+}
+
+/** Remove a repository's variables (admin only). */
+export async function deleteRepoEnv(repository: string): Promise<void> {
+  const res = await authenticatedFetch(
+    `/v1/repo-env?repository=${encodeURIComponent(repository)}`,
+    { method: "DELETE" },
+  );
+  if (!res.ok) throw new Error(await errorMessage(res));
+}
