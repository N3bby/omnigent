+/**
+ * "2 variables" next to a repository in the new-session form, when the
+ * repository has variables (added by this deployment). Clicking it lists
+ * their names; values never reach the browser. Renders nothing for a
+ * repository without variables, or while the names load.
+ */
+
+import { VariableIcon } from "lucide-react";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import { useRepoEnvNames } from "@/hooks/useRepoEnv";
+
+export function RepoEnvBadge({ url }: { url: string }) {
+  const { data: names } = useRepoEnvNames(url);
+  if (!names?.length) return null;
+  const label = `${names.length} variable${names.length === 1 ? "" : "s"}`;
+  return (
+    <Popover>
+      <PopoverTrigger asChild>
+        <button
+          type="button"
+          className="flex shrink-0 items-center gap-1 rounded-sm px-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
+          aria-label={`${label} for this repository`}
+          data-testid="repo-env-badge"
+        >
+          <VariableIcon className="size-3.5" />
+          {label}
+        </button>
+      </PopoverTrigger>
+      <PopoverContent align="end" className="w-64 p-3">
+        <p className="mb-2 text-sm text-muted-foreground">
+          The agent gets these in its environment:
+        </p>
+        <ul className="flex flex-col gap-0.5">
+          {names.map((name) => (
+            <li key={name} className="truncate font-mono text-sm">
+              {name}
+            </li>
+          ))}
+        </ul>
+      </PopoverContent>
+    </Popover>
+  );
+}
