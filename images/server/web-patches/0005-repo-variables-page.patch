@@ -0,0 +1,57 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import {
+  deleteRepoEnv,
+  fetchRepoEnv,
+  fetchRepoEnvNames,
+  repoKey,
+  saveRepoEnv,
+} from "@/lib/repoEnv";
+
+const LIST_KEY = ["repo-env"];
+const NAMES_KEY = "repo-env-names";
+
+/** Every repository with variables (admin only). */
+export function useRepoEnv() {
+  return useQuery({ queryKey: LIST_KEY, queryFn: fetchRepoEnv, staleTime: 5_000 });
+}
+
+/**
+ * The names of the variables sessions on ``url`` get, for the new-session
+ * form. Empty for a URL that isn't a repository.
+ */
+export function useRepoEnvNames(url: string) {
+  const key = repoKey(url);
+  return useQuery({
+    queryKey: [NAMES_KEY, key],
+    queryFn: () => fetchRepoEnvNames(url),
+    enabled: key !== null,
+    staleTime: 60_000,
+  });
+}
+
+function useInvalidate() {
+  const queryClient = useQueryClient();
+  return () => {
+    void queryClient.invalidateQueries({ queryKey: LIST_KEY });
+    void queryClient.invalidateQueries({ queryKey: [NAMES_KEY] });
+  };
+}
+
+/** Store a repository's variables; null keeps a variable's current value. */
+export function useSaveRepoEnv() {
+  const invalidate = useInvalidate();
+  return useMutation({
+    mutationFn: (args: { repository: string; variables: Record<string, string | null> }) =>
+      saveRepoEnv(args.repository, args.variables),
+    onSuccess: invalidate,
+  });
+}
+
+/** Remove a repository's variables. */
+export function useDeleteRepoEnv() {
+  const invalidate = useInvalidate();
+  return useMutation({
+    mutationFn: (repository: string) => deleteRepoEnv(repository),
+    onSuccess: invalidate,
+  });
+}
