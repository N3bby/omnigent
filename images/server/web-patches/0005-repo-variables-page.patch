+/**
+ * Admin page for repository variables (``/settings/repo-env``), added by this
+ * deployment. Rendered as a Settings sub-category, next to Members and
+ * Policies.
+ *
+ * Sessions started on a repository get its variables in their agent's
+ * environment. Values are write-only: the server lists names, and editing
+ * keeps a value whose field is left blank. The server stores each repository
+ * as the Kubernetes Secret that ``mise run setup-repo-env`` writes, so the two
+ * are interchangeable.
+ *
+ * Gated on the client by an admin check AND on the server by the routes.
+ */
+
+import { useEffect, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import {
+  ClipboardPasteIcon,
+  FolderGit2Icon,
+  PencilIcon,
+  PlusIcon,
+  SearchIcon,
+  Trash2Icon,
+  XIcon,
+} from "lucide-react";
+import { PageScroll } from "@/components/PageScroll";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Textarea } from "@/components/ui/textarea";
+import { showToast } from "@/components/ui/toast";
+import { useDeleteRepoEnv, useRepoEnv, useSaveRepoEnv } from "@/hooks/useRepoEnv";
+import { useServerInfo } from "@/lib/CapabilitiesContext";
+import { isSingleUserMode } from "@/lib/capabilities";
+import { fetchGithubRepos } from "@/lib/githubIntegration";
+import { getCurrentIsAdmin, resolveIdentity } from "@/lib/identity";
+import { absoluteTime, relativeTime } from "@/lib/relativeTime";
+import { type RepoEnvEntry, parseEnv, repoKey, variableNameError } from "@/lib/repoEnv";
+import { cn } from "@/lib/utils";
+
+/** ``github.com/kunlabora/roadpass`` → ``["github.com", "kunlabora/roadpass"]``. */
+function splitKey(key: string): [string, string] {
+  const slash = key.indexOf("/");
+  return [key.slice(0, slash), key.slice(slash + 1)];
+}
+
+function plural(count: number, word: string): string {
+  return `${count} ${word}${count === 1 ? "" : "s"}`;
+}
+
+export function RepoVariablesPage() {
+  const info = useServerInfo();
+  const isSingleUser = isSingleUserMode(info);
+  const [meIsAdmin, setMeIsAdmin] = useState<boolean | null>(null);
+
+  // Admin probe via the mode-agnostic `/v1/me` identity, as on the Sharing
+  // page. Skipped in single-user mode, where no auth endpoints exist.
+  useEffect(() => {
+    if (isSingleUser) return;
+    void (async () => {
+      const userId = await resolveIdentity();
+      if (userId === null) return;
+      setMeIsAdmin(getCurrentIsAdmin());
+    })();
+  }, [isSingleUser]);
+
+  if (!isSingleUser && meIsAdmin === null) {
+    return (
+      <div className="flex min-h-full items-center justify-center text-ui text-muted-foreground">
+        Loading...
+      </div>
+    );
+  }
+
+  if (!isSingleUser && meIsAdmin === false) {
+    return (
+      <PageScroll contentClassName="px-8" extraBottom="2.5rem">
+        <h1 className="mb-2 text-2xl font-semibold">Repository variables</h1>
+        <p className="text-ui text-muted-foreground">
+          You don't have permission to manage repository variables.
+        </p>
+      </PageScroll>
+    );
+  }
+
+  return <RepoVariables />;
+}
+
+function RepoVariables() {
+  const { data: entries, isLoading, error } = useRepoEnv();
+  const remove = useDeleteRepoEnv();
+  const [filter, setFilter] = useState("");
+  const [adding, setAdding] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [confirming, setConfirming] = useState<string | null>(null);
+
+  const list = entries ?? [];
+  const needle = filter.trim().toLowerCase();
+  const shown = needle ? list.filter((e) => e.repository.includes(needle)) : list;
+
+  function edit(repository: string) {
+    setAdding(false);
+    setConfirming(null);
+    setEditing(repository);
+  }
+
+  function confirmRemove(entry: RepoEnvEntry) {
+    remove.mutate(entry.repository, {
+      onSuccess: () => {
+        setConfirming(null);
+        showToast(`Removed the variables for ${splitKey(entry.repository)[1]}.`);
+      },
+      onError: (err) => showToast(`Couldn't remove them: ${err.message}`),
+    });
+  }
+
+  return (
+    <PageScroll contentClassName="px-8" extraBottom="2.5rem">
+      <div className="mb-6 flex flex-wrap items-start justify-between gap-3">
+        <div className="min-w-0 max-w-xl">
+          <h1 className="text-2xl font-semibold">Repository variables</h1>
+          <p className="mt-1 text-ui text-muted-foreground">
+            Environment variables for sessions started on a repository, such as a private registry
+            token. Once saved, a value can be replaced but not shown again.
+          </p>
+        </div>
+        {!adding && (
+          <Button
+            onClick={() => {
+              setEditing(null);
+              setConfirming(null);
+              setAdding(true);
+            }}
+            componentId="settings.repo_env.add"
+          >
+            <PlusIcon className="ui-icon" />
+            Add repository
+          </Button>
+        )}
+      </div>
+
+      {adding && (
+        <div className="mb-6 rounded-lg border border-border p-4">
+          <VariablesEditor
+            known={list.map((e) => e.repository)}
+            onClose={() => setAdding(false)}
+            onEditExisting={edit}
+          />
+        </div>
+      )}
+
+      {error ? (
+        <p className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-ui text-destructive">
+          Couldn't load the repository variables: {error.message}
+        </p>
+      ) : isLoading ? (
+        <p className="text-ui text-muted-foreground">Loading…</p>
+      ) : (
+        <>
+          {list.length > 0 && (
+            <label className="relative mb-3 block max-w-xs">
+              <SearchIcon className="pointer-events-none absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted-foreground" />
+              <Input
+                value={filter}
+                onChange={(e) => setFilter(e.target.value)}
+                placeholder="Filter repositories"
+                aria-label="Filter repositories"
+                className="pl-8"
+              />
+            </label>
+          )}
+          <div className="flex flex-col gap-3" data-testid="repo-env-list">
+            {shown.map((entry) => (
+              <RepositoryCard
+                key={entry.repository}
+                entry={entry}
+                editing={editing === entry.repository}
+                confirming={confirming === entry.repository}
+                removing={remove.isPending}
+                onEdit={() => edit(entry.repository)}
+                onCloseEditor={() => setEditing(null)}
+                onAskRemove={() => {
+                  setEditing(null);
+                  setConfirming(entry.repository);
+                }}
+                onCancelRemove={() => setConfirming(null)}
+                onRemove={() => confirmRemove(entry)}
+              />
+            ))}
+            {shown.length === 0 && (
+              <p className="rounded-lg border border-dashed border-border px-4 py-6 text-center text-ui text-muted-foreground">
+                {list.length
+                  ? "No repository matches that filter."
+                  : "No repository has variables yet. Add one to give its sessions a token or setting."}
+              </p>
+            )}
+          </div>
+        </>
+      )}
+
+      <p className="mt-6 max-w-xl text-sm text-muted-foreground">
+        New sessions on a repository get its variables. A running session gets changes the next time
+        it wakes from being idle. Sessions on other repositories never see them.
+      </p>
+    </PageScroll>
+  );
+}
+
+function RepositoryCard({
+  entry,
+  editing,
+  confirming,
+  removing,
+  onEdit,
+  onCloseEditor,
+  onAskRemove,
+  onCancelRemove,
+  onRemove,
+}: {
+  entry: RepoEnvEntry;
+  editing: boolean;
+  confirming: boolean;
+  removing: boolean;
+  onEdit: () => void;
+  onCloseEditor: () => void;
+  onAskRemove: () => void;
+  onCancelRemove: () => void;
+  onRemove: () => void;
+}) {
+  const [host, path] = splitKey(entry.repository);
+  const updated = entry.updated_at ? Date.parse(entry.updated_at) : NaN;
+  const ago = relativeTime(updated);
+  return (
+    <article
+      className="rounded-lg border border-border"
+      data-testid="repo-env-repository"
+      aria-label={entry.repository}
+    >
+      <div className="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2">
+        <FolderGit2Icon className="ui-icon shrink-0 text-muted-foreground" />
+        <span className="min-w-0 flex-1 truncate text-ui font-medium" title={entry.repository}>
+          <span className="font-normal text-muted-foreground">{host}/</span>
+          {path}
+        </span>
+        <span className="text-sm text-muted-foreground" title={absoluteTime(updated)}>
+          {plural(entry.names.length, "variable")}
+          {ago && ` · updated ${ago === "now" ? "just now" : `${ago} ago`}`}
+          {entry.updated_by && ` by ${entry.updated_by}`}
+        </span>
+        {!editing && (
+          <div className="flex gap-1">
+            <Button
+              variant="ghost"
+              size="icon-sm"
+              onClick={onEdit}
+              aria-label={`Edit variables for ${path}`}
+              title="Edit"
+              componentId="settings.repo_env.edit"
+            >
+              <PencilIcon className="ui-icon" />
+            </Button>
+            <Button
+              variant="ghost"
+              size="icon-sm"
+              onClick={onAskRemove}
+              aria-label={`Remove variables for ${path}`}
+              title="Remove"
+              componentId="settings.repo_env.remove"
+            >
+              <Trash2Icon className="ui-icon" />
+            </Button>
+          </div>
+        )}
+      </div>
+      <div className="border-t border-border px-3 py-2">
+        {editing ? (
+          <VariablesEditor entry={entry} onClose={onCloseEditor} />
+        ) : confirming ? (
+          <div className="flex flex-wrap items-center justify-between gap-3">
+            <p className="text-ui">
+              Remove all {plural(entry.names.length, "variable")} for{" "}
+              <span className="font-medium">{path}</span>? New sessions on it start without them.
+            </p>
+            <div className="flex gap-2">
+              <Button variant="outline" onClick={onCancelRemove} disabled={removing}>
+                Cancel
+              </Button>
+              <Button variant="destructive" onClick={onRemove} loading={removing}>
+                Remove
+              </Button>
+            </div>
+          </div>
+        ) : (
+          <ul className="flex flex-col">
+            {entry.names.map((name) => (
+              <li key={name} className="flex items-center gap-3 py-0.5 text-ui">
+                <span className="min-w-0 truncate font-mono text-sm">{name}</span>
+                <span className="text-muted-foreground" aria-label="hidden value">
+                  ••••••••
+                </span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </article>
+  );
+}
+
+const NO_REPOSITORIES: string[] = [];
+
+interface Row {
+  id: number;
+  name: string;
+  value: string;
+  /** Already stored: the name is fixed and a blank value keeps it. */
+  existing: boolean;
+}
+
+let nextRowId = 0;
+function newRow(name = "", value = "", existing = false): Row {
+  nextRowId += 1;
+  return { id: nextRowId, name, value, existing };
+}
+
+function rowError(row: Row, rows: Row[], index: number): string | null {
+  if (!row.name) return row.value ? "Give this value a name." : null;
+  const nameError = variableNameError(row.name);
+  if (nameError) return nameError;
+  if (rows.findIndex((r) => r.name === row.name) !== index) {
+    return `${row.name} is already in this list.`;
+  }
+  return null;
+}
+
+/**
+ * Edits one repository's variables. Without ``entry`` it adds a repository,
+ * starting with picking it.
+ */
+function VariablesEditor({
+  entry,
+  known = NO_REPOSITORIES,
+  onClose,
+  onEditExisting,
+}: {
+  entry?: RepoEnvEntry;
+  known?: string[];
+  onClose: () => void;
+  onEditExisting?: (repository: string) => void;
+}) {
+  const save = useSaveRepoEnv();
+  const [query, setQuery] = useState("");
+  const [rows, setRows] = useState<Row[]>(() =>
+    entry ? entry.names.map((name) => newRow(name, "", true)) : [newRow()],
+  );
+  const [pasting, setPasting] = useState(false);
+  const [pasteText, setPasteText] = useState("");
+  const [pasteError, setPasteError] = useState<string | null>(null);
+  const [saveError, setSaveError] = useState<string | null>(null);
+
+  const key = entry ? entry.repository : repoKey(query);
+  const alreadyThere = !entry && key !== null && known.includes(key);
+  const errors = rows.map((row, i) => rowError(row, rows, i));
+  const named = rows.filter((r) => r.name);
+  const missingValue = named.some((r) => !r.existing && !r.value);
+  const canSave =
+    key !== null &&
+    !alreadyThere &&
+    named.length > 0 &&
+    errors.every((e) => e === null) &&
+    !missingValue &&
+    !save.isPending;
+
+  function update(id: number, patch: Partial<Row>) {
+    setRows((current) => current.map((r) => (r.id === id ? { ...r, ...patch } : r)));
+  }
+
+  function removeRow(id: number) {
+    setRows((current) => {
+      const left = current.filter((r) => r.id !== id);
+      return left.length ? left : [newRow()];
+    });
+  }
+
+  function applyPaste() {
+    const { variables, badLines } = parseEnv(pasteText);
+    if (badLines.length) {
+      setPasteError(
+        `${badLines.length === 1 ? "Line" : "Lines"} ${badLines.join(", ")} ${
+          badLines.length === 1 ? "isn't" : "aren't"
+        } NAME=value.`,
+      );
+      return;
+    }
+    setRows((current) => {
+      const merged = current.filter((r) => r.name || r.value);
+      for (const v of variables) {
+        const same = merged.findIndex((r) => r.name === v.name);
+        if (same >= 0) merged[same] = { ...merged[same], value: v.value };
+        else merged.push(newRow(v.name, v.value));
+      }
+      return merged.length ? merged : [newRow()];
+    });
+    setPasting(false);
+    setPasteText("");
+    setPasteError(null);
+  }
+
+  function submit() {
+    if (!canSave || key === null) return;
+    const variables: Record<string, string | null> = {};
+    for (const row of named) variables[row.name] = row.existing && !row.value ? null : row.value;
+    setSaveError(null);
+    save.mutate(
+      { repository: key, variables },
+      {
+        onSuccess: (saved) => {
+          const path = splitKey(saved.repository)[1];
+          showToast(
+            entry
+              ? `Saved the variables for ${path}.`
+              : `Saved ${plural(saved.names.length, "variable")} for ${path}. New sessions on it get them.`,
+          );
+          onClose();
+        },
+        onError: (err) => setSaveError(err.message),
+      },
+    );
+  }
+
+  return (
+    <form
+      className="flex flex-col gap-3"
+      onSubmit={(e) => {
+        e.preventDefault();
+        submit();
+      }}
+      data-testid="repo-env-editor"
+    >
+      {!entry && (
+        <RepositoryPicker
+          query={query}
+          onQuery={setQuery}
+          repoKey={key}
+          known={known}
+          alreadyThere={alreadyThere}
+          onEditExisting={onEditExisting}
+        />
+      )}
+
+      <div className="flex flex-col gap-2">
+        <span className="text-sm font-medium text-muted-foreground">Variables</span>
+        {pasting ? (
+          <>
+            <Textarea
+              value={pasteText}
+              onChange={(e) => setPasteText(e.target.value)}
+              rows={5}
+              placeholder={"GOVFLANDERS_NPM_TOKEN=…\nNPM_CONFIG_REGISTRY=https://…"}
+              aria-label="Paste NAME=value lines"
+              className="font-mono text-sm"
+              autoFocus
+              spellCheck={false}
+            />
+            {pasteError && <p className="text-sm text-destructive">{pasteError}</p>}
+            <div className="flex gap-2">
+              <Button type="button" variant="outline" onClick={applyPaste}>
+                Add these lines
+              </Button>
+              <Button
+                type="button"
+                variant="ghost"
+                onClick={() => {
+                  setPasting(false);
+                  setPasteError(null);
+                }}
+              >
+                Cancel
+              </Button>
+            </div>
+          </>
+        ) : (
+          rows.map((row, i) => (
+            <div key={row.id} className="flex flex-col gap-1">
+              <div className="flex flex-wrap items-center gap-2 sm:flex-nowrap">
+                <Input
+                  value={row.name}
+                  onChange={(e) => update(row.id, { name: e.target.value.trim() })}
+                  readOnly={row.existing}
+                  placeholder="NAME"
+                  aria-label="Variable name"
+                  aria-invalid={errors[i] ? true : undefined}
+                  autoComplete="off"
+                  autoCapitalize="off"
+                  spellCheck={false}
+                  className={cn(
+                    "font-mono text-sm sm:w-64 sm:flex-none",
+                    row.existing && "bg-muted/40",
+                  )}
+                />
+                <Input
+                  type="password"
+                  value={row.value}
+                  onChange={(e) => update(row.id, { value: e.target.value })}
+                  placeholder={row.existing ? "Leave blank to keep the current value" : "Value"}
+                  aria-label={`Value for ${row.name || "new variable"}`}
+                  autoComplete="new-password"
+                  className="min-w-0 flex-1"
+                />
+                <Button
+                  type="button"
+                  variant="ghost"
+                  size="icon-sm"
+                  onClick={() => removeRow(row.id)}
+                  aria-label={`Remove ${row.name || "row"}`}
+                >
+                  <XIcon className="ui-icon" />
+                </Button>
+              </div>
+              {errors[i] && <p className="text-sm text-destructive">{errors[i]}</p>}
+            </div>
+          ))
+        )}
+      </div>
+
+      {!pasting && (
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <div className="flex gap-1">
+            <Button
+              type="button"
+              variant="ghost"
+              size="sm"
+              onClick={() => setRows((r) => [...r, newRow()])}
+            >
+              <PlusIcon className="ui-icon" />
+              Add variable
+            </Button>
+            <Button type="button" variant="ghost" size="sm" onClick={() => setPasting(true)}>
+              <ClipboardPasteIcon className="ui-icon" />
+              Paste .env
+            </Button>
+          </div>
+          <div className="flex items-center gap-2">
+            {missingValue && (
+              <span className="text-sm text-muted-foreground">
+                Give every new variable a value.
+              </span>
+            )}
+            <Button type="button" variant="outline" onClick={onClose} disabled={save.isPending}>
+              Cancel
+            </Button>
+            <Button type="submit" disabled={!canSave} loading={save.isPending}>
+              Save
+            </Button>
+          </div>
+        </div>
+      )}
+      {saveError && (
+        <p className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-ui text-destructive">
+          {saveError}
+        </p>
+      )}
+    </form>
+  );
+}
+
+/** Pick the repository: a GitHub repository of yours, or any clone URL. */
+function RepositoryPicker({
+  query,
+  onQuery,
+  repoKey: key,
+  known,
+  alreadyThere,
+  onEditExisting,
+}: {
+  query: string;
+  onQuery: (query: string) => void;
+  repoKey: string | null;
+  known: string[];
+  alreadyThere: boolean;
+  onEditExisting?: (repository: string) => void;
+}) {
+  const info = useServerInfo();
+  const githubEnabled = info !== "loading" && (info.enabled_connections ?? []).includes("github");
+  // Same query as the new-session form's picker, so the list is shared.
+  const { data } = useQuery({
+    queryKey: ["github-repos"],
+    queryFn: fetchGithubRepos,
+    enabled: githubEnabled,
+    staleTime: 5 * 60_000,
+  });
+  const repos = data?.connected ? data.repos : [];
+  const needle = query.trim().toLowerCase();
+  const suggestions = repos
+    .filter(
+      (r) => r.full_name.toLowerCase().includes(needle) && r.full_name.toLowerCase() !== needle,
+    )
+    .slice(0, 6);
+
+  return (
+    <div className="flex flex-col gap-2">
+      <label className="text-sm font-medium text-muted-foreground" htmlFor="repo-env-repository">
+        Repository
+      </label>
+      <Input
+        id="repo-env-repository"
+        value={query}
+        onChange={(e) => onQuery(e.target.value)}
+        placeholder={
+          repos.length
+            ? "Search your GitHub repositories, or paste a clone URL"
+            : "owner/repo, or a clone URL"
+        }
+        autoComplete="off"
+        spellCheck={false}
+        autoFocus
+      />
+      {suggestions.length > 0 && (
+        <div className="flex flex-col overflow-hidden rounded-md border border-border">
+          {suggestions.map((repo) => {
+            const has = known.includes(`github.com/${repo.full_name.toLowerCase()}`);
+            return (
+              <button
+                key={repo.full_name}
+                type="button"
+                onClick={() => onQuery(repo.full_name)}
+                className="flex items-center gap-2 px-3 py-1.5 text-left text-ui hover:bg-muted"
+              >
+                <FolderGit2Icon className="ui-icon shrink-0 text-muted-foreground" />
+                <span className="min-w-0 flex-1 truncate">{repo.full_name}</span>
+                {has && <span className="text-sm text-muted-foreground">has variables</span>}
+              </button>
+            );
+          })}
+        </div>
+      )}
+      {key &&
+        (alreadyThere ? (
+          <p className="text-sm text-destructive">
+            {key} already has variables.{" "}
+            {onEditExisting && (
+              <button type="button" className="underline" onClick={() => onEditExisting(key)}>
+                Edit them instead
+              </button>
+            )}
+          </p>
+        ) : (
+          <p className="text-sm text-muted-foreground">
+            Matches sessions on <span className="font-mono">{key}</span>
+          </p>
+        ))}
+      {query.trim() && !key && (
+        <p className="text-sm text-muted-foreground">Enter owner/repo or a clone URL.</p>
+      )}
+    </div>
+  );
+}
