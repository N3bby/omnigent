+
+function renderBadge(url: string, names: string[]) {
+  vi.mocked(identity.authenticatedFetch).mockResolvedValue(
+    new Response(JSON.stringify({ repository: "github.com/kunlabora/roadpass", names })),
+  );
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={client}>
+      <RepoEnvBadge url={url} />
+    </QueryClientProvider>,
+  );
+}
