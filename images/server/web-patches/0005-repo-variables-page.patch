+afterEach(() => {
+  cleanup();
+  vi.mocked(identity.authenticatedFetch).mockReset();
+});
+
+describe("RepoEnvBadge", () => {
+  it("shows how many variables a repository has, and their names on click", async () => {
+    renderBadge("https://github.com/kunlabora/roadpass.git", ["NPM_CONFIG_REGISTRY", "TOKEN"]);
+    fireEvent.click(await screen.findByRole("button", { name: "2 variables for this repository" }));
+    expect(await screen.findByText("NPM_CONFIG_REGISTRY")).toBeInTheDocument();
+    expect(vi.mocked(identity.authenticatedFetch).mock.calls[0][0]).toBe(
+      "/v1/repo-env/names?repository=https%3A%2F%2Fgithub.com%2Fkunlabora%2Froadpass.git",
+    );
+  });
+
+  it("shows nothing without variables, and asks nothing for a non-repository", async () => {
+    const { container } = renderBadge("https://github.com/a/b", []);
+    await vi.waitFor(() => expect(identity.authenticatedFetch).toHaveBeenCalled());
+    expect(container).toBeEmptyDOMElement();
+    cleanup();
+    vi.mocked(identity.authenticatedFetch).mockReset();
+    renderBadge("not a repo", []);
+    expect(identity.authenticatedFetch).not.toHaveBeenCalled();
+  });
+});
