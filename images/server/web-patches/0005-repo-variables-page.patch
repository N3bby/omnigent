+// Tests for the admin Repository variables page. The identity module's
+// authenticatedFetch is replaced by an in-memory /v1/repo-env, so the page,
+// its react-query hooks and the fetch helpers run as they do in the browser.
+
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { RepoVariablesPage } from "./RepoVariablesPage";
+import * as identity from "@/lib/identity";
+
+vi.mock("@/lib/CapabilitiesContext", () => ({
+  useServerInfo: () => ({ login_url: "/login", single_user: false, enabled_connections: [] }),
+}));
+vi.mock("@/lib/identity", () => ({
+  resolveIdentity: vi.fn(),
+  getCurrentIsAdmin: vi.fn(),
+  authenticatedFetch: vi.fn(),
+}));
+vi.mock("@/components/ui/toast", () => ({ showToast: vi.fn() }));
+
+const ROADPASS = "github.com/kunlabora/roadpass";
+
+// What the fake server holds: repository → name → value.
+let stored: Record<string, Record<string, string>>;
+let requests: { method: string; url: string; body?: unknown }[];
+
+function json(status: number, body: unknown): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+function entry(repository: string) {
+  return {
+    repository,
+    names: Object.keys(stored[repository]).sort(),
+    updated_at: new Date(Date.now() - 3 * 86_400_000).toISOString(),
+    updated_by: "levi",
+  };
+}
+
+async function fakeFetch(input: RequestInfo | URL, init?: RequestInit): Promise<Response> {
+  const url = String(input);
+  const method = init?.method ?? "GET";
+  const body = init?.body ? JSON.parse(String(init.body)) : undefined;
+  requests.push({ method, url, body });
+  if (method === "GET" && url === "/v1/repo-env") {
+    return json(200, { object: "list", data: Object.keys(stored).sort().map(entry) });
+  }
+  if (method === "PUT") {
+    const current = stored[body.repository] ?? {};
+    const next: Record<string, string> = {};
+    for (const [name, value] of Object.entries(body.variables as Record<string, string | null>)) {
+      if (value === null && !(name in current)) {
+        return json(400, { error: { message: `${name} has no value yet` } });
+      }
+      next[name] = value ?? current[name];
+    }
+    stored[body.repository] = next;
+    return json(200, entry(body.repository));
+  }
+  if (method === "DELETE") {
+    const repository = new URL(url, "http://x").searchParams.get("repository")!;
+    stored = Object.fromEntries(Object.entries(stored).filter(([key]) => key !== repository));
+    return json(200, { repository, deleted: true });
+  }
+  return json(404, { error: { message: "not found" } });
+}
+
+function renderPage() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={client}>
+      <RepoVariablesPage />
+    </QueryClientProvider>,
+  );
+}
+
+beforeEach(() => {
+  stored = {
+    [ROADPASS]: { GOVFLANDERS_NPM_TOKEN: "secret-token", NPM_CONFIG_REGISTRY: "https://r" },
+  };
+  requests = [];
+  vi.mocked(identity.resolveIdentity).mockResolvedValue("levi");
+  vi.mocked(identity.getCurrentIsAdmin).mockReturnValue(true);
+  vi.mocked(identity.authenticatedFetch).mockImplementation(fakeFetch);
+});
+
+afterEach(cleanup);
+
+describe("RepoVariablesPage", () => {
+  it("lists repositories and variable names, never values", async () => {
+    renderPage();
+    const card = await screen.findByRole("article", { name: ROADPASS });
+    expect(within(card).getByText("GOVFLANDERS_NPM_TOKEN")).toBeInTheDocument();
+    expect(within(card).getByText(/2 variables · updated 3d ago by levi/)).toBeInTheDocument();
+    expect(document.body.textContent).not.toContain("secret-token");
+  });
+
+  it("tells a non-admin they can't manage it", async () => {
+    vi.mocked(identity.getCurrentIsAdmin).mockReturnValue(false);
+    renderPage();
+    expect(
+      await screen.findByText("You don't have permission to manage repository variables."),
+    ).toBeInTheDocument();
+    expect(requests).toEqual([]);
+  });
+
+  it("keeps blank values and replaces typed ones when editing", async () => {
+    renderPage();
+    const card = await screen.findByRole("article", { name: ROADPASS });
+    fireEvent.click(
+      within(card).getByRole("button", { name: "Edit variables for kunlabora/roadpass" }),
+    );
+    fireEvent.change(within(card).getByLabelText("Value for NPM_CONFIG_REGISTRY"), {
+      target: { value: "https://new" },
+    });
+    fireEvent.click(within(card).getByRole("button", { name: "Save" }));
+    await waitFor(() => expect(requests.some((r) => r.method === "PUT")).toBe(true));
+    expect(requests.find((r) => r.method === "PUT")!.body).toEqual({
+      repository: ROADPASS,
+      variables: { GOVFLANDERS_NPM_TOKEN: null, NPM_CONFIG_REGISTRY: "https://new" },
+    });
+    expect(stored[ROADPASS]).toEqual({
+      GOVFLANDERS_NPM_TOKEN: "secret-token",
+      NPM_CONFIG_REGISTRY: "https://new",
+    });
+  });
+
+  it("adds a repository from a clone URL and a pasted .env", async () => {
+    renderPage();
+    await screen.findByRole("article", { name: ROADPASS });
+    fireEvent.click(screen.getByRole("button", { name: "Add repository" }));
+    const editor = screen.getByTestId("repo-env-editor");
+    fireEvent.change(within(editor).getByLabelText("Repository"), {
+      target: { value: "git@github.com:N3bby/Omnigent.git" },
+    });
+    expect(within(editor).getByText("github.com/n3bby/omnigent")).toBeInTheDocument();
+    fireEvent.click(within(editor).getByRole("button", { name: "Paste .env" }));
+    fireEvent.change(within(editor).getByLabelText("Paste NAME=value lines"), {
+      target: { value: "# zone\nexport CLOUDFLARE_ZONE_ID='abc'\n" },
+    });
+    fireEvent.click(within(editor).getByRole("button", { name: "Add these lines" }));
+    fireEvent.click(within(editor).getByRole("button", { name: "Save" }));
+    await waitFor(() => expect(stored["github.com/n3bby/omnigent"]).toBeDefined());
+    expect(stored["github.com/n3bby/omnigent"]).toEqual({ CLOUDFLARE_ZONE_ID: "abc" });
+    expect(
+      await screen.findByRole("article", { name: "github.com/n3bby/omnigent" }),
+    ).toBeInTheDocument();
+  });
+
