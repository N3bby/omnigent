@@ -0,0 +1,31 @@
+import { parseTailscaleHost } from "./tailscale";
+
+/** Gateway needs a specific IDE build to install or reuse it without a wizard. */
+export function gatewayLink(host: string | null, projectPath: string | null): string | null {
+  const tailscaleHost = parseTailscaleHost(host);
+  const buildNumber = import.meta.env.VITE_OMNIGENT_GATEWAY_IDEA_BUILD;
+  const hasControlCharacters = Array.from(projectPath ?? "").some((char) => {
+    const code = char.charCodeAt(0);
+    return code < 32 || code === 127;
+  });
+  if (
+    !tailscaleHost ||
+    !projectPath?.startsWith("/") ||
+    hasControlCharacters ||
+    !/^\d+(?:\.\d+)+$/.test(buildNumber ?? "")
+  ) {
+    return null;
+  }
+
+  const params = new URLSearchParams({
+    type: "ssh",
+    host: tailscaleHost,
+    port: "22",
+    user: "root",
+    projectPath,
+    productCode: "IU",
+    buildNumber,
+    deploy: "true",
+  });
+  return `jetbrains-gateway://connect#${params.toString().replaceAll("+", "%20")}`;
+}
