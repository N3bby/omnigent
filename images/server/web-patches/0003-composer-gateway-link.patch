new file mode 100644
index 0000000..3f9e6a0
--- /dev/null
+++ b/web/src/lib/gateway.ts
@@ -0,0 +1,31 @@
+import { parseTailscaleHost } from "./tailscale";
+
+/** Host-based links require an installed backend, not Gateway's deploy flow. */
+export function gatewayLink(host: string | null, projectPath: string | null): string | null {
+  const tailscaleHost = parseTailscaleHost(host);
+  const idePath = import.meta.env.VITE_OMNIGENT_GATEWAY_IDEA_PATH;
+  const hasControlCharacters = Array.from(`${projectPath ?? ""}${idePath ?? ""}`).some((char) => {
+    const code = char.charCodeAt(0);
+    return code < 32 || code === 127;
+  });
+  if (
+    !tailscaleHost ||
+    !projectPath?.startsWith("/") ||
+    !idePath?.startsWith("/") ||
+    hasControlCharacters
+  ) {
+    return null;
+  }
+
+  const params = new URLSearchParams({
+    type: "ssh",
+    host: tailscaleHost,
+    port: "22",
+    user: "root",
+    projectPath,
+    idePath,
+    // Deploy mode requires a saved SSH configuration ID on each client.
+    deploy: "false",
+  });
+  return `jetbrains-gateway://connect#${params.toString().replaceAll("+", "%20")}`;
+}
