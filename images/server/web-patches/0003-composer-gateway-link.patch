+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { gatewayLink } from "./gateway";
+
+const host = "omnigent-388e67fd.taild5bc1b.ts.net";
+const idePath = "/opt/jetbrains/intellij";
+
+describe("gatewayLink", () => {
+  beforeEach(() => vi.stubEnv("VITE_OMNIGENT_GATEWAY_IDEA_PATH", idePath));
+  afterEach(() => vi.unstubAllEnvs());
+
+  it("connects with host details without requiring a client-local SSH configuration ID", () => {
+    const url = new URL(gatewayLink(host, "/home/omnigent/workspace/project")!);
+    expect(url.protocol).toBe("jetbrains-gateway:");
+    expect(Object.fromEntries(new URLSearchParams(url.hash.slice(1)))).toEqual({
+      type: "ssh",
+      host,
+      port: "22",
+      user: "root",
+      projectPath: "/home/omnigent/workspace/project",
+      idePath,
+      deploy: "false",
+    });
+  });
+
+  it("preserves project paths containing spaces and URL delimiters", () => {
+    const path = "/home/omnigent/workspace/a + café & #100%";
+    const url = new URL(gatewayLink(host, path)!);
+    expect(new URLSearchParams(url.hash.slice(1)).get("projectPath")).toBe(path);
+    expect(url.hash).not.toContain("+");
+  });
+
+  it.each(["", "relative/path", "/opt/idea\n"])(
+    "hides the control when the backend path is invalid: %s",
+    (path) => {
+      vi.stubEnv("VITE_OMNIGENT_GATEWAY_IDEA_PATH", path);
+      expect(gatewayLink(host, "/home/omnigent/workspace/project")).toBeNull();
+    },
+  );
+
+  it.each([null, "relative/path", "/home/omnigent/workspace/project\n"])(
+    "does not create a connection for an invalid workspace: %s",
+    (path) => expect(gatewayLink(host, path)).toBeNull(),
+  );
+});
