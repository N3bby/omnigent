@@ -0,0 +1,137 @@
+import { useEffect, useState } from "react";
+
+import { Button } from "@/components/ui/button";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import {
+  currentRateLimitWindows,
+  formatTimeUntil,
+  rateLimitWindowLabel,
+  rateLimitWindowShortLabel,
+  type RateLimits,
+  type RateLimitWindow,
+} from "@/lib/rateLimits";
+import { cn } from "@/lib/utils";
+
+/** Near a limit is worth a glance; at it, the next turn may be refused. */
+const WARNING_PERCENT = 75;
+const DESTRUCTIVE_PERCENT = 90;
+
+function usageTone(usedPercent: number): string | null {
+  if (usedPercent >= DESTRUCTIVE_PERCENT) return "text-destructive";
+  if (usedPercent >= WARNING_PERCENT) return "text-warning";
+  return null;
+}
+
+function formatPercent(usedPercent: number): string {
+  return `${Math.round(usedPercent)}%`;
+}
+
+/**
+ * Subscription usage windows for the composer workspace bar, next to the
+ * context ring: `5h 23% · 7d 41%`. Tapping opens the reset times, since a
+ * tooltip never opens on touch in the mobile apps.
+ *
+ * Unlike the context ring, the text escalates to warning/destructive colors:
+ * an exhausted window stops the next turn, so it is actionable. Self-nulls
+ * when the harness hasn't reported any window, or every window has reset.
+ *
+ * @param rateLimits - Windows the session's native harness last reported,
+ *   or `null` when none were reported.
+ */
+export function ComposerRateLimits({
+  rateLimits,
+  className,
+}: {
+  rateLimits: RateLimits | null;
+  className?: string;
+}) {
+  const [nowMs, setNowMs] = useState(() => Date.now());
+  // Countdowns only need minute resolution; the re-render also drops a
+  // window once its reset time passes.
+  useEffect(() => {
+    if (rateLimits === null) return;
+    const timer = window.setInterval(() => setNowMs(Date.now()), 60_000);
+    return () => window.clearInterval(timer);
+  }, [rateLimits]);
+
+  const windows = currentRateLimitWindows(rateLimits, nowMs);
+  if (windows.length === 0) return null;
+  const summary = windows
+    .map((w) => `${rateLimitWindowLabel(w.windowMinutes)} ${formatPercent(w.usedPercent)} used`)
+    .join(", ");
+
+  return (
+    <Popover>
+      <PopoverTrigger asChild>
+        <Button
+          type="button"
+          variant="ghost"
+          size="xs"
+          data-testid="composer-rate-limits"
+          aria-label={summary}
+          className={cn(
+            "shrink-0 gap-1 px-1 font-normal tabular-nums text-muted-foreground md:px-1.5",
+            className,
+          )}
+        >
+          {windows.map((w, index) => (
+            <span key={w.windowMinutes} className="flex items-center gap-1">
+              {index > 0 && (
+                <span aria-hidden="true" className="opacity-50">
+                  ·
+                </span>
+              )}
+              <span className="opacity-70">{rateLimitWindowShortLabel(w.windowMinutes)}</span>
+              <span className={cn(usageTone(w.usedPercent))}>{formatPercent(w.usedPercent)}</span>
+            </span>
+          ))}
+        </Button>
+      </PopoverTrigger>
+      <PopoverContent
+        side="top"
+        align="end"
+        collisionPadding={8}
+        aria-label="Usage limits"
+        className="w-[min(18rem,calc(100vw-2rem))] p-3"
+      >
+        <p className="mb-2 text-xs font-medium text-muted-foreground">Usage limits</p>
+        <ul className="flex flex-col gap-2.5">
+          {windows.map((w) => (
+            <RateLimitRow key={w.windowMinutes} limit={w} nowMs={nowMs} />
+          ))}
+        </ul>
+      </PopoverContent>
+    </Popover>
+  );
+}
+
+function RateLimitRow({ limit: w, nowMs }: { limit: RateLimitWindow; nowMs: number }) {
+  const fill = Math.min(Math.max(w.usedPercent, 0), 100);
+  const tone = usageTone(w.usedPercent);
+  return (
+    <li className="flex flex-col gap-1">
+      <div className="flex items-baseline justify-between gap-3 text-sm">
+        <span>{rateLimitWindowLabel(w.windowMinutes)}</span>
+        <span className={cn("tabular-nums", tone ?? "text-muted-foreground")}>
+          {formatPercent(w.usedPercent)} used
+        </span>
+      </div>
+      <div className="h-1.5 overflow-hidden rounded-full bg-muted" aria-hidden="true">
+        <div
+          className={cn("h-full rounded-full bg-current", tone ?? "text-foreground/60")}
+          style={{ width: `${fill}%` }}
+        />
+      </div>
+      {w.resetsAt !== null && (
+        <p className="text-xs tabular-nums text-muted-foreground">
+          Resets in {formatTimeUntil(w.resetsAt, nowMs)} ·{" "}
+          {new Date(w.resetsAt * 1000).toLocaleString(undefined, {
+            weekday: "short",
+            hour: "numeric",
+            minute: "2-digit",
+          })}
+        </p>
+      )}
+    </li>
+  );
+}
