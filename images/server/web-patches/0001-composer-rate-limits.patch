--- /dev/null
+++ b/web/src/lib/rateLimits.ts
@@ -0,0 +1,100 @@
+/**
+ * Subscription usage windows a native harness reports for its login, e.g.
+ * Claude's rolling 5-hour and weekly limits. They belong to the account, not
+ * the session, so every session on the same login shows the same figures.
+ */
+export interface RateLimitWindow {
+  /** Window length, e.g. `300` (5 hours) or `10080` (a week). */
+  windowMinutes: number;
+  /** Share of the window already used, `0`–`100` (can exceed 100). */
+  usedPercent: number;
+  /** Unix epoch seconds when the window resets, or `null` when unknown. */
+  resetsAt: number | null;
+}
+
+export interface RateLimits {
+  windows: RateLimitWindow[];
+}
+
+/** Session label holding the latest windows, for a reload before any update. */
+export const RATE_LIMITS_LABEL_KEY = "omnigent.rate_limits";
+
+/**
+ * Parse the wire `rate_limits` object (`session.usage` event or the session
+ * label's JSON).
+ *
+ * @param raw - `{ windows: [{ window_minutes, used_percent, resets_at }] }`.
+ * @returns The parsed windows, `undefined` when absent, or `null` when
+ *   malformed.
+ */
+export function parseRateLimits(raw: unknown): RateLimits | null | undefined {
+  if (raw === undefined || raw === null) return undefined;
+  if (typeof raw !== "object") return null;
+  const windows = (raw as { windows?: unknown }).windows;
+  if (!Array.isArray(windows) || windows.length === 0) return null;
+  const parsed: RateLimitWindow[] = [];
+  for (const window of windows) {
+    if (typeof window !== "object" || window === null) return null;
+    const {
+      window_minutes: minutes,
+      used_percent: used,
+      resets_at: resetsAt,
+    } = window as Record<string, unknown>;
+    if (typeof minutes !== "number" || !Number.isInteger(minutes) || minutes <= 0) return null;
+    if (typeof used !== "number" || !Number.isFinite(used) || used < 0) return null;
+    if (resetsAt !== null && (typeof resetsAt !== "number" || !Number.isFinite(resetsAt))) {
+      return null;
+    }
+    parsed.push({ windowMinutes: minutes, usedPercent: used, resetsAt });
+  }
+  return { windows: parsed };
+}
+
+/** Parse the session label's JSON; anything unusable reads as no windows. */
+export function rateLimitsFromLabels(
+  labels: Record<string, string> | undefined,
+): RateLimits | null {
+  const raw = labels?.[RATE_LIMITS_LABEL_KEY];
+  if (raw === undefined) return null;
+  try {
+    return parseRateLimits(JSON.parse(raw)) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+/** Windows still in effect: a window whose reset has passed is stale. */
+export function currentRateLimitWindows(
+  rateLimits: RateLimits | null,
+  nowMs: number = Date.now(),
+): RateLimitWindow[] {
+  return (rateLimits?.windows ?? []).filter(
+    (window) => window.resetsAt === null || window.resetsAt * 1000 > nowMs,
+  );
+}
+
+/** Short label for the composer bar, e.g. `"5h"` or `"7d"`. */
+export function rateLimitWindowShortLabel(windowMinutes: number): string {
+  if (windowMinutes % 1440 === 0) return `${windowMinutes / 1440}d`;
+  if (windowMinutes % 60 === 0) return `${windowMinutes / 60}h`;
+  return `${windowMinutes}m`;
+}
+
+/** Descriptive label, e.g. `"5-hour limit"` or `"Weekly limit"`. */
+export function rateLimitWindowLabel(windowMinutes: number): string {
+  if (windowMinutes === 7 * 1440) return "Weekly limit";
+  if (windowMinutes % 1440 === 0) return `${windowMinutes / 1440}-day limit`;
+  if (windowMinutes % 60 === 0) return `${windowMinutes / 60}-hour limit`;
+  return `${windowMinutes}-minute limit`;
+}
+
+/** Time until a reset, e.g. `"45m"`, `"2h 10m"`, `"6d 23h"`. */
+export function formatTimeUntil(resetsAt: number, nowMs: number = Date.now()): string {
+  const totalMinutes = Math.max(0, Math.floor((resetsAt * 1000 - nowMs) / 60_000));
+  const days = Math.floor(totalMinutes / 1440);
+  const hours = Math.floor((totalMinutes % 1440) / 60);
+  const minutes = totalMinutes % 60;
+  if (days > 0) return `${days}d ${hours}h`;
+  if (hours > 0) return `${hours}h ${minutes}m`;
+  return `${minutes}m`;
+}
