@@ -0,0 +1,266 @@
+/**
+ * The "Custom" tab of the new-session repository picker (added by this
+ * deployment): any repository by its URL, with an optional branch and, for
+ * admins, its own Git token or SSH key.
+ *
+ * A credential is saved on the repository (``PUT /v1/repo-env/credentials``)
+ * before the repository is added, so every session on it uses it, as when an
+ * admin sets it in Settings → Repository variables. It's write-only: the
+ * form only says whether the repository already has one.
+ */
+
+import { useState } from "react";
+import { KeyRoundIcon, PlusIcon } from "lucide-react";
+import { showToast } from "@/components/ui/toast";
+import { useIsAdmin } from "@/hooks/useIsAdmin";
+import { useRepoEnvNames, useSaveRepoCredentials } from "@/hooks/useRepoEnv";
+import { GIT_TOKEN, repoKey } from "@/lib/repoEnv";
+import { cn } from "@/lib/utils";
+
+type Credential = "none" | "token" | "ssh";
+
+const CREDENTIALS: { value: Credential; label: string }[] = [
+  { value: "none", label: "None" },
+  { value: "token", label: "Git token" },
+  { value: "ssh", label: "SSH key" },
+];
+
+const FIELD =
+  "min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-colors focus-visible:border-ring";
+
+/** ``https://…`` or ``git@host:path``, as the server accepts (``isValidSandboxRepoUrl``). */
+function urlKind(url: string): "https" | "ssh" | null {
+  const t = url.trim();
+  if (/^https:\/\/[^\s#/]+\/[^\s#]+$/.test(t)) return "https";
+  if (/^git@[^\s#:]+:[^\s#]+$/.test(t)) return "ssh";
+  return null;
+}
+
+export function RepoCustomForm({
+  onAdd,
+  isPicked,
+}: {
+  /** Adds the repository to the session, with its branch ("" = default). */
+  onAdd: (url: string, branch: string) => void;
+  /** Whether the session already has this URL. */
+  isPicked: (url: string) => boolean;
+}) {
+  const isAdmin = useIsAdmin();
+  const save = useSaveRepoCredentials();
+  const [url, setUrl] = useState("");
+  const [branch, setBranch] = useState("");
+  const [credential, setCredential] = useState<Credential>("none");
+  const [token, setToken] = useState("");
+  const [sshKey, setSshKey] = useState("");
+  const [error, setError] = useState<string | null>(null);
+
+  const kind = urlKind(url);
+  const key = kind ? repoKey(url) : null;
+  // Only asked once a credential is chosen, to say it replaces one.
+  const { data: existing } = useRepoEnvNames(credential !== "none" && key ? url : "");
+  const hasToken = existing?.names.includes(GIT_TOKEN) ?? false;
+  const hasKey = existing?.ssh_key ?? false;
+
+  const mismatch =
+    kind === "ssh" && credential === "token"
+      ? "A Git token works with an HTTPS URL, like https://github.com/org/repo."
+      : kind === "https" && credential === "ssh"
+        ? "An SSH key works with an SSH URL, like git@github.com:org/repo.git."
+        : null;
+  const secret = credential === "token" ? token.trim() : credential === "ssh" ? sshKey.trim() : "";
+  const picked = kind !== null && isPicked(url.trim());
+  const canAdd =
+    kind !== null &&
+    !picked &&
+    mismatch === null &&
+    (credential === "none" || secret !== "") &&
+    !save.isPending;
+
+  function reset() {
+    setUrl("");
+    setBranch("");
+    setCredential("none");
+    setToken("");
+    setSshKey("");
+    setError(null);
+  }
+
+  function add() {
+    if (!canAdd) return;
+    const u = url.trim();
+    if (credential === "none") {
+      onAdd(u, branch);
+      reset();
+      return;
+    }
+    setError(null);
+    save.mutate(
+      {
+        repository: u,
+        credentials: credential === "token" ? { git_token: token } : { ssh_key: sshKey },
+      },
+      {
+        onSuccess: (saved) => {
+          onAdd(u, branch);
+          showToast(
+            `Saved the ${credential === "token" ? "Git token" : "SSH key"} for ${saved.repository}. Every session on it uses it, and it's listed under Repositories.`,
+          );
+          reset();
+        },
+        onError: (err) => setError(err.message),
+      },
+    );
+  }
+
+  return (
+    <form
+      className="flex flex-col gap-2.5"
+      onSubmit={(e) => {
+        // The composer around it must never submit.
+        e.preventDefault();
+        e.stopPropagation();
+        add();
+      }}
+      data-testid="new-chat-landing-repo-custom"
+    >
+      <div className="flex flex-col gap-1">
+        <label htmlFor="landing-repo-url" className="text-sm text-muted-foreground">
+          Repository URL
+        </label>
+        <input
+          id="landing-repo-url"
+          type="text"
+          value={url}
+          onChange={(e) => setUrl(e.target.value)}
+          placeholder="https://github.com/org/repo or git@…"
+          autoComplete="off"
+          autoCapitalize="off"
+          spellCheck={false}
+          className={FIELD}
+          data-testid="new-chat-landing-repo-input"
+        />
+        {picked && <p className="text-sm text-muted-foreground">Already picked.</p>}
+      </div>
+      <div className="flex flex-col gap-1">
+        <label htmlFor="landing-repo-branch" className="text-sm text-muted-foreground">
+          Branch
+        </label>
+        <input
+          id="landing-repo-branch"
+          type="text"
+          value={branch}
+          onChange={(e) => setBranch(e.target.value)}
+          placeholder="Default branch"
+          autoComplete="off"
+          autoCapitalize="off"
+          spellCheck={false}
+          className={FIELD}
+          data-testid="new-chat-landing-repo-branch-input"
+        />
+      </div>
+      {isAdmin ? (
+        <div className="flex flex-col gap-1.5">
+          <span id="landing-repo-credential" className="text-sm text-muted-foreground">
+            Credential
+          </span>
+          <div
+            role="radiogroup"
+            aria-labelledby="landing-repo-credential"
+            className="grid grid-cols-3 gap-0.5 rounded-lg bg-muted p-[3px]"
+          >
+            {CREDENTIALS.map((c) => (
+              <button
+                key={c.value}
+                type="button"
+                role="radio"
+                aria-checked={credential === c.value}
+                onClick={() => {
+                  setCredential(c.value);
+                  setError(null);
+                }}
+                className={cn(
+                  "rounded-md px-2 py-1 text-sm text-muted-foreground transition-colors hover:text-foreground",
+                  credential === c.value && "bg-background text-foreground shadow-sm",
+                )}
+                data-testid={`new-chat-landing-repo-credential-${c.value}`}
+              >
+                {c.label}
+              </button>
+            ))}
+          </div>
+          {credential === "none" && (
+            <p className="text-sm text-muted-foreground">
+              Public repositories, and those your GitHub connection reaches, need none.
+            </p>
+          )}
+          {credential === "token" && (
+            <input
+              type="password"
+              value={token}
+              onChange={(e) => setToken(e.target.value)}
+              placeholder={hasToken ? "A new token replaces the current one" : "github_pat_…"}
+              aria-label="Git token"
+              autoComplete="new-password"
+              className={FIELD}
+              data-testid="new-chat-landing-repo-token"
+            />
+          )}
+          {credential === "ssh" && (
+            <textarea
+              value={sshKey}
+              onChange={(e) => setSshKey(e.target.value)}
+              rows={4}
+              placeholder={
+                hasKey
+                  ? "A new key replaces the current one"
+                  : "-----BEGIN OPENSSH PRIVATE KEY-----"
+              }
+              aria-label="SSH private key"
+              autoComplete="off"
+              spellCheck={false}
+              className={cn(FIELD, "resize-none font-mono text-xs")}
+              data-testid="new-chat-landing-repo-ssh-key"
+            />
+          )}
+          {mismatch ? (
+            <p className="text-sm text-warning">{mismatch}</p>
+          ) : (
+            credential !== "none" && (
+              <p className="flex items-start gap-1.5 text-sm text-muted-foreground">
+                <span className="cap-icon">
+                  <KeyRoundIcon className="size-3.5 shrink-0" />
+                </span>
+                <span>
+                  {credential === "ssh" ? "A key without a passphrase, such as a deploy key. " : ""}
+                  Saved with the repository for every session on it. Change it in Settings →
+                  Repository variables.
+                </span>
+              </p>
+            )
+          )}
+        </div>
+      ) : (
+        <p className="text-sm text-muted-foreground">
+          A private repository outside your GitHub connection needs a Git token or SSH key, which an
+          admin can add.
+        </p>
+      )}
+      {error && (
+        <p className="text-sm text-destructive" data-testid="new-chat-landing-repo-custom-error">
+          {error}
+        </p>
+      )}
+      <button
+        type="submit"
+        disabled={!canAdd}
+        className="flex items-center justify-center gap-1 self-end rounded-md border border-input px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground disabled:opacity-40"
+        data-testid="new-chat-landing-repo-add"
+      >
+        <span className="cap-icon">
+          <PlusIcon className="size-3.5" />
+        </span>
+        {credential === "none" ? "Add" : save.isPending ? "Saving…" : "Save and add"}
+      </button>
+    </form>
+  );
+}
