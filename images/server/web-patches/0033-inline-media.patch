+/* Images, video and audio in chat markdown (ChatMarkdownMedia). A single
+   image, a video and an audio player are at most as wide as two tiles of a
+   three-image grid (2 x 13rem plus the 0.5rem gap), so a reply's media line up;
+   the lightbox shows an image whole. */
+.message-markdown {
+  --chat-media-width: 26.5rem;
+}
+
+.message-markdown .chat-media-image {
+  max-width: min(100%, var(--chat-media-width));
+  max-height: 20rem;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+}
+
+.message-markdown video.chat-media {
+  display: block;
+  width: 100%;
+  max-width: var(--chat-media-width);
+  max-height: 24rem;
+  margin-block: 0.5rem;
+  border-radius: var(--radius-md);
+  background: black;
+}
+
+.message-markdown audio.chat-media {
+  display: block;
+  width: 100%;
+  max-width: var(--chat-media-width);
+  margin-block: 0.5rem;
+}
+
+.message-markdown .chat-media-placeholder {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 14rem;
+  max-width: 100%;
+  aspect-ratio: 4 / 3;
+  vertical-align: middle;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+  background: var(--color-muted);
+  color: var(--color-muted-foreground);
+}
+
+/* Two or more images in a row share a grid (groupMediaGalleries): as many
+   columns as fit at 10rem or more, so up to three a row in the chat and two
+   on a phone, with more images wrapping onto further rows. Each image fills a 16:10 tile, which a desktop
+   screenshot fits, cropped from the top so a taller one keeps its header;
+   the lightbox shows it whole. */
+.message-markdown [data-media-gallery] {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
+  gap: 0.5rem;
+  max-width: 40rem;
+  margin-block: 1rem;
+}
+
+.message-markdown [data-media-gallery] > * {
+  min-width: 0;
+}
+
+.message-markdown [data-media-gallery] :is(.chat-media, .chat-media-unavailable) {
+  display: flex;
+  width: 100%;
+  height: auto;
+  max-height: none;
+  margin: 0;
+  aspect-ratio: 16 / 10;
+}
+
+.message-markdown [data-media-gallery] .chat-media-unavailable {
+  justify-content: center;
+}
+
+.message-markdown [data-media-gallery] .chat-media-image {
+  width: 100%;
+  height: 100%;
+  max-width: none;
+  max-height: none;
+  object-fit: cover;
+  object-position: top;
+}
+
 /* Use the usable chat column so side panels and split views keep narrow prose. */
 .chat-conversation-content {
   container: chat-column / inline-size;
