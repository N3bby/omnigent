--- /dev/null
+++ b/web/src/lib/chatMediaCache.ts
@@ -0,0 +1,205 @@
+// The files agents show in the chat, kept in memory once loaded, so the chat
+// doesn't flash when it remounts them.
+//
+// The chat remounts a message's media more often than it looks: when a
+// streamed reply is saved, when you come back to a session, when a virtualized
+// row scrolls back into view. Each mount used to download the file again
+// behind a spinner. Here each message (its scope: the bubble's stable key)
+// keeps the version of a file it first showed, so a remount paints it in its
+// first frame without a download. A message showing a path for the first time
+// fetches it fresh, so after the agent overwrites `shot.png`, a new reply
+// shows the new one. Messages mounting while a download is in flight, or
+// within SHARE_MS after it, as a page's transcript does, share that one.
+//
+// A file that couldn't be loaded stays a chip, without a spinner, and is tried
+// again in the background once the failure is older than RETRY_AFTER_MS, as
+// the server may have a copy by then. Object URLs nothing shows are revoked,
+// least recently shown first, past MAX_ENTRIES or MAX_UNUSED_BYTES.
+
+export const SHARE_MS = 1_000;
+export const RETRY_AFTER_MS = 10_000;
+export const MAX_ENTRIES = 300;
+export const MAX_UNUSED_BYTES = 192 * 1024 * 1024;
+const MAX_SCOPES = 2_000;
+
+/** One download of a file. */
+interface Version {
+  /** An object URL once loaded, `null` once it failed, `undefined` until either. */
+  url: string | null | undefined;
+  promise: Promise<Version>;
+  loadedAt: number;
+  bytes: number;
+  /** Mounted media showing it. */
+  users: number;
+  usedAt: number;
+  revoked: boolean;
+}
+
+/** The newest download per session and path, for sharing and eviction. */
+const latest = new Map<string, Version>();
+/** Every download not yet revoked. */
+const versions = new Set<Version>();
+/** The version each message shows per session and path. */
+const scopes = new Map<string, Map<string, Version>>();
+
+function shown(scope: string | null, key: string): Version | undefined {
+  const version = scope === null ? undefined : scopes.get(scope)?.get(key);
+  return version?.revoked ? undefined : version;
+}
+
+function show(scope: string | null, key: string, version: Version): void {
+  if (scope === null) return;
+  let files = scopes.get(scope);
+  if (!files) {
+    files = new Map();
+    scopes.set(scope, files);
+    if (scopes.size > MAX_SCOPES) scopes.delete(scopes.keys().next().value!);
+  }
+  files.set(key, version);
+}
+
+/**
+ * The newest download, if this message may share it rather than fetch its
+ * own: one in flight, one that just loaded, or a failure not due a retry.
+ */
+function shareable(key: string, now: number): Version | undefined {
+  const version = latest.get(key);
+  if (!version || version.revoked) return undefined;
+  if (version.url === undefined) return version;
+  const age = now - version.loadedAt;
+  return age < (version.url === null ? RETRY_AFTER_MS : SHARE_MS) ? version : undefined;
+}
+
+/**
+ * What a message shows of a file now: its object URL, `null` when it couldn't
+ * be loaded, or `undefined` before its first load settles. A failed file being
+ * tried again still reads `null`, so its chip doesn't turn into a spinner.
+ *
+ * :param scope: The message, e.g. ``"assistant:resp_1"``; `null` for none.
+ * :param key: The session and the path, e.g. ``"conv_1\0shots/a.png"``.
+ */
+export function peekChatMedia(
+  scope: string | null,
+  key: string,
+  now: number = Date.now(),
+): string | null | undefined {
+  const own = shown(scope, key);
+  if (own) return own.url;
+  // A message about to share a settled load shows it in its first render.
+  const shared = shareable(key, now);
+  if (shared && shared.url !== undefined) show(scope, key, shared);
+  return shared?.url;
+}
+
+/**
+ * Load a file for a message: resolves to its object URL, or `null`.
+ *
+ * :param fetchBlob: Downloads the file.
+ */
+export function loadChatMedia(
+  scope: string | null,
+  key: string,
+  fetchBlob: () => Promise<Blob>,
+  now: number = Date.now(),
+): Promise<string | null> {
+  const own = shown(scope, key);
+  if (own && (own.url !== null || now - own.loadedAt < RETRY_AFTER_MS)) {
+    return own.promise.then((version) => version.url ?? null);
+  }
+  const shared = own ? undefined : shareable(key, now);
+  const version = shared ?? download(key, fetchBlob, now);
+  return version.promise.then((loaded) => {
+    // A retry that failed again leaves the chip; one that worked replaces it.
+    if (!own || loaded.url !== null) show(scope, key, loaded);
+    else own.loadedAt = loaded.loadedAt;
+    return loaded.url ?? null;
+  });
+}
+
+function download(key: string, fetchBlob: () => Promise<Blob>, now: number): Version {
+  const version: Version = {
+    url: undefined,
+    promise: Promise.resolve(null as unknown as Version),
+    loadedAt: now,
+    bytes: 0,
+    users: 0,
+    usedAt: now,
+    revoked: false,
+  };
+  version.promise = fetchBlob().then(
+    async (blob) => {
+      const url = URL.createObjectURL(blob);
+      await decodeImage(url, blob.type);
+      version.url = url;
+      version.bytes = blob.size;
+      version.loadedAt = Date.now();
+      evict();
+      return version;
+    },
+    () => {
+      version.url = null;
+      version.loadedAt = Date.now();
+      return version;
+    },
+  );
+  latest.set(key, version);
+  versions.add(version);
+  return version;
+}
+
+/**
+ * Mark the version a message shows as on screen, so it isn't revoked.
+ *
+ * :returns: Releases it, when the media unmounts.
+ */
+export function retainChatMedia(scope: string | null, key: string): () => void {
+  const version = shown(scope, key) ?? latest.get(key);
+  if (!version) return () => {};
+  version.users += 1;
+  let released = false;
+  return () => {
+    if (released) return;
+    released = true;
+    version.users -= 1;
+    version.usedAt = Date.now();
+    evict();
+  };
+}
+
+/**
+ * Decode an image before it's handed out, so its `<img>` paints in the frame
+ * that replaces the spinner rather than one frame later. Best effort: a file
+ * the browser can't decode still goes to the `<img>`, which reports it.
+ */
+async function decodeImage(url: string, type: string): Promise<void> {
+  if (!type.startsWith("image/") || typeof Image === "undefined") return;
+  const image = new Image();
+  if (typeof image.decode !== "function") return;
+  image.src = url;
+  await image.decode().catch(() => undefined);
+}
+
+function evict(): void {
+  const unused = [...versions]
+    .filter((version) => version.users === 0 && version.url !== undefined)
+    .sort((a, b) => a.usedAt - b.usedAt);
+  let unusedBytes = unused.reduce((sum, version) => sum + version.bytes, 0);
+  for (const version of unused) {
+    if (versions.size <= MAX_ENTRIES && unusedBytes <= MAX_UNUSED_BYTES) break;
+    versions.delete(version);
+    unusedBytes -= version.bytes;
+    version.revoked = true;
+    if (version.url) URL.revokeObjectURL(version.url);
+  }
+}
+
+/** Forget everything, revoking every object URL; for tests. */
+export function resetChatMediaCache(): void {
+  for (const version of versions) {
+    version.revoked = true;
+    if (version.url) URL.revokeObjectURL(version.url);
+  }
+  versions.clear();
+  latest.clear();
+  scopes.clear();
+}
