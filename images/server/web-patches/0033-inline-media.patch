+// What a markdown image's path or URL names, by its extension: chat markdown
+// plays a video or audio file (`![demo](demo.mp4)`) and shows anything else as
+// an image.
+
+export type MediaKind = "image" | "video" | "audio";
+
+const VIDEO_EXTENSIONS = new Set(["mp4", "m4v", "webm", "mov", "ogv"]);
+const AUDIO_EXTENSIONS = new Set(["mp3", "m4a", "aac", "wav", "oga", "ogg", "opus", "flac"]);
+
+/** Whether a path or URL names a video, an audio file, or (otherwise) an image. */
+export function mediaKind(pathOrUrl: string): MediaKind {
+  let path = pathOrUrl;
+  if (/^https?:/i.test(path)) {
+    try {
+      path = new URL(path).pathname;
+    } catch {
+      // Not a parseable URL; judge the text as it is.
+    }
+  }
+  path = path.split(/[?#]/)[0];
+  const dot = path.lastIndexOf(".");
+  const extension = dot > path.lastIndexOf("/") ? path.slice(dot + 1).toLowerCase() : "";
+  if (VIDEO_EXTENSIONS.has(extension)) return "video";
+  if (AUDIO_EXTENSIONS.has(extension)) return "audio";
+  return "image";
+}
