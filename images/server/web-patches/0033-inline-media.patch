+++ b/web/src/lib/chatMediaCache.test.ts
@@ -0,0 +1,114 @@
+// The in-memory files the chat shows: each message keeps the version it first
+// showed, a new message fetches its own unless another just did, a failure
+// stays a chip while it's retried, and unused files are revoked past the
+// limits.
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  MAX_ENTRIES,
+  RETRY_AFTER_MS,
+  SHARE_MS,
+  loadChatMedia,
+  peekChatMedia,
+  resetChatMediaCache,
+  retainChatMedia,
+} from "./chatMediaCache";
+
+let next = 0;
+const revoked: string[] = [];
+
+beforeEach(() => {
+  next = 0;
+  revoked.length = 0;
+  vi.stubGlobal(
+    "URL",
+    Object.assign(URL, {
+      createObjectURL: () => `blob:media-${next++}`,
+      revokeObjectURL: (url: string) => revoked.push(url),
+    }),
+  );
+});
+
+afterEach(() => {
+  resetChatMediaCache();
+});
+
+const KEY = "conv_1\0shot.png";
+const blob = () => vi.fn(async () => new Blob(["png"], { type: "image/png" }));
+
+describe("chat media cache", () => {
+  it("keeps the version a message showed, without a second download", async () => {
+    const fetchBlob = blob();
+
+    expect(peekChatMedia("assistant:a", KEY)).toBeUndefined();
+    expect(await loadChatMedia("assistant:a", KEY, fetchBlob)).toBe("blob:media-0");
+    // Remounted: ready in the first render.
+    expect(peekChatMedia("assistant:a", KEY)).toBe("blob:media-0");
+    expect(await loadChatMedia("assistant:a", KEY, fetchBlob)).toBe("blob:media-0");
+    expect(fetchBlob).toHaveBeenCalledTimes(1);
+  });
+
+  it("shares a load with a message showing the file at the same time", async () => {
+    const fetchBlob = blob();
+    const [mine, reply] = await Promise.all([
+      loadChatMedia("user:u", KEY, fetchBlob),
+      loadChatMedia("assistant:a", KEY, fetchBlob),
+    ]);
+    expect([mine, reply]).toEqual(["blob:media-0", "blob:media-0"]);
+    // One that mounts just after shows it in its first render.
+    expect(peekChatMedia("assistant:b", KEY)).toBe("blob:media-0");
+    expect(fetchBlob).toHaveBeenCalledTimes(1);
+  });
+
+  it("fetches a later message's own, so an overwritten file shows its new version", async () => {
+    const fetchBlob = blob();
+    await loadChatMedia("assistant:a", KEY, fetchBlob);
+    const later = Date.now() + SHARE_MS + 1000;
+
+    expect(peekChatMedia("assistant:b", KEY, later)).toBeUndefined();
+    expect(await loadChatMedia("assistant:b", KEY, fetchBlob, later)).toBe("blob:media-1");
+    expect(peekChatMedia("assistant:a", KEY)).toBe("blob:media-0");
+    expect(fetchBlob).toHaveBeenCalledTimes(2);
+  });
+
+  it("keeps a failure a chip and retries it in the background after a while", async () => {
+    const fetchBlob = vi.fn(async (): Promise<Blob> => {
+      throw new Error("503");
+    });
+    expect(await loadChatMedia("assistant:a", KEY, fetchBlob)).toBeNull();
+    expect(peekChatMedia("assistant:a", KEY)).toBeNull();
+
+    await loadChatMedia("assistant:a", KEY, fetchBlob, Date.now() + RETRY_AFTER_MS - 1000);
+    expect(fetchBlob).toHaveBeenCalledTimes(1);
+
+    let finish!: (b: Blob) => void;
+    fetchBlob.mockImplementation(
+      () =>
+        new Promise<Blob>((resolve) => {
+          finish = resolve;
+        }),
+    );
+    const retry = loadChatMedia("assistant:a", KEY, fetchBlob, Date.now() + RETRY_AFTER_MS + 1);
+    expect(fetchBlob).toHaveBeenCalledTimes(2);
+    expect(peekChatMedia("assistant:a", KEY)).toBeNull(); // still a chip, never a spinner
+    finish(new Blob(["png"]));
+    expect(await retry).toBe("blob:media-0");
+    expect(peekChatMedia("assistant:a", KEY)).toBe("blob:media-0");
+  });
+
+  it("revokes the least recently shown unused files past the limit, never a shown one", async () => {
+    await loadChatMedia("assistant:shown", "conv_1\0shown.png", blob());
+    const release = retainChatMedia("assistant:shown", "conv_1\0shown.png");
+    const keys = Array.from({ length: MAX_ENTRIES + 5 }, (_, i) => `conv_1\0${i}.png`);
+    await Promise.all(keys.map((key) => loadChatMedia(`assistant:${key}`, key, blob())));
+    keys.forEach((key) => retainChatMedia(`assistant:${key}`, key)());
+
+    expect(peekChatMedia("assistant:shown", "conv_1\0shown.png")).toBe("blob:media-0");
+    expect(revoked).not.toContain("blob:media-0");
+    expect(revoked.length).toBeGreaterThan(0);
+    expect(peekChatMedia(`assistant:${keys[0]}`, keys[0], Date.now() + SHARE_MS)).toBeUndefined();
+    const last = keys[keys.length - 1];
+    expect(peekChatMedia(`assistant:${last}`, last)).not.toBeUndefined();
+    release();
+  });
+});
