+// Images, video and audio in chat markdown (`![alt](path-or-url)`), shown
+// inline. An image opens in the shared lightbox, and paging through the others
+// when it sits in a grid of them (see groupMediaGalleries).
+//
+// A workspace path is loaded through the session's filesystem API: the file
+// lives in the sandbox, which the browser can't reach directly. The bytes come
+// as a Blob rather than as an `<img src>` to the API, because the download
+// endpoint has no range requests, without which Safari won't play a video, and
+// because an embedding host or native shell needs its own auth on the request.
+// Each message keeps the files it showed in memory (lib/chatMediaCache), so a
+// remount, such as when a streamed reply is saved or you come back to the
+// session, doesn't flash.
+
+import type React from "react";
+import { createContext, useContext, useEffect, useReducer, useState } from "react";
+import { FileAudioIcon, FileVideoIcon, ImageIcon } from "lucide-react";
+import { WORKSPACE_MEDIA_ATTR } from "@/components/ai-elements/streamdown-security";
+import { ZoomableImage } from "@/components/ImageLightbox";
+import { Spinner } from "@/components/ui/spinner";
+import { mediaKind, type MediaKind } from "@/lib/mediaKind";
+import { fetchWorkspaceFileBlob } from "@/hooks/useFileContent";
+import { loadChatMedia, peekChatMedia, retainChatMedia } from "@/lib/chatMediaCache";
+import { resolveChatFilePath } from "@/hooks/useWorkspaceChangedFiles";
+import { useFileViewerConversationId, useWorkspacePaths } from "@/shell/FileViewerContext";
+
+/**
+ * The message whose media renders below: a bubble's stable key, e.g.
+ * ``"assistant:resp_1"``. It keeps the files it showed across remounts.
+ */
+export const ChatMediaScope = createContext<string | null>(null);
+
+function fileName(pathOrUrl: string): string {
+  const path = pathOrUrl.split(/[?#]/)[0].replace(/\/+$/, "");
+  return path.slice(path.lastIndexOf("/") + 1) || pathOrUrl;
+}
+
+type MediaSource = { status: "loading" } | { status: "error" } | { status: "ready"; url: string };
+
+/**
+ * Where the browser can load a markdown image's media from: the URL as
+ * written, or an object URL for the bytes of the workspace file it names,
+ * shared with every other mount that shows it. A file loaded before is ready
+ * in the first render.
+ */
+function useMediaSource(workspacePath: string | null, src: string | undefined): MediaSource {
+  const conversationId = useFileViewerConversationId();
+  const scope = useContext(ChatMediaScope);
+  const { root, home } = useWorkspacePaths();
+  // `./shot.png` is as relative as `shot.png`; the resolver rejects `.`.
+  const cited = workspacePath?.replace(/^(?:\.\/)+/, "") ?? null;
+  const filePath = cited ? (resolveChatFilePath(cited, root, home)?.path ?? null) : null;
+  const key = conversationId && filePath ? `${conversationId}\0${filePath}` : null;
+  const [, settled] = useReducer((n: number) => n + 1, 0);
+
+  useEffect(() => {
+    if (!conversationId || !filePath || !key) return;
+    let cancelled = false;
+    const before = peekChatMedia(scope, key);
+    void loadChatMedia(scope, key, () => fetchWorkspaceFileBlob(conversationId, filePath)).then(
+      (url) => {
+        if (!cancelled && url !== before) settled();
+      },
+    );
+    const release = retainChatMedia(scope, key);
+    return () => {
+      cancelled = true;
+      release();
+    };
+  }, [conversationId, filePath, key, scope]);
+
+  if (workspacePath === null) return src ? { status: "ready", url: src } : { status: "error" };
+  if (!key) {
+    // An absolute or `~` path can't be resolved until the workspace root is
+    // known; it resolves once the environment metadata loads.
+    const rootPending = root === null && /^[/~]/.test(cited ?? "");
+    return rootPending && conversationId ? { status: "loading" } : { status: "error" };
+  }
+  const url = peekChatMedia(scope, key);
+  if (url === undefined) return { status: "loading" };
+  return url ? { status: "ready", url } : { status: "error" };
+}
+
+const KIND_ICONS = { image: ImageIcon, video: FileVideoIcon, audio: FileAudioIcon };
+
+/** A compact chip for media that can't be shown, naming what it was. */
+function UnavailableMedia({ kind, name, path }: { kind: MediaKind; name: string; path: string }) {
+  const Icon = KIND_ICONS[kind];
+  return (
+    <span
+      role="img"
+      aria-label={name}
+      title={`Couldn't load ${path}`}
+      className="chat-media-unavailable inline-flex max-w-full items-center gap-1.5 rounded-md border border-border bg-muted px-2 py-1 align-middle text-sm text-muted-foreground"
+    >
+      <Icon className="size-3.5 shrink-0" />
+      <span className="truncate">{name}</span>
+    </span>
+  );
+}
+
+/**
+ * The `img` renderer for chat markdown. A path or URL ending in a video or
+ * audio extension plays in a native player; anything else is an image that
+ * opens in the lightbox. A workspace path arrives on
+ * {@link WORKSPACE_MEDIA_ATTR}, moved there by markWorkspaceMedia.
+ */
+export function ChatMarkdownMedia({
+  src,
+  alt,
+  title,
+  ...props
+}: React.ComponentProps<"img"> & { node?: unknown }) {
+  const marked = (props as Record<string, unknown>)[WORKSPACE_MEDIA_ATTR];
+  const workspacePath = typeof marked === "string" ? marked : null;
+  const remoteSrc = typeof src === "string" ? src : undefined;
+  const source = useMediaSource(workspacePath, remoteSrc);
+  const [failedUrl, setFailedUrl] = useState<string | null>(null);
+  const where = workspacePath ?? remoteSrc ?? "";
+  const kind = mediaKind(where);
+  const name = alt || fileName(where) || "image";
+
+  if (source.status === "loading") {
+    return (
+      <span
+        role="status"
+        aria-label={`Loading ${name}`}
+        className="chat-media chat-media-placeholder"
+      >
+        <Spinner />
+      </span>
+    );
+  }
+  if (source.status === "error" || failedUrl === source.url) {
+    return <UnavailableMedia kind={kind} name={name} path={where} />;
+  }
+  const onError = () => setFailedUrl(source.url);
+  if (kind === "video") {
+    return (
+      <video
+        className="chat-media chat-media-video"
+        src={source.url}
+        title={title ?? name}
+        aria-label={name}
+        controls
+        playsInline
+        preload="metadata"
+        onError={onError}
+      />
+    );
+  }
+  if (kind === "audio") {
+    return (
+      <audio
+        className="chat-media chat-media-audio"
+        src={source.url}
+        title={title ?? name}
+        aria-label={name}
+        controls
+        preload="metadata"
+        onError={onError}
+      />
+    );
+  }
+  return (
+    <ZoomableImage
+      src={source.url}
+      alt={alt ?? ""}
+      title={title}
+      buttonClassName="chat-media"
+      className="chat-media-image"
+      // A remote image needn't learn which page shows it.
+      referrerPolicy="no-referrer"
+      loading="lazy"
+      decoding="async"
+      onError={onError}
+    />
+  );
+}
