--- /dev/null
+++ b/web/src/hooks/useHosts.hermes.test.tsx
@@ -0,0 +1,66 @@
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, renderHook, waitFor } from "@testing-library/react";
+import { useState, type ReactNode } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { useHosts } from "./useHosts";
+
+const fetchMock = vi.fn();
+
+const wrapper = function QueryWrapper({ children }: { children: ReactNode }) {
+  const [client] = useState(
+    () => new QueryClient({ defaultOptions: { queries: { retry: false } } }),
+  );
+  return <QueryClientProvider client={client}>{children}</QueryClientProvider>;
+};
+
+const hosts = [
+  {
+    host_id: "host_hermes",
+    name: "Hermes",
+    owner: "alice",
+    status: "online",
+    sandbox_provider: null,
+    hermes_only: true,
+  },
+  {
+    host_id: "host_laptop",
+    name: "Laptop",
+    owner: "alice",
+    status: "online",
+    sandbox_provider: null,
+    hermes_only: false,
+  },
+];
+
+beforeEach(() => {
+  fetchMock.mockReset();
+  fetchMock.mockResolvedValue({
+    ok: true,
+    status: 200,
+    statusText: "OK",
+    json: async () => ({ hosts }),
+  } as unknown as Response);
+  vi.stubGlobal("fetch", fetchMock);
+});
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+describe("useHosts and the Hermes host", () => {
+  it("leaves the Hermes host out of the host pickers", async () => {
+    const { result } = renderHook(() => useHosts(), { wrapper });
+    await waitFor(() => expect(result.current.isSuccess).toBe(true));
+
+    expect(result.current.data?.map((h) => h.host_id)).toEqual(["host_laptop"]);
+  });
+
+  it("keeps it for labelling a session that runs there", async () => {
+    const { result } = renderHook(() => useHosts({ includeSandbox: true }), { wrapper });
+    await waitFor(() => expect(result.current.isSuccess).toBe(true));
+
+    expect(result.current.data?.map((h) => h.host_id)).toEqual(["host_hermes", "host_laptop"]);
+  });
+});
