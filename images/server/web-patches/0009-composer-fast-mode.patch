+import { describe, expect, it } from "vitest";
+
+import { fastCommandText, fastModeFromLabels, parseFastMode } from "./fastMode";
+
+describe("fastModeFromLabels", () => {
+  it("reads the session label", () => {
+    expect(fastModeFromLabels({ "omnigent.fast_mode": "true" })).toBe(true);
+    expect(fastModeFromLabels({ "omnigent.fast_mode": "false" })).toBe(false);
+  });
+
+  it("is null when the harness hasn't reported it", () => {
+    expect(fastModeFromLabels(undefined)).toBeNull();
+    expect(fastModeFromLabels({})).toBeNull();
+    expect(fastModeFromLabels({ "omnigent.fast_mode": "yes" })).toBeNull();
+  });
+});
+
+describe("parseFastMode", () => {
+  it("separates absent, valid and malformed values", () => {
+    expect(parseFastMode(undefined)).toBeUndefined();
+    expect(parseFastMode(null)).toBeUndefined();
+    expect(parseFastMode(true)).toBe(true);
+    expect(parseFastMode(false)).toBe(false);
+    expect(parseFastMode("true")).toBeNull();
+  });
+});
+
+describe("fastCommandText", () => {
+  it("keeps an explicit on or off", () => {
+    expect(fastCommandText("on", true)).toBe("/fast on");
+    expect(fastCommandText("OFF", null)).toBe("/fast off");
+  });
+
+  it("turns a bare /fast around from the state the composer shows", () => {
+    expect(fastCommandText("", true)).toBe("/fast off");
+    expect(fastCommandText("", false)).toBe("/fast on");
+    expect(fastCommandText("", null)).toBe("/fast");
+  });
+
+  it("rejects any other argument", () => {
+    expect(fastCommandText("maybe", false)).toBeNull();
+  });
+});
