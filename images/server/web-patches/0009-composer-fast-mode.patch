@@ -0,0 +1,42 @@
+/**
+ * Whether a native harness runs in fast mode: Claude Code's `/fast`, or
+ * Codex's Fast service tier. Reported by the session's runner.
+ */
+
+/** Session label holding `"true"` or `"false"`, for a reload before any update. */
+export const FAST_MODE_LABEL_KEY = "omnigent.fast_mode";
+
+/** Read the session label; `null` when the harness hasn't reported it. */
+export function fastModeFromLabels(labels: Record<string, string> | undefined): boolean | null {
+  const raw = labels?.[FAST_MODE_LABEL_KEY];
+  if (raw === "true") return true;
+  if (raw === "false") return false;
+  return null;
+}
+
+/**
+ * Parse the wire `fast_mode` of a `session.usage` event.
+ *
+ * @returns The flag, `undefined` when absent, or `null` when malformed.
+ */
+export function parseFastMode(raw: unknown): boolean | null | undefined {
+  if (raw === undefined || raw === null) return undefined;
+  return typeof raw === "boolean" ? raw : null;
+}
+
+/**
+ * The `/fast` message to send for what the user typed: a bare `/fast` turns
+ * the state the composer shows around, so it can't open the CLI's picker.
+ *
+ * @param arg - The argument typed after `/fast`, or `""`.
+ * @param fastMode - The state the composer shows, or `null` when unknown.
+ * @returns `"/fast on"`, `"/fast off"`, or a bare `"/fast"` when the state
+ *   is unknown (the runner then decides); `null` for an unknown argument.
+ */
+export function fastCommandText(arg: string, fastMode: boolean | null): string | null {
+  const value = arg.toLowerCase();
+  if (value === "on" || value === "off") return `/fast ${value}`;
+  if (value !== "") return null;
+  if (fastMode === null) return "/fast";
+  return fastMode ? "/fast off" : "/fast on";
+}
