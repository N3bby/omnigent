diff --git a/web/src/hooks/useSessionEnvironment.ts b/web/src/hooks/useSessionEnvironment.ts
new file mode 100644
index 0000000..8247c9c
--- /dev/null
+++ b/web/src/hooks/useSessionEnvironment.ts
@@ -0,0 +1,101 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+
+import { authenticatedFetch } from "@/lib/identity";
+
+/**
+ * What a sandbox session's Pod is doing, from
+ * `GET /v1/sessions/{id}/environment`. Times are Unix seconds; a field is
+ * absent when it's unknown (no Pod, no runner report yet, not a sandbox).
+ */
+export interface SessionEnvironment {
+  /** When the running Pod started. */
+  pod_started_at?: number;
+  /** The Sandbox's deadline: when it stops, or when it stopped. */
+  shutdown_at?: number;
+  /** How long the Pod outlives its agent when idle, in seconds. */
+  idle_stop_window_s?: number;
+  disk_used_bytes?: number;
+  disk_total_bytes?: number;
+  /** Free disk as the kubelet counts it for eviction. */
+  disk_available_fraction?: number;
+  /** CPUs the Pod is using, e.g. `1.5`. */
+  cpu_cores?: number;
+  /** Memory the Pod is using, in bytes. */
+  memory_bytes?: number;
+  agent_active?: boolean;
+  agent_idle_since?: number;
+  /** When the agent exits for being idle; absent while it's working. */
+  agent_exits_at?: number;
+  /** "Keep running": until when, and how many hours were chosen. */
+  keep_running_until?: number;
+  keep_running_hours?: number;
+  /** "Keep running": until the user stops it. */
+  keep_running_forever?: boolean;
+}
+
+/** The "Keep running" choice: for some hours, for good, or the usual idle timeout (`{}`). */
+export type KeepRunningChoice = { hours: number } | { forever: true } | Record<string, never>;
+
+interface KeepRunningState {
+  keep_running_until: number | null;
+  keep_running_hours: number | null;
+  keep_running_forever: boolean;
+}
+
+export async function fetchSessionEnvironment(sessionId: string): Promise<SessionEnvironment> {
+  const res = await authenticatedFetch(`/v1/sessions/${encodeURIComponent(sessionId)}/environment`);
+  if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
+  return (await res.json()) as SessionEnvironment;
+}
+
+/** How often the open menu refreshes. */
+const POLL_MS = 5_000;
+
+/**
+ * The session's environment, fetched only while the environment menu is open
+ * and refreshed every {@link POLL_MS} until it closes. Reopening shows the last
+ * answer straight away while it refreshes.
+ */
+export function useSessionEnvironment(sessionId: string, open: boolean) {
+  return useQuery({
+    queryKey: ["session-environment", sessionId],
+    queryFn: () => fetchSessionEnvironment(sessionId),
+    enabled: open,
+    staleTime: 0,
+    refetchInterval: open ? POLL_MS : false,
+    refetchOnWindowFocus: false,
+    retry: false,
+  });
+}
+
+export async function setKeepRunning(
+  sessionId: string,
+  choice: KeepRunningChoice,
+): Promise<KeepRunningState> {
+  const res = await authenticatedFetch(
+    `/v1/sessions/${encodeURIComponent(sessionId)}/environment/keep-running`,
+    {
+      method: "PUT",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(choice),
+    },
+  );
+  if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
+  return (await res.json()) as KeepRunningState;
+}
+
+/** Set "Keep running", and show it in the open menu straight away. */
+export function useSetKeepRunning(sessionId: string) {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (choice: KeepRunningChoice) => setKeepRunning(sessionId, choice),
+    onSuccess: (state) => {
+      queryClient.setQueryData<SessionEnvironment>(["session-environment", sessionId], (old) => ({
+        ...old,
+        keep_running_until: state.keep_running_until ?? undefined,
+        keep_running_hours: state.keep_running_hours ?? undefined,
+        keep_running_forever: state.keep_running_forever || undefined,
+      }));
+    },
+  });
+}
