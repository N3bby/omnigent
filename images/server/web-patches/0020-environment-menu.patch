+
+/** Memory in use, e.g. `"8 GB"`, `"1.2 GB"`, `"512 MB"`. */
+export function formatMemory(bytes: number): string {
+  return bytes >= GIB ? `${oneDecimal(bytes / GIB)} GB` : `${Math.round(bytes / 1024 ** 2)} MB`;
