+    <EnvironmentMenu
+      sessionId={sessionId}
+      view={{
+        state,
+        startStep,
+        providerLabel: sandboxOptionLabel(provider),
+        tailscaleHost,
+        fallbackName: host?.name ?? null,
+        agentLabel: nativeCodingAgentForWrapper(wrapper)?.displayName ?? null,
+        error: sandboxStatus?.error ?? null,
+        canControl: isOwner && !readOnly,
+        canCancelStart: Boolean(session?.hostId && session.hostResumable),
+        canStart: Boolean(session?.hostId && session.hostResumable),
+        status: status ?? null,
+      }}
+      onOpenChange={setOpen}
