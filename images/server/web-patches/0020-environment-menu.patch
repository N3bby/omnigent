+      >
+        {content}
+        <ChevronRightIcon className="ml-auto" />
+      </ControlItem>
+    );
+  }
+  const trigger = (
+    <DropdownMenuSubTrigger
+      className="gap-2"
+      disabled={!allowed}
+      data-testid="environment-keep-running"
+    >
+      {content}
+    </DropdownMenuSubTrigger>
+  );
+  if (!allowed) {
+    return (
+      <Tooltip>
+        <TooltipTrigger asChild>
+          <div>
+            <DropdownMenuSub>{trigger}</DropdownMenuSub>
+          </div>
+        </TooltipTrigger>
+        <TooltipContent side="right">Only the session owner can do this</TooltipContent>
+      </Tooltip>
+    );
+  }
+  return (
+    <DropdownMenuSub>
+      {trigger}
+      <DropdownMenuSubContent
+        className="composer-host-menu environment-menu min-w-[220px]"
+        sideOffset={6}
+        data-testid="environment-keep-running-menu"
+      >
+        <KeepRunningOptions sessionId={sessionId} status={status} />
+      </DropdownMenuSubContent>
+    </DropdownMenuSub>
+  );
+}
+
+/** Keep running's choices on a phone, in place of the menu, with a way back. */
+function KeepRunningPage({
+  sessionId,
+  status,
+  onBack,
+}: {
+  sessionId: string;
+  status: SessionEnvironment | null | undefined;
+  onBack: () => void;
+}) {
+  return (
+    <div
+      className="animate-in fade-in-0 slide-in-from-right-2 duration-150"
+      data-testid="environment-keep-running-menu"
+    >
+      <DropdownMenuGroup>
+        <DropdownMenuItem
+          className="gap-2"
+          data-testid="environment-keep-running-back"
+          onSelect={(event) => {
+            event.preventDefault();
+            onBack();
+          }}
+        >
+          <ChevronLeftIcon className="size-4" />
+          <span data-cap>Keep running</span>
+        </DropdownMenuItem>
+      </DropdownMenuGroup>
+      <DropdownMenuSeparator />
+      <KeepRunningOptions sessionId={sessionId} status={status} />
+    </div>
+  );
+}
+
+/** How long a copy's check mark shows. */
+const COPIED_MS = 2000;
+
+/** A menu item that copies `text` and shows a check, keeping the menu open. */
+function CopyItem({
+  icon,
+  label,
+  text,
+  testId,
+  trailingIcon = false,
+}: {
+  icon: ReactNode;
+  label: string;
+  text: string;
+  testId: string;
+  /** Show the copy icon at the end, as a hint, rather than leading. */
+  trailingIcon?: boolean;
+}) {
+  const [copied, setCopied] = useState(false);
+  const timer = useRef<number | undefined>(undefined);
+  useEffect(() => () => window.clearTimeout(timer.current), []);
+  return (
+    <DropdownMenuItem
+      className="gap-2"
+      data-testid={testId}
+      onSelect={(event) => {
+        event.preventDefault();
+        copyText(text).then(
+          () => {
+            setCopied(true);
+            window.clearTimeout(timer.current);
+            timer.current = window.setTimeout(() => setCopied(false), COPIED_MS);
+          },
+          () => toast.error("Couldn't copy to the clipboard."),
+        );
+      }}
+    >
+      {copied && !trailingIcon ? <CheckIcon className="size-4 text-success" /> : icon}
+      <span data-cap>{copied && !trailingIcon ? "Copied" : label}</span>
+      {trailingIcon && (
+        <Hint>
+          {copied ? <CheckIcon className="size-3 text-success" /> : <CopyIcon className="size-3" />}
+        </Hint>
+      )}
+    </DropdownMenuItem>
+  );
+}
+
+/** An owner-only item: disabled with a tooltip for everyone else. */
+function ControlItem({
+  allowed,
+  children,
+  ...props
+}: Omit<ComponentProps<typeof DropdownMenuItem>, "disabled"> & { allowed: boolean }) {
+  if (allowed) return <DropdownMenuItem {...props}>{children}</DropdownMenuItem>;
+  return (
+    <Tooltip>
+      <TooltipTrigger asChild>
+        <div>
+          <DropdownMenuItem {...props} disabled>
+            {children}
+          </DropdownMenuItem>
+        </div>
+      </TooltipTrigger>
+      <TooltipContent side="right">Only the session owner can do this</TooltipContent>
+    </Tooltip>
+  );
+}
+
+/**
+ * The composer's environment menu for a sandbox session: the sandbox's state,
+ * what's running in it, and its controls. Opened from the monitor icon left
+ * of the permission picker. Spacing lives in `index.css` (`.environment-menu`).
+ */
+export function EnvironmentMenu({
+  sessionId,
+  view,
+  defaultOpen = false,
+  onOpenChange,
+}: {
+  sessionId: string;
+  view: EnvironmentView;
+  /** Open on mount (stories and screenshots). */
+  defaultOpen?: boolean;
+  /** Told when the menu opens and closes, to fetch its status only while open. */
+  onOpenChange?: (open: boolean) => void;
+}) {
+  const stop = useStopSession();
+  const [stopOpen, setStopOpen] = useState(false);
+  const isMobile = useIsMobileViewport();
+  // On a phone, Keep running's choices replace the menu until Back or it closes.
+  const [keepRunningPage, setKeepRunningPage] = useState(false);
+  const [optimistic, setOptimistic] = useOptimisticState(view.state);
+  const shown: EnvironmentView = optimistic
+    ? {
+        ...view,
+        state: optimistic,
+        // Starting the agent on a Pod that's up skips "Starting the Pod".
+        startStep: optimistic === "starting" && view.state === "agent_exited" ? 1 : view.startStep,
+      }
+    : view;
+  const { state } = shown;
+  const up = state === "running" || state === "idle" || state === "agent_exited";
+  // The MagicDNS short name, e.g. `ssh root@omnigent-d8ee7424`.
+  const sshCommand = view.tailscaleHost
+    ? `ssh root@${tailscaleShortName(view.tailscaleHost)}`
+    : null;
+
+  const restartAgent = () =>
+    stop.mutate(sessionId, {
+      onSuccess: () => {
+        setOptimistic("agent_exited");
+        toast.success("The agent stopped. Your next message starts it again.");
+      },
+      onError: (error) =>
+        toast.error(
+          `Couldn't restart the agent${error instanceof Error && error.message ? `: ${error.message}` : ""}.`,
+        ),
+    });
+  // Start now, Try again and Start agent: relaunch without a message.
+  const start = useMutation({ mutationFn: () => retrySession(sessionId) });
+  const startNow = () => {
+    const what = state === "agent_exited" ? "the agent" : "the sandbox";
+    setOptimistic("starting");
+    start.mutate(undefined, {
+      onError: (error) =>
+        toast.error(
+          `Couldn't start ${what}${error instanceof Error && error.message ? `: ${error.message}` : ""}.`,
+        ),
+    });
+  };
+  const cancelStart = () =>
+    stop.mutate(
+      { id: sessionId, suspendSandbox: true },
+      {
+        onSuccess: () => setOptimistic("stopped"),
+        onError: (error) =>
+          toast.error(
+            `Couldn't cancel the start${error instanceof Error && error.message ? `: ${error.message}` : ""}.`,
+          ),
+      },
+    );
+
+  // Keep running needs the agent up: its runner holds the Pod.
+  const keepRunning = up && state !== "agent_exited";
+  const actions: { key: string; node: ReactNode }[] = [];
+  if (up) {
+    if (sshCommand || keepRunning) {
+      actions.push({
+        key: "connect",
+        node: (
+          <DropdownMenuGroup>
+            {sshCommand && (
+              <CopyItem
+                icon={<TerminalIcon className="size-4" />}
+                label="Copy SSH command"
+                text={sshCommand}
+                testId="environment-copy-ssh"
+                trailingIcon
+              />
+            )}
+            {keepRunning && (
+              <KeepRunningMenu
+                sessionId={sessionId}
+                status={view.status}
+                allowed={view.canControl}
+                onOpenPage={isMobile ? () => setKeepRunningPage(true) : undefined}
+              />
+            )}
+          </DropdownMenuGroup>
+        ),
+      });
+    }
+    actions.push({
+      key: "lifecycle",
+      node: (
+        <DropdownMenuGroup>
+          {state === "agent_exited" ? (
+            <ControlItem
+              allowed={view.canControl}
+              className="gap-2"
+              data-testid="environment-start-agent"
+              onSelect={startNow}
+            >
+              <PlayIcon className="size-4" />
+              <span data-cap>Start agent</span>
+              <Hint>without a message</Hint>
+            </ControlItem>
+          ) : (
+            <ControlItem
+              allowed={view.canControl}
+              className="gap-2"
+              data-testid="environment-restart-agent"
+              onSelect={restartAgent}
+            >
+              <RotateCcwIcon className="size-4" />
+              <span data-cap>Restart agent</span>
+              <Hint>keeps the Pod</Hint>
+            </ControlItem>
+          )}
+          <ControlItem
+            allowed={view.canControl}
+            variant="destructive"
+            className="gap-2"
+            data-testid="environment-stop-sandbox"
+            onSelect={() => setStopOpen(true)}
+          >
+            <CircleStopIcon className="size-4" />
+            <span data-cap>Stop sandbox</span>
+            <Hint>keeps files</Hint>
+          </ControlItem>
+        </DropdownMenuGroup>
+      ),
+    });
+  } else if (state === "stopped" && view.canStart) {
+    actions.push({
+      key: "start",
+      node: (
+        <DropdownMenuGroup>
+          <ControlItem
+            allowed={view.canControl}
+            className="gap-2"
+            data-testid="environment-start-now"
+            onSelect={startNow}
+          >
+            <PlayIcon className="size-4" />
+            <span data-cap>Start now</span>
+            <Hint>without a message</Hint>
+          </ControlItem>
+        </DropdownMenuGroup>
+      ),
+    });
+  } else if (state === "starting" && view.canCancelStart) {
+    actions.push({
+      key: "cancel",
+      node: (
+        <DropdownMenuGroup>
+          <ControlItem
+            allowed={view.canControl}
+            variant="destructive"
+            className="gap-2"
+            data-testid="environment-cancel-start"
+            onSelect={cancelStart}
+          >
+            <CircleStopIcon className="size-4" />
+            <span data-cap>Cancel start</span>
+          </ControlItem>
+        </DropdownMenuGroup>
+      ),
+    });
+  } else if (state === "failed" && (view.error || view.canStart)) {
+    actions.push({
+      key: "failed",
+      node: (
+        <DropdownMenuGroup>
+          {view.canStart && (
+            <ControlItem
+              allowed={view.canControl}
+              className="gap-2"
+              data-testid="environment-try-again"
+              onSelect={startNow}
+            >
+              <RotateCcwIcon className="size-4" />
+              <span data-cap>Try again</span>
+            </ControlItem>
+          )}
+          {view.error && (
+            <CopyItem
+              icon={<CopyIcon className="size-4" />}
+              label="Copy error details"
+              text={view.error}
+              testId="environment-copy-error"
+            />
+          )}
+        </DropdownMenuGroup>
+      ),
+    });
+  }
+
+  return (
+    <>
+      <DropdownMenu
+        defaultOpen={defaultOpen}
+        onOpenChange={(open) => {
+          if (!open) setKeepRunningPage(false);
+          onOpenChange?.(open);
+        }}
+      >
+        <DropdownMenuTrigger asChild>
+          <ComposerHostTrigger
+            label={`${view.providerLabel}, ${STATE_WORD[state].toLowerCase()}`}
+            status={state === "stopped" ? "offline" : "online"}
+            dot={<EnvironmentDot state={state} />}
+            cloud
+            data-testid="composer-host-select"
+          />
+        </DropdownMenuTrigger>
+        <DropdownMenuContent
+          align="start"
+          side="top"
+          sideOffset={8}
+          className="composer-host-menu environment-menu w-[320px] max-w-[calc(100vw-16px)]"
+          data-testid="composer-host-menu"
+          data-state-name={state}
+        >
+          {keepRunningPage && isMobile && keepRunning ? (
+            <KeepRunningPage
+              sessionId={sessionId}
+              status={view.status}
+              onBack={() => setKeepRunningPage(false)}
+            />
+          ) : (
+            <>
+              <Header view={shown} />
+              <DropdownMenuSeparator />
+              <div className="py-1.5">
+                <Body view={shown} />
+              </div>
+              {actions.map(({ key, node }) => (
+                <Fragment key={key}>
+                  <DropdownMenuSeparator />
+                  {node}
+                </Fragment>
+              ))}
+            </>
+          )}
+        </DropdownMenuContent>
+      </DropdownMenu>
+      <StopSandboxDialog
+        sessionId={sessionId}
+        open={stopOpen}
+        onOpenChange={setStopOpen}
+        onStopped={() => setOptimistic("stopped")}
+      />
+    </>
+  );
+}
+
+/** How long an optimistic state waits for the polled one to catch up. */
+const OPTIMISTIC_MS = 90_000;
+
+/**
+ * Show the state a just-accepted action leads to (Stop sandbox, Restart
+ * agent, Start now, Start agent) until the polled state reaches it. Liveness comes from a ~10s poll
+ * and a Pod takes up to 30s to stop, so without this the menu would say
+ * Running for a while after Stop. Gives up after {@link OPTIMISTIC_MS}, or
+ * when something else happens: a turn or a start begins, or a start fails.
+ */
+export function useOptimisticState(
+  actual: EnvironmentState,
+): [EnvironmentState | null, (state: EnvironmentState) => void] {
+  const [pending, setPending] = useState<{
+    target: EnvironmentState;
+    from: EnvironmentState;
+  } | null>(null);
+  useEffect(() => {
+    if (pending === null) return;
+    const { target, from } = pending;
+    const settled =
+      actual === target ||
+      // Stopping the sandbox stops the agent too.
+      (target === "agent_exited" && actual === "stopped") ||
+      (actual !== from &&
+        (actual === "running" ||
+          actual === "starting" ||
+          actual === "failed" ||
+          // An agent started on a live Pod can come up before a poll sees it start.
+          (target === "starting" && actual === "idle")));
+    if (settled) {
+      setPending(null);
+      return;
+    }
+    const timer = window.setTimeout(() => setPending(null), OPTIMISTIC_MS);
+    return () => window.clearTimeout(timer);
+  }, [actual, pending]);
+  return [pending?.target ?? null, (target) => setPending({ target, from: actual })];
+}
