+/* The composer's environment menu for a sandbox session (EnvironmentMenu.tsx).
+ * One rule: every block of content sits 16px from the menu edge or the nearest
+ * divider. Item text is 6px (menu) + 10px (item) in; a group's first and last
+ * item text lands 6px (divider) + 3px (group) + 7px (item) from the divider;
+ * dividers and hover highlights are inset 6px like the content. */
+.environment-menu.composer-host-menu {
+  padding: 6px;
+}
+
+.environment-menu.composer-host-menu [role="menuitem"] {
+  min-height: 34px;
+  gap: 10px;
+  padding: 7px 10px;
+}
+
+.environment-menu.composer-host-menu [role="separator"] {
+  margin: 6px 0;
+}
+
+.environment-menu.composer-host-menu [role="group"] {
+  padding: 3px 0;
+}
+
+/* Trim labels to their capitals, so flex centring lines an icon up with the
+ * capital letters in any font. Firefox ignores text-box and keeps the ~1px
+ * offset it had. Rows that use it set a height, since trimming removes the
+ * line height. */
+.environment-menu [data-cap] {
+  text-box: trim-both cap alphabetic;
+}
+
 .composer-host-menu [role="separator"] {
   margin: 4px 0;
 }
