index 0000000..fda944f
--- /dev/null
+++ b/web/src/components/StopSandboxDialog.tsx
@@ -0,0 +1,99 @@
+import { useEffect, type MouseEvent } from "react";
+
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { useStopSession } from "@/hooks/useConversations";
+
+/**
+ * Confirms "Stop sandbox": stops the session's agent and its Pod, as an idle
+ * stop would. Files in the home directory are kept and the next message starts
+ * the sandbox again. Shared by the sidebar's session menu and the composer's
+ * environment menu.
+ */
+export function StopSandboxDialog({
+  sessionId,
+  open,
+  onOpenChange,
+  onStopped,
+  onContentClick,
+}: {
+  sessionId: string;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  /** Runs after the server accepted the stop, before the dialog closes. */
+  onStopped?: () => void;
+  /** Lets a caller inside a link keep the dialog's clicks to itself. */
+  onContentClick?: (event: MouseEvent<HTMLDivElement>) => void;
+}) {
+  const stopSession = useStopSession();
+  const { reset } = stopSession;
+  // Clear a previous failure each time the dialog opens, so a stale "couldn't
+  // stop" doesn't greet the next attempt. An effect rather than onOpenChange:
+  // Radix only reports the changes it makes itself, not a caller's open.
+  useEffect(() => {
+    if (open) reset();
+  }, [open, reset]);
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      {open && (
+        <DialogContent onClick={onContentClick} data-testid="stop-sandbox-dialog">
+          <DialogHeader>
+            <DialogTitle>Stop the sandbox?</DialogTitle>
+            <DialogDescription>
+              The agent and everything running in its Pod stop now, including dev servers and
+              containers. Files in <span className="font-mono">/home/omnigent</span> are kept, and
+              your next message starts it again.
+            </DialogDescription>
+          </DialogHeader>
+          {stopSession.isError && (
+            <p className="text-ui text-destructive" role="alert">
+              Couldn't stop the sandbox
+              {stopSession.error instanceof Error && stopSession.error.message
+                ? `: ${stopSession.error.message}`
+                : ""}
+              . Try again in a moment.
+            </p>
+          )}
+          <DialogFooter>
+            <Button
+              type="button"
+              variant="ghost"
+              onClick={() => onOpenChange(false)}
+              disabled={stopSession.isPending}
+            >
+              Cancel
+            </Button>
+            <Button
+              type="button"
+              variant="destructive"
+              data-testid="stop-sandbox-confirm"
+              onClick={() =>
+                stopSession.mutate(
+                  { id: sessionId, suspendSandbox: true },
+                  {
+                    onSuccess: () => {
+                      onStopped?.();
+                      onOpenChange(false);
+                    },
+                  },
+                )
+              }
+              loading={stopSession.isPending}
+              componentId="session.stop_sandbox"
+            >
+              Stop sandbox
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      )}
+    </Dialog>
+  );
+}
