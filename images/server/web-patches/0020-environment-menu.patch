+/**
+ * The composer's environment menu for a sandbox session, fed from the signals
+ * the open session already has: its launch stage, liveness and turn.
+ */
+function SandboxEnvironmentMenu({
+  sessionId,
+  host,
+  session,
+  hostOnline,
+  readOnly,
+  agentWorking,
+}: {
+  sessionId: string;
+  /** `undefined` while a new session's sandbox launches, before its host is bound. */
+  host: Host | undefined;
+  session: Session | null | undefined;
+  hostOnline: boolean | null | undefined;
+  readOnly: boolean;
+  agentWorking: boolean;
+}) {
+  // The chat store holds the open session's live state; ignore it for another.
+  const isOpen = useChatStore((s) => s.conversationId === sessionId);
+  const sandboxStatus = useChatStore((s) => (isOpen ? s.sandboxStatus : null));
