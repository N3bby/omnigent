+  const level = session?.permissionLevel;
+  const isOwner = level === null || level === undefined || level >= 4;
+  const wrapper = session?.labels?.[WRAPPER_LABEL_KEY];
+  const serverInfo = useServerInfo();
+  const [open, setOpen] = useState(false);
