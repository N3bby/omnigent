+  sandboxStatus,
+  liveness,
+  agentWorking,
+  hostOnline,
+}: {
+  sandboxStatus: SandboxStatus | null;
+  liveness: SessionLiveness;
+  agentWorking: boolean;
+  hostOnline: boolean | null | undefined;
+}): { state: EnvironmentState; startStep: StartStep } {
+  if (sandboxStatus?.stage === "failed") return { state: "failed", startStep: 0 };
+  if (sandboxStatus && sandboxStatus.stage !== "ready") {
+    const step: StartStep =
+      sandboxStatus.stage === "starting" ? 1 : sandboxStatus.stage === "connecting" ? 2 : 0;
+    return { state: "starting", startStep: step };
+  }
+  switch (liveness.kind) {
+    case "online":
+      return { state: agentWorking ? "running" : "idle", startStep: 0 };
+    case "starting":
+      return { state: "starting", startStep: hostOnline === true ? 1 : 0 };
+    case "runner_asleep":
+      return { state: "agent_exited", startStep: 0 };
+    case "unknown":
+      // Not polled yet: go by the host's record rather than flash "Stopped".
+      return { state: hostOnline === false ? "stopped" : "idle", startStep: 0 };
