diff --git a/web/src/components/composer/EnvironmentMenu.stories.tsx b/web/src/components/composer/EnvironmentMenu.stories.tsx
new file mode 100644
index 0000000..f3c6f65
--- /dev/null
+++ b/web/src/components/composer/EnvironmentMenu.stories.tsx
@@ -0,0 +1,250 @@
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { ArrowUpIcon, FolderIcon, GitBranchIcon, PlusIcon } from "lucide-react";
+import type { ReactNode } from "react";
+
+import { Button } from "@/components/ui/button";
+import { StoryQueryRouter } from "@/storybook/StoryProviders";
+import { ChatComposer } from "./ChatComposer";
+import { ComposerWorkspaceBar } from "./ComposerControls";
+import type { SessionEnvironment } from "@/hooks/useSessionEnvironment";
+import { EnvironmentMenu, type EnvironmentView } from "./EnvironmentMenu";
+
+const TAILNET = "omnigent-d8ee7424.taild5bc1b.ts.net";
+const GIB = 1024 ** 3;
+const NOW = Date.now() / 1000;
+const MINUTE = 60;
+
+/** A Pod using 2 CPUs and 8 GB, on a VM disk with 59 of 193 GB used. */
+function status(overrides: Partial<SessionEnvironment> = {}): SessionEnvironment {
+  return {
+    pod_started_at: NOW - 63 * MINUTE,
+    shutdown_at: NOW + 5 * MINUTE,
+    idle_stop_window_s: 30 * MINUTE,
+    disk_used_bytes: 59 * GIB,
+    disk_total_bytes: 193 * GIB,
+    disk_available_fraction: (193 - 59) / 193,
+    cpu_cores: 2,
+    memory_bytes: 8 * GIB,
+    agent_active: true,
+    agent_idle_since: NOW,
+    ...overrides,
+  };
+}
+
+/** The agent idle for 12 minutes, exiting in 18; the Pod stops 30 minutes after. */
+const IDLE = status({
+  pod_started_at: NOW - (3 * 60 + 41) * MINUTE,
+  agent_active: false,
+  agent_idle_since: NOW - 12 * MINUTE,
+  agent_exits_at: NOW + 18 * MINUTE,
+});
+
+function disk(usedGb: number): Partial<SessionEnvironment> {
+  return {
+    disk_used_bytes: usedGb * GIB,
+    disk_available_fraction: (193 - usedGb) / 193,
+  };
+}
+
+const BASE: EnvironmentView = {
+  state: "running",
+  startStep: 0,
+  providerLabel: "Agent Sandbox",
+  tailscaleHost: TAILNET,
+  fallbackName: "omnigent-managed-d8ee7424",
+  agentLabel: "Claude Code",
+  error: null,
+  canControl: true,
+  canCancelStart: true,
+  canStart: true,
+  status: status(),
+};
+
+/** The open menu in a composer, as it sits in a session. */
+function Scene({ view, mobile = false }: { view: Partial<EnvironmentView>; mobile?: boolean }) {
+  const full = { ...BASE, ...view };
+  return (
+    <StoryQueryRouter>
+      <div
+        className={
+          mobile
+            ? "flex h-[720px] w-[390px] flex-col justify-end bg-background pb-3"
+            : "flex h-[600px] w-[720px] flex-col justify-end bg-background px-6 pb-6"
+        }
+      >
+        <Composer mobile={mobile} stopped={full.state === "stopped"}>
+          <EnvironmentMenu sessionId="conversation-environment-story" view={full} defaultOpen />
+        </Composer>
+      </div>
+    </StoryQueryRouter>
+  );
+}
+
+function Composer({
+  children,
+  mobile,
+  stopped,
+}: {
+  children: ReactNode;
+  mobile: boolean;
+  stopped: boolean;
+}) {
+  return (
+    <div className="w-full">
+      <ComposerWorkspaceBar>
+        <span className="inline-flex h-6 items-center gap-1 px-1 text-xs text-muted-foreground">
+          <FolderIcon className="size-3.5" />
+          omnigent
+        </span>
+        <span className="inline-flex h-6 items-center gap-1 px-1 text-xs text-muted-foreground">
+          <GitBranchIcon className="size-3.5" />
+          main
+        </span>
+        {!stopped && !mobile && (
+          <span className="inline-flex h-6 items-center px-1 font-mono text-xs text-muted-foreground">
+            omnigent-d8ee7424
+          </span>
+        )}
+      </ComposerWorkspaceBar>
+      <ChatComposer
+        keyboard={{ submitWithModEnter: false, preventsKeyboardSubmit: false }}
+        input={{ value: "", onChange: () => {}, placeholder: "Ask Claude anything…" }}
+        actions={{
+          leading: (
+            <>
+              <button
+                type="button"
+                className="flex size-7 items-center justify-center rounded-lg text-muted-foreground"
+              >
+                <PlusIcon className="size-4" />
+              </button>
+              {children}
+            </>
+          ),
+          trailing: (
+            <>
+              <span className="px-2 text-ui text-muted-foreground">Opus 5.5</span>
+              <Button size="icon" className="size-7 rounded-full" disabled>
+                <ArrowUpIcon className="size-4" />
+              </Button>
+            </>
+          ),
+        }}
+      />
+    </div>
+  );
+}
+
+const meta = {
+  title: "Components/Composer/EnvironmentMenu",
+  parameters: { layout: "fullscreen" },
+} satisfies Meta;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const Running: Story = { render: () => <Scene view={{ state: "running" }} /> };
+export const Idle: Story = { render: () => <Scene view={{ state: "idle", status: IDLE }} /> };
+/** The agent exited after its idle timeout; the Pod is still up. */
+export const AgentExited: Story = {
+  render: () => (
+    <Scene
+      view={{
+        state: "agent_exited",
+        status: status({ agent_active: false, shutdown_at: NOW + 18 * MINUTE }),
