+++ b/web/src/lib/agentProgress.test.ts
@@ -0,0 +1,186 @@
+import { afterEach, describe, expect, it } from "vitest";
+
+import { parseEvent } from "@/lib/sse";
+import { formatToolTitle } from "@/lib/toolTitle";
+import { handleSessionEvent, useChatStore } from "@/store/chatStore";
+import {
+  formatProgressDuration,
+  formatProgressPercent,
+  liveProgress,
+  parseAgentProgress,
+  parseAgentProgressList,
+  placeFinishedProgress,
+  splitProgressLabel,
+  type AgentProgress,
+  type ProgressRow,
+} from "./agentProgress";
+
+const WIRE = {
+  id: "bar_1",
+  label: "Running tests",
+  percent: 40,
+  started_at: 100,
+  updated_at: 130,
+  ended_at: null,
+  outcome: null,
+  log_files: ["/home/omnigent/logs/tests.log"],
+  has_log: true,
+};
+
+function bar(id: string, startedAt: number, extra: Partial<AgentProgress> = {}): AgentProgress {
+  return {
+    id,
+    label: id,
+    percent: null,
+    startedAt,
+    updatedAt: startedAt,
+    endedAt: null,
+    outcome: null,
+    logFiles: [],
+    hasLog: false,
+    ...extra,
+  };
+}
+
+describe("parseAgentProgress", () => {
+  it("reads a bar from the wire", () => {
+    expect(parseAgentProgress(WIRE)).toEqual({
+      id: "bar_1",
+      label: "Running tests",
+      percent: 40,
+      startedAt: 100,
+      updatedAt: 130,
+      endedAt: null,
+      outcome: null,
+      logFiles: ["/home/omnigent/logs/tests.log"],
+      hasLog: true,
+    });
+  });
+
+  it("keeps a percentage between 0 and 100, and a bar without one", () => {
+    expect(parseAgentProgress({ ...WIRE, percent: 140 })?.percent).toBe(100);
+    expect(parseAgentProgress({ ...WIRE, percent: null })?.percent).toBeNull();
+  });
+
+  it("drops anything without an id, a label or a start", () => {
+    expect(parseAgentProgress(null)).toBeNull();
+    expect(parseAgentProgress({ ...WIRE, id: "" })).toBeNull();
+    expect(parseAgentProgress({ ...WIRE, label: " " })).toBeNull();
+    expect(parseAgentProgress({ ...WIRE, started_at: "now" })).toBeNull();
+    expect(parseAgentProgressList([WIRE, { label: "x" }]).map((b) => b.id)).toEqual(["bar_1"]);
+    expect(parseAgentProgressList(null)).toEqual([]);
+  });
+});
+
+describe("formatting", () => {
+  it("rounds a percentage, but only says 100% when it's done", () => {
+    expect(formatProgressPercent(41.6)).toBe("42%");
+    expect(formatProgressPercent(99.6)).toBe("99%");
+    expect(formatProgressPercent(100)).toBe("100%");
+    expect(formatProgressPercent(null)).toBeNull();
+  });
+
+  it("keeps a trailing count apart, to keep it in view", () => {
+    expect(splitProgressLabel("Migrating settings pages (12/40)")).toEqual([
+      "Migrating settings pages",
+      "(12/40)",
+    ]);
+    expect(splitProgressLabel("Running the test suite")).toEqual(["Running the test suite", null]);
+  });
+
+  it("says how long a bar ran", () => {
+    expect(formatProgressDuration(bar("a", 100, { endedAt: 142 }))).toBe("42s");
+    expect(formatProgressDuration(bar("a", 100, { endedAt: 352 }))).toBe("4m 12s");
+    expect(formatProgressDuration(bar("a", 0, { updatedAt: 3900 }))).toBe("1h 05m");
+  });
+});
+
+// A transcript: a scheduled run's reply, then two messages from the user, each
+// with a reply; the second reply has a hidden system message before it.
+const ROWS: ProgressRow[] = [
+  { key: "assistant:r0", kind: "assistant" },
+  { key: "user:u1", kind: "turn", createdAtS: 200 },
+  { key: "assistant:r1", kind: "assistant" },
+  { key: "user:u2", kind: "turn", createdAtS: 300 },
+  { key: "user:system", kind: "other", createdAtS: 320 },
+  { key: "assistant:r2a", kind: "assistant" },
+  { key: "assistant:r2b", kind: "assistant" },
+];
+
+describe("placing bars", () => {
+  it("shows the newest bar live while the agent works on its turn", () => {
+    const bars = [bar("first", 210), bar("second", 305)];
+    expect(liveProgress(bars, ROWS, true)?.id).toBe("second");
+    expect(liveProgress(bars, ROWS, false)).toBeNull();
+    // A message from the user starts a turn without a bar.
+    expect(liveProgress([bar("first", 210)], ROWS, true)).toBeNull();
+    // A bar set in the same second as the message is the message's.
+    expect(liveProgress([bar("same", 300.4)], ROWS, true)?.id).toBe("same");
+  });
+
+  it("shows no bar live while a message from the user is on its way", () => {
+    // The last turn's bar finished; the UI shows Working… as soon as the user
+    // sends, before the server has taken the message.
+    const rows: ProgressRow[] = [...ROWS, { key: "user:tmp_1", kind: "pending", createdAtS: 400 }];
+    const bars = [bar("second", 305, { endedAt: 330, outcome: "done" })];
+    expect(liveProgress(bars, rows, true)).toBeNull();
+    // It stays at the end of its own turn meanwhile.
+    expect(
+      placeFinishedProgress(bars, rows, null)
+        .get("assistant:r2b")
+        ?.map((b) => b.id),
+    ).toEqual(["second"]);
+  });
+
+  it("puts each finished bar at the end of its turn", () => {
+    const bars = [bar("scheduled", 50), bar("first", 210), bar("again", 250), bar("second", 330)];
+    const placed = placeFinishedProgress(bars, ROWS, null);
+    expect([...placed.entries()].map(([key, list]) => [key, list.map((b) => b.id)])).toEqual([
+      ["assistant:r0", ["scheduled"]],
+      ["assistant:r1", ["first", "again"]],
+      ["assistant:r2b", ["second"]],
+    ]);
+  });
+
+  it("leaves the live bar out, and puts a bar of a last turn without a reply at the end", () => {
+    const rows: ProgressRow[] = [...ROWS, { key: "user:u3", kind: "turn", createdAtS: 400 }];
+    const bars = [bar("first", 210), bar("third", 405)];
+    expect(placeFinishedProgress(bars, rows, bars[1]!).get("end")).toBeUndefined();
+    expect(
+      placeFinishedProgress(bars, rows, null)
+        .get("end")
+        ?.map((b) => b.id),
+    ).toEqual(["third"]);
+  });
+});
+
+describe("session.progress events", () => {
+  afterEach(() => useChatStore.setState({ conversationId: null, agentProgress: [] }));
+
+  it("replace the open session's bars", () => {
+    useChatStore.setState({ conversationId: "conv_1", agentProgress: [] });
+    const event = parseEvent("session.progress", { conversation_id: "conv_1", progress: [WIRE] });
+    expect(event?.type).toBe("session_progress");
+    handleSessionEvent(event!, "conv_1");
+    expect(useChatStore.getState().agentProgress.map((b) => b.label)).toEqual(["Running tests"]);
+  });
+
+  it("without a session are dropped", () => {
+    expect(parseEvent("session.progress", { progress: [] })).toBeNull();
+  });
+});
+
+describe("the tool call's title", () => {
+  it("reads as the bar's label, whichever name the agent calls it by", () => {
+    for (const name of ["sys_session_progress", "mcp__omnigent__sys_session_progress"]) {
+      expect(formatToolTitle(name, { label: "Running the test suite", log_file: "/x" })).toEqual({
+        verb: "Progress:",
+        body: "Running the test suite",
+      });
+      expect(formatToolTitle(name, { clear: true })).toEqual({
+        verb: "End progress bar",
+        body: "",
+      });
+    }
+  });
+});
diff --git a/web/src/lib/agentProgress.ts b/web/src/lib/agentProgress.ts
new file mode 100644
index 0000000..5805e67
--- /dev/null
+++ b/web/src/lib/agentProgress.ts
@@ -0,0 +1,199 @@
+/**
+ * The progress bars an agent shows in the chat, and the logs under them.
+ *
+ * The agent sets a bar with its `sys_session_progress` tool, optionally naming
+ * a log file the runner follows. This deployment's server (`omnigent_progress`
+ * in the server image) keeps a short history of the session's bars, sends it as
+ * the session snapshot's `progress` field and as `session.progress` events, and
+ * serves each bar's log from `GET /v1/sessions/{id}/progress/{bar}/log`.
+ *
+ * The newest bar shows above Working… while the agent works on the turn that
+ * set it. Every other bar is finished, and shows as a line at the end of its
+ * turn, where its log can still be opened.
+ */
+
+import { authenticatedFetch } from "@/lib/identity";
+
+export interface AgentProgress {
+  id: string;
+  /** What's in progress, e.g. `"Migrating components (12/40)"`. */
+  label: string;
+  /** How far along, 0–100, or `null` when the agent can't tell. */
+  percent: number | null;
+  /** When the agent set it first and last, in Unix seconds. */
+  startedAt: number;
+  updatedAt: number;
+  /** When its turn ended, or `null` while the agent works. */
+  endedAt: number | null;
+  outcome: "done" | "failed" | null;
+  /** The files the runner follows for it. */
+  logFiles: string[];
+  hasLog: boolean;
+}
+
+export interface ProgressLogLine {
+  seq: number;
+  t: number;
+  text: string;
+}
+
+export interface ProgressLogPage {
+  lines: ProgressLogLine[];
+  /** The last line's number, to ask for the lines after it. */
+  next: number;
+  /** Whether older lines were dropped. */
+  dropped: boolean;
+}
+
+const num = (value: unknown): number | null =>
+  typeof value === "number" && Number.isFinite(value) ? value : null;
+
+/** Read one bar from the wire; `null` for anything malformed. */
+export function parseAgentProgress(raw: unknown): AgentProgress | null {
+  if (raw === null || typeof raw !== "object") return null;
+  const get = (key: string): unknown => Reflect.get(raw, key);
+  const id = get("id");
+  const label = get("label");
+  const startedAt = num(get("started_at"));
+  if (typeof id !== "string" || !id || typeof label !== "string" || !label.trim()) return null;
+  if (startedAt === null) return null;
+  const percent = num(get("percent"));
+  const outcome = get("outcome");
+  const logFiles = get("log_files");
+  return {
+    id,
+    label,
+    percent: percent === null ? null : Math.min(100, Math.max(0, percent)),
+    startedAt,
+    updatedAt: num(get("updated_at")) ?? startedAt,
+    endedAt: num(get("ended_at")),
+    outcome: outcome === "done" || outcome === "failed" ? outcome : null,
+    logFiles: Array.isArray(logFiles)
+      ? logFiles.filter((f): f is string => typeof f === "string")
+      : [],
+    hasLog: get("has_log") === true,
+  };
+}
+
+/** Read a session's bars from the wire, oldest first; `[]` for none. */
+export function parseAgentProgressList(raw: unknown): AgentProgress[] {
+  if (!Array.isArray(raw)) return [];
+  return raw.map(parseAgentProgress).filter((bar): bar is AgentProgress => bar !== null);
+}
+
+/** The percentage as the bar shows it, e.g. `"42%"`; `null` without one. */
+export function formatProgressPercent(percent: number | null): string | null {
+  if (percent === null) return null;
+  // 99.6 isn't done yet, so it doesn't round up to 100%.
+  const shown = percent < 100 ? Math.min(99, Math.round(percent)) : 100;
+  return `${shown}%`;
+}
+
+/** A label's trailing count, kept in view when the rest is cut: `["Migrating", "(12/40)"]`. */
+export function splitProgressLabel(label: string): [string, string | null] {
+  const match = /^(.*?)\s*(\(\s*\d+\s*\/\s*\d+\s*\))\s*$/.exec(label);
+  return match && match[1] ? [match[1], match[2]!] : [label, null];
+}
+
+/** How long a bar ran, e.g. `"4m 12s"`. */
+export function formatProgressDuration(bar: AgentProgress): string {
+  const seconds = Math.max(0, Math.round((bar.endedAt ?? bar.updatedAt) - bar.startedAt));
+  if (seconds < 60) return `${seconds}s`;
+  if (seconds < 3600)
+    return `${Math.floor(seconds / 60)}m ${String(seconds % 60).padStart(2, "0")}s`;
+  return `${Math.floor(seconds / 3600)}h ${String(Math.floor((seconds % 3600) / 60)).padStart(2, "0")}m`;
+}
+
+/**
+ * A row of the transcript, as placing bars needs it: where a turn starts (a
+ * message from the user), and where an assistant reply can carry a bar. A
+ * message the server hasn't taken yet is `"pending"`: it starts a turn too.
+ */
+export interface ProgressRow {
+  key: string;
+  kind: "turn" | "pending" | "assistant" | "other";
+  /** When it was sent, in Unix seconds; turns without one are skipped. */
+  createdAtS?: number;
+}
+
+/**
+ * The bar above Working…: the newest bar, while the agent works on the turn
+ * that set it. A message from the user starts a turn without one, also while
+ * it's still on its way: the UI shows Working… as soon as it's sent, and the
+ * last turn's finished bar mustn't show as live meanwhile.
+ */
+export function liveProgress(
+  bars: readonly AgentProgress[],
+  rows: readonly ProgressRow[],
+  working: boolean,
+): AgentProgress | null {
+  const newest = bars.at(-1);
+  if (!working || !newest) return null;
+  if (rows.some((row) => row.kind === "pending")) return null;
+  const turnStart = rows.findLast((row) => row.kind === "turn" && row.createdAtS !== undefined);
+  // Message times are whole seconds, rounded down, so they're never late.
+  if (turnStart && newest.startedAt < turnStart.createdAtS!) return null;
+  return newest;
+}
+
+/**
+ * Where each finished bar shows: the last assistant reply of the turn it was
+ * set in, keyed by that reply's row. A bar of a turn without a reply shows at
+ * the end, under the `"end"` key, if its turn is the last one; bars of turns
+ * that aren't loaded don't show.
+ */
+export function placeFinishedProgress(
+  bars: readonly AgentProgress[],
+  rows: readonly ProgressRow[],
+  live: AgentProgress | null,
+): Map<string, AgentProgress[]> {
+  // Each turn: when it started, and its last reply. The first turn may have no
+  // message, e.g. a scheduled run.
+  const turns: { start: number; reply: string | null }[] = [{ start: -Infinity, reply: null }];
+  for (const row of rows) {
+    if (row.kind === "turn" && row.createdAtS !== undefined) {
+      turns.push({ start: row.createdAtS, reply: null });
+    } else if (row.kind === "assistant") {
+      turns.at(-1)!.reply = row.key;
+    }
+  }
+  const placed = new Map<string, AgentProgress[]>();
+  for (const bar of bars) {
+    if (bar.id === live?.id) continue;
+    const index = turns.findLastIndex((turn) => turn.start <= bar.startedAt);
+    const turn = turns[index]!;
+    const key = turn.reply ?? (index === turns.length - 1 ? "end" : null);
+    if (key === null) continue;
+    placed.set(key, [...(placed.get(key) ?? []), bar]);
+  }
+  return placed;
+}
+
+/** A bar's log after line `after`; `null` once the server no longer has the bar. */
+export async function fetchProgressLog(
+  sessionId: string,
+  barId: string,
+  after: number,
+): Promise<ProgressLogPage | null> {
+  const res = await authenticatedFetch(
+    `/v1/sessions/${encodeURIComponent(sessionId)}/progress/${encodeURIComponent(barId)}/log?after=${after}`,
+  );
+  if (res.status === 404) return null;
+  if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
+  const data: unknown = await res.json();
+  const raw = data !== null && typeof data === "object" ? data : {};
+  const lines = Reflect.get(raw, "lines");
+  return {
+    lines: Array.isArray(lines)
+      ? lines.flatMap((line: unknown) => {
+          if (line === null || typeof line !== "object") return [];
+          const seq = num(Reflect.get(line, "seq"));
+          const text = Reflect.get(line, "text");
+          if (seq === null || typeof text !== "string") return [];
+          return [{ seq, t: num(Reflect.get(line, "t")) ?? 0, text }];
+        })
+      : [],
+    next: num(Reflect.get(raw, "next")) ?? after,
+    dropped: Reflect.get(raw, "dropped") === true,
+  };
+}
