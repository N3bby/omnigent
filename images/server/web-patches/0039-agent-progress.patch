+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import type { AgentProgress } from "@/lib/agentProgress";
+import { useChatStore } from "@/store/chatStore";
+
+const mocks = vi.hoisted(() => ({ fetch: vi.fn() }));
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: (url: string) => mocks.fetch(url) }));
+
+import { AgentProgressCard, FinishedProgress, SessionAgentProgress } from "./AgentProgressCard";
+
+function bar(extra: Partial<AgentProgress> = {}): AgentProgress {
+  return {
+    id: "bar_1",
+    label: "Migrating settings pages (12/40)",
+    percent: 30,
+    startedAt: 100,
+    updatedAt: 160,
+    endedAt: null,
+    outcome: null,
+    logFiles: [],
+    hasLog: false,
+    ...extra,
+  };
+}
+
+function logPage(lines: string[], from = 1) {
+  return {
+    ok: true,
+    status: 200,
+    json: () =>
+      Promise.resolve({
+        lines: lines.map((text, i) => ({ seq: from + i, t: 0, text })),
+        next: from + lines.length - 1,
+        dropped: false,
+      }),
+  };
+}
+
+beforeEach(() => {
+  useChatStore.setState({ conversationId: "conv_1" });
+  mocks.fetch.mockReset();
+});
+
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  useChatStore.setState({ conversationId: null, agentProgress: [] });
+});
+
+describe("AgentProgressCard", () => {
+  it("shows what's in progress, its count, how far along, and a bar", () => {
+    render(<AgentProgressCard progress={bar()} sessionId="conv_1" />);
+
+    expect(screen.getByText("Migrating settings pages")).toBeTruthy();
+    expect(screen.getByText("(12/40)")).toBeTruthy();
+    expect(screen.getByText("30%")).toBeTruthy();
+    const progressbar = screen.getByRole("progressbar", {
+      name: "Migrating settings pages (12/40)",
+    });
+    expect(progressbar.getAttribute("aria-valuenow")).toBe("30");
+    expect(screen.queryByRole("button", { name: /log/i })).toBeNull();
+  });
+
+  it("without a percentage only shows the agent is busy", () => {
+    render(<AgentProgressCard progress={bar({ percent: null })} sessionId="conv_1" />);
+
+    expect(screen.queryByText(/%$/)).toBeNull();
+    expect(screen.getByRole("progressbar").hasAttribute("aria-valuenow")).toBe(false);
+  });
+
+  it("opens the log, which follows new lines", async () => {
+    vi.useFakeTimers();
+    mocks.fetch
+      .mockResolvedValueOnce(logPage(["VITE v6 ready in 312 ms"]))
+      .mockResolvedValueOnce(logPage(["GET / 200"], 2))
+      .mockResolvedValue(logPage([], 3));
+    render(
+      <AgentProgressCard
+        progress={bar({ id: "bar_dev", label: "Dev server on :5173", percent: null, hasLog: true })}
+        sessionId="conv_1"
+      />,
+    );
+
+    fireEvent.click(screen.getByRole("button", { name: /log/i }));
+    await act(() => vi.advanceTimersByTimeAsync(0));
+    expect(screen.getByTestId("agent-progress-log").textContent).toContain("VITE v6 ready");
+    await act(() => vi.advanceTimersByTimeAsync(1600));
+    expect(screen.getByTestId("agent-progress-log").textContent).toBe(
+      "VITE v6 ready in 312 ms\nGET / 200",
+    );
+    expect(mocks.fetch.mock.calls.map(([url]) => url)).toEqual([
+      "/v1/sessions/conv_1/progress/bar_dev/log?after=0",
+      "/v1/sessions/conv_1/progress/bar_dev/log?after=1",
+    ]);
+  });
+
+  it("says when the server no longer keeps the log", async () => {
+    mocks.fetch.mockResolvedValue({ ok: false, status: 404, statusText: "Not Found" });
+    render(
+      <AgentProgressCard progress={bar({ id: "bar_gone", hasLog: true })} sessionId="conv_1" />,
+    );
+
+    fireEvent.click(screen.getByRole("button", { name: /log/i }));
+    expect(await screen.findByText("This log is no longer kept.")).toBeTruthy();
+  });
+});
+
+describe("SessionAgentProgress", () => {
+  it("shows the live bar, and nothing without one", () => {
+    const { rerender } = render(<SessionAgentProgress bar={null} />);
+    expect(screen.queryByTestId("agent-progress")).toBeNull();
+
+    rerender(<SessionAgentProgress bar={bar({ percent: 75 })} />);
+    expect(screen.getByTestId("agent-progress").textContent).toContain("75%");
+  });
+});
+
+describe("FinishedProgress", () => {
+  it("shows each finished bar as one line with how long it ran", () => {
+    render(
+      <FinishedProgress
+        bars={[
+          bar({ id: "a", label: "Migrated all 40 pages", endedAt: 352 }),
+          bar({ id: "b", label: "Running the suite", endedAt: 130, outcome: "failed" }),
+        ]}
+      />,
+    );
+
+    const lines = screen.getAllByTestId("agent-progress-finished");
+    expect(lines.map((line) => line.textContent)).toEqual([
+      "Migrated all 40 pages· 4m 12s",
+      "Running the suite· 30s",
+    ]);
+    expect(screen.getByLabelText("Stopped")).toBeTruthy();
+    // Without a log there's nothing to open.
+    expect(screen.queryByRole("button")).toBeNull();
+  });
+
+  it("opens a finished bar's log", async () => {
+    mocks.fetch.mockResolvedValue(logPage(["12 passed"]));
+    render(<FinishedProgress bars={[bar({ id: "bar_done", hasLog: true, endedAt: 200 })]} />);
+
+    fireEvent.click(screen.getByRole("button"));
+    expect((await screen.findByTestId("agent-progress-log")).textContent).toContain("12 passed");
+  });
+});
