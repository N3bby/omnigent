@@ -0,0 +1,284 @@
+import { CheckIcon, ChevronRightIcon, CircleXIcon, Loader2Icon } from "lucide-react";
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+
+import {
+  fetchProgressLog,
+  formatProgressDuration,
+  formatProgressPercent,
+  splitProgressLabel,
+  type AgentProgress,
+  type ProgressLogLine,
+} from "@/lib/agentProgress";
+import { cn } from "@/lib/utils";
+import { useChatStore } from "@/store/chatStore";
+
+const POLL_MS = 1500;
+const MAX_SHOWN_LINES = 2000;
+
+/** Bars whose log is open, so it stays open when the bar finishes and moves. */
+const openLogs = new Set<string>();
+
+function useLogOpen(barId: string): [boolean, () => void] {
+  const [open, setOpen] = useState(() => openLogs.has(barId));
+  const toggle = () => {
+    setOpen((value) => {
+      if (value) openLogs.delete(barId);
+      else openLogs.add(barId);
+      return !value;
+    });
+  };
+  return [open, toggle];
+}
+
+const hasLogOf = (bar: AgentProgress): boolean => bar.hasLog || bar.logFiles.length > 0;
+
+/**
+ * A bar's log, polled while it's open. It keeps coming after the agent's turn
+ * while the file grows, e.g. from a dev server.
+ */
+export function ProgressLog({
+  sessionId,
+  barId,
+  className,
+}: {
+  sessionId: string;
+  barId: string;
+  className?: string;
+}) {
+  const [lines, setLines] = useState<ProgressLogLine[]>([]);
+  const [state, setState] = useState<"loading" | "ready" | "gone">("loading");
+  const [dropped, setDropped] = useState(false);
+  const scrollRef = useRef<HTMLPreElement>(null);
+  const atBottom = useRef(true);
+
+  useEffect(() => {
+    let cancelled = false;
+    let next = 0;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const tick = async () => {
+      try {
+        const page = await fetchProgressLog(sessionId, barId, next);
+        if (cancelled) return;
+        if (page === null) {
+          setState("gone");
+          return;
+        }
+        if (page.lines.length > 0) {
+          setLines((prev) => [...prev, ...page.lines].slice(-MAX_SHOWN_LINES));
+        }
+        next = page.next;
+        setDropped(page.dropped);
+        setState("ready");
+      } catch {
+        // The next poll tries again.
+      }
+      if (!cancelled) timer = setTimeout(() => void tick(), POLL_MS);
+    };
+    void tick();
+    return () => {
+      cancelled = true;
+      clearTimeout(timer);
+    };
+  }, [sessionId, barId]);
+
+  // Follow new lines, unless the reader scrolled up.
+  useLayoutEffect(() => {
+    const el = scrollRef.current;
+    if (el && atBottom.current) el.scrollTop = el.scrollHeight;
+  }, [lines]);
+
+  const note =
+    state === "loading"
+      ? "Loading…"
+      : state === "gone"
+        ? "This log is no longer kept."
+        : lines.length === 0
+          ? "No output yet."
+          : null;
+  return (
+    <div data-testid="agent-progress-log" className={cn("bg-muted/40", className)}>
+      <pre
+        ref={scrollRef}
+        onScroll={(event) => {
+          const el = event.currentTarget;
+          atBottom.current = el.scrollHeight - el.scrollTop - el.clientHeight < 8;
+        }}
+        className="max-h-56 overflow-auto px-2.5 py-2 font-mono text-[11px] leading-[1.5] break-all whitespace-pre-wrap text-foreground"
+      >
+        {dropped && lines.length > 0 && (
+          <span className="text-muted-foreground">{"Earlier lines aren't kept.\n"}</span>
+        )}
+        {lines.map((line) => line.text).join("\n")}
+        {note && <span className="text-muted-foreground">{note}</span>}
+      </pre>
+    </div>
+  );
+}
+
+function Label({ label, className }: { label: string; className?: string }) {
+  const [text, count] = splitProgressLabel(label);
+  return (
+    <span className={cn("flex min-w-0 items-baseline gap-1", className)} title={label}>
+      <span className="truncate">{text}</span>
+      {count && <span className="shrink-0 tabular-nums">{count}</span>}
+    </span>
+  );
+}
+
+/**
+ * The bar the agent shows while it works: what's in progress, how far along,
+ * and a thin bar along the bottom, which sweeps without a percentage. "Log"
+ * opens the lines of the file the agent named.
+ */
+export function AgentProgressCard({
+  progress,
+  sessionId,
+  className,
+}: {
+  progress: AgentProgress;
+  sessionId: string | null;
+  className?: string;
+}) {
+  const [open, toggle] = useLogOpen(progress.id);
+  const percent = formatProgressPercent(progress.percent);
+  const hasLog = hasLogOf(progress) && sessionId !== null;
+  return (
+    <div
+      data-testid="agent-progress"
+      className={cn(
+        "w-full overflow-hidden rounded-lg border border-border bg-card text-card-foreground",
+        className,
+      )}
+    >
+      <div className="relative flex items-center gap-2 px-2.5 py-1.5">
+        <Loader2Icon aria-hidden className="size-3.5 shrink-0 animate-spin text-muted-foreground" />
+        <Label label={progress.label} className="flex-1 text-xs font-medium" />
+        {percent !== null && (
+          <span className="shrink-0 font-mono text-[11px] text-muted-foreground tabular-nums">
+            {percent}
+          </span>
+        )}
+        {hasLog && (
+          <button
+            type="button"
+            aria-expanded={open}
+            onClick={toggle}
+            className="-my-1 flex shrink-0 items-center gap-0.5 rounded-md px-1.5 py-1 text-[11px] text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
+          >
+            Log
+            <ChevronRightIcon
+              aria-hidden
+              className={cn("size-3 transition-transform", open && "rotate-90")}
+            />
+          </button>
+        )}
+        <div
+          role="progressbar"
+          aria-label={progress.label}
+          aria-valuemin={0}
+          aria-valuemax={100}
+          aria-valuenow={progress.percent === null ? undefined : Math.round(progress.percent)}
+          className="absolute inset-x-0 bottom-0 h-0.5 overflow-hidden bg-muted"
+        >
+          {progress.percent === null ? (
+            <div
+              className="absolute inset-y-0 w-1/3 bg-primary"
+              style={{ animation: "compaction-slide 1.5s ease-in-out infinite alternate" }}
+            />
+          ) : (
+            <div
+              className="h-full bg-primary transition-[width] duration-500 ease-out"
+              style={{ width: `${progress.percent}%` }}
+            />
+          )}
+        </div>
+      </div>
+      {open && hasLog && sessionId !== null && (
+        <ProgressLog sessionId={sessionId} barId={progress.id} className="border-t border-border" />
+      )}
+    </div>
+  );
+}
+
+/** The current session's live bar, or nothing. */
+export function SessionAgentProgress({
+  bar,
+  className,
+}: {
+  bar: AgentProgress | null;
+  className?: string;
+}) {
+  const sessionId = useChatStore((s) => s.conversationId);
+  if (bar === null) return null;
+  return <AgentProgressCard progress={bar} sessionId={sessionId} className={className} />;
+}
+
+function FinishedProgressLine({
+  bar,
+  sessionId,
+}: {
+  bar: AgentProgress;
+  sessionId: string | null;
+}) {
+  const [open, toggle] = useLogOpen(bar.id);
+  const hasLog = hasLogOf(bar) && sessionId !== null;
+  const content = (
+    <>
+      {bar.outcome === "failed" ? (
+        <CircleXIcon aria-label="Stopped" className="size-3.5 shrink-0 text-destructive" />
+      ) : (
+        <CheckIcon aria-hidden className="size-3.5 shrink-0 text-success" />
+      )}
+      <Label label={bar.label} />
+      <span className="shrink-0">· {formatProgressDuration(bar)}</span>
+      {hasLog && (
+        <ChevronRightIcon
+          aria-hidden
+          className={cn("size-3.5 shrink-0 transition-transform", open && "rotate-90")}
+        />
+      )}
+    </>
+  );
+  return (
+    <div data-testid="agent-progress-finished" className="text-chat text-muted-foreground">
+      {hasLog ? (
+        <button
+          type="button"
+          aria-expanded={open}
+          onClick={toggle}
+          className="flex max-w-full cursor-pointer items-center gap-1.5 py-0.5 text-left transition-colors hover:text-foreground"
+        >
+          {content}
+        </button>
+      ) : (
+        <div className="flex max-w-full items-center gap-1.5 py-0.5">{content}</div>
+      )}
+      {open && hasLog && sessionId !== null && (
+        <ProgressLog
+          sessionId={sessionId}
+          barId={bar.id}
+          className="mt-1 overflow-hidden rounded-lg border border-border"
+        />
+      )}
+    </div>
+  );
+}
+
+/** Finished bars at the end of their turn, one line each, their log a click away. */
+export function FinishedProgress({
+  bars,
+  className,
+}: {
+  bars: readonly AgentProgress[];
+  className?: string;
+}) {
+  const sessionId = useChatStore((s) => s.conversationId);
+  if (bars.length === 0) return null;
+  return (
+    <div className={cn("flex flex-col", className)}>
+      {bars.map((bar) => (
+        <FinishedProgressLine key={bar.id} bar={bar} sessionId={sessionId} />
+      ))}
+    </div>
+  );
+}
