+import { renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  SWIPE_ACTION_WIDTH,
+  TOUCH_PRIMARY_QUERY,
+  classifySwipe,
+  closeSwipeRow,
+  getOpenSwipeRow,
+  resetTouchPrimaryQueryForTests,
+  setOpenSwipeRow,
+  settleSwipe,
+  swipeOffset,
+  useIsSwipeRowOpen,
+  useIsTouchPrimary,
+} from "./sidebarSwipe";
+
+describe("classifySwipe", () => {
+  it("stays pending inside the slop, so taps and long presses never lock", () => {
+    expect(classifySwipe(0, 0)).toBe("pending");
+    expect(classifySwipe(-9, 3)).toBe("pending");
+    expect(classifySwipe(6, -9)).toBe("pending");
+  });
+
+  it("locks to the dominant axis once past the slop", () => {
+    expect(classifySwipe(-12, 4)).toBe("horizontal");
+    expect(classifySwipe(15, -10)).toBe("horizontal");
+    expect(classifySwipe(-6, 14)).toBe("vertical");
+    expect(classifySwipe(-11, -12)).toBe("vertical");
+  });
+
+  it("treats a diagonal as a scroll", () => {
+    expect(classifySwipe(-20, 20)).toBe("vertical");
+  });
+});
+
+describe("swipeOffset", () => {
+  it("follows the finger to the left from closed", () => {
+    expect(swipeOffset(0, -20)).toBe(20);
+    expect(swipeOffset(0, -SWIPE_ACTION_WIDTH)).toBe(SWIPE_ACTION_WIDTH);
+  });
+
+  it("never slides right of closed", () => {
+    expect(swipeOffset(0, 30)).toBe(0);
+    expect(swipeOffset(SWIPE_ACTION_WIDTH, SWIPE_ACTION_WIDTH + 40)).toBe(0);
+  });
+
+  it("closes from open as the finger moves right", () => {
+    expect(swipeOffset(SWIPE_ACTION_WIDTH, 20)).toBe(SWIPE_ACTION_WIDTH - 20);
+  });
+
+  it("resists an over-pull past fully open", () => {
+    const pulled = swipeOffset(0, -(SWIPE_ACTION_WIDTH + 40));
+    expect(pulled).toBeGreaterThan(SWIPE_ACTION_WIDTH);
+    expect(pulled).toBeLessThan(SWIPE_ACTION_WIDTH + 40);
+  });
+});
+
+describe("settleSwipe", () => {
+  it("opens past halfway and closes short of it", () => {
+    expect(settleSwipe(SWIPE_ACTION_WIDTH / 2 + 1, 0)).toBe(true);
+    expect(settleSwipe(SWIPE_ACTION_WIDTH / 2 - 1, 0)).toBe(false);
+  });
+
+  it("lets a flick decide by its direction", () => {
+    expect(settleSwipe(5, -0.5)).toBe(true);
+    expect(settleSwipe(SWIPE_ACTION_WIDTH, 0.5)).toBe(false);
+  });
+
+  it("ignores slow drift", () => {
+    expect(settleSwipe(5, -0.1)).toBe(false);
+    expect(settleSwipe(SWIPE_ACTION_WIDTH, 0.1)).toBe(true);
+  });
+});
+
+describe("open row store", () => {
+  afterEach(() => setOpenSwipeRow(null));
+
+  it("keeps at most one row open", () => {
+    const a = renderHook(() => useIsSwipeRowOpen("a"));
+    const b = renderHook(() => useIsSwipeRowOpen("b"));
+    setOpenSwipeRow("a");
+    a.rerender();
+    expect(a.result.current).toBe(true);
+    expect(b.result.current).toBe(false);
+    setOpenSwipeRow("b");
+    a.rerender();
+    b.rerender();
+    expect(a.result.current).toBe(false);
+    expect(b.result.current).toBe(true);
+  });
+
+  it("only closes the row that asks", () => {
+    setOpenSwipeRow("a");
+    closeSwipeRow("b");
+    expect(getOpenSwipeRow()).toBe("a");
+    closeSwipeRow("a");
+    expect(getOpenSwipeRow()).toBeNull();
+  });
+});
+
+describe("useIsTouchPrimary", () => {
+  const original = window.matchMedia;
+  afterEach(() => {
+    window.matchMedia = original;
+    resetTouchPrimaryQueryForTests();
+  });
+
+  function mockMatchMedia(touch: boolean) {
+    window.matchMedia = vi.fn((query: string) => ({
+      matches: query === TOUCH_PRIMARY_QUERY && touch,
+      media: query,
+      onchange: null,
+      addListener: () => {},
+      removeListener: () => {},
+      addEventListener: () => {},
+      removeEventListener: () => {},
+      dispatchEvent: () => false,
+    })) as unknown as typeof window.matchMedia;
+    resetTouchPrimaryQueryForTests();
+  }
+
+  it("is true without hover and with a coarse pointer", () => {
+    mockMatchMedia(true);
+    expect(renderHook(() => useIsTouchPrimary()).result.current).toBe(true);
+    expect(window.matchMedia).toHaveBeenCalledWith("(hover: none) and (pointer: coarse)");
+  });
+
+  it("is false on mouse and trackpad devices, whatever their width", () => {
+    mockMatchMedia(false);
+    expect(renderHook(() => useIsTouchPrimary()).result.current).toBe(false);
+  });
+});
