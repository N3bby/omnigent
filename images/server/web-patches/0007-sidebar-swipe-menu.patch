+import {
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+  type HTMLAttributes,
+  type ReactNode,
+  type RefObject,
+} from "react";
+import { MoreHorizontalIcon } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuTrigger,
+} from "@/components/ui/dropdown-menu";
+import {
+  SWIPE_ACTION_WIDTH,
+  classifySwipe,
+  closeSwipeRow,
+  getOpenSwipeRow,
+  settleSwipe,
+  setOpenSwipeRow,
+  swipeOffset,
+  useIsSwipeRowOpen,
+} from "./sidebarSwipe";
+
+const SETTLE_MS = 180;
+// A finger that rests this long before lifting ends without a flick.
+const FLICK_MAX_AGE_MS = 100;
+// The click a browser may still send after a swipe or a drag lifts.
+const SWIPE_CLICK_GUARD_MS = 400;
+const ACTION_SELECTOR = "[data-swipe-action]";
+const ROW_ID_ATTRIBUTE = "data-sidebar-session-id";
+const ROW_SELECTOR = `[${ROW_ID_ATTRIBUTE}]`;
+
+// While a row is slid, every child of the row except the action moves left by
+// `--swipe-x`. `transform` (not `translate`, which the row's centred badges
+// use) so the two don't fight. Only while `data-swiped` is set, so a row at
+// rest has no transform and no extra stacking contexts.
+const ROW_CLASS =
+  "overflow-hidden rounded-[var(--radius-otto-button)] touch-pan-y select-none [-webkit-touch-callout:none] [&[data-swiped]>:not([data-swipe-action])]:[transform:translate3d(var(--swipe-x),0,0)]";
+
+interface Gesture {
+  pointerId: number;
+  x: number;
+  y: number;
+  start: number;
+  axis: "pending" | "horizontal";
+  offset: number;
+  lastX: number;
+  lastT: number;
+  velocity: number;
+}
+
+export interface SessionRowSwipe {
+  enabled: boolean;
+  menuOpen: boolean;
+  setMenuOpen: (open: boolean) => void;
+  /** Spread onto the row's `<li>`. Empty when the gesture is off. */
+  rowProps: HTMLAttributes<HTMLLIElement>;
+  /** Added to the row's `<li>` classes. Empty when the gesture is off. */
+  rowClassName: string | undefined;
+}
+
+/**
+ * Swipe a sidebar session row from right to left, on touch-primary devices,
+ * to reveal a button for the row's menu ({@link SessionRowSwipeAction}).
+ * With `enabled` off (mouse and trackpad devices, selection mode) the row
+ * gets nothing from this hook.
+ *
+ * Only horizontal-dominant swipes count; a vertical move is left to the list's
+ * scrolling, and a long press to the drag. One row is open at a time, and it
+ * closes on a tap on the row or anywhere else, on scroll, when its menu
+ * closes, and when a drag starts.
+ */
+export function useSessionRowSwipe({
+  id,
+  enabled,
+  dragging,
+  rowRef,
+}: {
+  id: string;
+  enabled: boolean;
+  /** A drag (long press) is in progress: close, and ignore touches. */
+  dragging: boolean;
+  rowRef: RefObject<HTMLLIElement | null>;
+}): SessionRowSwipe {
+  const isOpen = useIsSwipeRowOpen(id) && enabled;
+  const [menuOpen, setMenuOpen] = useState(false);
+  const gesture = useRef<Gesture | null>(null);
+  const suppressClickUntil = useRef(0);
+  const shown = useRef(0);
+  const frame = useRef(0);
+
+  // The slide is drawn outside React (CSS variables on the row), so following
+  // the finger never re-renders the row.
+  const draw = useCallback(
+    (offset: number) => {
+      shown.current = offset;
+      const row = rowRef.current;
+      if (!row) return;
+      if (offset > 0) {
+        row.setAttribute("data-swiped", "");
+        row.style.setProperty("--swipe-x", `${-offset}px`);
+        row.style.setProperty("--swipe-progress", String(Math.min(1, offset / SWIPE_ACTION_WIDTH)));
+      } else {
+        row.removeAttribute("data-swiped");
+        row.style.removeProperty("--swipe-x");
+        row.style.removeProperty("--swipe-progress");
+      }
+    },
+    [rowRef],
+  );
+  const animateTo = useCallback(
+    (target: number) => {
+      cancelAnimationFrame(frame.current);
+      const from = shown.current;
+      if (from === target) return;
+      const begin = performance.now();
+      const step = (now: number) => {
+        const t = Math.min(1, Math.max(0, now - begin) / SETTLE_MS);
+        const eased = 1 - (1 - t) ** 3;
+        draw(from + (target - from) * eased);
+        if (t < 1) frame.current = requestAnimationFrame(step);
+      };
+      frame.current = requestAnimationFrame(step);
+    },
+    [draw],
+  );
+  useEffect(() => () => cancelAnimationFrame(frame.current), []);
+
+  useLayoutEffect(() => {
+    if (gesture.current?.axis === "horizontal") return;
+    animateTo(isOpen ? SWIPE_ACTION_WIDTH : 0);
+  }, [isOpen, animateTo]);
+
+  // A long press picked the row up: the drag owns the touch now.
+  useEffect(() => {
+    if (!dragging) return undefined;
+    gesture.current = null;
+    closeSwipeRow(id);
+    animateTo(0);
+    // Lifting the finger without moving still clicks the row's link. dnd-kit
+    // stops that click's propagation at the document, before React sees it,
+    // but not its default action, so the browser would load the session as a
+    // new page. Cancel it from the window, which comes first.
+    const swallowClick = (event: MouseEvent) => {
+      const row = event.target instanceof Element ? event.target.closest(ROW_SELECTOR) : null;
+      if (row?.getAttribute(ROW_ID_ATTRIBUTE) === id) event.preventDefault();
+    };
+    window.addEventListener("click", swallowClick, true);
+    return () => {
+      setTimeout(
+        () => window.removeEventListener("click", swallowClick, true),
+        SWIPE_CLICK_GUARD_MS,
+      );
+    };
+  }, [dragging, id, animateTo]);
+
+  // Closing the menu (an item picked, a tap outside, Escape) closes the row.
+  const menuWasOpen = useRef(false);
+  useEffect(() => {
+    if (menuWasOpen.current && !menuOpen) closeSwipeRow(id);
+    menuWasOpen.current = menuOpen;
+  }, [menuOpen, id]);
+
+  // While open (and its menu isn't), a touch anywhere else or a scroll closes it.
+  useEffect(() => {
+    if (!isOpen || menuOpen) return undefined;
+    const onPointerDown = (event: PointerEvent) => {
+      if (!rowRef.current?.contains(event.target as Node)) closeSwipeRow(id);
+    };
+    const onScroll = () => closeSwipeRow(id);
+    document.addEventListener("pointerdown", onPointerDown, true);
+    document.addEventListener("scroll", onScroll, true);
+    return () => {
+      document.removeEventListener("pointerdown", onPointerDown, true);
+      document.removeEventListener("scroll", onScroll, true);
+    };
+  }, [isOpen, menuOpen, id, rowRef]);
+
+  useEffect(() => {
+    if (!enabled) return undefined;
+    return () => closeSwipeRow(id);
+  }, [enabled, id]);
+
+  if (!enabled) {
+    return { enabled, menuOpen: false, setMenuOpen, rowProps: {}, rowClassName: undefined };
+  }
+
+  // Only touches on the row itself: not its revealed button, and not the
+  // menus and dialogs React portals out of it (their events bubble here too).
+  const onRow = (event: { currentTarget: Element; target: EventTarget }) =>
+    event.target instanceof Element &&
+    event.currentTarget.contains(event.target) &&
+    !event.target.closest(ACTION_SELECTOR);
+
+  const settle = (g: Gesture, velocity: number) => {
+    const open = settleSwipe(g.offset, velocity);
+    suppressClickUntil.current = performance.now() + SWIPE_CLICK_GUARD_MS;
+    if (open) setOpenSwipeRow(id);
+    else closeSwipeRow(id);
+    animateTo(open ? SWIPE_ACTION_WIDTH : 0);
+  };
+
+  const rowProps: HTMLAttributes<HTMLLIElement> = {
+    // Long press is the drag gesture here; keep the browser's own menu away.
+    onContextMenu: (event) => {
+      if (onRow(event)) event.preventDefault();
+    },
+    onPointerDown: (event) => {
+      if (event.pointerType !== "touch" || !event.isPrimary || dragging || !onRow(event)) return;
+      cancelAnimationFrame(frame.current);
+      const start = shown.current;
+      gesture.current = {
+        pointerId: event.pointerId,
+        x: event.clientX,
+        y: event.clientY,
+        start,
+        axis: "pending",
+        offset: start,
+        lastX: event.clientX,
+        lastT: event.timeStamp,
+        velocity: 0,
+      };
+    },
+    onPointerMove: (event) => {
+      const g = gesture.current;
+      if (!g || event.pointerId !== g.pointerId) return;
+      const dx = event.clientX - g.x;
+      if (g.axis === "pending") {
+        const axis = classifySwipe(dx, event.clientY - g.y);
+        if (axis === "pending") return;
+        if (axis === "vertical") {
+          gesture.current = null;
+          // Put back a row caught mid-settle; the list scrolls instead.
+          animateTo(isOpen ? SWIPE_ACTION_WIDTH : 0);
+          return;
+        }
+        g.axis = "horizontal";
+        // One open row at a time: swiping this one closes any other.
+        if (getOpenSwipeRow() !== id) setOpenSwipeRow(null);
+      }
+      const dt = event.timeStamp - g.lastT;
+      if (dt > 0) g.velocity = (event.clientX - g.lastX) / dt;
+      g.lastX = event.clientX;
+      g.lastT = event.timeStamp;
+      g.offset = swipeOffset(g.start, dx);
+      draw(g.offset);
+    },
+    onPointerUp: (event) => {
+      const g = gesture.current;
+      if (!g || event.pointerId !== g.pointerId) return;
+      gesture.current = null;
+      if (g.axis !== "horizontal") {
+        // A tap during the settle animation: finish it where it was heading.
+        animateTo(isOpen ? SWIPE_ACTION_WIDTH : 0);
+        return;
+      }
+      const fresh = event.timeStamp - g.lastT <= FLICK_MAX_AGE_MS;
+      settle(g, fresh ? g.velocity : 0);
+    },
+    onPointerCancel: (event) => {
+      const g = gesture.current;
+      if (!g || event.pointerId !== g.pointerId) return;
+      gesture.current = null;
+      if (g.axis === "horizontal") settle(g, 0);
+      else animateTo(isOpen ? SWIPE_ACTION_WIDTH : 0);
+    },
+    // A tap on an open row closes it instead of opening the session, and the
+    // click a swipe may leave behind is dropped.
+    onClickCapture: (event) => {
+      if (!onRow(event)) return;
+      if (isOpen || performance.now() < suppressClickUntil.current) {
+        event.preventDefault();
+        event.stopPropagation();
+        closeSwipeRow(id);
+      }
+    },
+  };
+  return { enabled, menuOpen, setMenuOpen, rowProps, rowClassName: ROW_CLASS };
+}
+
+/**
+ * The button a swipe reveals at the row's right edge. It sits under the row
+ * and fades in as the row slides off it; its menu is the row's own menu.
+ * Assistive technology can reach it without swiping.
+ */
+export function SessionRowSwipeAction({
+  swipe,
+  label = "More actions",
+  children,
+}: {
+  swipe: SessionRowSwipe;
+  label?: string;
+  /** The menu's items. */
+  children: ReactNode;
+}) {
+  if (!swipe.enabled) return null;
+  return (
+    <div
+      data-swipe-action
+      className="absolute inset-y-0 right-0 flex items-center justify-end pr-0.5"
+      style={{ width: SWIPE_ACTION_WIDTH, opacity: "var(--swipe-progress, 0)" }}
+    >
+      <DropdownMenu open={swipe.menuOpen} onOpenChange={swipe.setMenuOpen}>
+        <DropdownMenuTrigger asChild>
+          <Button
+            type="button"
+            variant="secondary"
+            size="icon-sm"
+            aria-label={label}
+            data-testid="session-swipe-actions"
+            className="h-[calc(100%-4px)] w-11 rounded-[var(--radius-otto-button)]"
+          >
+            <MoreHorizontalIcon className="size-4" />
+          </Button>
+        </DropdownMenuTrigger>
+        <DropdownMenuContent align="end" className="min-w-44">
+          {children}
+        </DropdownMenuContent>
+      </DropdownMenu>
+    </div>
+  );
+}
