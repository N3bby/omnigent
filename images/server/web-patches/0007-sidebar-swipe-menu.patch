index 0000000..831b81a
--- /dev/null
+++ b/web/src/shell/sidebarSwipe.ts
@@ -0,0 +1,133 @@
+// Swipe-to-reveal for sidebar session rows on touch devices.
+//
+// On a touch-primary device a long press on a session row picks it up for
+// dragging (dnd-kit's TouchSensor), so it can't also open the row's menu.
+// Instead, swiping a row from right to left slides it over and reveals a
+// "more" button that opens the same menu. This module holds the pure gesture
+// maths (unit-tested), the "which row is open" store (one row at a time), and
+// the media-query hook that decides whether the gesture is on at all.
+
+import { useSyncExternalStore } from "react";
+
+/** Width of the revealed action area, in CSS pixels. */
+export const SWIPE_ACTION_WIDTH = 52;
+/** Movement before a touch counts as a swipe or a scroll. */
+export const SWIPE_SLOP_PX = 10;
+/** A release faster than this (px/ms) settles in its direction. */
+export const SWIPE_FLICK_VELOCITY = 0.3;
+/** How much of an over-pull past the open position still moves the row. */
+const OVERPULL_RESISTANCE = 0.25;
+
+export type SwipeAxis = "pending" | "horizontal" | "vertical";
+
+/**
+ * Decide what a touch is from how far it has moved since it started. Stays
+ * `pending` inside the slop, so a tap or a long press (drag) never locks.
+ * Past it, the dominant axis wins once and for all: a mostly vertical move is
+ * the list scrolling and is left to the browser.
+ */
+export function classifySwipe(dx: number, dy: number, slop = SWIPE_SLOP_PX): SwipeAxis {
+  const ax = Math.abs(dx);
+  const ay = Math.abs(dy);
+  if (Math.max(ax, ay) < slop) return "pending";
+  return ax > ay ? "horizontal" : "vertical";
+}
+
+/**
+ * How far the row is slid left, given where it started (`0` closed, `width`
+ * open) and the finger's horizontal travel (negative = left). Never slides
+ * right of closed; past fully open it follows the finger with resistance.
+ */
+export function swipeOffset(start: number, dx: number, width = SWIPE_ACTION_WIDTH): number {
+  const raw = start - dx;
+  if (raw <= 0) return 0;
+  if (raw <= width) return raw;
+  return width + (raw - width) * OVERPULL_RESISTANCE;
+}
+
+/**
+ * Whether the row stays open when the finger lifts. A flick decides by its
+ * direction (`velocity` in px/ms, negative = moving left); otherwise the row
+ * opens when it's more than halfway out.
+ */
+export function settleSwipe(offset: number, velocity: number, width = SWIPE_ACTION_WIDTH): boolean {
+  if (velocity <= -SWIPE_FLICK_VELOCITY) return true;
+  if (velocity >= SWIPE_FLICK_VELOCITY) return false;
+  return offset > width / 2;
+}
+
+// ── The open row ──────────────────────────────────────────────────────────
+// At most one row is swiped open; opening another closes the previous one.
+
+let openRowId: string | null = null;
+const openRowListeners = new Set<() => void>();
+
+function subscribeOpenRow(listener: () => void): () => void {
+  openRowListeners.add(listener);
+  return () => openRowListeners.delete(listener);
+}
+
+/** Open `id`'s row (closing any other), or close the open row with `null`. */
+export function setOpenSwipeRow(id: string | null): void {
+  if (openRowId === id) return;
+  openRowId = id;
+  for (const listener of openRowListeners) listener();
+}
+
+/** Close `id`'s row if it's the open one; leaves another open row alone. */
+export function closeSwipeRow(id: string): void {
+  if (openRowId === id) setOpenSwipeRow(null);
+}
+
+export function getOpenSwipeRow(): string | null {
+  return openRowId;
+}
+
+/** Whether `id`'s row is swiped open. Re-renders only that row on changes. */
+export function useIsSwipeRowOpen(id: string): boolean {
+  return useSyncExternalStore(
+    subscribeOpenRow,
+    () => openRowId === id,
+    () => false,
+  );
+}
+
+// ── Touch-primary devices ──────────────────────────────────────────────────
+// Phones and tablets: no hover, and a coarse primary pointer. A laptop with a
+// touchscreen, or a tablet with a mouse or trackpad attached, reports hover
+// and keeps the desktop behaviour (right-click menu, kebab on hover).
+
+export const TOUCH_PRIMARY_QUERY = "(hover: none) and (pointer: coarse)";
+
+let touchQuery: MediaQueryList | null | undefined;
+
+function getTouchQuery(): MediaQueryList | null {
+  if (touchQuery === undefined) {
+    touchQuery =
+      typeof window !== "undefined" && window.matchMedia
+        ? window.matchMedia(TOUCH_PRIMARY_QUERY)
+        : null;
+  }
+  return touchQuery;
+}
+
+function subscribeTouch(callback: () => void): () => void {
+  const mql = getTouchQuery();
+  if (!mql) return () => {};
+  mql.addEventListener("change", callback);
+  return () => mql.removeEventListener("change", callback);
+}
+
+/** True on touch-primary devices (no hover, coarse pointer). SSR-safe. */
+export function useIsTouchPrimary(): boolean {
+  return useSyncExternalStore(
+    subscribeTouch,
+    () => getTouchQuery()?.matches ?? false,
+    () => false,
+  );
+}
+
+/** Test hook: forget the cached media query so a new `matchMedia` mock applies. */
+export function resetTouchPrimaryQueryForTests(): void {
+  touchQuery = undefined;
+}
