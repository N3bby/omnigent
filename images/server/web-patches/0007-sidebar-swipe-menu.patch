+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/hooks/useScopeCache", () => import("@/test/mockScopeCache"));
+import { SidebarDataProvider } from "@/hooks/useSidebarData";
+// The session row's menu on touch-primary devices. A long press picks the row
+// up to drag it, so it no longer opens the menu as well; swiping the row to
+// the left reveals a button for the same menu instead. Mouse and trackpad
+// devices keep the right-click menu and the kebab, and get no swipe.
+// The gesture itself is covered by SessionRowSwipe.test.tsx.
+
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { TooltipProvider } from "@/components/ui/tooltip";
+import type * as SidebarSwipe from "./sidebarSwipe";
+
+const touch = vi.hoisted(() => ({ primary: false }));
+
+vi.mock("./sidebarSwipe", async (importOriginal) => ({
+  ...(await importOriginal<typeof SidebarSwipe>()),
+  useIsTouchPrimary: () => touch.primary,
+}));
+
+vi.mock("@/hooks/useConversations", () => ({
+  useConversations: vi.fn(),
+  useConnectedConversations: () => [],
+  useStopAndDeleteConversation: () => ({
+    mutate: vi.fn(),
+    reset: vi.fn(),
+    isPending: false,
+    isError: false,
+  }),
+  usePinnedConversations: () => ({
+    data: { conversations: [], filterHonored: true },
+    isSuccess: true,
+  }),
+  useTogglePinnedConversation: () => ({ mutate: vi.fn() }),
+  setConversationPinned: vi.fn(() => Promise.resolve({})),
+  PINNED_CONVERSATIONS_KEY: ["pinned-conversations"],
+  useRenameConversation: () => ({ mutate: vi.fn() }),
+  useLeaveSession: () => ({ mutate: vi.fn(), isPending: false }),
+  useArchiveConversation: () => ({ mutate: vi.fn() }),
+  useBulkArchiveConversations: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  useBulkDeleteConversations: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  useBulkMoveToProject: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  useBulkStopSessions: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  useStopSession: () => ({ mutate: vi.fn() }),
+  useProjects: () => ({ data: [] }),
+  useMoveToProject: () => ({ mutate: vi.fn() }),
+  useDeleteProject: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  useRenameProject: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  useCreateProject: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  useProjectConfig: () => ({ data: undefined, isLoading: false }),
+  useUpdateProjectConfig: () => ({ mutate: vi.fn(), isPending: false, isError: false }),
+  fetchProjectSessionIds: () => Promise.resolve([]),
+  PROJECT_LABEL_KEY: "omni_project",
+}));
+
+vi.mock("@/components/PermissionsModal", () => ({ PermissionsModal: () => null }));
+
+import { type Conversation, useConversations } from "@/hooks/useConversations";
+import { Sidebar } from "./Sidebar";
+import { getOpenSwipeRow, setOpenSwipeRow } from "./sidebarSwipe";
+
+const useConvMock = vi.mocked(useConversations);
+
+const CONV: Conversation = {
+  id: "conv_1",
+  object: "conversation",
+  title: "Fix login redirect",
+  created_at: 1_700_000_000,
+  updated_at: 1_700_000_000,
+  labels: {},
+  permission_level: null,
+  status: "idle",
+};
+
+function mockConversations(conversations: Conversation[]) {
+  const withData = {
+    data: {
+      pages: [
+        {
+          data: conversations,
+          first_id: conversations[0]?.id ?? null,
+          last_id: conversations.at(-1)?.id ?? null,
+          has_more: false,
+        },
+      ],
+      pageParams: [undefined],
+    },
+    isLoading: false,
+    isError: false,
+    error: null,
+    fetchNextPage: vi.fn(),
+    hasNextPage: false,
+    isFetchingNextPage: false,
+  } as unknown as ReturnType<typeof useConversations>;
+  useConvMock.mockImplementation(() => withData);
+}
+
+function renderSidebar() {
+  const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={qc}>
+      <SidebarDataProvider>
+        <TooltipProvider>
+          <MemoryRouter initialEntries={["/"]}>
+            <Sidebar open={true} onClose={vi.fn()} />
+          </MemoryRouter>
+        </TooltipProvider>
+      </SidebarDataProvider>
+    </QueryClientProvider>,
+  );
+}
+
+const rowLink = () => screen.getByRole("link", { name: /Fix login redirect/ });
+const rowItem = () => rowLink().closest("li") as HTMLLIElement;
+
+function swipeLeft(target: Element) {
+  const base = { pointerId: 7, pointerType: "touch", isPrimary: true };
+  fireEvent.pointerDown(target, { ...base, clientX: 220, clientY: 100 });
+  for (const x of [205, 185, 160, 140]) {
+    fireEvent.pointerMove(target, { ...base, clientX: x, clientY: 102 });
+  }
+  fireEvent.pointerUp(target, { ...base, clientX: 140, clientY: 102 });
+}
+
+beforeEach(() => {
+  mockConversations([CONV]);
+});
+
+afterEach(() => {
+  act(() => setOpenSwipeRow(null));
+  touch.primary = false;
+  cleanup();
+});
+
+describe("session row menu on touch-primary devices", () => {
+  beforeEach(() => {
+    touch.primary = true;
+  });
+
+  it("doesn't open the menu on a long press, which drags the row instead", () => {
+    renderSidebar();
+    const notCancelled = fireEvent.contextMenu(rowLink());
+    expect(screen.queryByTestId("rename-conversation")).toBeNull();
+    // Nor the browser's own link menu.
+    expect(notCancelled).toBe(false);
+  });
+
+  it("opens the row's own menu from the button a swipe to the left reveals", () => {
+    renderSidebar();
+    act(() => swipeLeft(rowLink()));
+    expect(getOpenSwipeRow()).toBe("conv_1");
+
+    fireEvent.pointerDown(screen.getByRole("button", { name: "More actions" }), {
+      button: 0,
+      ctrlKey: false,
+      pointerType: "touch",
+    });
+
+    // The same items as the kebab and the right-click menu.
+    expect(screen.getByTestId("rename-conversation")).toBeInTheDocument();
+    expect(screen.getByTestId("archive-conversation")).toBeInTheDocument();
+    expect(screen.getByTestId("delete-conversation")).toBeInTheDocument();
+  });
+});
+
+describe("session row menu with a mouse or trackpad", () => {
+  it("keeps the right-click menu and adds no swipe", () => {
+    renderSidebar();
+    expect(screen.queryByRole("button", { name: "More actions" })).toBeNull();
+    expect(rowItem().className).toBe("group relative");
+
+    act(() => swipeLeft(rowLink()));
+    expect(rowItem()).not.toHaveAttribute("data-swiped");
+
+    fireEvent.contextMenu(rowLink());
+    expect(screen.getByTestId("rename-conversation")).toBeInTheDocument();
+  });
+});
