+import { useRef } from "react";
+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { DropdownMenuItem } from "@/components/ui/dropdown-menu";
+import { SessionRowSwipeAction, useSessionRowSwipe } from "./SessionRowSwipe";
+import { getOpenSwipeRow, setOpenSwipeRow } from "./sidebarSwipe";
+
+const onNavigate = vi.fn((event: { preventDefault: () => void }) => event.preventDefault());
+
+function Row({
+  id,
+  enabled = true,
+  dragging = false,
+}: {
+  id: string;
+  enabled?: boolean;
+  dragging?: boolean;
+}) {
+  const rowRef = useRef<HTMLLIElement>(null);
+  const swipe = useSessionRowSwipe({ id, enabled, dragging, rowRef });
+  return (
+    <li
+      ref={rowRef}
+      data-testid={`row-${id}`}
+      data-sidebar-session-id={id}
+      {...swipe.rowProps}
+      className={swipe.rowClassName}
+    >
+      <SessionRowSwipeAction swipe={swipe} label={`More actions ${id}`}>
+        <DropdownMenuItem onSelect={() => swipe.setMenuOpen(false)}>Rename {id}</DropdownMenuItem>
+      </SessionRowSwipeAction>
+      <a href={`/c/${id}`} onClick={onNavigate}>
+        Session {id}
+      </a>
+    </li>
+  );
+}
+
+function List(props: { enabled?: boolean; dragging?: boolean }) {
+  return (
+    <ul>
+      <Row id="a" {...props} />
+      <Row id="b" />
+    </ul>
+  );
+}
+
+let pointerId = 1;
+
+/** A touch that moves from (x, y) by (dx, dy) in a few steps, then lifts. */
+function swipeRow(target: Element, dx: number, dy = 0, pointerType = "touch") {
+  const id = pointerId++;
+  const base = { pointerId: id, pointerType, isPrimary: true, bubbles: true };
+  fireEvent.pointerDown(target, { ...base, clientX: 200, clientY: 100 });
+  for (let i = 1; i <= 4; i++) {
+    fireEvent.pointerMove(target, {
+      ...base,
+      clientX: 200 + (dx * i) / 4,
+      clientY: 100 + (dy * i) / 4,
+    });
+  }
+  fireEvent.pointerUp(target, { ...base, clientX: 200 + dx, clientY: 100 + dy });
+}
+
+const link = (id: string) => screen.getByText(`Session ${id}`);
+const row = (id: string) => screen.getByTestId(`row-${id}`);
+
+afterEach(() => {
+  act(() => setOpenSwipeRow(null));
+  onNavigate.mockClear();
+});
+
+describe("useSessionRowSwipe", () => {
+  it("opens a row on a swipe to the left and reveals its button", async () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -80));
+    expect(getOpenSwipeRow()).toBe("a");
+    // Settles back from the over-pull to exactly the button's width.
+    await waitFor(() => expect(row("a").style.getPropertyValue("--swipe-x")).toBe("-52px"));
+    expect(row("a")).toHaveAttribute("data-swiped");
+    expect(screen.getByRole("button", { name: "More actions a" })).toBeInTheDocument();
+  });
+
+  it("leaves a vertical move to the list's scrolling", () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -12, 60));
+    expect(getOpenSwipeRow()).toBeNull();
+    expect(row("a")).not.toHaveAttribute("data-swiped");
+  });
+
+  it("ignores mouse and pen", () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -80, 0, "mouse"));
+    act(() => swipeRow(link("a"), -80, 0, "pen"));
+    expect(getOpenSwipeRow()).toBeNull();
+  });
+
+  it("keeps one row open at a time", () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -80));
+    act(() => swipeRow(link("b"), -80));
+    expect(getOpenSwipeRow()).toBe("b");
+  });
+
+  it("closes on a swipe back to the right", () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -80));
+    act(() => swipeRow(link("a"), 80));
+    expect(getOpenSwipeRow()).toBeNull();
+  });
+
+  it("closes an open row on a tap instead of opening the session", () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -80));
+    // The swipe's own trailing click is swallowed too; wait it out.
+    vi.spyOn(performance, "now").mockReturnValue(performance.now() + 1000);
+    const notCancelled = fireEvent.click(link("a"));
+    vi.restoreAllMocks();
+    expect(notCancelled).toBe(false);
+    expect(onNavigate).not.toHaveBeenCalled();
+    expect(getOpenSwipeRow()).toBeNull();
+    // Closed, a tap opens the session again.
+    vi.spyOn(performance, "now").mockReturnValue(performance.now() + 2000);
+    fireEvent.click(link("a"));
+    vi.restoreAllMocks();
+    expect(onNavigate).toHaveBeenCalledTimes(1);
+  });
+
+  it("closes on a touch elsewhere and on scroll", () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -80));
+    act(() => {
+      fireEvent.pointerDown(document.body, { pointerType: "touch" });
+    });
+    expect(getOpenSwipeRow()).toBeNull();
+    act(() => swipeRow(link("a"), -80));
+    act(() => {
+      fireEvent.scroll(document);
+    });
+    expect(getOpenSwipeRow()).toBeNull();
+  });
+
+  it("closes when a long press starts a drag", () => {
+    const { rerender } = render(<List />);
+    act(() => swipeRow(link("a"), -80));
+    rerender(<List dragging />);
+    expect(getOpenSwipeRow()).toBeNull();
+  });
+
+  it("does nothing while disabled", () => {
+    render(<List enabled={false} />);
+    act(() => swipeRow(link("a"), -80));
+    expect(getOpenSwipeRow()).toBeNull();
+    expect(screen.queryByRole("button", { name: "More actions a" })).toBeNull();
+    expect(row("a")).not.toHaveAttribute("class");
+  });
+
+  it("opens the row's menu from the revealed button, and closes with it", async () => {
+    render(<List />);
+    act(() => swipeRow(link("a"), -80));
+    const button = screen.getByRole("button", { name: "More actions a" });
+    fireEvent.pointerDown(button, { button: 0, ctrlKey: false, pointerType: "touch" });
+    // Touches on the button aren't swipes and don't close the row.
+    expect(getOpenSwipeRow()).toBe("a");
+    fireEvent.click(await screen.findByRole("menuitem", { name: "Rename a" }));
+    await waitFor(() => expect(screen.queryByRole("menu")).toBeNull());
+    expect(getOpenSwipeRow()).toBeNull();
+  });
+});
