+
+  it("keeps blank values and drops removed headers when editing", async () => {
+    stored[1].headers = { Authorization: "Bearer lin_secret", "X-Team": "eng" };
+    renderPage();
+    const linear = await screen.findByRole("article", { name: "linear" });
