+    expect(stored[1].headers).toEqual({ Authorization: "Bearer lin_secret" });
+  });
+
+  it("says when changing the transport drops the stored values", async () => {
+    renderPage();
+    const figma = await screen.findByRole("article", { name: "figma" });
+    fireEvent.click(within(figma).getByRole("button", { name: "Edit figma" }));
+    fireEvent.click(within(figma).getByLabelText("URL (HTTP)"));
+    expect(within(figma).getByText("Saving removes its 1 variable.")).toBeInTheDocument();
