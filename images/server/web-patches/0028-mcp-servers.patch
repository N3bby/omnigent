+            value={name}
+            onChange={(e) => setName(e.target.value.trim())}
+            placeholder="figma"
+            aria-invalid={nameError ? true : undefined}
+            autoComplete="off"
+            autoCapitalize="off"
+            spellCheck={false}
+            className={cn("font-mono sm:w-64", TOUCH_HEIGHT)}
+          />
+        </div>
+        {nameError ? (
+          <p className="text-sm text-destructive">{nameError}</p>
+        ) : overlap ? (
+          <p className="text-sm text-muted-foreground">{overlap}</p>
+        ) : (
+          <p className="text-sm text-muted-foreground">
+            The agents list the server's tools under this name.
+          </p>
+        )}
+        <fieldset className="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1">
+          <legend className="mb-1 text-sm font-medium text-muted-foreground">For</legend>
+          {MCP_AGENTS.map((agent) => (
+            <label
+              key={agent.id}
+              className={cn("flex cursor-pointer items-center gap-2 text-ui", TOUCH_HEIGHT)}
+            >
+              <input
+                type="checkbox"
+                checked={agents.includes(agent.id)}
+                onChange={(e) => toggleAgent(agent.id, e.target.checked)}
+                className="size-4 shrink-0 accent-primary"
+              />
+              {agent.label}
+            </label>
+          ))}
+          {agents.length === 0 && (
+            <span className="text-sm text-muted-foreground">
+              Switched off: no agent gets it until you choose one.
+            </span>
+          )}
+        </fieldset>
+      </div>
+
+      <div className={SECTION}>
+        <fieldset className="flex flex-wrap items-center gap-x-4 gap-y-1">
+          <legend className="mb-1 text-sm font-medium text-muted-foreground">Connect by</legend>
+          {(
+            [
+              ["http", "URL (HTTP)"],
+              ["stdio", "Command (stdio)"],
+            ] as const
+          ).map(([id, label]) => (
+            <label
+              key={id}
+              className={cn("flex cursor-pointer items-center gap-2 text-ui", TOUCH_HEIGHT)}
+            >
+              <input
+                type="radio"
+                name="mcp-server-transport"
+                checked={transport === id}
+                onChange={() => setTransport(id)}
+                className="size-4 shrink-0 accent-primary"
+              />
+              {label}
+            </label>
+          ))}
+        </fieldset>
+        {dropping > 0 && (
+          <p className="text-sm text-muted-foreground">
+            Saving removes its{" "}
+            {plural(dropping, server?.transport === "http" ? "header" : "variable")}.
+          </p>
+        )}
+        {transport === "http" ? (
+          <>
+            <Input
+              value={url}
+              onChange={(e) => setUrl(e.target.value)}
+              placeholder="https://mcp.figma.com/mcp"
+              aria-label="URL"
+              aria-invalid={urlProblem ? true : undefined}
+              autoComplete="off"
+              spellCheck={false}
+              className={cn("font-mono", TOUCH_HEIGHT)}
+            />
+            {urlProblem && <p className="text-sm text-destructive">{urlProblem}</p>}
+            <PairsEditor
+              label="Headers"
+              what="header"
+              rows={headers}
+              onRows={setHeaders}
+              errors={errors}
+              placeholder="Authorization"
+            >
+              Such as Authorization: Bearer …, for a server that takes an API key. A server that
+              signs you in with your browser needs none.
+            </PairsEditor>
+          </>
+        ) : (
+          <>
+            <label htmlFor="mcp-server-command" className={FIELD_LABEL}>
+              Command
+            </label>
+            <Input
+              id="mcp-server-command"
+              value={command}
+              onChange={(e) => setCommand(e.target.value)}
+              placeholder="npx"
+              autoComplete="off"
+              spellCheck={false}
+              className={cn("font-mono sm:w-64", TOUCH_HEIGHT)}
+            />
+            <label htmlFor="mcp-server-args" className={FIELD_LABEL}>
+              Arguments
+            </label>
+            <Textarea
+              id="mcp-server-args"
+              value={args}
+              onChange={(e) => setArgs(e.target.value)}
+              rows={3}
+              placeholder={"-y\nfigma-developer-mcp\n--stdio"}
+              className="font-mono text-sm md:text-sm"
+              spellCheck={false}
+              autoCapitalize="off"
+            />
+            <p className="text-sm text-muted-foreground">
+              One argument per line, taken as written: nothing is expanded. It starts in the
+              session's workspace. Keep keys out of the arguments; give them as variables.
+            </p>
+            <PairsEditor
+              label="Variables"
+              what="variable"
+              rows={env}
+              onRows={setEnv}
+              errors={errors}
+              placeholder="FIGMA_API_KEY"
+            >
+              Only this server gets them, not the agent.
+            </PairsEditor>
+          </>
+        )}
+      </div>
+
+      <div className="flex flex-wrap items-center justify-end gap-2 border-t border-border pt-3">
+        {hint && <span className="mr-auto text-sm text-muted-foreground">{hint}</span>}
+        <Button
+          type="button"
+          variant="outline"
+          onClick={onClose}
+          disabled={save.isPending}
+          className={TOUCH_HEIGHT}
+        >
+          Cancel
+        </Button>
+        <Button type="submit" disabled={!canSave} loading={save.isPending} className={TOUCH_HEIGHT}>
+          Save
+        </Button>
+      </div>
+      {saveError && (
+        <p className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-ui text-destructive">
+          {saveError}
+        </p>
+      )}
+    </form>
+  );
+}
+
+/**
+ * Where a server goes: every session, or sessions on one repository, picked
+ * from your GitHub repositories and the ones with variables, or pasted. A
+ * saved server says where it is; it can't move.
+ */
+function ScopeField({
+  server,
+  forRepository,
+  onForRepository,
+  text,
+  onText,
+  repository,
+  known,
+}: {
+  server?: McpServer;
+  forRepository: boolean;
+  onForRepository: (on: boolean) => void;
+  text: string;
+  onText: (text: string) => void;
+  repository: string | null;
+  /** Repositories that already have MCP servers. */
+  known: string[];
+}) {
+  const info = useServerInfo();
+  const githubEnabled = info !== "loading" && (info.enabled_connections ?? []).includes("github");
+  // The same queries as Repository variables and the new-session picker.
+  const { data: github } = useQuery({
+    queryKey: ["github-repos"],
+    queryFn: fetchGithubRepos,
+    enabled: githubEnabled && !server && forRepository,
+    staleTime: 5 * 60_000,
+  });
+  const { data: withVariables } = useRepoEnv();
+  const listId = useId();
+
+  if (server) {
+    return (
+      <>
+        <span className="text-sm font-medium text-muted-foreground">Sessions</span>
+        <p className="text-ui">
+          {server.repository ? (
+            <>
+              Sessions on <span className="font-mono">{server.repository}</span>
+            </>
+          ) : (
+            "Every session"
+          )}
+        </p>
+        <p className="text-sm text-muted-foreground">
+          To move it, add it again where you want it and remove it here.
+        </p>
+      </>
+    );
+  }
+
+  const suggestions = [
+    ...new Set([
+      ...known,
+      ...(withVariables ?? []).map((e) => e.repository),
+      ...(github?.connected
+        ? github.repos.map((r) => `github.com/${r.full_name.toLowerCase()}`)
+        : []),
+    ]),
+  ].sort();
+
+  return (
+    <>
+      <fieldset className="flex flex-wrap items-center gap-x-4 gap-y-1">
+        <legend className="mb-1 text-sm font-medium text-muted-foreground">Sessions</legend>
+        {(
+          [
+            [false, "Every session"],
+            [true, "Sessions on one repository"],
+          ] as const
+        ).map(([value, label]) => (
+          <label
+            key={label}
+            className={cn("flex cursor-pointer items-center gap-2 text-ui", TOUCH_HEIGHT)}
+          >
+            <input
+              type="radio"
+              name="mcp-server-scope"
+              checked={forRepository === value}
+              onChange={() => onForRepository(value)}
+              className="size-4 shrink-0 accent-primary"
+            />
+            {label}
+          </label>
+        ))}
+      </fieldset>
+      {forRepository && (
+        <>
+          <Input
+            value={text}
+            onChange={(e) => onText(e.target.value)}
+            list={listId}
+            placeholder="owner/repo, or a clone URL"
+            aria-label="Repository"
+            autoComplete="off"
+            spellCheck={false}
+            autoFocus
+            className={cn("font-mono", TOUCH_HEIGHT)}
+          />
+          <datalist id={listId}>
+            {suggestions.map((key) => (
+              <option key={key} value={key} />
+            ))}
+          </datalist>
+          {repository ? (
+            <p className="text-sm text-muted-foreground wrap-anywhere">
+              Only sessions on <span className="font-mono">{repository}</span> get it, and its keys.
+            </p>
+          ) : (
+            text.trim() && (
+              <p className="text-sm text-destructive">Enter owner/repo or a clone URL.</p>
+            )
+          )}
+        </>
+      )}
+    </>
+  );
+}
+
+/** A server's headers or variables: names with write-only values. */
+function PairsEditor({
+  label,
+  what,
+  rows,
+  onRows,
+  errors,
+  placeholder,
+  children,
+}: {
+  label: string;
+  what: "header" | "variable";
+  rows: Row[];
+  onRows: (update: (rows: Row[]) => Row[]) => void;
+  errors: (string | null)[];
+  placeholder: string;
+  children: ReactNode;
+}) {
+  function update(id: number, patch: Partial<Row>) {
+    onRows((current) => current.map((r) => (r.id === id ? { ...r, ...patch } : r)));
+  }
+  return (
+    <div className="flex flex-col gap-2">
+      <span className={FIELD_LABEL}>{label}</span>
+      <p className="text-sm text-muted-foreground">{children}</p>
+      {rows.map((row, i) => (
+        <div key={row.id} className="flex flex-col gap-1 not-first:max-sm:mt-1">
+          {/* Narrow screens: the name and its remove button, with the value
+          below at full width. From sm, one line. */}
+          <div className="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-2 gap-y-1.5 sm:flex">
+            <Input
+              value={row.name}
+              onChange={(e) => update(row.id, { name: e.target.value.trim() })}
+              readOnly={row.existing}
+              placeholder={placeholder}
+              aria-label={`${what === "header" ? "Header" : "Variable"} name`}
+              aria-invalid={errors[i] ? true : undefined}
+              autoComplete="off"
+              autoCapitalize="off"
+              spellCheck={false}
+              className={cn(
+                "font-mono sm:w-64 sm:flex-none",
+                TOUCH_HEIGHT,
+                row.existing && "bg-muted/40",
+              )}
+            />
+            <Input
+              type="password"
+              value={row.value}
+              onChange={(e) => update(row.id, { value: e.target.value })}
+              placeholder={row.existing ? "Leave blank to keep the current value" : "Value"}
+              aria-label={`Value for ${row.name || `new ${what}`}`}
+              autoComplete="new-password"
+              className={cn("col-span-2 min-w-0 sm:flex-1", TOUCH_HEIGHT)}
+            />
+            <Button
+              type="button"
+              variant="ghost"
+              size="icon-sm"
+              onClick={() => onRows((current) => current.filter((r) => r.id !== row.id))}
+              aria-label={`Remove ${row.name || what}`}
+              className={cn("col-start-2 row-start-1", TOUCH_ICON_BUTTON)}
+            >
+              <XIcon className="ui-icon" />
+            </Button>
+          </div>
+          {errors[i] && <p className="text-sm text-destructive">{errors[i]}</p>}
+        </div>
+      ))}
+      <div>
+        <Button
+          type="button"
+          variant="ghost"
+          size="sm"
+          onClick={() => onRows((current) => [...current, newRow()])}
+          className={TOUCH_HEIGHT}
+        >
+          <PlusIcon className="ui-icon" />
+          Add {what}
+        </Button>
+      </div>
+    </div>
+  );
+}
