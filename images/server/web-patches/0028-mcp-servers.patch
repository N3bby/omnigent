+    expect(within(editor).getByText("Give every new variable a value.")).toBeInTheDocument();
+    expect(within(editor).getByRole("button", { name: "Save" })).toBeDisabled();
+    fireEvent.change(within(editor).getByLabelText("Value for GITHUB_PERSONAL_ACCESS_TOKEN"), {
