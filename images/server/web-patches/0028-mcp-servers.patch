diff --git a/web/src/lib/mcpServers.ts b/web/src/lib/mcpServers.ts
new file mode 100644
index 0000000..a771bdd
--- /dev/null
+++ b/web/src/lib/mcpServers.ts
@@ -0,0 +1,141 @@
+/**
+ * MCP servers for sessions' Claude Code and Codex (``/v1/mcp-servers``, added
+ * by this deployment): global ones for every session, and a repository's for
+ * sessions on it, where they replace a global server of the same name.
+ *
+ * Header and variable values only go to the server. Listing returns their
+ * names, and saving a name with ``null`` keeps its current value. The checks
+ * here mirror ``omnigent_mcp_servers.py`` so the page can flag a field before
+ * saving; the server checks again.
+ */
+
+import { authenticatedFetch } from "./identity";
+
+export type McpAgent = "claude" | "codex";
+export type McpTransport = "http" | "stdio";
+
+export const MCP_AGENTS: { id: McpAgent; label: string }[] = [
+  { id: "claude", label: "Claude Code" },
+  { id: "codex", label: "Codex" },
+];
+
+/** One server, from ``GET /v1/mcp-servers``. */
+export interface McpServer {
+  id: string;
+  /** What the agents call it, e.g. ``"figma"``; their tools carry it as a prefix. */
+  name: string;
+  /** ``host/owner/repo`` for a repository's server, or null for every session's. */
+  repository: string | null;
+  transport: McpTransport;
+  /** The HTTP server's URL, or null for a command. */
+  url: string | null;
+  /** The HTTP server's header names, sorted. Never values. */
+  header_names: string[];
+  /** The command that starts a stdio server, or null for HTTP. */
+  command: string | null;
+  args: string[];
+  /** The stdio server's variable names, sorted. Never values. */
+  env_names: string[];
+  /** The agents that get it; empty when it's switched off. */
+  agents: McpAgent[];
+  /** ISO-8601 time of the last change, or null. */
+  updated_at: string | null;
+  /** Who last saved it, or null. */
+  updated_by: string | null;
+}
+
+/** Body for ``PUT /v1/mcp-servers``; without ``id`` it adds a server. */
+export interface SaveMcpServer {
+  id?: string;
+  /** owner/repo or a clone URL for a repository's server; null for every session's. */
+  repository: string | null;
+  name: string;
+  transport: McpTransport;
+  agents: McpAgent[];
+  url?: string;
+  /** Each header's new value, or null to keep the current one. Names left out are removed. */
+  headers?: Record<string, string | null>;
+  command?: string;
+  args?: string[];
+  /** Each variable's new value, or null to keep the current one. Names left out are removed. */
+  env?: Record<string, string | null>;
+}
+
+const NAME = /^[A-Za-z0-9_-]{1,64}$/;
+const HEADER_NAME = /^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,128}$/;
+const ENV_NAME = /^[A-Za-z_][A-Za-z0-9_]{0,127}$/;
+
+/**
+ * Why a server can't have this name, or null when it can.
+ *
+ * @param taken The names already used where it goes: every session's, or the
+ *   repository's. The same name in the other place is fine.
+ */
+export function serverNameError(name: string, taken: string[]): string | null {
+  if (!name) return null;
+  if (!NAME.test(name)) return "Use letters, digits, - and _, up to 64 characters.";
+  if (name.toLowerCase() === "omnigent") return "omnigent is Omnigent's own MCP server.";
+  if (taken.some((t) => t.toLowerCase() === name.toLowerCase())) {
+    return `There's already an MCP server called ${name} here.`;
+  }
+  return null;
+}
+
+/** Why this isn't a URL the agents can reach, or null when it is. */
+export function urlError(url: string): string | null {
+  if (!url.trim()) return null;
+  try {
+    const parsed = new URL(url.trim());
+    if ((parsed.protocol === "https:" || parsed.protocol === "http:") && parsed.host) return null;
+  } catch {
+    // Falls through to the message.
+  }
+  return "Give the server's URL, starting with https://.";
+}
+
+export function headerNameError(name: string): string | null {
+  return HEADER_NAME.test(name) ? null : "Use a header name such as Authorization, without spaces.";
+}
+
+export function envNameError(name: string): string | null {
+  return ENV_NAME.test(name)
+    ? null
+    : "Use letters, digits and underscores, not starting with a digit.";
+}
+
+/** One argument per line, as the page edits them; blank lines are dropped. */
+export function parseArgs(text: string): string[] {
+  return text.split(/\r?\n/).filter((line) => line.trim() !== "");
+}
+
+async function errorMessage(res: Response): Promise<string> {
+  const body = await res.json().catch(() => ({}));
+  return body?.error?.message ?? `${res.status} ${res.statusText}`;
+}
+
+/** Every MCP server (admin only). */
+export async function fetchMcpServers(): Promise<McpServer[]> {
+  const res = await authenticatedFetch("/v1/mcp-servers");
+  if (!res.ok) throw new Error(await errorMessage(res));
+  return ((await res.json()) as { data: McpServer[] }).data;
+}
+
+/** Add a server, or replace the one with ``body.id`` (admin only). */
+export async function saveMcpServer(body: SaveMcpServer): Promise<McpServer> {
+  const res = await authenticatedFetch("/v1/mcp-servers", {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+  if (!res.ok) throw new Error(await errorMessage(res));
+  return (await res.json()) as McpServer;
+}
+
+/** Remove a server, global or a repository's (admin only). */
+export async function deleteMcpServer(id: string, repository: string | null): Promise<void> {
+  const query = repository ? `?repository=${encodeURIComponent(repository)}` : "";
+  const res = await authenticatedFetch(`/v1/mcp-servers/${encodeURIComponent(id)}${query}`, {
+    method: "DELETE",
+  });
+  if (!res.ok) throw new Error(await errorMessage(res));
+}
