+    ? "Choose the repository."
+    : !name
+      ? "Name the server."
+      : transport === "http" && !url.trim()
+        ? "Give the server's URL."
+        : transport === "stdio" && !command.trim()
+          ? "Give the command that starts it."
+          : missingValue
+            ? `Give every new ${transport === "http" ? "header" : "variable"} a value.`
+            : null;
