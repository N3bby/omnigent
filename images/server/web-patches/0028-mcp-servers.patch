+      {error ? (
+        <p className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-ui text-destructive">
+          Couldn't load the MCP servers: {error.message}
+        </p>
+      ) : isLoading ? (
+        <p className="text-ui text-muted-foreground">Loading…</p>
+      ) : (
+        <div className="flex flex-col gap-6" data-testid="mcp-server-list">
+          {groups.map((group) => (
+            <section
