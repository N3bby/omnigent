+
+  it("adds a server for one repository", async () => {
+    renderPage();
+    fireEvent.click(await screen.findByRole("button", { name: "Add server" }));
+    const editor = screen.getByTestId("mcp-server-editor");
+    fireEvent.click(within(editor).getByLabelText("Sessions on one repository"));
+    fireEvent.change(within(editor).getByLabelText("Name"), { target: { value: "figma" } });
+    expect(within(editor).getByText("Choose the repository.")).toBeInTheDocument();
+    fireEvent.change(within(editor).getByLabelText("Repository"), {
+      target: { value: "git@github.com:Kunlabora/RoadPass.git" },
