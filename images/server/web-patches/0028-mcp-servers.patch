+/** What a server is recognised by: as saved, or as the editor has it so far. */
+export interface McpServerLike {
+  name: string;
+  url?: string | null;
+  args?: string[];
+}
+
+function host(url: string | null | undefined): string {
+  if (!url) return "";
+  try {
+    return new URL(url).host;
+  } catch {
+    return "";
+  }
+}
+
+/** The brand a server is for, or null for the coloured initial. */
+export function serverBrand(server: McpServerLike): McpBrand | null {
+  for (const text of [server.name, host(server.url), (server.args ?? []).join(" ")]) {
+    if (!text) continue;
+    const brand = MCP_BRANDS.find((b) => b.pattern.test(text));
+    if (brand) return brand;
+  }
+  return null;
+}
+
+/**
+ * Whether the logo goes white on ``hex``, as most brands show it, rather than
+ * black. White as long as it has the 3:1 contrast WCAG asks of graphics, so
+ * only light colours, such as Supabase's green, get black.
+ */
+export function lightOn(hex: string): boolean {
+  const [r, g, b] = [0, 2, 4].map((i) => {
+    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  });
+  const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+  return 1.05 / (luminance + 0.05) >= 3;
+}
+
+/** A hue for a server without a logo, the same for the same name every time. */
+export function initialHue(name: string): number {
+  let hash = 0;
+  for (const char of name.toLowerCase()) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
+  return hash % 360;
+}
