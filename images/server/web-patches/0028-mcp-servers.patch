+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import {
+  deleteMcpServer,
+  fetchMcpServers,
+  type SaveMcpServer,
+  saveMcpServer,
+} from "@/lib/mcpServers";
+
+const LIST_KEY = ["mcp-servers"];
+
+/** Every MCP server (admin only). */
+export function useMcpServers() {
+  return useQuery({ queryKey: LIST_KEY, queryFn: fetchMcpServers, staleTime: 5_000 });
+}
+
+function useInvalidate() {
+  const queryClient = useQueryClient();
+  return () => {
+    void queryClient.invalidateQueries({ queryKey: LIST_KEY });
+    // A repository's servers show on its Repository variables card.
+    void queryClient.invalidateQueries({ queryKey: ["repo-env"] });
+  };
+}
+
+/** Add or replace a server, null keeping a header's or variable's current value. */
+export function useSaveMcpServer() {
+  const invalidate = useInvalidate();
+  return useMutation({
+    mutationFn: (body: SaveMcpServer) => saveMcpServer(body),
+    onSuccess: invalidate,
+  });
+}
+
+/** Remove a server, global or a repository's. */
+export function useDeleteMcpServer() {
+  const invalidate = useInvalidate();
+  return useMutation({
+    mutationFn: (server: { id: string; repository: string | null }) =>
+      deleteMcpServer(server.id, server.repository),
+    onSuccess: invalidate,
+  });
+}
