+    fireEvent.click(within(editor).getByRole("button", { name: "Save" }));
+    await waitFor(() => expect(screen.queryByTestId("mcp-server-editor")).toBeNull());
+    expect(lastPut()).toEqual({
+      repository: null,
+      name: "github",
+      transport: "stdio",
+      agents: ["codex"],
+      command: "docker",
+      args: ["run", "-i", "--rm", "ghcr.io/github/github-mcp-server"],
