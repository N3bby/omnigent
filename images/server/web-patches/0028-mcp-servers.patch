@@ -0,0 +1,57 @@
+/**
+ * An MCP server's icon (added by this deployment): its service's logo on the
+ * brand colour, or its initial on a colour of its own, so servers are easy to
+ * tell apart. Settings → MCP servers and the new-session form's repository
+ * badge show it.
+ */
+
+import { type McpServerLike, initialHue, lightOn, serverBrand } from "@/lib/mcpServerIcons";
+import { cn } from "@/lib/utils";
+
+export function McpServerIcon({
+  server,
+  size = "md",
+}: {
+  server: McpServerLike;
+  size?: "md" | "lg";
+}) {
+  const brand = serverBrand(server);
+  const tile = cn(
+    "flex shrink-0 items-center justify-center rounded-md ring-1 ring-black/10 ring-inset dark:ring-white/15",
+    size === "lg" ? "size-8" : "size-5",
+  );
+  if (brand) {
+    return (
+      <span
+        className={tile}
+        style={{ backgroundColor: `#${brand.hex}`, color: lightOn(brand.hex) ? "#fff" : "#000" }}
+        title={brand.title}
+        data-testid="mcp-server-icon"
+        data-brand={brand.title}
+      >
+        <svg
+          viewBox="0 0 24 24"
+          fill="currentColor"
+          aria-hidden="true"
+          className={size === "lg" ? "size-4.5" : "size-3"}
+        >
+          <path d={brand.path} />
+        </svg>
+      </span>
+    );
+  }
+  return (
+    <span
+      className={cn(
+        tile,
+        "font-sans font-semibold text-white uppercase",
+        size === "lg" ? "text-sm" : "text-[11px]",
+      )}
+      style={{ backgroundColor: `hsl(${initialHue(server.name)} 45% 42%)` }}
+      aria-hidden="true"
+      data-testid="mcp-server-icon"
+    >
+      {server.name.charAt(0)}
+    </span>
+  );
+}
