+
+interface Row {
+  id: number;
+  name: string;
+  value: string;
+  /** Already stored: the name is fixed and a blank value keeps it. */
+  existing: boolean;
+}
+
+let nextRowId = 0;
+function newRow(name = "", value = "", existing = false): Row {
+  nextRowId += 1;
+  return { id: nextRowId, name, value, existing };
+}
+
+function storedRows(names: string[]): Row[] {
+  return names.length ? names.map((name) => newRow(name, "", true)) : [];
+}
+
+function rowError(row: Row, rows: Row[], index: number, nameError: (n: string) => string | null) {
+  if (!row.name) return row.value ? "Give this value a name." : null;
+  const error = nameError(row.name);
+  if (error) return error;
+  if (rows.findIndex((r) => r.name === row.name) !== index)
+    return `${row.name} is already in this list.`;
+  return null;
+}
+
+/** The rows sent to the server: each name's new value, or null to keep it. */
+function rowValues(rows: Row[]): Record<string, string | null> {
+  const values: Record<string, string | null> = {};
+  for (const row of rows) {
+    if (row.name) values[row.name] = row.existing && !row.value ? null : row.value;
+  }
+  return values;
+}
+
+/** Sections of the editor, one under the other with a rule between. */
+const SECTION = "flex flex-col gap-2 not-first:border-t not-first:border-border not-first:pt-4";
+/** A field's label inside a section, below the section's own label. */
+const FIELD_LABEL = "mt-2 text-sm font-medium text-muted-foreground";
+
+/** Edits one server. Without ``server`` it adds one. */
+function ServerEditor({
+  server,
+  servers,
+  onClose,
+}: {
+  server?: McpServer;
+  /** Every other server, global and per repository. */
+  servers: McpServer[];
+  onClose: () => void;
+}) {
+  const save = useSaveMcpServer();
+  // A new server picks where it goes; a saved one stays there.
+  const [forRepository, setForRepository] = useState(server ? server.repository !== null : false);
+  const [repositoryText, setRepositoryText] = useState(server?.repository ?? "");
+  const [name, setName] = useState(server?.name ?? "");
+  const [agents, setAgents] = useState<McpAgent[]>(server?.agents ?? ["claude", "codex"]);
+  const [transport, setTransport] = useState<McpTransport>(server?.transport ?? "http");
+  const [url, setUrl] = useState(server?.url ?? "");
+  const [headers, setHeaders] = useState<Row[]>(() =>
+    server?.transport === "http" ? storedRows(server.header_names) : [],
+  );
+  const [command, setCommand] = useState(server?.command ?? "");
+  const [args, setArgs] = useState(server?.args.join("\n") ?? "");
+  const [env, setEnv] = useState<Row[]>(() =>
+    server?.transport === "stdio" ? storedRows(server.env_names) : [],
+  );
+  const [saveError, setSaveError] = useState<string | null>(null);
+
+  const rows = transport === "http" ? headers : env;
+  const nameCheck = transport === "http" ? headerNameError : envNameError;
+  const errors = rows.map((row, i) => rowError(row, rows, i, nameCheck));
+  const missingValue = rows.some((r) => r.name && !r.existing && !r.value);
+  const repository = server ? server.repository : forRepository ? repoKey(repositoryText) : null;
+  const repositoryMissing = forRepository && repository === null;
+  const nameError = serverNameError(
+    name,
+    servers.filter((s) => s.repository === repository).map((s) => s.name),
+  );
+  // The same name in the other place is allowed: a repository's replaces the
+  // one for every session in its sessions.
+  const overlap = !name
+    ? null
+    : repository
+      ? servers.some((s) => s.repository === null && sameName(s.name, name))
+        ? `Sessions on ${repositoryPath(repository)} get this one instead of the ${name} for every session.`
+        : null
+      : (() => {
+          const shadowing = servers.filter((s) => s.repository && sameName(s.name, name));
+          return shadowing.length
+            ? `Sessions on ${shadowing.map((s) => repositoryPath(s.repository!)).join(", ")} get their repository's ${name} instead.`
+            : null;
+        })();
