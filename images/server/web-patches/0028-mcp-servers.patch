+// Tests for the admin MCP servers page. The identity module's
+// authenticatedFetch is replaced by an in-memory /v1/mcp-servers, so the page,
+// its react-query hooks and the fetch helpers run as they do in the browser.
+
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { McpServersPage } from "./McpServersPage";
+import * as identity from "@/lib/identity";
+import { parseArgs, serverNameError, urlError } from "@/lib/mcpServers";
+
+vi.mock("@/lib/CapabilitiesContext", () => ({
+  useServerInfo: () => ({ login_url: "/login", single_user: false, enabled_connections: [] }),
+}));
+vi.mock("@/lib/identity", () => ({
+  resolveIdentity: vi.fn(),
+  getCurrentIsAdmin: vi.fn(),
+  authenticatedFetch: vi.fn(),
+}));
+vi.mock("@/components/ui/toast", () => ({ showToast: vi.fn() }));
+
+interface Stored {
+  id: string;
+  repository: string | null;
+  name: string;
+  transport: "http" | "stdio";
+  agents: string[];
+  url?: string;
+  headers?: Record<string, string>;
+  command?: string;
+  args?: string[];
+  env?: Record<string, string>;
+}
+
+// What the fake server holds, values included.
+const ROADPASS = "github.com/kunlabora/roadpass";
+
+let stored: Stored[];
+let requests: { method: string; url: string; body?: Record<string, unknown> }[];
+
+function json(status: number, body: unknown): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+function entry(server: Stored) {
+  return {
+    id: server.id,
+    repository: server.repository,
+    name: server.name,
+    transport: server.transport,
+    url: server.url ?? null,
+    header_names: Object.keys(server.headers ?? {}).sort(),
+    command: server.command ?? null,
+    args: server.args ?? [],
+    env_names: Object.keys(server.env ?? {}).sort(),
+    agents: server.agents,
+    updated_at: new Date(Date.now() - 2 * 86_400_000).toISOString(),
+    updated_by: "levi",
+  };
+}
+
+function merge(sent: Record<string, string | null>, current: Record<string, string>) {
+  const next: Record<string, string> = {};
+  for (const [name, value] of Object.entries(sent)) {
+    if (value === null && !(name in current)) throw new Error(`${name} has no value yet`);
+    next[name] = value ?? current[name];
+  }
+  return next;
+}
+
+async function fakeFetch(input: RequestInfo | URL, init?: RequestInit): Promise<Response> {
+  const url = String(input);
+  const method = init?.method ?? "GET";
+  const body = init?.body ? JSON.parse(String(init.body)) : undefined;
+  requests.push({ method, url, body });
+  if (method === "GET" && url === "/v1/mcp-servers") {
+    return json(200, { object: "list", data: stored.map(entry) });
+  }
+  if (method === "PUT") {
+    const current = stored.find((s) => s.id === body.id);
+    const same = current?.transport === body.transport ? current : undefined;
+    try {
+      const server: Stored = {
+        id: current?.id ?? `id-${stored.length + 1}`,
+        repository: body.repository,
+        name: body.name,
+        transport: body.transport,
+        agents: body.agents,
+        ...(body.transport === "http"
+          ? { url: body.url, headers: merge(body.headers ?? {}, same?.headers ?? {}) }
+          : {
+              command: body.command,
+              args: body.args,
+              env: merge(body.env ?? {}, same?.env ?? {}),
+            }),
+      };
+      stored = current ? stored.map((s) => (s === current ? server : s)) : [...stored, server];
+      return json(200, entry(server));
+    } catch (err) {
+      return json(400, { error: { message: (err as Error).message } });
+    }
+  }
+  if (method === "DELETE") {
+    const id = new URL(url, "http://x").pathname.split("/").pop();
+    stored = stored.filter((s) => s.id !== id);
+    return json(200, { id, deleted: true });
+  }
+  return json(404, { error: { message: "not found" } });
+}
+
+function renderPage() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={client}>
+      <McpServersPage />
+    </QueryClientProvider>,
+  );
+}
+
+function lastPut() {
+  return requests.filter((r) => r.method === "PUT").at(-1)?.body;
+}
+
+beforeEach(() => {
+  stored = [
+    {
+      id: "figma-id",
+      repository: null,
+      name: "figma",
+      transport: "stdio",
+      agents: ["claude", "codex"],
+      command: "npx",
+      args: ["-y", "figma-developer-mcp", "--stdio"],
+      env: { FIGMA_API_KEY: "figd_secret" },
+    },
+    {
+      id: "linear-id",
+      repository: null,
+      name: "linear",
+      transport: "http",
+      agents: ["codex"],
+      url: "https://mcp.linear.app/mcp",
+      headers: { Authorization: "Bearer lin_secret" },
+    },
+  ];
+  requests = [];
+  vi.mocked(identity.resolveIdentity).mockResolvedValue("levi");
+  vi.mocked(identity.getCurrentIsAdmin).mockReturnValue(true);
+  vi.mocked(identity.authenticatedFetch).mockImplementation(fakeFetch);
+});
+
+afterEach(cleanup);
+
+describe("McpServersPage", () => {
+  it("lists the servers with their header and variable names, never values", async () => {
+    renderPage();
+    const figma = await screen.findByRole("article", { name: "figma" });
+    expect(within(figma).getByText("npx -y figma-developer-mcp --stdio")).toBeInTheDocument();
+    expect(within(figma).getByText("FIGMA_API_KEY")).toBeInTheDocument();
+    expect(
+      within(figma).getByText(/Command · Claude Code and Codex · updated 2d ago by levi/),
+    ).toBeInTheDocument();
+    const linear = screen.getByRole("article", { name: "linear" });
+    expect(within(linear).getByText(/HTTP · mcp.linear.app · Codex only/)).toBeInTheDocument();
+    expect(within(linear).getByText("Authorization")).toBeInTheDocument();
+    expect(document.body.textContent).not.toContain("secret");
+  });
+
+  it("tells a non-admin they can't manage it", async () => {
+    vi.mocked(identity.getCurrentIsAdmin).mockReturnValue(false);
+    renderPage();
+    expect(
+      await screen.findByText("You don't have permission to manage MCP servers."),
+    ).toBeInTheDocument();
+    expect(requests).toEqual([]);
+  });
+
+  it("adds a command server with its arguments and variables", async () => {
+    renderPage();
+    fireEvent.click(await screen.findByRole("button", { name: "Add server" }));
+    const editor = screen.getByTestId("mcp-server-editor");
+    fireEvent.change(within(editor).getByLabelText("Name"), { target: { value: "github" } });
+    fireEvent.click(within(editor).getByLabelText("Command (stdio)"));
+    fireEvent.click(within(editor).getByLabelText("Claude Code"));
+    fireEvent.change(within(editor).getByLabelText("Command"), { target: { value: "docker" } });
+    fireEvent.change(within(editor).getByLabelText("Arguments"), {
+      target: { value: "run\n-i\n\n--rm\nghcr.io/github/github-mcp-server" },
