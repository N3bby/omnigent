+
+function plural(count: number, word: string): string {
+  return `${count} ${word}${count === 1 ? "" : "s"}`;
+}
+
+/** ``["claude", "codex"]`` → ``"Claude Code and Codex"``; none → ``"Off"``. */
+function agentsLabel(agents: McpAgent[]): string {
+  const labels = MCP_AGENTS.filter((a) => agents.includes(a.id)).map((a) => a.label);
+  if (!labels.length) return "Off";
+  return labels.length === 1 ? `${labels[0]} only` : labels.join(" and ");
+}
+
+/** The command line as a shell would show it, quoting what needs it. */
+function commandLine(server: McpServer): string {
+  const quote = (word: string) =>
+    /^[A-Za-z0-9_@%+=:,./-]+$/.test(word) ? word : `'${word.replaceAll("'", `'\\''`)}'`;
+  return [server.command ?? "", ...server.args].map(quote).join(" ");
