+import { describe, expect, it } from "vitest";
+import { MCP_BRANDS, initialHue, lightOn, serverBrand } from "./mcpServerIcons";
+
+describe("serverBrand", () => {
+  it("recognises a service by name, then URL host, then arguments", () => {
+    expect(serverBrand({ name: "figma" })?.title).toBe("Figma");
+    expect(serverBrand({ name: "tracker", url: "https://mcp.linear.app/mcp" })?.title).toBe(
+      "Linear",
+    );
+    expect(
+      serverBrand({ name: "db", args: ["-y", "@modelcontextprotocol/server-postgres"] })?.title,
+    ).toBe("PostgreSQL");
+    // The name wins over what the URL or arguments say.
+    expect(serverBrand({ name: "sentry", url: "https://api.githubcopilot.com/mcp/" })?.title).toBe(
+      "Sentry",
+    );
+  });
+
+  it("never counts the command, only what it runs", () => {
+    expect(
+      serverBrand({
+        name: "code",
+        args: ["run", "-i", "--rm", "ghcr.io/github/github-mcp-server"],
+      })?.title,
+    ).toBe("GitHub");
+    expect(serverBrand({ name: "tools", args: ["-y", "some-mcp-server"] })).toBeNull();
+  });
+
+  it("matches whole words only", () => {
+    expect(serverBrand({ name: "mirror" })).toBeNull();
+    expect(serverBrand({ name: "my-figma-tools" })?.title).toBe("Figma");
+  });
+
+  it("has a colour and a path for every brand", () => {
+    for (const brand of MCP_BRANDS) {
+      expect(brand.hex).toMatch(/^[0-9A-F]{6}$/);
+      expect(brand.path).toMatch(/^[Mm]/);
+    }
+  });
+});
+
+describe("lightOn and initialHue", () => {
+  it("puts white on brand colours unless they are too light for it", () => {
+    expect(lightOn("181717")).toBe(true); // GitHub
+    expect(lightOn("5E6AD2")).toBe(true); // Linear
+    // White on Figma's orange has 3.6:1, enough for a logo.
+    expect(lightOn("F24E1E")).toBe(true);
+    expect(lightOn("3FCF8E")).toBe(false); // Supabase
+    expect(lightOn("FFD21E")).toBe(false); // Hugging Face
+  });
+
+  it("gives the same name the same hue, whatever its case", () => {
+    expect(initialHue("context7")).toBe(initialHue("Context7"));
+    expect(initialHue("context7")).not.toBe(initialHue("storybook"));
+  });
+});
