+ * connection, about two minutes in all. While a sandbox starts the server
+ * holds the POST open, and a phone can drop it then, for example when
+ * Tailscale reapplies its routes as the session's Pod joins the tailnet. The
+ * server delivers a message with the same `stable_id` once, so a resend
+ * waits for the first copy or gets its answer.
+ */
+export const MESSAGE_RESEND_DELAYS_MS = [
+  1_000, 2_000, 4_000, 8_000, 15_000, 15_000, 15_000, 15_000, 15_000, 15_000,
+];
+
+/**
+ * Whether `fetch` failed without a response: "Load failed" in Safari,
+ * "Failed to fetch" in Chrome, "NetworkError when attempting to fetch
+ * resource." in Firefox. An aborted fetch rejects with a DOMException instead.
+ */
+export function isNetworkError(err: unknown): boolean {
+  return err instanceof TypeError;
+}
+
+/** Run `send`, and again after a network error, until it gets a response. */
+async function sendResending(send: () => Promise<Response>, attempt = 0): Promise<Response> {
+  try {
+    return await send();
+  } catch (err) {
+    const delay = MESSAGE_RESEND_DELAYS_MS[attempt];
+    if (!isNetworkError(err) || delay === undefined) throw err;
+    await new Promise<void>((resolve) => {
+      setTimeout(resolve, delay);
+    });
+    return sendResending(send, attempt + 1);
+  }
+}
