+/**
+ * Admin subscriptions page (``/settings/subscriptions``): the named Claude and
+ * ChatGPT accounts this deployment's agents can use, and which one is active
+ * for each provider. Credentials never come back from the server; the page
+ * only ever sees names, IDs and timestamps.
+ */
+
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import {
+  CheckIcon,
+  CopyIcon,
+  ExternalLinkIcon,
+  Loader2Icon,
+  PencilIcon,
+  PlusIcon,
+  Trash2Icon,
+} from "lucide-react";
+import { ClaudeIcon } from "@/components/icons/ClaudeIcon";
+import { CodexIcon } from "@/components/icons/CodexIcon";
+import { PageScroll } from "@/components/PageScroll";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { showToast } from "@/components/ui/toast";
+import { useServerInfo } from "@/lib/CapabilitiesContext";
+import { isSingleUserMode } from "@/lib/capabilities";
+import { getCurrentIsAdmin, resolveIdentity } from "@/lib/identity";
+import { absoluteTime, relativeTime } from "@/lib/relativeTime";
+import {
+  subscriptionRequest,
+  SubscriptionRequestError,
+  type Login,
+  type Provider,
+  type Subscription,
+  type Subscriptions,
+} from "@/lib/subscriptions";
+import { cn } from "@/lib/utils";
+
+const PAGE_PADDING = "px-4 sm:px-8";
+const TOUCH_ICON_BUTTON = "max-md:pointer-coarse:size-10";
+const TOUCH_HEIGHT = "max-md:pointer-coarse:h-10";
+
+const PROVIDERS: { id: Provider; name: string; plans: string; signIn: string }[] = [
+  { id: "claude", name: "Claude", plans: "Claude Pro and Max", signIn: "Claude" },
+  { id: "codex", name: "Codex", plans: "ChatGPT Plus, Pro and Business", signIn: "ChatGPT" },
+];
+const providerName = (provider: Provider) => PROVIDERS.find((p) => p.id === provider)!.name;
+const signInName = (provider: Provider) => PROVIDERS.find((p) => p.id === provider)!.signIn;
+
+function ProviderLogo({ provider, className }: { provider: Provider; className?: string }) {
+  const Icon = provider === "claude" ? ClaudeIcon : CodexIcon;
+  return (
+    <Icon
+      aria-hidden
+      size={20}
+      className={cn("shrink-0", provider === "claude" && "text-[#D97757]", className)}
+    />
+  );
+}
+
+function updated(account: Subscription) {
+  const at = Date.parse(account.updated_at);
+  const ago = relativeTime(at);
+  return ago ? `Updated ${ago === "now" ? "just now" : `${ago} ago`}` : "";
+}
+
+export function SubscriptionsPage() {
+  const info = useServerInfo();
+  const isSingleUser = isSingleUserMode(info);
+  const [meIsAdmin, setMeIsAdmin] = useState<boolean | null>(null);
+  const [data, setData] = useState<Subscriptions | null>(null);
+  const [error, setError] = useState("");
+  const [pending, setPending] = useState<string | null>(null);
+  const [editor, setEditor] = useState<{ provider: Provider; account?: Subscription } | null>(null);
+  const [remove, setRemove] = useState<Subscription | null>(null);
+  const allowed = isSingleUser || meIsAdmin === true;
+
+  // Admin probe via `/v1/me`, as on the other admin pages: the cached
+  // useIsAdmin value can still be false when this page is opened directly.
+  useEffect(() => {
+    if (isSingleUser) return;
+    void (async () => {
+      const userId = await resolveIdentity();
+      if (userId === null) return;
+      setMeIsAdmin(getCurrentIsAdmin());
+    })();
+  }, [isSingleUser]);
+
+  function load() {
+    setError("");
+    subscriptionRequest<Subscriptions>()
+      .then(setData)
+      .catch((e: Error) => setError(e.message));
+  }
+
+  useEffect(() => {
+    if (allowed) load();
+  }, [allowed]);
+
+  async function activate(account: Subscription) {
+    setPending(account.id);
+    setError("");
+    try {
+      setData(await subscriptionRequest<Subscriptions>(`/${account.id}/activate`, "POST"));
+      showToast(
+        `${account.name} is now the active ${providerName(account.provider)} account. Stop and resume open sessions to switch them.`,
+      );
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setPending(null);
+    }
+  }
+
+  async function confirmRemove(account: Subscription) {
+    setPending(account.id);
+    setError("");
+    try {
+      setData(await subscriptionRequest<Subscriptions>(`/${account.id}`, "DELETE"));
+      setRemove(null);
+      showToast(`Removed ${account.name}.`);
+    } catch (e) {
+      setError((e as Error).message);
+      setRemove(null);
+    } finally {
+      setPending(null);
+    }
+  }
+
+  if (!isSingleUser && meIsAdmin === null) {
+    return (
+      <div className="flex min-h-full items-center justify-center text-ui text-muted-foreground">
+        Loading...
+      </div>
+    );
+  }
+
+  if (!allowed) {
+    return (
+      <PageScroll contentClassName={PAGE_PADDING} extraBottom="2.5rem">
+        <h1 className="mb-2 text-2xl font-semibold">Subscriptions</h1>
+        <p className="text-ui text-muted-foreground">
+          You don't have permission to manage subscriptions.
+        </p>
+      </PageScroll>
+    );
+  }
+
+  return (
+    <PageScroll contentClassName={PAGE_PADDING} extraBottom="2.5rem">
+      <div className="mb-6 max-w-xl">
+        <h1 className="text-2xl font-semibold">Subscriptions</h1>
+        <p className="mt-1 text-ui text-muted-foreground">
+          The Claude and ChatGPT accounts agents use, shared by everyone on this deployment.
+          Switching reaches new sessions within about a minute. To move an open session, choose Stop
+          session in its menu, then send another message.
+        </p>
+      </div>
+
+      {error && (
+        <div
+          role="alert"
+          className="mb-4 flex max-w-3xl items-center justify-between gap-3 rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-ui text-destructive"
+        >
+          <span>{error}</span>
+          <Button variant="ghost" size="sm" onClick={load} className={TOUCH_HEIGHT}>
+            Reload
+          </Button>
+        </div>
+      )}
+
+      {!data ? (
+        !error && <p className="text-ui text-muted-foreground">Loading…</p>
+      ) : (
+        <div className="flex max-w-3xl flex-col gap-8">
+          {PROVIDERS.map((provider) => (
+            <ProviderSection
+              key={provider.id}
+              provider={provider.id}
+              accounts={data.data.filter((a) => a.provider === provider.id)}
+              pending={pending}
+              onAdd={() => setEditor({ provider: provider.id })}
+              onActivate={(account) => void activate(account)}
+              onEdit={(account) => setEditor({ provider: provider.id, account })}
+              onRemove={setRemove}
+            />
+          ))}
+          <p className="text-sm text-muted-foreground">
+            Credentials are kept in a Kubernetes Secret and are never sent back to the browser. Each
+            account keeps its own usage limits; switching doesn't move or reset them.
+          </p>
+        </div>
+      )}
+
+      {editor && (
+        <SubscriptionEditor
+          provider={editor.provider}
+          account={editor.account}
+          onClose={() => setEditor(null)}
+          onSaved={(value, name) => {
+            setData(value);
+            setEditor(null);
+            showToast(`Saved ${name}.`);
+          }}
+        />
+      )}
+
+      <Dialog
+        open={!!remove}
+        onOpenChange={(open) => {
+          if (!open && !pending) setRemove(null);
+        }}
+      >
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>Remove {remove?.name}?</DialogTitle>
+            <DialogDescription>
+              Its saved login is deleted from this deployment. That doesn't sign it out with{" "}
+              {remove ? signInName(remove.provider) : ""}, and you can add it again later.
+            </DialogDescription>
+          </DialogHeader>
+          <DialogFooter>
+            <Button variant="outline" disabled={!!pending} onClick={() => setRemove(null)}>
+              Cancel
+            </Button>
+            <Button
+              variant="destructive"
+              loading={!!pending}
+              onClick={() => remove && void confirmRemove(remove)}
+            >
+              Remove
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </PageScroll>
+  );
+}
+
+function ProviderSection({
+  provider,
+  accounts,
+  pending,
+  onAdd,
+  onActivate,
+  onEdit,
+  onRemove,
+}: {
+  provider: Provider;
+  accounts: Subscription[];
+  pending: string | null;
+  onAdd: () => void;
+  onActivate: (account: Subscription) => void;
+  onEdit: (account: Subscription) => void;
+  onRemove: (account: Subscription) => void;
+}) {
+  const meta = PROVIDERS.find((p) => p.id === provider)!;
+  return (
+    <section aria-labelledby={`subscriptions-${provider}`}>
+      <div className="mb-2 flex items-center justify-between gap-3">
+        <div className="flex min-w-0 items-center gap-2.5">
+          <ProviderLogo provider={provider} />
+          <div className="min-w-0">
+            <h2 id={`subscriptions-${provider}`} className="text-ui font-semibold">
+              {meta.name}
+            </h2>
+            <p className="text-sm text-muted-foreground">{meta.plans}</p>
+          </div>
+        </div>
+        {accounts.length > 0 && (
+          <Button
+            variant="outline"
+            size="sm"
+            disabled={!!pending}
+            onClick={onAdd}
+            aria-label={`Add ${meta.name} account`}
+            className={TOUCH_HEIGHT}
+          >
+            <PlusIcon className="ui-icon" />
+            Add account
+          </Button>
+        )}
+      </div>
+      {accounts.length === 0 ? (
+        <div className="flex flex-col items-start gap-3 rounded-lg border border-dashed border-border px-4 py-5 sm:flex-row sm:items-center sm:justify-between">
+          <p className="text-ui text-muted-foreground">
+            No accounts yet. Agents use the login this deployment was set up with.
+          </p>
+          <Button
+            variant="outline"
+            size="sm"
+            onClick={onAdd}
+            aria-label={`Add ${meta.name} account`}
+            className={cn("shrink-0", TOUCH_HEIGHT)}
+          >
+            <PlusIcon className="ui-icon" />
+            Add account
+          </Button>
+        </div>
+      ) : (
+        <div
+          role="radiogroup"
+          aria-label={`Active ${meta.name} account`}
+          className="divide-y divide-border overflow-hidden rounded-lg border border-border"
+        >
+          {accounts.map((account) => (
+            <AccountRow
+              key={account.id}
+              account={account}
+              pending={pending}
+              onActivate={() => onActivate(account)}
+              onEdit={() => onEdit(account)}
+              onRemove={() => onRemove(account)}
+            />
+          ))}
+        </div>
+      )}
+    </section>
+  );
+}
+
+function AccountRow({
+  account,
+  pending,
+  onActivate,
+  onEdit,
+  onRemove,
+}: {
+  account: Subscription;
+  pending: string | null;
+  onActivate: () => void;
+  onEdit: () => void;
+  onRemove: () => void;
+}) {
+  const switching = pending === account.id;
+  return (
+    <div className={cn("flex items-center gap-1 pr-2", account.active && "bg-muted/40")}>
+      <label
+        className={cn(
+          "flex min-w-0 flex-1 items-center gap-3 py-3 pl-4",
+          !account.active && !pending && "cursor-pointer",
+        )}
+      >
+        <input
+          type="radio"
+          name={`subscription-${account.provider}`}
+          checked={account.active}
+          disabled={!!pending}
+          onChange={onActivate}
+          className="size-4 shrink-0 accent-primary"
+        />
+        <span className="min-w-0 flex-1">
+          <span className="flex items-center gap-2">
+            <span className="truncate text-ui font-medium">{account.name}</span>
+            {account.active && (
+              <span className="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
+                Active
+              </span>
+            )}
+            {switching && <Loader2Icon className="ui-icon animate-spin text-muted-foreground" />}
+          </span>
+          <span
+            className="block text-sm text-muted-foreground"
+            title={absoluteTime(Date.parse(account.updated_at))}
+          >
+            {updated(account)}
+          </span>
+        </span>
+      </label>
+      <Button
+        variant="ghost"
+        size="icon"
+        aria-label={`Edit ${account.name}`}
+        disabled={!!pending}
+        onClick={onEdit}
+        className={TOUCH_ICON_BUTTON}
+      >
+        <PencilIcon className="ui-icon" />
+      </Button>
+      <Button
+        variant="ghost"
+        size="icon"
+        aria-label={`Remove ${account.name}`}
+        title={
+          account.active ? "Switch to another account before removing this one" : "Remove account"
+        }
+        disabled={!!pending || account.active}
+        onClick={onRemove}
+        className={TOUCH_ICON_BUTTON}
+      >
+        <Trash2Icon className="ui-icon" />
+      </Button>
+    </div>
+  );
+}
+
+function Step({ n, title, children }: { n: number; title: string; children: ReactNode }) {
+  return (
+    <li className="flex gap-3">
+      <span
+        aria-hidden
+        className="flex size-6 shrink-0 items-center justify-center rounded-full border border-border text-xs font-medium text-muted-foreground"
+      >
+        {n}
+      </span>
+      <div className="min-w-0 flex-1 space-y-2 pt-0.5">
+        <p className="text-ui font-medium">{title}</p>
+        {children}
+      </div>
+    </li>
+  );
+}
+
+function SubscriptionEditor({
+  provider,
+  account,
+  onClose,
+  onSaved,
+}: {
+  provider: Provider;
+  account?: Subscription;
+  onClose: () => void;
+  onSaved: (data: Subscriptions, name: string) => void;
+}) {
+  const [name, setName] = useState(account?.name ?? "");
+  const [credential, setCredential] = useState("");
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [login, setLogin] = useState<Login | null>(null);
+  const [loginId, setLoginId] = useState<string | null>(null);
+  const [authorizationCode, setAuthorizationCode] = useState("");
+  const [manual, setManual] = useState(false);
+  const [pollError, setPollError] = useState("");
+  const [codeSubmitted, setCodeSubmitted] = useState(false);
+  const [copied, setCopied] = useState(false);
+  const via = signInName(provider);
+  // The parent passes a new callback each render; polling shouldn't restart.
+  const saved = useRef(onSaved);
+  saved.current = onSaved;
+  const nameRef = useRef(name);
+  nameRef.current = name;
+
+  useEffect(() => {
+    if (!loginId) return;
+    let live = true;
+    let timer: ReturnType<typeof setTimeout>;
+    async function poll() {
+      try {
+        const result = await subscriptionRequest<Login>(`/login/${loginId}`);
+        if (!live) return;
+        setPollError("");
+        setLogin(result);
+        if (result.status === "complete" && result.subscriptions) {
+          saved.current(result.subscriptions, nameRef.current.trim());
+          return;
+        }
+        if (result.status === "expired" || result.status === "failed") {
+          setError(
+            result.status === "failed"
+              ? provider === "claude" && codeSubmitted
+                ? "Claude didn't accept that code. Start again and paste the whole code."
+                : "Sign-in failed. Start again."
+              : "Sign-in expired. Start again.",
+          );
+          setLoginId(null);
+          setLogin(null);
+          return;
+        }
+      } catch (e) {
+        if (!live) return;
+        if (e instanceof SubscriptionRequestError && e.status < 500) {
+          setError(e.message);
+          return; // Keep the helper ID so Cancel still cleans it up.
+        }
+        setPollError("Connection interrupted. Retrying…");
+      }
+      timer = setTimeout(() => void poll(), 2000);
+    }
+    void poll();
+    return () => {
+      live = false;
+      clearTimeout(timer);
+    };
+  }, [loginId, provider, codeSubmitted]);
+
+  async function close() {
+    if (busy) return;
+    if (loginId) {
+      try {
+        await subscriptionRequest(`/login/${loginId}`, "DELETE");
+      } catch (e) {
+        setError((e as Error).message);
+        return;
+      }
+    }
+    onClose();
+  }
+
+  async function save() {
+    setBusy(true);
+    setError("");
+    try {
+      const value = await subscriptionRequest<Subscriptions>("", "PUT", {
+        provider,
+        name: name.trim(),
+        credential: credential || null,
+        id: account?.id,
+      });
+      onSaved(value, name.trim());
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function connect() {
+    setCodeSubmitted(false);
+    setPollError("");
+    setBusy(true);
+    setError("");
+    try {
+      const result = await subscriptionRequest<Login>(`/login/${provider}`, "POST", {
+        name: name.trim(),
+        id: account?.id,
+      });
+      setLogin(result);
+      setLoginId(result.id!);
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function submitCode() {
+    if (!loginId) return;
+    setBusy(true);
+    setError("");
+    try {
+      const state = await subscriptionRequest<Login>(`/login/${loginId}/code`, "POST", {
+        code: authorizationCode.trim(),
+      });
+      setLogin(state);
+      setCodeSubmitted(true);
+      setAuthorizationCode("");
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function copyCode(code: string) {
+    try {
+      await navigator.clipboard.writeText(code);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 1500);
+    } catch {
+      // Clipboard access can be denied; the code stays selectable.
+    }
+  }
+
+  const waiting = login?.status === "waiting" && !codeSubmitted;
+  const canSave = !loginId && name.trim() && (account ? true : !!credential);
+
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open) void close();
+      }}
+    >
+      <DialogContent className="sm:max-w-md">
+        <DialogHeader>
+          <DialogTitle className="flex items-center gap-2.5">
+            <ProviderLogo provider={provider} />
+            {account ? `Edit ${account.name}` : `Add ${providerName(provider)} account`}
+          </DialogTitle>
+          <DialogDescription>
+            {account
+              ? `Rename it, or sign in again to replace its ${via} login.`
+              : `Name it so you can tell it apart, then sign in with ${via}.`}
+          </DialogDescription>
+        </DialogHeader>
+
+        <div className="flex flex-col gap-5">
+          <div className="flex flex-col gap-1.5">
+            <label className="text-sm font-medium" htmlFor="subscription-name">
+              Name
+            </label>
+            <Input
+              id="subscription-name"
+              placeholder="Personal, Work…"
+              value={name}
+              maxLength={80}
+              disabled={!!loginId || busy}
+              onChange={(e) => setName(e.target.value)}
+              autoComplete="off"
+              className={TOUCH_HEIGHT}
+            />
+          </div>
+
+          {loginId ? (
+            waiting ? (
+              <ol className="flex flex-col gap-4">
+                {provider === "claude" ? (
+                  <>
+                    <Step n={1} title="Approve access in Claude">
+                      <Button asChild variant="outline" className={cn("w-full", TOUCH_HEIGHT)}>
+                        <a href={login?.url} target="_blank" rel="noopener noreferrer">
+                          Continue with Claude
+                          <ExternalLinkIcon className="ui-icon" />
+                        </a>
+                      </Button>
+                    </Step>
+                    <Step n={2} title="Paste the code Claude shows you">
+                      <form
+                        className="flex gap-2"
+                        onSubmit={(e) => {
+                          e.preventDefault();
+                          void submitCode();
+                        }}
+                      >
+                        <Input
+                          id="subscription-code"
+                          aria-label="Authorization code"
+                          placeholder="code#state"
+                          value={authorizationCode}
+                          onChange={(e) => setAuthorizationCode(e.target.value)}
+                          autoComplete="off"
+                          spellCheck={false}
+                          disabled={busy}
+                          className={cn("font-mono", TOUCH_HEIGHT)}
+                        />
+                        <Button
+                          type="submit"
+                          loading={busy}
+                          disabled={!authorizationCode.trim()}
+                          className={TOUCH_HEIGHT}
+                        >
+                          Finish sign-in
+                        </Button>
+                      </form>
+                    </Step>
+                  </>
+                ) : (
+                  <>
+                    <Step n={1} title="Copy this one-time code">
+                      <div className="flex items-center gap-2 rounded-md border border-border bg-muted/40 py-1.5 pr-1.5 pl-3">
+                        <code className="flex-1 font-mono text-lg tracking-[0.2em] select-all">
+                          {login?.code}
+                        </code>
+                        <Button
+                          variant="ghost"
+                          size="sm"
+                          onClick={() => login?.code && void copyCode(login.code)}
+                          className={TOUCH_HEIGHT}
+                        >
+                          {copied ? (
+                            <CheckIcon className="ui-icon" />
+                          ) : (
+                            <CopyIcon className="ui-icon" />
+                          )}
+                          {copied ? "Copied" : "Copy"}
+                        </Button>
+                      </div>
+                    </Step>
+                    <Step n={2} title="Enter it on the ChatGPT sign-in page">
+                      <Button asChild variant="outline" className={cn("w-full", TOUCH_HEIGHT)}>
+                        <a href={login?.url} target="_blank" rel="noopener noreferrer">
+                          Continue with ChatGPT
+                          <ExternalLinkIcon className="ui-icon" />
+                        </a>
+                      </Button>
+                      <p className="flex items-center gap-2 text-sm text-muted-foreground">
+                        <Loader2Icon className="ui-icon animate-spin" />
+                        Saves on its own once you've signed in.
+                      </p>
+                    </Step>
+                  </>
+                )}
+              </ol>
+            ) : (
+              <p
+                role="status"
+                className="flex items-center gap-2 rounded-md border border-border px-3 py-3 text-ui text-muted-foreground"
+              >
+                <Loader2Icon className="ui-icon animate-spin" />
+                {login?.status === "exchanging" || codeSubmitted
+                  ? "Finishing sign-in…"
+                  : "Preparing a secure sign-in…"}
+              </p>
+            )
+          ) : (
+            <div className="flex flex-col gap-2">
+              <Button
+                variant={account ? "outline" : "default"}
+                loading={busy && !manual}
+                disabled={busy || !name.trim()}
+                onClick={() => void connect()}
+                className={TOUCH_HEIGHT}
+              >
+                <ProviderLogo
+                  provider={provider}
+                  className={cn("size-4", provider === "codex" && "text-current")}
+                />
+                {account ? `Sign in again with ${via}` : `Sign in with ${via}`}
+              </Button>
+              <button
+                type="button"
+                className="self-start text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
+                onClick={() => setManual((current) => !current)}
+              >
+                {manual
+                  ? "Hide credential import"
+                  : provider === "claude"
+                    ? "Already have a token? Import instead"
+                    : "Already have an auth.json? Import instead"}
+              </button>
+              {manual &&
+                (provider === "claude" ? (
+                  <div className="flex flex-col gap-1.5">
+                    <label className="text-sm font-medium" htmlFor="subscription-token">
+                      Subscription token
+                    </label>
+                    <Input
+                      id="subscription-token"
+                      type="password"
+                      value={credential}
+                      placeholder="sk-ant-oat…"
+                      onChange={(e) => setCredential(e.target.value)}
+                      autoComplete="new-password"
+                      spellCheck={false}
+                      className={TOUCH_HEIGHT}
+                    />
+                    <p className="text-sm text-muted-foreground">
+                      From <code className="text-xs">claude setup-token</code>.
+                      {account ? " Leave it empty to keep the saved login." : ""}
+                    </p>
+                  </div>
+                ) : (
+                  <div className="flex flex-col gap-1.5">
+                    <label className="text-sm font-medium" htmlFor="subscription-auth">
+                      Codex auth.json
+                    </label>
+                    <Input
+                      id="subscription-auth"
+                      type="file"
+                      accept=".json,application/json"
+                      onChange={(e) => {
+                        const file = e.target.files?.[0];
+                        if (!file) return;
+                        if (file.size > 65536) {
+                          setError("That file is too large to be a Codex auth.json.");
+                          return;
+                        }
+                        void file
+                          .text()
+                          .then(setCredential)
+                          .catch(() => setError("Couldn't read that file."));
+                      }}
+                    />
+                    <p className="text-sm text-muted-foreground">
+                      From a ChatGPT login, usually{" "}
+                      <code className="text-xs">~/.codex/auth.json</code>. It's uploaded when you
+                      save.
+                    </p>
+                  </div>
+                ))}
+            </div>
+          )}
+
+          {(error || pollError) && (
+            <p role="alert" className="text-ui text-destructive">
+              {error || pollError}
+            </p>
+          )}
+        </div>
+
+        <DialogFooter>
+          <Button variant="outline" disabled={busy} onClick={() => void close()}>
+            Cancel
+          </Button>
+          {!loginId && (account || manual) && (
+            <Button loading={busy && !!canSave} disabled={!canSave} onClick={() => void save()}>
+              Save
+            </Button>
+          )}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
