@@ -0,0 +1,48 @@
+import { authenticatedFetch } from "./identity";
+
+export type Provider = "claude" | "codex";
+export interface Subscription {
+  id: string;
+  provider: Provider;
+  name: string;
+  active: boolean;
+  updated_at: string;
+}
+export interface Subscriptions {
+  data: Subscription[];
+  active: Partial<Record<Provider, string>>;
+}
+export interface Login {
+  id?: string;
+  status: "starting" | "waiting" | "complete" | "expired" | "exchanging" | "failed";
+  url?: string;
+  code?: string;
+  subscriptions?: Subscriptions;
+}
+
+export class SubscriptionRequestError extends Error {
+  readonly status: number;
+  constructor(message: string, status: number) {
+    super(message);
+    this.status = status;
+  }
+}
+
+export async function subscriptionRequest<T>(
+  path = "",
+  method = "GET",
+  body?: unknown,
+): Promise<T> {
+  const response = await authenticatedFetch(`/v1/subscriptions${path}`, {
+    method,
+    headers: body ? { "Content-Type": "application/json" } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  const data = await response.json();
+  if (!response.ok)
+    throw new SubscriptionRequestError(
+      data.error?.message ?? "Couldn't reach subscriptions. Try again.",
+      response.status,
+    );
+  return data as T;
+}
