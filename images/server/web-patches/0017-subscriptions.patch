+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { SubscriptionsPage } from "./SubscriptionsPage";
+import * as identity from "@/lib/identity";
+
+vi.mock("@/lib/CapabilitiesContext", () => ({ useServerInfo: () => ({ single_user: false }) }));
+vi.mock("@/lib/identity", () => ({
+  resolveIdentity: vi.fn(),
+  getCurrentIsAdmin: vi.fn(),
+  authenticatedFetch: vi.fn(),
+}));
+const accounts = [
+  { id: "personal", provider: "claude", name: "Personal", active: true, updated_at: "2026-10-12" },
+  { id: "work", provider: "claude", name: "Work", active: false, updated_at: "2026-10-12" },
+];
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), { status });
+function renderPage() {
+  return render(
+    <QueryClientProvider
+      client={new QueryClient({ defaultOptions: { queries: { retry: false } } })}
+    >
+      <SubscriptionsPage />
+    </QueryClientProvider>,
+  );
+}
+beforeEach(() => {
+  vi.mocked(identity.getCurrentIsAdmin).mockReturnValue(true);
+  vi.mocked(identity.resolveIdentity).mockResolvedValue("admin");
+  vi.mocked(identity.authenticatedFetch).mockResolvedValue(
+    json({ data: accounts, active: { claude: "personal" } }),
+  );
+});
+afterEach(() => {
+  cleanup();
+  vi.clearAllMocks();
+});
+
+describe("subscriptions", () => {
+  it("gates all reads for non-admins", async () => {
+    vi.mocked(identity.getCurrentIsAdmin).mockReturnValue(false);
+    renderPage();
+    expect(screen.getByText("Only admins can manage subscriptions.")).toBeInTheDocument();
+    expect(identity.authenticatedFetch).not.toHaveBeenCalled();
+  });
+
+  it("switches accounts and cannot remove the active account", async () => {
+    renderPage();
+    await screen.findByText("Personal");
+    expect(screen.getByRole("button", { name: "Remove Personal" })).toBeDisabled();
+    vi.mocked(identity.authenticatedFetch).mockResolvedValue(
+      json({
+        data: accounts.map((a) => ({ ...a, active: a.id === "work" })),
+        active: { claude: "work" },
+      }),
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Use" }));
+    await waitFor(() =>
+      expect(identity.authenticatedFetch).toHaveBeenLastCalledWith(
+        "/v1/subscriptions/work/activate",
+        expect.objectContaining({ method: "POST" }),
+      ),
+    );
+    await waitFor(() => expect(screen.getByRole("button", { name: "Remove Work" })).toBeDisabled());
+    expect(screen.getByRole("status")).toHaveTextContent("Stop and resume");
+  });
+
+  it("keeps credentials blank when editing and saves null to preserve them", async () => {
+    renderPage();
+    await screen.findByText("Personal");
+    fireEvent.click(screen.getByRole("button", { name: "Edit Work" }));
+    const dialog = screen.getByRole("dialog");
+    fireEvent.click(
+      within(dialog).getByRole("button", { name: "Already have credentials? Import instead" }),
+    );
+    expect(within(dialog).getByLabelText("Subscription token")).toHaveValue("");
+    fireEvent.change(within(dialog).getByLabelText("Subscription name"), {
+      target: { value: "Work renamed" },
+    });
+    fireEvent.click(within(dialog).getByRole("button", { name: "Save subscription" }));
+    await waitFor(() =>
+      expect(identity.authenticatedFetch).toHaveBeenLastCalledWith(
+        "/v1/subscriptions",
+        expect.objectContaining({
+          method: "PUT",
+          body: JSON.stringify({
+            provider: "claude",
+            name: "Work renamed",
+            credential: null,
+            id: "work",
+          }),
+        }),
+      ),
+    );
+  });
+
+  it("shows a failed switch without changing the active account", async () => {
+    renderPage();
+    await screen.findByText("Personal");
+    vi.mocked(identity.authenticatedFetch).mockResolvedValue(
+      json({ error: { message: "Subscriptions changed. Reload and try again." } }, 409),
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Use" }));
+    expect(await screen.findByRole("alert")).toHaveTextContent("Subscriptions changed");
+    expect(screen.getByRole("button", { name: "Remove Personal" })).toBeDisabled();
+  });
+
+  it("starts device login and cancels the helper on dialog close", async () => {
+    renderPage();
+    await screen.findByText("Personal");
+    fireEvent.click(screen.getAllByRole("button", { name: "Add subscription" })[1]);
+    fireEvent.change(screen.getByLabelText("Subscription name"), {
+      target: { value: "ChatGPT Personal" },
+    });
+    vi.mocked(identity.authenticatedFetch).mockImplementation(async (path, init) => {
+      if (String(path).endsWith("/login/codex")) return json({ id: "helper", status: "starting" });
+      if (init?.method === "DELETE") return json({ status: "cancelled" });
+      return json({
+        status: "waiting",
+        code: "ABCD-EFGHI",
+        url: "https://auth.openai.com/codex/device",
+      });
+    });
+    fireEvent.click(screen.getByRole("button", { name: "Sign in with ChatGPT" }));
+    await screen.findByText("ABCD-EFGHI");
+    fireEvent.click(screen.getByRole("button", { name: "Cancel" }));
+    await waitFor(() => expect(screen.queryByRole("dialog")).not.toBeInTheDocument());
+    expect(identity.authenticatedFetch).toHaveBeenLastCalledWith(
+      "/v1/subscriptions/login/helper",
+      expect.objectContaining({ method: "DELETE" }),
+    );
+  });
+});
+
+it("signs into Claude entirely through the browser flow", async () => {
+  renderPage();
+  await screen.findByText("Personal");
+  fireEvent.click(screen.getAllByRole("button", { name: "Add subscription" })[0]);
+  fireEvent.change(screen.getByLabelText("Subscription name"), { target: { value: "Travel" } });
+  vi.mocked(identity.authenticatedFetch).mockImplementation(async (path) => {
+    if (String(path).endsWith("/login/claude")) return json({ id: "helper", status: "starting" });
+    if (String(path).endsWith("/code")) return json({ status: "exchanging" });
+    return json({
+      status: "waiting",
+      url: "https://claude.com/cai/oauth/authorize?code_challenge=test",
+    });
+  });
+  fireEvent.click(screen.getByRole("button", { name: "Sign in with Claude" }));
+  await screen.findByRole("link", { name: "Continue with Claude" });
+  expect(screen.queryByText(/setup-token/)).not.toBeInTheDocument();
+  fireEvent.change(screen.getByLabelText("Authorization code"), {
+    target: { value: "one-time-code#state" },
+  });
+  fireEvent.click(screen.getByRole("button", { name: "Finish sign-in" }));
+  await waitFor(() =>
+    expect(identity.authenticatedFetch).toHaveBeenLastCalledWith(
+      "/v1/subscriptions/login/helper/code",
+      expect.objectContaining({
+        method: "POST",
+        body: JSON.stringify({ code: "one-time-code#state" }),
+      }),
+    ),
+  );
+  expect(await screen.findByRole("status")).toHaveTextContent("Finishing sign-in");
+});
+
+it("keeps the helper available for cancellation after a failed poll", async () => {
+  renderPage();
+  await screen.findByText("Personal");
+  fireEvent.click(screen.getAllByRole("button", { name: "Add subscription" })[1]);
+  fireEvent.change(screen.getByLabelText("Subscription name"), { target: { value: "Travel" } });
+  vi.mocked(identity.authenticatedFetch).mockImplementation(async (path, init) => {
+    if (String(path).endsWith("/login/codex")) return json({ id: "helper", status: "starting" });
+    if (init?.method === "DELETE") return json({ status: "cancelled" });
+    throw new Error("Network unavailable");
+  });
+  fireEvent.click(screen.getByRole("button", { name: "Sign in with ChatGPT" }));
+  await screen.findByText("Connection interrupted. Retrying sign-in status…");
+  fireEvent.click(screen.getByRole("button", { name: "Cancel" }));
+  await waitFor(() => expect(screen.queryByRole("dialog")).not.toBeInTheDocument());
+  expect(identity.authenticatedFetch).toHaveBeenLastCalledWith(
+    "/v1/subscriptions/login/helper",
+    expect.objectContaining({ method: "DELETE" }),
+  );
+});
