+describe("EnvironmentMenu exit node row", () => {
+  const STATUS = { pod_started_at: Date.now() / 1000 - 600, cpu_cores: 0.2 };
+  const row = () => screen.getByTestId("environment-exit-node");
+
+  it("has no row when the repositories name no exit node", () => {
+    renderMenu({ state: "idle", status: STATUS });
+    expect(screen.queryByText("Exit node")).toBeNull();
+    expect(screen.queryByTestId("environment-exit-node")).toBeNull();
+  });
+
+  it("shows a connected exit node", () => {
+    renderMenu({
+      state: "idle",
+      status: { ...STATUS, exit_node: { state: "connected", name: "cronos-vpn" } },
+    });
+    expect(screen.getByText("Exit node")).toBeInTheDocument();
+    expect(row()).toHaveTextContent("cronos-vpn · connected");
+    expect(screen.getByText("cronos-vpn")).toHaveClass("font-mono");
+  });
+
+  it("says the session has no internet while it's offline", () => {
+    renderMenu({
+      state: "running",
+      status: { ...STATUS, exit_node: { state: "offline", name: "cronos-vpn" } },
+    });
+    expect(row()).toHaveTextContent(
+      "cronos-vpn · offlineThe session has no internet until it's back.",
+    );
+    expect(screen.getByText(/· offline/)).toHaveClass("text-destructive");
+  });
+
+  it("warns when the repositories name different exit nodes", () => {
+    renderMenu({
+      state: "idle",
+      status: { ...STATUS, exit_node: { state: "conflict", names: ["cronos-vpn", "office-exit"] } },
+    });
+    expect(row()).toHaveTextContent(
+      "None · the repositories name different ones (cronos-vpn, office-exit)",
+    );
+    expect(row()).toHaveClass("text-warning");
+  });
+
+  it("says why Tailscale refused it", () => {
+    renderMenu({
+      state: "idle",
+      status: {
+        ...STATUS,
+        exit_node: { state: "failed", name: "no-such-node", error: "no node found in netmap" },
+      },
+    });
+    expect(row()).toHaveTextContent("no-such-node · couldn't use itno node found in netmap");
+  });
+
+  it("says when the session doesn't use it, and names it when tailscaled didn't answer", () => {
+    const { rerender } = renderMenu({
+      state: "idle",
+      status: { ...STATUS, exit_node: { state: "off", name: "cronos-vpn" } },
+    });
+    expect(row()).toHaveTextContent("cronos-vpn · not in use");
+    rerenderMenu(rerender, {
+      state: "idle",
+      status: { ...STATUS, exit_node: { state: "unknown", name: "cronos-vpn" } },
+    });
+    expect(row()).toHaveTextContent(/^cronos-vpn$/);
+  });
+});
