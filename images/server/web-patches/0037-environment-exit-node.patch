+
+/**
+ * A session's exit node, as its runner reports it: `connected` or `offline`;
+ * `off` when the Pod doesn't use it; `failed` when Tailscale refused it
+ * (`error` says why); `conflict` when the repositories name different ones
+ * (`names`), so the Pod uses none; `unknown` when tailscaled didn't answer.
+ */
+export interface SessionExitNode {
+  state: "connected" | "offline" | "off" | "failed" | "conflict" | "unknown";
+  name?: string;
+  names?: string[];
+  error?: string;
 }
 
