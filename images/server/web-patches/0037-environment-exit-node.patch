+/**
+ * The tailnet exit node the session's repositories name, and whether it's
+ * up: while it's offline the session has no internet. No row without one.
+ */
+function ExitNodeRow({ status }: { status: SessionEnvironment }) {
+  const node = status.exit_node;
+  if (!node) return null;
+  if (node.state === "conflict") {
+    return (
+      <Row label="Exit node">
+        <span data-testid="environment-exit-node" data-state={node.state} className="text-warning">
+          None · the repositories name different ones ({(node.names ?? []).join(", ")})
+        </span>
+      </Row>
+    );
+  }
+  const name = <span className="font-mono">{node.name}</span>;
+  const content = {
+    connected: (
+      <>
+        {name} <Muted>· connected</Muted>
+      </>
+    ),
+    offline: (
+      <>
+        <span className="text-destructive">{name} · offline</span>
+        <span className="block text-muted-foreground">
+          The session has no internet until it's back.
+        </span>
+      </>
+    ),
+    failed: (
+      <>
+        <span className="text-destructive">{name} · couldn't use it</span>
+        {node.error && (
+          <span className="block break-words text-[11px] leading-4 text-muted-foreground">
+            {node.error}
+          </span>
+        )}
+      </>
+    ),
+    off: (
+      <>
+        {name} <Muted>· not in use</Muted>
+      </>
+    ),
+    unknown: name,
+  }[node.state];
+  return (
+    <Row label="Exit node">
+      <span data-testid="environment-exit-node" data-state={node.state}>
+        {content}
+      </span>
+    </Row>
+  );
+}
