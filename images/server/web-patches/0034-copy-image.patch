+describe("copyImage", () => {
+  it("writes a PNG before the image has loaded, inside the click's activation", async () => {
+    const write = vi.fn().mockResolvedValue(undefined);
+    Object.defineProperty(Navigator.prototype, "clipboard", {
+      configurable: true,
+      value: { write },
+    });
+    const items: Record<string, unknown>[] = [];
+    vi.stubGlobal(
+      "ClipboardItem",
+      vi.fn(function (item: Record<string, unknown>) {
+        items.push(item);
+      }),
+    );
+    // jsdom has no decode(); this one resolves when the test says so.
+    let loaded!: () => void;
+    const decoding = new Promise<void>((resolve) => {
+      loaded = resolve;
+    });
+    Object.defineProperty(HTMLImageElement.prototype, "decode", {
+      configurable: true,
+      value: () => decoding,
+    });
+
+    const copying = copyImage("blob:shot");
+
+    expect(write).toHaveBeenCalledOnce();
+    expect(Object.keys(items[0])).toEqual(["image/png"]);
+    expect(items[0]["image/png"]).toBeInstanceOf(Promise);
+    await copying;
+    // jsdom has no canvas, so the PNG itself never arrives.
+    loaded();
+    await expect(items[0]["image/png"]).rejects.toThrow();
+    vi.unstubAllGlobals();
+    delete (HTMLImageElement.prototype as { decode?: unknown }).decode;
+  });
+
+  it("fails without the async clipboard", async () => {
+    Object.defineProperty(Navigator.prototype, "clipboard", { configurable: true, value: {} });
