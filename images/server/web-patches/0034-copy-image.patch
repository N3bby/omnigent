+/**
+ * A right-click menu with "Copy image" around `children`, an image or its
+ * button, in the desktop app: its window has no context menu of its own, so a
+ * right-click there did nothing. A browser keeps its native menu, which has
+ * Copy image and more.
+ */
+export function ImageContextMenu({
+  src,
+  children,
+}: {
+  src?: string;
+  children: React.ReactElement;
+}) {
+  if (!src || !isElectronShell()) return children;
+  return (
+    <ContextMenu>
+      <ContextMenuTrigger asChild>{children}</ContextMenuTrigger>
+      <ContextMenuContent
+        // Above the lightbox, which opens on z-60.
+        className="z-[70]"
+        // The menu is portalled, but React still bubbles its events to the
+        // image's ancestors: keep the lightbox from taking a click on an item
+        // as a pan, or an arrow key as paging.
+        onPointerDown={(e) => e.stopPropagation()}
+        onKeyDown={(e) => e.stopPropagation()}
+      >
+        <ContextMenuItem
+          onSelect={() =>
+            copyImage(src).then(
+              () => toast.success("Copied the image."),
+              () => toast.error("Couldn't copy the image."),
+            )
+          }
+        >
+          <CopyIcon />
+          Copy image
+        </ContextMenuItem>
+      </ContextMenuContent>
+    </ContextMenu>
+  );
+}
