#!/usr/bin/env bash
# Applies every custom-feature patch to a clean upstream Omnigent checkout,
# the way the image builds do (--fuzz=0, in order, each image from fresh
# source), and byte-compiles the patched Python. Prints PASS/FAIL per patch.
#
#   check-patches            # the omnigent_commit pinned in versions.yaml
#   check-patches <commit>   # a candidate upgrade, before pinning it
#
# Accepts a commit or a tag. Exits 1 if any patch fails, so a failure means
# that image build would fail, and keeps the rejected hunks (*.rej) for
# inspection. Exits 2 if it could not run.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
commit="${1:-$(awk -F'"' '/^omnigent_commit:/ {print $2}' "$root/versions.yaml")}"
[[ -n "$commit" ]] || { echo "no omnigent_commit in versions.yaml" >&2; exit 2; }
command -v patch >/dev/null || { echo "needs GNU patch: apt-get install -y patch" >&2; exit 2; }

work="$(mktemp -d)"
rejects="$(mktemp -d)"
trap 'rm -rf "$work"; rmdir "$rejects" 2>/dev/null' EXIT
git -C "$work" init -q
git -C "$work" fetch -q --depth 1 https://github.com/omnigent-ai/omnigent.git "$commit" \
  || { echo "could not fetch upstream Omnigent $commit" >&2; exit 2; }
git -C "$work" -c advice.detachedHead=false checkout -q FETCH_HEAD
echo "upstream: $(git -C "$work" rev-parse HEAD)"

failed=0
# Each image applies its own patch set to fresh source; later patches in a set
# depend on earlier ones, so apply them for real, in order, then reset.
for set in images/runner/patches images/server/patches images/server/web-patches; do
  git -C "$work" checkout -q -- . && git -C "$work" clean -fdq
  set_failed=0
  for patch_file in "$root/$set"/*.patch; do
    name="${patch_file#"$root"/}"
    if out="$(patch -d "$work" -p1 --forward --fuzz=0 --no-backup-if-mismatch < "$patch_file" 2>&1)"; then
      echo "PASS  $name"
    else
      # A failed patch leaves its set half applied, so later failures in the
      # set may only be knock-on effects of the first.
      echo "FAIL  $name$( ((set_failed)) && echo " (after an earlier failure in this set; may be a knock-on)")"
      printf '        %s\n' "${out//$'\n'/$'\n'        }"
      set_failed=1
      mkdir -p "$rejects/${patch_file##*/}"
      (cd "$work" && find . -name '*.rej' -exec cp --parents {} "$rejects/${patch_file##*/}" \; -delete)
    fi
  done
  if ((set_failed)); then
    failed=1
    continue
  fi
  changed=()
  while IFS= read -r path; do
    [[ "$path" == *.py ]] && changed+=("$work/$path")
  done < <(git -C "$work" status --porcelain | awk '{print $2}')
  if ((${#changed[@]})); then
    if python3 -m py_compile "${changed[@]}"; then
      echo "PASS  $set: patched Python compiles"
    else
      echo "FAIL  $set: patched Python does not compile"
      failed=1
    fi
  fi
done

if [[ -n "$(ls -A "$rejects")" ]]; then
  echo "rejected hunks kept in $rejects"
fi
exit "$failed"
